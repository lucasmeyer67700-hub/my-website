[
  {
    "name": "theme_info",
    "theme_name": "Douceur",
    "theme_version": "1.0.0",
    "theme_author": "Sur mesure",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo et identité",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Format SVG ou PNG transparent recommandé. Sans logo, le nom de la boutique s'affiche dans la typographie des titres."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Largeur du logo",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Image carrée de 96 × 96 px minimum."
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Signature de marque",
        "default": "Le confort menstruel, avec douceur.",
        "info": "Affichée dans le pied de page."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Image de partage par défaut",
        "info": "Utilisée quand une page partagée sur les réseaux n'a pas d'image propre. 1200 × 630 px recommandé."
      },
      {
        "type": "header",
        "content": "Référencement"
      },
      {
        "type": "text",
        "id": "seo_home_title",
        "label": "Titre de la page d'accueil",
        "info": "Utilisé si le titre de la page d'accueil n'est pas renseigné dans Préférences (il vaut alors le nom de la boutique).",
        "default": "Ceinture chauffante pour les règles"
      },
      {
        "type": "textarea",
        "id": "seo_description",
        "label": "Description par défaut",
        "info": "Utilisée quand une page n'a pas de description (par exemple l'accueil). Environ 155 caractères.",
        "default": "VELEA, la ceinture chauffante sans fil pour vos jours de règles : une chaleur douce et réglable. Livraison offerte en France."
      }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Arrière-plan",
            "default": "#FCF9F7"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Dégradé d'arrière-plan (facultatif)",
            "info": "Laissez vide pour un fond uni, recommandé pour un rendu sobre."
          },
          {
            "type": "color",
            "id": "text",
            "label": "Texte",
            "default": "#49352F"
          },
          {
            "type": "color",
            "id": "text_muted",
            "label": "Texte secondaire",
            "default": "#6E574C"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent (surtitres, détails)",
            "default": "#725A4E"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "Surface (cartes, encadrés)",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Bordures",
            "default": "#EDE2DE"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Bouton principal",
            "default": "#49352F"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Texte du bouton principal",
            "default": "#FFFFFF"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Police des titres",
        "default": "instrument_serif_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Police du texte",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Taille des titres",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Largeur maximale du contenu",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Apparition douce des sections au défilement",
        "info": "Désactivée automatiquement pour les visiteurs qui ont demandé à réduire les animations.",
        "default": true
      }
    ]
  },
  {
    "name": "Réassurance",
    "settings": [
      {
        "type": "paragraph",
        "content": "Ces informations apparaissent sur la page produit, dans le panier et dans les sections de réassurance. N'indiquez que des informations vérifiées."
      },
      {
        "type": "text",
        "id": "shipping_info",
        "label": "Livraison",
        "default": "Livraison offerte en France"
      },
      {
        "type": "text",
        "id": "shipping_delay",
        "label": "Délai de livraison",
        "info": "Laissez vide tant que le délai n'est pas confirmé par votre fournisseur. Exemple : 7 à 14 jours ouvrés."
      },
      {
        "type": "text",
        "id": "returns_info",
        "label": "Retours",
        "default": "14 jours pour changer d'avis"
      },
      {
        "type": "text",
        "id": "warranty_info",
        "label": "Garantie",
        "default": "Garantie légale de conformité de 2 ans"
      },
      {
        "type": "page",
        "id": "shipping_page",
        "label": "Page livraison et retours"
      },
      {
        "type": "page",
        "id": "returns_page",
        "label": "Page politique de retour"
      },
      {
        "type": "text",
        "id": "health_notice",
        "label": "Mention de prudence",
        "default": "Accessoire de confort, la ceinture ne remplace pas un avis médical. En cas de douleurs intenses, inhabituelles ou persistantes, consultez un professionnel de santé."
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "options": [
          {
            "value": "drawer",
            "label": "Tiroir latéral"
          },
          {
            "value": "page",
            "label": "Page panier"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_note",
        "label": "Autoriser une note de commande",
        "default": false
      },
      {
        "type": "product",
        "id": "cart_empty_product",
        "label": "Produit suggéré quand le panier est vide"
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "paragraph",
        "content": "N'ajoutez que des comptes réellement actifs. Les icônes vides ne s'affichent pas."
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "placeholder": "https://instagram.com/"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "placeholder": "https://tiktok.com/@"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "placeholder": "https://facebook.com/"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest",
        "placeholder": "https://pinterest.com/"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube",
        "placeholder": "https://youtube.com/"
      }
    ]
  }
]
