{% doc %}
  Optional add-ons under a filled cart: real products of the chosen
  collection that are not in the cart yet, with their real photo, price and
  tagline. Products with several variants ask for the variant first; nothing
  is ever added without a click. Renders nothing when there is no suitable
  product (no invented suggestion).

  @param {string} context - Unique prefix for ids ('drawer' or 'page')

  @example
  {% render 'cart-upsell', context: 'drawer' %}
{% enddoc %}
{%- liquid
  assign upsell_collection = settings.cart_upsell_collection
  assign upsell_limit = settings.cart_upsell_limit | default: 2
  assign in_cart = cart.items | map: 'product_id'
  assign shown = 0
-%}
{%- if upsell_collection != blank and cart.item_count > 0 -%}
  {%- capture upsell_items -%}
    {%- for product in upsell_collection.products -%}
      {%- if shown >= upsell_limit -%}{%- break -%}{%- endif -%}
      {%- if in_cart contains product.id or product.available == false -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- liquid
        assign form_id = 'CartUpsell-' | append: context | append: '-' | append: product.id
        assign tagline = product.metafields.custom.accroche.value
        if tagline == blank
          assign tagline = product.description | strip_html | truncatewords: 14, '…'
        endif
      -%}
      <li class="cart-upsell__item">
        <a class="cart-upsell__media media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
          {%- if product.featured_media -%}
            {% render 'responsive-image', image: product.featured_media.preview_image, sizes: '80px', widths: '80, 160, 240', decorative: true %}
          {%- else -%}
            <span class="cart-upsell__placeholder">{% render 'icon', icon: 'image' %}</span>
          {%- endif -%}
        </a>
        <form class="cart-upsell__form" id="{{ form_id }}" action="{{ routes.cart_add_url }}" method="post" data-upsell-form novalidate>
          <p class="cart-upsell__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></p>
          <p class="cart-upsell__price">
            {%- if product.price_varies -%}
              {%- assign price_min_text = product.price_min | money -%}
              {{ 'products.price_from' | t: price: price_min_text }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </p>
          {%- if tagline != blank -%}
            <p class="cart-upsell__text">{{ tagline | escape }}</p>
          {%- endif -%}
          <div class="cart-upsell__actions">
            {%- if product.has_only_default_variant or product.variants.size == 1 -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {%- else -%}
              <label class="visually-hidden" for="{{ form_id }}-variant">{{ 'cart.upsell_choose_label' | t: product: product.title }}</label>
              <span class="cart-upsell__select">
                <select id="{{ form_id }}-variant" name="id" required aria-describedby="{{ form_id }}-error">
                  <option value="">{{ 'cart.upsell_choose' | t }}</option>
                  {%- if product.options.size == 2 -%}
                    {%- for value in product.options_with_values.first.values -%}
                      <optgroup label="{{ value.name | escape }}">
                        {%- for variant in product.variants -%}
                          {%- if variant.option1 == value.name -%}
                            <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                              {{- variant.option2 | escape }}{% if product.price_varies %} · {{ variant.price | money }}{% endif -%}
                            </option>
                          {%- endif -%}
                        {%- endfor -%}
                      </optgroup>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for variant in product.variants -%}
                      <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                        {{- variant.title | escape }}{% if product.price_varies %} · {{ variant.price | money }}{% endif -%}
                      </option>
                    {%- endfor -%}
                  {%- endif -%}
                </select>
                {% render 'icon', icon: 'chevron-down' %}
              </span>
            {%- endif -%}
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="button button--secondary cart-upsell__add">
              {%- render 'icon', icon: 'plus' -%}
              {{ 'cart.upsell_add' | t }}
              <span class="visually-hidden"> – {{ product.title | escape }}</span>
            </button>
          </div>
          <p class="cart-upsell__error" id="{{ form_id }}-error" role="alert" data-upsell-error hidden></p>
        </form>
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if shown > 0 -%}
    <cart-upsell class="cart-upsell" role="region" aria-labelledby="CartUpsellTitle-{{ context }}">
      <p class="cart-upsell__heading" id="CartUpsellTitle-{{ context }}">{{ settings.cart_upsell_heading | escape }}</p>
      <ul class="cart-upsell__list" role="list">{{ upsell_items }}</ul>
    </cart-upsell>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .cart-upsell {
    display: grid;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
  }

  .cart-upsell__heading {
    font-size: var(--text-xs);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cart-upsell__list {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-upsell__item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .cart-upsell__media {
    --media-ratio: 1;

    align-self: start;
    border-radius: var(--radius-sm);
  }

  .cart-upsell__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    background-color: var(--color-background);
  }

  .cart-upsell__form {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .cart-upsell__title {
    font-family: var(--font-heading-family);
    font-size: 1.0625rem;
    line-height: 1.25;

    & a {
      color: inherit;
      text-decoration: none;
    }
  }

  .cart-upsell__price {
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
  }

  .cart-upsell__text {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--color-text-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .cart-upsell__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
  }

  .cart-upsell__select {
    position: relative;
    flex: 1 1 8rem;
    min-width: 0;

    & select {
      width: 100%;
      min-height: 2.75rem;
      padding: 0 2rem 0 0.75rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      font: inherit;
      font-size: var(--text-sm);
      color: var(--color-text);
      background-color: var(--color-background);
      appearance: none;
    }

    & .icon {
      --icon-size: 0.9rem;

      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: 0.75rem;
      translate: 0 -50%;
      pointer-events: none;
    }
  }

  .cart-upsell__add {
    flex: none;
    min-height: 2.75rem;
    padding-inline: 1rem;
    font-size: var(--text-sm);

    & .icon {
      --icon-size: 0.9rem;
    }
  }

  .cart-upsell__error {
    font-size: var(--text-xs);
    color: var(--color-error, #a1332f);
  }
{% endstylesheet %}
