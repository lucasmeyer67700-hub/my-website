{% doc %}
  Product card for grids (collection, search, empty cart). One tab stop:
  the title link, stretched over the whole card. A second photo fades in on
  hover (pointer devices only) and colour options show as small dots.

  @param {object} product - Product object
  @param {string} [heading_tag] - Heading element for the title (default h3)
  @param {string} [sizes] - sizes attribute for the image

  @example
  {% render 'product-card', product: product %}
{% enddoc %}
{%- liquid
  assign tag = heading_tag | default: 'h3'
  assign image_sizes = sizes | default: '(min-width: 990px) 30vw, (min-width: 600px) 45vw, 90vw'
  assign second_media = ''
  if product.media.size > 1
    assign second_media = product.media[1]
  endif
  assign color_option = ''
  for option in product.options_with_values
    assign option_handle = option.name | handleize
    if option_handle == 'couleur' or option_handle == 'coloris' or option_handle == 'color' or option_handle == 'colour'
      assign color_option = option
    endif
  endfor
-%}
<article class="product-card" aria-labelledby="CardTitle-{{ product.id }}">
  {%- liquid
    comment
      A photo wider than the 4:5 card is shown whole rather than cropped.
    endcomment
    assign card_image = product.featured_media.preview_image
    assign card_contain = false
    if card_image and card_image.aspect_ratio > 0.95
      assign card_contain = true
    endif
  -%}
  <div
    class="product-card__media media{% if second_media != blank %} product-card__media--swap{% endif %}{% if card_contain %} product-card__media--contain{% endif %}"
    {% if card_contain %}
      style="--image-ratio: {{ card_image.aspect_ratio }};"
    {% endif %}
  >
    {%- if product.featured_media -%}
      {% render 'responsive-image', image: product.featured_media.preview_image, sizes: image_sizes, alt: product.featured_media.alt, class: 'product-card__image' %}
      {%- if second_media != blank -%}
        {% render 'responsive-image', image: second_media.preview_image, sizes: image_sizes, decorative: true, class: 'product-card__image product-card__image--second' %}
      {%- endif -%}
    {%- else -%}
      <span class="product-card__soon-art" aria-hidden="true">
        <span class="product-card__soon-ripple"></span>
        <span class="product-card__soon-drop"></span>
      </span>
    {%- endif -%}
  </div>
  <div class="product-card__body">
    <{{ tag }} class="product-card__title" id="CardTitle-{{ product.id }}">
      <a class="product-card__link" href="{{ product.url }}">{{ product.title | escape }}</a>
    </{{ tag }}>
    {%- if product.price_varies -%}
      {%- assign price_min_text = product.price_min | money -%}
      <p class="price product-card__price">
        <span class="price__current">{{ 'products.price_from' | t: price: price_min_text }}</span>
      </p>
    {%- else -%}
      {% render 'price', product: product, class: 'product-card__price' %}
    {%- endif -%}
    {%- liquid
      comment
        Count real colours only ("Rose + Blanc" is a combination, not a colour).
      endcomment
      assign single_colors = 0
      if color_option != blank
        for value in color_option.values
          unless value.name contains '+'
            assign single_colors = single_colors | plus: 1
          endunless
        endfor
      endif
    -%}
    {%- if single_colors > 1 -%}
      <p class="product-card__colors">
        <span class="product-card__dots" aria-hidden="true">
          {%- for value in color_option.values limit: 5 -%}
            {%- if value.name contains '+' -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign swatch_color = value.swatch.color
              if swatch_color == blank
                assign value_handle = value.name | handleize
                case value_handle
                  when 'rose'
                    assign swatch_color = '#E5AEB9'
                  when 'blanc'
                    assign swatch_color = '#FFFFFF'
                  when 'noir'
                    assign swatch_color = '#2B2523'
                  when 'gris'
                    assign swatch_color = '#BDB6B3'
                  when 'beige'
                    assign swatch_color = '#E8DCCB'
                  when 'rouge'
                    assign swatch_color = '#9E2B33'
                endcase
              endif
            -%}
            <span class="product-card__dot" style="--swatch-color: {{ swatch_color | default: '#E8DCCB' }};"></span>
          {%- endfor -%}
        </span>
        <span>{{ 'products.colors_count' | t: count: single_colors }}</span>
      </p>
    {%- endif -%}
  </div>
</article>
