{% doc %}
  Empty cart, in the drawer and on the cart page: the VELEA drop floating
  slowly over two ripples, the sentence, a short line, the way back to the
  catalogue, a sign-in link for visitors who are not signed in, and a few
  real products of the chosen collection (photo, name, real price). No badge,
  no urgency, nothing invented. Still for visitors who reduce motion.

  @param {string} context - 'drawer' or 'page'

  @example
  {% render 'cart-empty', context: 'drawer' %}
{% enddoc %}
{%- liquid
  assign button_link = settings.cart_empty_link | default: routes.all_products_collection_url
  assign essentials = settings.cart_empty_collection
  assign essentials_limit = settings.cart_empty_limit | default: 3
  assign shown = 0
-%}
<div class="cart-empty cart-empty--{{ context }}">
  {%- if settings.cart_empty_animation -%}
    <div class="cart-empty__art" aria-hidden="true">
      <span class="cart-empty__ripple"></span>
      <span class="cart-empty__ripple cart-empty__ripple--late"></span>
      <span class="cart-empty__shadow"></span>
      <span class="cart-empty__drop"></span>
    </div>
  {%- endif -%}

  <div class="cart-empty__copy">
    <p class="cart-empty__title">{{ 'cart.empty' | t }}</p>
    {%- if settings.cart_empty_text != blank -%}
      <p class="cart-empty__text">{{ settings.cart_empty_text | escape }}</p>
    {%- endif -%}
  </div>

  {%- if settings.cart_empty_button != blank -%}
    <a class="button cart-empty__button" href="{{ button_link }}">
      {{- settings.cart_empty_button | escape -}}
      {% render 'icon', icon: 'arrow-right' %}
    </a>
  {%- endif -%}

  {%- if settings.cart_empty_login and shop.customer_accounts_enabled and customer == nil -%}
    <p class="cart-empty__login">{{ 'cart.empty_login_html' | t: url: routes.account_login_url }}</p>
  {%- endif -%}

  {%- if essentials != blank -%}
    {%- capture essentials_items -%}
      {%- for product in essentials.products -%}
        {%- if shown >= essentials_limit -%}{%- break -%}{%- endif -%}
        {%- unless product.available -%}{%- continue -%}{%- endunless -%}
        {%- assign shown = shown | plus: 1 -%}
        <li>
          <a class="cart-empty__item" href="{{ product.url }}">
            <span class="cart-empty__media media">
              {%- if product.featured_media -%}
                {%- assign media_alt = product.featured_media.alt | default: product.title -%}
                {% render 'responsive-image', image: product.featured_media.preview_image, sizes: '(min-width: 750px) 160px, 30vw', widths: '120, 180, 240, 360', alt: media_alt %}
              {%- else -%}
                <span class="product-card__soon-art" aria-hidden="true">
                  <span class="product-card__soon-ripple"></span>
                  <span class="product-card__soon-drop"></span>
                </span>
              {%- endif -%}
            </span>
            <span class="cart-empty__name">{{ product.title | escape }}</span>
            <span class="cart-empty__price">
              {%- if product.price_varies -%}
                {%- assign price_min_text = product.price_min | money -%}
                {{ 'products.price_from' | t: price: price_min_text }}
              {%- else -%}
                {{ product.price | money }}
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if shown > 0 -%}
      <nav class="cart-empty__essentials" aria-labelledby="CartEmptyEssentials-{{ context }}">
        <p class="cart-empty__heading" id="CartEmptyEssentials-{{ context }}">{{ settings.cart_empty_heading | escape }}</p>
        <ul class="cart-empty__list" role="list">{{ essentials_items }}</ul>
      </nav>
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-empty {
    --cart-empty-delay: 0s;

    display: grid;
    justify-items: center;
    gap: var(--space-md);
    padding-block: var(--space-lg) var(--space-md);
    text-align: center;
  }

  .cart-empty--page {
    max-width: 34rem;
    margin-inline: auto;
    padding-block: var(--space-md) var(--space-xl);
  }

  /* The drop floats above two ripples that widen and fade, like a drop on water */
  .cart-empty__art {
    position: relative;
    width: 8.5rem;
    height: 7.5rem;
  }

  .cart-empty__drop {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: 50%;
    width: 3.6rem;
    aspect-ratio: 1;
    margin-inline-start: -1.8rem;
    border-radius: 50% 0 50% 50%;
    background:
      radial-gradient(circle at 44% 30%, rgb(255 255 255 / 0.95) 0 6%, transparent 18%),
      linear-gradient(225deg, #f9e3e7 0%, #ecbcc5 55%, #dc97a4 100%);
    box-shadow:
      inset 0 0 0 1px rgb(var(--warm-rgb) / 0.45),
      0 18px 30px -18px rgb(160 90 105 / 0.6);
    rotate: -45deg;
    animation: cart-empty-float 4.8s ease-in-out infinite;
  }

  .cart-empty__shadow {
    position: absolute;
    inset-block-end: 1.35rem;
    inset-inline-start: 50%;
    width: 2.6rem;
    height: 0.45rem;
    margin-inline-start: -1.3rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(160 90 105 / 0.28), transparent);
    animation: cart-empty-shadow 4.8s ease-in-out infinite;
  }

  .cart-empty__ripple {
    position: absolute;
    inset-block-end: 0.9rem;
    inset-inline-start: 50%;
    width: 7rem;
    height: 1.6rem;
    margin-inline-start: -3.5rem;
    border: 1px solid rgb(var(--rose-strong-rgb) / 0.55);
    border-radius: 50%;
    opacity: 0;
    animation: cart-empty-ripple 4.8s ease-out infinite;
  }

  .cart-empty__ripple--late {
    animation-delay: 2.4s;
  }

  @keyframes cart-empty-float {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -0.55rem;
    }
  }

  @keyframes cart-empty-shadow {
    0%,
    100% {
      opacity: 1;
      scale: 1;
    }

    50% {
      opacity: 0.55;
      scale: 0.8;
    }
  }

  @keyframes cart-empty-ripple {
    0% {
      opacity: 0;
      scale: 0.35;
    }

    20% {
      opacity: 0.9;
    }

    100% {
      opacity: 0;
      scale: 1.15;
    }
  }

  .cart-empty__copy {
    display: grid;
    gap: var(--space-2xs);
  }

  .cart-empty__title {
    font-family: var(--font-heading-family);
    font-size: calc(1.625rem * var(--font-heading-scale, 1));
    line-height: 1.2;
    color: var(--color-text);
    text-wrap: balance;

    .cart-empty--page & {
      font-size: calc(clamp(1.75rem, 1.5rem + 1vw, 2.25rem) * var(--font-heading-scale, 1));
    }
  }

  .cart-empty__text {
    max-width: 26rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .cart-empty__button {
    gap: var(--space-xs);
    width: 100%;
    max-width: 22rem;

    & .icon {
      --icon-size: 1rem;
      transition: transform var(--duration-base) var(--ease-out);
    }

    &:hover .icon {
      transform: translateX(0.2rem);
    }
  }

  .cart-empty__login {
    font-size: var(--text-sm);
    color: var(--color-text-muted);

    & a {
      color: var(--color-text);
      text-underline-offset: 0.2em;
    }
  }

  .cart-empty__essentials {
    display: grid;
    gap: var(--space-sm);
    width: 100%;
    margin-block-start: var(--space-sm);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
  }

  .cart-empty__heading {
    font-size: var(--text-xs);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cart-empty__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-empty__item {
    display: grid;
    gap: 0.35rem;
    color: var(--color-text);
    text-align: start;
    text-decoration: none;

    &:hover .cart-empty__name {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .cart-empty__media {
    --media-ratio: 4 / 5;

    border-radius: var(--radius-md);

    & img {
      transition: transform 0.9s var(--ease-out);
    }
  }

  .cart-empty__item:hover .cart-empty__media img {
    transform: scale(1.04);
  }

  .cart-empty__name {
    display: -webkit-box;
    overflow: hidden;
    font-family: var(--font-heading-family);
    font-size: 0.9375rem;
    line-height: 1.25;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .cart-empty__price {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Gentle entrance each time the empty cart appears */
  .cart-empty > * {
    animation: cart-empty-in 0.7s var(--ease-out) both;
  }

  .cart-empty > :nth-child(2) {
    animation-delay: 0.08s;
  }

  .cart-empty > :nth-child(3) {
    animation-delay: 0.16s;
  }

  .cart-empty > :nth-child(4) {
    animation-delay: 0.24s;
  }

  .cart-empty > :nth-child(n + 5) {
    animation-delay: 0.32s;
  }

  @keyframes cart-empty-in {
    from {
      opacity: 0;
      translate: 0 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-empty > *,
    .cart-empty__drop,
    .cart-empty__shadow,
    .cart-empty__ripple {
      animation: none;
    }

    .cart-empty__ripple {
      opacity: 0.6;
    }

    .cart-empty__ripple--late {
      display: none;
    }
  }
{% endstylesheet %}
