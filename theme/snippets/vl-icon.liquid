{%- comment -%}
  Icônes VELEA (trait, 24 px). Usage : {% render 'vl-icon', icon: 'heat' %}
{%- endcomment -%}
<svg class="vl-icon vl-icon--{{ icon }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'heat' -%}
      <path d="M8 20c-1.6-2 1.6-4 0-6s1.6-4 0-6"/><path d="M12 20c-1.6-2 1.6-4 0-6s1.6-4 0-6"/><path d="M16 20c-1.6-2 1.6-4 0-6s1.6-4 0-6"/>
    {%- when 'massage' -%}
      <path d="M3 12c1.5 0 1.5-3 3-3s1.5 6 3 6 1.5-6 3-6 1.5 6 3 6 1.5-6 3-6 1.5 3 3 3"/>
    {%- when 'battery' -%}
      <rect x="2.5" y="7" width="17" height="10" rx="2.5"/><path d="M21.5 10.5v3"/><path d="M6 10v4M9.5 10v4M13 10v4"/>
    {%- when 'cable' -%}
      <path d="M9 3v4M15 3v4"/><path d="M7 7h10v4a5 5 0 0 1-10 0z"/><path d="M12 16v5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'repeat' -%}
      <path d="M17 2l3 3-3 3"/><path d="M4 11V9a4 4 0 0 1 4-4h12"/><path d="M7 22l-3-3 3-3"/><path d="M20 13v2a4 4 0 0 1-4 4H4"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'return' -%}
      <path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
    {%- when 'lock' -%}
      <rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7.5 2.8C19.5 15.4 12 20 12 20z"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19l7-7"/>
    {%- when 'feather' -%}
      <path d="M20 4c-7 0-13 5-13 12v4"/><path d="M20 4c0 7-4 12-11 12"/><path d="M7 20h5"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8M8 13h5"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8-4.3-4.1 5.9-.9z"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="9" width="17" height="11.5" rx="1.5"/><path d="M2.5 9h19M12 9v11.5"/><path d="M12 9c-2-4-6-4-6-1.5S10 9 12 9c2 0 6 0 6-1.5S14 5 12 9z"/>
    {%- when 'body' -%}
      <circle cx="12" cy="4.5" r="2"/><path d="M8 21l1.2-6.5L7.5 9.5c2.8-1 6.2-1 9 0l-1.7 5L16 21"/><path d="M8.5 13h7"/>
    {%- when 'cross' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="M12 8l1.4 2.6L16 12l-2.6 1.4L12 16l-1.4-2.6L8 12l2.6-1.4z"/>
    {%- when 'calendar' -%}
      <rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
    {%- when 'thermo' -%}
      <path d="M10 14.5V5a2 2 0 0 1 4 0v9.5a4 4 0 1 1-4 0z"/><path d="M12 9v7"/>
    {%- when 'power' -%}
      <path d="M12 3v8"/><path d="M6.5 7a7.5 7.5 0 1 0 11 0"/>
    {%- else -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
  {%- endcase -%}
</svg>
