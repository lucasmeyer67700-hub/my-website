{% doc %}
  What the VELEA assistant knows, as JSON read by assets/assistant-brain.js:
  the products of the chosen collection (prices, options, stock, and the
  details shown on their pages: highlights, specifications, contents, how to
  use, care, size guide, precautions), the theme's shipping, returns and
  warranty settings, the assistant's own answers, the payment methods and the
  useful pages. Nothing here is written by hand: when a product or a setting
  changes, the assistant follows.

  @param {object} settings_source - The assistant section's settings
  @param {string} contact_url - Contact page

  @example
  {% render 'assistant-knowledge', settings_source: section.settings, contact_url: '/pages/contact' %}
{% enddoc %}
{%- liquid
  assign source = settings_source
  assign catalogue = source.catalogue
  if catalogue == blank
    assign catalogue = collections.all
  endif
  assign current_handle = ''
  if request.page_type == 'product' and product
    assign current_handle = product.handle
  endif
  comment
    Product details shown on the product pages, as "key in the answer:metafield".
  endcomment
  assign detail_fields = 'tagline:accroche,highlights:points_forts,specs:caracteristiques,box:contenu_colis,howto:mode_emploi,care:entretien,sizes:guide_tailles,precautions:precautions' | split: ','
-%}
{
  "shop": {{ shop.name | json }},
  "assistantName": {{ source.title | json }},
  "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
  "page": { "type": {{ request.page_type | json }}, "product": {{ current_handle | json }} },
  "facts": {
    "shipping": {{ settings.shipping_info | default: '' | json }},
    "shippingDelay": {{ settings.shipping_delay | default: '' | json }},
    "returns": {{ settings.returns_info | default: '' | json }},
    "warranty": {{ settings.warranty_info | default: '' | json }},
    "health": {{ settings.health_notice | default: '' | json }},
    "tagline": {{ settings.brand_tagline | default: '' | json }}
  },
  "answers": {
    "shipping": {{ source.answer_shipping | default: '' | json }},
    "tracking": {{ source.answer_tracking | default: '' | json }},
    "returns": {{ source.answer_returns | default: '' | json }},
    "guarantee": {{ source.answer_guarantee | default: '' | json }},
    "damaged": {{ source.answer_damaged | default: '' | json }},
    "origin": {{ source.answer_origin | default: '' | json }}
  },
  "urls": {
    "contact": {{ contact_url | default: '' | json }},
    "shipping": {{ settings.shipping_page.url | default: '' | json }},
    "returns": {{ settings.returns_page.url | default: '' | json }},
    "tracking": {{ source.tracking_page.url | default: '' | json }},
    "faq": {{ source.faq_page.url | default: '' | json }},
    "story": {{ source.story_page.url | default: '' | json }},
    "guide": {{ source.guide_page.url | default: '' | json }},
    "privacy": {{ source.privacy_page.url | default: shop.privacy_policy.url | default: '' | json }},
    "account": {{ routes.account_url | json }},
    "cart": {{ routes.cart_url | json }},
    "catalogue": {{ catalogue.url | default: routes.all_products_collection_url | json }}
  },
  "accounts": {{ shop.customer_accounts_enabled | json }},
  "payments": {{ shop.enabled_payment_types | json }},
  "products": [
    {%- for item in catalogue.products limit: 12 -%}
      {%- liquid
        assign custom = item.metafields.custom
        assign image = item.featured_media.preview_image
        assign has_reviews = false
        if custom.avis_selection.value != blank or custom.avis.value != blank or custom.avis_externes.value != blank
          assign has_reviews = true
        endif
      -%}
      {
        "handle": {{ item.handle | json }},
        "title": {{ item.title | json }},
        "type": {{ item.type | json }},
        "url": {{ item.url | json }},
        "image": {% if image %}{{ image | image_url: width: 240 | json }}{% else %}null{% endif %},
        "available": {{ item.available | json }},
        "price": {{ item.price_min | money | strip_html | json }},
        "priceMax": {{ item.price_max | money | strip_html | json }},
        "varies": {{ item.price_varies | json }},
        "reviews": {{ has_reviews | json }},
        "options": [
          {%- for option in item.options_with_values -%}
            { "name": {{ option.name | json }}, "values": [{%- for value in option.values -%}{{ value.name | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}] }
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "variants": [
          {%- for variant in item.variants limit: 50 -%}
            { "id": {{ variant.id }}, "options": [{{ variant.option1 | default: '' | json }}, {{ variant.option2 | default: '' | json }}, {{ variant.option3 | default: '' | json }}], "price": {{ variant.price | money | strip_html | json }}, "cents": {{ variant.price }}, "available": {{ variant.available | json }} }
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        {%- for field in detail_fields -%}
          {%- assign pair = field | split: ':' -%}
          {%- assign detail = custom[pair[1]].value -%}
          "{{ pair[0] }}": {% if detail != blank %}{{ detail | json }}{% else %}null{% endif %},
        {%- endfor %}
        "description": {{ item.description | replace: '</p>', ' </p>' | replace: '<br>', ' ' | strip_html | strip_newlines | truncate: 700 | json }}
      }
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
