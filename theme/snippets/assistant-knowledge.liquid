{% doc %}
  What the VELEA assistant knows, as JSON read by its script: the products of
  the chosen collection (prices, options, and the details shown on their
  pages: highlights, specifications, contents, how to use, care, size guide,
  precautions), the shop's shipping, returns and warranty settings, its
  payment methods and useful pages. Nothing is written here by hand: when a
  product or a setting changes, the assistant follows.

  @param {object} catalogue - Collection whose products the assistant knows
  @param {string} contact_url - Contact page
  @param {object} [tracking_page] - Order tracking page
  @param {object} [faq_page] - Questions page
  @param {object} [story_page] - Brand story page

  @example
  {% render 'assistant-knowledge', catalogue: section.settings.catalogue, contact_url: '/pages/contact' %}
{% enddoc %}
{%- liquid
  assign current_handle = null
  if request.page_type == 'product' and product
    assign current_handle = product.handle
  endif
-%}
{
  "shop": {{ shop.name | json }},
  "page": { "type": {{ request.page_type | json }}, "product": {{ current_handle | json }} },
  "facts": {
    "shipping": {{ settings.shipping_info | json }},
    "shippingDelay": {{ settings.shipping_delay | json }},
    "returns": {{ settings.returns_info | json }},
    "warranty": {{ settings.warranty_info | json }},
    "health": {{ settings.health_notice | json }},
    "tagline": {{ settings.brand_tagline | json }}
  },
  "urls": {
    "contact": {{ contact_url | json }},
    "shipping": {{ settings.shipping_page.url | json }},
    "returns": {{ settings.returns_page.url | json }},
    "tracking": {{ tracking_page.url | json }},
    "faq": {{ faq_page.url | json }},
    "story": {{ story_page.url | json }},
    "privacy": {{ shop.privacy_policy.url | json }},
    "account": {{ routes.account_url | json }},
    "cart": {{ routes.cart_url | json }},
    "catalogue": {{ catalogue.url | default: routes.all_products_collection_url | json }}
  },
  "accounts": {{ shop.customer_accounts_enabled | json }},
  "payments": {{ shop.enabled_payment_types | json }},
  "products": [
    {%- if catalogue != blank -%}
      {%- for item in catalogue.products limit: 12 -%}
        {%- liquid
          assign custom = item.metafields.custom
          assign image = item.featured_media.preview_image
        -%}
        {
          "handle": {{ item.handle | json }},
          "title": {{ item.title | json }},
          "type": {{ item.type | json }},
          "url": {{ item.url | json }},
          "image": {% if image %}{{ image | image_url: width: 160 | json }}{% else %}null{% endif %},
          "available": {{ item.available | json }},
          "price": {{ item.price_min | money | json }},
          "priceMax": {{ item.price_max | money | json }},
          "varies": {{ item.price_varies | json }},
          "options": [
            {%- for option in item.options_with_values -%}
              { "name": {{ option.name | json }}, "values": [{%- for value in option.values -%}{{ value.name | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}] }
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "variants": [
            {%- for variant in item.variants limit: 50 -%}
              { "options": [{{ variant.option1 | json }}, {{ variant.option2 | json }}, {{ variant.option3 | json }}], "price": {{ variant.price | money | json }}, "available": {{ variant.available | json }} }
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "tagline": {{ custom.accroche.value | json }},
          "highlights": {{ custom.points_forts.value | json }},
          "specs": {{ custom.caracteristiques.value | json }},
          "box": {{ custom.contenu_colis.value | json }},
          "howto": {{ custom.mode_emploi.value | json }},
          "care": {{ custom.entretien.value | json }},
          "sizes": {{ custom.guide_tailles.value | json }},
          "precautions": {{ custom.precautions.value | json }},
          "description": {{ item.description | strip_html | strip_newlines | truncate: 600 | json }}
        }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  ]
}
