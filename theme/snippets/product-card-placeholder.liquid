{% doc %}
  "Coming soon" card that keeps a catalogue slot until a real product
  replaces it. Purely informative: no price, no link to a product page.

  @param {string} title - Card title (e.g. "Bientôt disponible")
  @param {string} [text] - Short line under the title
  @param {image} [image] - Optional teaser image
  @param {string} [attributes] - Theme editor attributes of the block

  @example
  {% render 'product-card-placeholder', title: block.settings.title, text: block.settings.text %}
{% enddoc %}
<article class="product-card product-card--soon" {{ attributes }}>
  <div class="product-card__media media product-card__soon-media">
    {%- if image != blank -%}
      {% render 'responsive-image', image: image, sizes: '(min-width: 990px) 30vw, (min-width: 600px) 45vw, 90vw', decorative: true, class: 'product-card__image' %}
    {%- else -%}
      <span class="product-card__soon-art" aria-hidden="true">
        <span class="product-card__soon-ripple"></span>
        <span class="product-card__soon-drop"></span>
      </span>
    {%- endif -%}
    <span class="product-card__badge">{{ 'collections.coming_soon' | t }}</span>
  </div>
  <div class="product-card__body">
    <h2 class="product-card__title">{{ title | escape }}</h2>
    {%- if text != blank -%}
      <p class="product-card__soon-text">{{ text | escape }}</p>
    {%- endif -%}
    <button type="button" class="link link--arrow product-card__notify" data-welcome-open hidden>
      {{- 'collections.notify' | t -}}
      {% render 'icon', icon: 'arrow-right' %}
    </button>
  </div>
</article>
