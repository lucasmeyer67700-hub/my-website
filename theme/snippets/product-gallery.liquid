{% doc %}
  Product media gallery: a large photo in a light frame with previous/next
  buttons on its sides, a strip of thumbnails below and a zoom dialog.
  Optional overlays come from the product section's "gallery_card" and
  "gallery_badge" blocks. Works as a simple scrollable list without
  JavaScript. Without photos, empty photo slots are shown.

  A photo belongs to a colour when its alt text or its file name holds that
  colour (for example "Culotte menstruelle beige" or culotte-beige.jpg):
  choosing the colour in the variant picker then shows it, and it opens the
  page when that colour is the one selected. A photo attached to a variant
  in Shopify takes precedence.

  @param {object} product - Product object
  @param {string} [fit] - 'contain' or 'cover'
  @param {string} [ratio] - CSS aspect-ratio for slides
  @param {object} [overlays] - The section's blocks (gallery_card and gallery_badge are used)
  @param {boolean} [slots] - Keep 5 places (main photo + 4) and show the free ones as photo slots
  @param {string} [media_color] - Colour shown by the product's own photos (e.g. "Rose")

  Photos of a colour can also come from "color_photo" blocks (colour + photo)
  in overlays. When the chosen colour has photos, only its photos show; a
  colour without photos (e.g. "Rose + Blanc") shows them all.

  @example
  {% render 'product-gallery', product: product, overlays: section.blocks %}
{% enddoc %}
{%- liquid
  assign media_count = product.media.size
  for block in overlays
    if block.type == 'color_photo' and block.settings.image != blank and block.settings.color != blank
      assign media_count = media_count | plus: 1
    endif
  endfor
  assign initial_media = product.selected_or_first_available_variant.featured_media

  comment
    The product's colours as handles, longest first so that rose-blanc wins
    over rose. A variant chosen in the page address, without its own photo,
    opens on the photo of its colour.
  endcomment
  assign color_handles = ''
  assign current_color = ''
  for option in product.options_with_values
    assign option_handle = option.name | handleize
    if option_handle == 'couleur' or option_handle == 'coloris' or option_handle == 'color' or option_handle == 'colour'
      for value in option.values
        assign value_handle = value.name | handleize
        assign color_handles = color_handles | append: value_handle | append: ','
      endfor
      if product.selected_variant
        assign current_color = product.selected_variant.options[forloop.index0] | handleize
      endif
    endif
  endfor
  assign color_list = color_handles | split: ','
  assign color_list_sorted = ''
  for size in (1..40) reversed
    for color in color_list
      if color.size == size
        assign color_list_sorted = color_list_sorted | append: color | append: ','
      endif
    endfor
  endfor
  assign color_list = color_list_sorted | split: ','

  comment
    Colour photos chosen in the section, and the colour of the product's own
    photos. The gallery opens on the colour of the selected variant.
  endcomment
  assign default_media_color = media_color | handleize
  assign color_photo_count = 0
  for block in overlays
    if block.type == 'color_photo' and block.settings.image != blank and block.settings.color != blank
      assign color_photo_count = color_photo_count | plus: 1
    endif
  endfor
  assign selected_color = ''
  for option in product.options_with_values
    assign option_handle = option.name | handleize
    if option_handle == 'couleur' or option_handle == 'coloris' or option_handle == 'color' or option_handle == 'colour'
      assign selected_color = product.selected_or_first_available_variant.options[forloop.index0] | handleize
    endif
  endfor
  assign selected_has_photos = false
  if selected_color != blank
    if default_media_color == selected_color
      assign selected_has_photos = true
    endif
    for block in overlays
      if block.type == 'color_photo' and block.settings.image != blank
        assign block_color = block.settings.color | handleize
        if block_color == selected_color
          assign selected_has_photos = true
        endif
      endif
    endfor
  endif
  if initial_media == blank and current_color != blank
    for media in product.media
      capture media_color
        render 'media-color', media: media, colors: color_list
      endcapture
      if media_color == current_color
        assign initial_media = media
        break
      endif
    endfor
  endif

  assign slide_ratio = ratio | default: '1'
  assign slide_fit = fit | default: 'contain'
  comment
    Main photo + 4: with fewer than 5 photos, the free places show as slots
    the merchant fills from the product's media.
  endcomment
  assign slot_total = 5
  assign free_slots = 0
  if slots and media_count > 0 and media_count < slot_total
    assign free_slots = slot_total | minus: media_count
  endif
-%}
<media-gallery
  class="gallery gallery--{{ slide_fit }}"
  style="--gallery-ratio: {{ slide_ratio }};"
  {% if initial_media %}
    data-initial-media="{{ initial_media.id }}"
  {% endif %}
>
  <div class="gallery__stage">
    {%- if media_count == 0 -%}
      {%- comment -%} Photo slot, ready for the merchant's own photos. {%- endcomment -%}
      <div class="gallery__slot gallery__slot--main">
        <span class="gallery__slot-art" aria-hidden="true">
          <span class="gallery__slot-ripple"></span>
          <span class="gallery__slot-drop"></span>
        </span>
        {%- if request.design_mode -%}
          <p class="gallery__slot-hint">{{ 'products.media_slot_hint' | t }}</p>
        {%- endif -%}
      </div>
    {%- else -%}
      <ul
        class="gallery__track"
        role="list"
        data-gallery-track
        tabindex="0"
        aria-label="{{ 'products.gallery_label' | t }}"
      >
        {%- for media in product.media -%}
          {%- liquid
            assign media_alt = media.alt | default: product.title
            assign media_color = ''
            if color_list.size > 0
              capture media_color
                render 'media-color', media: media, colors: color_list
              endcapture
            endif
            if media_color == blank
              assign media_color = default_media_color
            endif
          -%}
          <li
            class="gallery__slide"
            data-gallery-slide
            data-media-id="{{ media.id }}"
            {% if media_color != blank %}
              data-media-color="{{ media_color }}"
            {% endif %}
            {% if selected_has_photos and media_color != blank and media_color != selected_color %}
              hidden
            {% endif %}
            aria-label="{{ 'products.media_x_of_y' | t: index: forloop.index, count: media_count }}"
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <button
                  type="button"
                  class="gallery__zoom"
                  data-gallery-zoom
                  data-zoom-src="{{ media.preview_image | image_url: width: 2000 }}"
                  data-zoom-alt="{{ media_alt | escape }}"
                >
                  {%- if forloop.first -%}
                    {% render 'responsive-image', image: media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', eager: true, alt: media_alt %}
                  {%- else -%}
                    {% render 'responsive-image', image: media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', alt: media_alt %}
                  {%- endif -%}
                  <span class="visually-hidden">{{ 'products.zoom' | t }}</span>
                </button>
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, preload: 'none', image_size: '1200x', class: 'gallery__video' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: class: 'gallery__video', loading: 'lazy' }}
              {%- else -%}
                {% render 'responsive-image', image: media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', alt: media_alt %}
            {%- endcase -%}
          </li>
        {%- endfor -%}
        {%- for block in overlays -%}
          {%- if block.type == 'color_photo' and block.settings.image != blank and block.settings.color != blank -%}
            {%- liquid
              assign block_color = block.settings.color | handleize
              assign block_alt = block.settings.image.alt | default: product.title | append: ' – ' | append: block.settings.color
            -%}
            <li
              class="gallery__slide"
              data-gallery-slide
              data-media-id="color-{{ block.id }}"
              data-media-color="{{ block_color }}"
              {% if selected_has_photos and block_color != selected_color %}
                hidden
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="gallery__zoom"
                data-gallery-zoom
                data-zoom-src="{{ block.settings.image | image_url: width: 2000 }}"
                data-zoom-alt="{{ block_alt | escape }}"
              >
                {% render 'responsive-image', image: block.settings.image, sizes: '(min-width: 990px) 55vw, 100vw', alt: block_alt %}
                <span class="visually-hidden">{{ 'products.zoom' | t }}</span>
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- liquid
      assign has_badges = false
      for block in overlays
        if block.type == 'gallery_badge'
          assign has_badges = true
        endif
      endfor
    -%}
    {%- for block in overlays -%}
      {%- if block.type == 'gallery_card' -%}
        {%- liquid
          assign card_link = block.settings.link
          if card_link == blank and settings.returns_page != blank
            assign card_link = settings.returns_page.url
          endif
        -%}
        <aside class="gallery-card" data-gallery-card {{ block.shopify_attributes }}>
          <span class="gallery-card__icon" aria-hidden="true">{% render 'icon', icon: block.settings.icon %}</span>
          <p class="gallery-card__title">{{ block.settings.title | escape }}</p>
          <div class="gallery-card__body">
            {%- if block.settings.text != blank -%}
              <p class="gallery-card__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if card_link != blank and block.settings.link_label != blank -%}
              <a class="gallery-card__link" href="{{ card_link }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
          {%- if block.settings.dismissible -%}
            <button type="button" class="gallery-card__close" data-gallery-card-close>
              {% render 'icon', icon: 'close' %}
              <span class="visually-hidden">{{ 'general.close' | t }}</span>
            </button>
          {%- endif -%}
        </aside>
      {%- endif -%}
    {%- endfor -%}

    {%- if has_badges -%}
      <ul class="gallery-badges" role="list">
        {%- for block in overlays -%}
          {%- if block.type == 'gallery_badge' -%}
            <li class="gallery-badge gallery-badge--{{ block.settings.style }}" {{ block.shopify_attributes }}>
              <span class="gallery-badge__circle">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 240 | image_tag: width: 120, height: 120, alt: '', loading: 'lazy', class: 'gallery-badge__image' }}
                {%- elsif block.settings.style == 'light' and block.settings.icon != 'none' -%}
                  {% render 'icon', icon: block.settings.icon %}
                {%- endif -%}
                {%- if block.settings.style == 'filled' -%}
                  {%- if block.settings.title != blank -%}
                    <span class="gallery-badge__title">{{ block.settings.title | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="gallery-badge__subtitle">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                {%- endif -%}
              </span>
              {%- if block.settings.style == 'light' -%}
                {%- if block.settings.title != blank -%}
                  <span class="gallery-badge__caption gallery-badge__caption--strong">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="gallery-badge__caption">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if media_count > 1 -%}
      <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev disabled>
        {% render 'icon', icon: 'chevron-left' %}
        <span class="visually-hidden">{{ 'products.previous_media' | t }}</span>
      </button>
      <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next>
        {% render 'icon', icon: 'chevron-right' %}
        <span class="visually-hidden">{{ 'products.next_media' | t }}</span>
      </button>
    {%- endif -%}
  </div>

  {%- unless request.design_mode -%}
    {%- assign free_slots = 0 -%}
  {%- endunless -%}
  {%- if media_count == 0 and request.design_mode -%}
    <ul class="gallery__thumbs gallery__thumbs--slots" role="list" aria-hidden="true">
      {%- for i in (1..4) -%}
        <li class="gallery__slot gallery__slot--thumb">{% render 'icon', icon: 'image' %}</li>
      {%- endfor -%}
    </ul>
  {%- elsif media_count > 1 or free_slots > 0 -%}
    <ul class="gallery__thumbs{% if media_count <= slot_total %} gallery__thumbs--grid{% endif %}" role="list">
      {%- for media in product.media -%}
        {%- liquid
          assign thumb_color = ''
          if color_list.size > 0
            capture thumb_color
              render 'media-color', media: media, colors: color_list
            endcapture
          endif
          if thumb_color == blank
            assign thumb_color = default_media_color
          endif
        -%}
        <li
          {% if selected_has_photos and thumb_color != blank and thumb_color != selected_color %}
            hidden
          {% endif %}
        >
          <button
            type="button"
            class="gallery__thumb"
            data-gallery-thumb
            {% if forloop.first %}
              aria-current="true"
            {% endif %}
          >
            {% render 'responsive-image', image: media.preview_image, sizes: '96px', widths: '96, 192, 288', decorative: true %}
            <span class="visually-hidden">{{ 'products.view_media' | t: index: forloop.index }}</span>
          </button>
        </li>
      {%- endfor -%}
      {%- for block in overlays -%}
        {%- if block.type == 'color_photo' and block.settings.image != blank and block.settings.color != blank -%}
          {%- assign block_color = block.settings.color | handleize -%}
          <li
            {% if selected_has_photos and block_color != selected_color %}
              hidden
            {% endif %}
          >
            <button type="button" class="gallery__thumb" data-gallery-thumb>
              {% render 'responsive-image', image: block.settings.image, sizes: '96px', widths: '96, 192, 288', alt: block.settings.color %}
              <span class="visually-hidden">{{ block.settings.color | escape }}</span>
            </button>
          </li>
        {%- endif -%}
      {%- endfor -%}
      {%- for i in (1..free_slots) -%}
        <li class="gallery__slot gallery__slot--thumb" aria-hidden="true">
          {%- render 'icon', icon: 'image' -%}
          {%- if request.design_mode -%}
            <span class="gallery__slot-label">{{ 'products.media_slot_short' | t }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if media_count > 0 -%}
    <dialog class="gallery__lightbox" data-gallery-lightbox aria-label="{{ 'products.gallery_label' | t }}">
      <button type="button" class="icon-button gallery__lightbox-close" data-lightbox-close>
        {% render 'icon', icon: 'close' %}
        <span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
      <img class="gallery__lightbox-image" data-lightbox-image src="data:," alt="" width="2000" height="2000" loading="lazy">
    </dialog>
  {%- endif -%}
</media-gallery>

{% stylesheet %}
  .gallery {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  /* The large photo, in a light frame, with the overlays and side arrows */
  .gallery__stage {
    position: relative;
  }

  .gallery__track {
    position: relative;
    display: grid;
    grid-auto-columns: 100%;
    grid-auto-flow: column;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-md);
    background-color: var(--gallery-bg);

    &::-webkit-scrollbar {
      display: none;
    }
  }

  /* Photos of another colour than the one chosen */
  .gallery__slide[hidden],
  .gallery__thumbs > li[hidden] {
    display: none;
  }

  .gallery__slide {
    position: relative;
    overflow: hidden;
    scroll-snap-align: start;
    aspect-ratio: var(--gallery-ratio, 1);
    background-color: var(--gallery-bg);

    & img,
    & video,
    & iframe {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .gallery--contain .gallery__slide img {
    object-fit: contain;
  }

  .gallery__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .gallery__arrow {
    position: absolute;
    inset-block-start: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    translate: 0 -50%;
    border: 0;
    border-radius: 50%;
    color: var(--color-text);
    background-color: #fff;
    box-shadow: 0 2px 10px rgb(48 39 36 / 0.16);
    cursor: pointer;
    transition: opacity var(--duration-fast) ease, box-shadow var(--duration-fast) ease;

    &:hover {
      box-shadow: 0 4px 16px rgb(48 39 36 / 0.24);
    }

    &[disabled] {
      opacity: 0.45;
      cursor: default;
    }

    & .icon {
      --icon-size: 1.1rem;
    }
  }

  .gallery__arrow--prev {
    inset-inline-start: var(--space-2xs);

    @media screen and (min-width: 990px) {
      inset-inline-start: -1.375rem;
    }
  }

  .gallery__arrow--next {
    inset-inline-end: var(--space-2xs);

    @media screen and (min-width: 990px) {
      inset-inline-end: -1.375rem;
    }
  }

  /* Thumbnails: one row below the photo, scrollable */
  .gallery__thumbs {
    position: relative;
    display: flex;
    gap: var(--space-xs);
    margin: 0;
    padding: 0 0 2px;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x proximity;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    & > li {
      flex: none;
      scroll-snap-align: start;
    }
  }

  /* Main photo + 4: five equal places across the width */
  .gallery__thumbs--grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    overflow: visible;

    & .gallery__thumb {
      width: 100%;
    }

    & .gallery__slot--thumb {
      width: auto;
      aspect-ratio: 1;
    }
  }

  .gallery__slot-label {
    position: absolute;
    inset-block-end: 0.35rem;
    inset-inline: 0.35rem;
    font-size: 0.625rem;
    line-height: 1.2;
    text-align: center;
  }

  .gallery__thumb {
    position: relative;
    display: block;
    width: clamp(3.75rem, 2.75rem + 3vw, 5.75rem);
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background-color: var(--gallery-bg);
    cursor: pointer;
    transition: border-color var(--duration-fast) ease;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &:hover {
      border-color: rgb(var(--color-text-rgb) / 0.25);
    }

    &[aria-current='true'] {
      border-color: var(--color-text);
    }
  }

  /* Overlay card, top left (e.g. the 30-day guarantee) */
  .gallery-card {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    max-width: min(34rem, 82%);
    padding: var(--space-sm) calc(var(--space-lg) + 0.75rem) var(--space-sm) var(--space-sm);
    border-start-start-radius: var(--radius-md);
    border-end-end-radius: var(--radius-md);
    background-color: #fff;
    clip-path: polygon(0 0, 100% 0, calc(100% - 1.5rem) 100%, 0 100%);

    &[hidden] {
      display: none;
    }

    @media screen and (max-width: 749px) {
      grid-template-columns: auto minmax(0, 1fr);
      max-width: 88%;
      padding: var(--space-xs) calc(var(--space-lg) + 0.5rem) var(--space-xs) var(--space-xs);
    }
  }

  .gallery-card__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--rose-strong);
    background-color: var(--rose-soft);

    & .icon {
      --icon-size: 1.1rem;
    }
  }

  .gallery-card__title {
    max-width: 11ch;
    font-family: var(--font-heading-family);
    font-size: var(--text-xl);
    line-height: 1.05;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-wrap: balance;

    @media screen and (max-width: 749px) {
      max-width: none;
      font-size: var(--text-lg);
    }
  }

  .gallery-card__body {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-sm);
    line-height: 1.4;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
      font-size: var(--text-xs);
    }
  }

  .gallery-card__link {
    width: fit-content;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gallery-card__close {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: var(--space-xs);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    color: var(--color-text-muted);
    background: none;
    cursor: pointer;

    &::before {
      content: '';
      position: absolute;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 50%;
      background-color: #f1eeed;
      transition: background-color var(--duration-fast) ease;
    }

    &:hover::before {
      background-color: #e8e2e0;
    }

    & .icon {
      position: relative;
      --icon-size: 0.7rem;
    }
  }

  /* Round badges, top right */
  .gallery-badges {
    position: absolute;
    inset-block-start: clamp(4.5rem, 3rem + 5vw, 7.5rem);
    inset-inline-end: var(--space-md);
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;

    @media screen and (max-width: 749px) {
      inset-block-start: auto;
      inset-block-end: var(--space-sm);
      inset-inline-end: var(--space-sm);
      gap: var(--space-xs);
    }
  }

  .gallery-badge {
    display: grid;
    justify-items: center;
    gap: var(--space-3xs);
    max-width: 9.5rem;
    text-align: center;
  }

  .gallery-badge__circle {
    display: grid;
    place-content: center;
    justify-items: center;
    width: clamp(4.25rem, 3rem + 4vw, 7rem);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    color: var(--rose-strong);
    background-color: #fff;
    box-shadow: 0 6px 20px -8px rgb(48 39 36 / 0.3);

    & .icon {
      --icon-size: clamp(1.5rem, 1rem + 1.4vw, 2.5rem);
    }
  }

  .gallery-badge__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-badge--filled .gallery-badge__circle {
    gap: 0.1rem;
    color: #fff;
    background-color: var(--rose-text);
  }

  .gallery-badge__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.15rem, 0.85rem + 1vw, 1.75rem);
    line-height: 1;
  }

  .gallery-badge__subtitle {
    max-width: 8ch;
    font-size: clamp(0.625rem, 0.55rem + 0.25vw, 0.75rem);
    line-height: 1.2;

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .gallery-badge__caption {
    font-size: var(--text-sm);
    line-height: 1.25;
    color: var(--color-text);

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .gallery-badge__caption--strong {
    font-weight: var(--font-body-weight-medium);
  }

  /* Empty photo slots */
  .gallery__slot {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, var(--gallery-bg) 0%, #f6e4e7 100%);
    color: rgb(var(--warm-rgb) / 0.8);
  }

  .gallery__slot--main {
    aspect-ratio: var(--gallery-ratio, 1);
  }

  .gallery__slot--thumb {
    width: clamp(3.75rem, 2.75rem + 3vw, 5.75rem);
    aspect-ratio: 1;
    border: 1px dashed rgb(var(--warm-rgb) / 0.55);
    border-radius: var(--radius-sm);
    --icon-size: 1.25rem;
  }

  .gallery__slot-art {
    position: absolute;
    inset: 0;
  }

  .gallery__slot-drop {
    position: absolute;
    top: 42%;
    left: 42%;
    width: 22%;
    aspect-ratio: 1;
    translate: -50% -50%;
    rotate: -45deg;
    border-radius: 50% 0 50% 50%;
    background:
      radial-gradient(circle at 44% 30%, rgb(255 255 255 / 0.95) 0 5%, transparent 16%),
      linear-gradient(225deg, #f9e3e7 0%, #ecbcc5 55%, #dc97a4 100%);
    box-shadow:
      inset 0 0 0 1px rgb(var(--warm-rgb) / 0.5),
      0 20px 34px -20px rgb(160 90 105 / 0.55);
  }

  .gallery__slot-ripple {
    position: absolute;
    top: 70%;
    left: 42%;
    width: 40%;
    aspect-ratio: 4 / 1;
    translate: -50% -50%;
    border: 1px solid rgb(var(--warm-rgb) / 0.55);
    border-radius: 50%;
  }

  .gallery__slot-hint {
    position: absolute;
    inset-inline: var(--space-sm);
    inset-block-end: var(--space-sm);
    z-index: 2;
    padding: var(--space-xs) var(--space-sm);
    border: 1px dashed rgb(var(--warm-rgb) / 0.8);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text);
    background-color: rgb(var(--palette-warm-white-rgb) / 0.9);
  }

  .gallery__lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: var(--space-xl) var(--gutter);
    border: 0;
    background-color: var(--palette-warm-white);

    &::backdrop {
      background-color: rgb(48 39 36 / 0.6);
    }
  }

  .gallery__lightbox-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery__lightbox-close {
    position: fixed;
    inset-block-start: var(--space-sm);
    inset-inline-end: var(--space-sm);
    background-color: var(--palette-warm-white);
    box-shadow: var(--shadow-sm);
  }
{% endstylesheet %}
