{% doc %}
  Product media gallery: swipeable slider (scroll-snap) with thumbnails,
  previous/next controls and a zoom dialog. Works as a simple scrollable
  list without JavaScript.

  @param {object} product - Product object
  @param {string} [fit] - 'contain' or 'cover'
  @param {string} [ratio] - CSS aspect-ratio for slides

  @example
  {% render 'product-gallery', product: product %}
{% enddoc %}
{%- liquid
  assign media_count = product.media.size
  assign initial_media = product.selected_or_first_available_variant.featured_media
  assign slide_ratio = ratio | default: '1'
  assign slide_fit = fit | default: 'contain'
-%}
<media-gallery
  class="gallery gallery--{{ slide_fit }}"
  style="--gallery-ratio: {{ slide_ratio }};"
  {% if initial_media %}
    data-initial-media="{{ initial_media.id }}"
  {% endif %}
>
  {%- if media_count == 0 -%}
    {%- comment -%} Photo slots, ready for the merchant's own photos. {%- endcomment -%}
    <div class="gallery__slot gallery__slot--main">
      <span class="gallery__slot-art" aria-hidden="true">
        <span class="gallery__slot-ripple"></span>
        <span class="gallery__slot-drop"></span>
      </span>
      {%- if request.design_mode -%}
        <p class="gallery__slot-hint">{{ 'products.media_slot_hint' | t }}</p>
      {%- endif -%}
    </div>
    <ul class="gallery__thumbs gallery__thumbs--slots" role="list" aria-hidden="true">
      {%- for i in (1..4) -%}
        <li class="gallery__slot gallery__slot--thumb">{% render 'icon', icon: 'image' %}</li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <ul
      class="gallery__track"
      role="list"
      data-gallery-track
      tabindex="0"
      aria-label="{{ 'products.gallery_label' | t }}"
    >
      {%- for media in product.media -%}
        <li
          class="gallery__slide"
          data-gallery-slide
          data-media-id="{{ media.id }}"
          aria-label="{{ 'products.media_x_of_y' | t: index: forloop.index, count: media_count }}"
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <button
                type="button"
                class="gallery__zoom"
                data-gallery-zoom
                data-zoom-src="{{ media.preview_image | image_url: width: 2000 }}"
                data-zoom-alt="{{ media.alt | escape }}"
              >
                {%- if forloop.first -%}
                  {% render 'responsive-image', image: media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', eager: true, alt: media.alt %}
                {%- else -%}
                  {% render 'responsive-image', image: media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt %}
                {%- endif -%}
                <span class="gallery__zoom-icon" aria-hidden="true">{% render 'icon', icon: 'zoom' %}</span>
                <span class="visually-hidden">{{ 'products.zoom' | t }}</span>
              </button>
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, preload: 'none', image_size: '1200x', class: 'gallery__video' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag: class: 'gallery__video', loading: 'lazy' }}
            {%- else -%}
              {% render 'responsive-image', image: media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt %}
          {%- endcase -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if media_count > 1 -%}
      <div class="gallery__controls">
        <button type="button" class="icon-button gallery__arrow" data-gallery-prev disabled>
          {% render 'icon', icon: 'chevron-left' %}
          <span class="visually-hidden">{{ 'products.previous_media' | t }}</span>
        </button>
        <span class="gallery__counter" data-gallery-counter aria-hidden="true">1 / {{ media_count }}</span>
        <button type="button" class="icon-button gallery__arrow" data-gallery-next>
          {% render 'icon', icon: 'chevron-right' %}
          <span class="visually-hidden">{{ 'products.next_media' | t }}</span>
        </button>
      </div>

      <ul class="gallery__thumbs" role="list">
        {%- for media in product.media -%}
          <li>
            <button
              type="button"
              class="gallery__thumb"
              data-gallery-thumb
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            >
              {% render 'responsive-image', image: media.preview_image, sizes: '72px', widths: '72, 144, 216', decorative: true %}
              <span class="visually-hidden">{{ 'products.view_media' | t: index: forloop.index }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <dialog class="gallery__lightbox" data-gallery-lightbox aria-label="{{ 'products.gallery_label' | t }}">
      <button type="button" class="icon-button gallery__lightbox-close" data-lightbox-close>
        {% render 'icon', icon: 'close' %}
        <span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
      <img class="gallery__lightbox-image" data-lightbox-image src="data:," alt="" width="2000" height="2000" loading="lazy">
    </dialog>
  {%- endif -%}
</media-gallery>

{% stylesheet %}
  .gallery {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .gallery__track {
    position: relative;
    display: grid;
    grid-auto-columns: 100%;
    grid-auto-flow: column;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-md);

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .gallery__slide {
    position: relative;
    overflow: hidden;
    scroll-snap-align: start;
    aspect-ratio: var(--gallery-ratio, 1);
    background-color: var(--color-surface);

    & img,
    & video,
    & iframe {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .gallery--contain .gallery__slide img {
    object-fit: contain;
  }

  .gallery__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .gallery__zoom-icon {
    position: absolute;
    inset-block-end: var(--space-sm);
    inset-inline-end: var(--space-sm);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--color-text);
    background-color: rgb(var(--color-background-rgb) / 0.85);
    box-shadow: var(--shadow-sm);
  }

  .gallery__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);

    & [disabled] {
      opacity: 0.35;
      cursor: default;
    }
  }

  .gallery__thumbs {
    display: none;

    @media screen and (min-width: 750px) {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2xs);
    }
  }

  /* Computers: thumbnails in a column on the left of the main photo */
  @media screen and (min-width: 990px) {
    .gallery:has(.gallery__thumbs) {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      align-items: start;
      column-gap: var(--space-md);

      & > .gallery__track,
      & > .gallery__controls,
      & > .gallery__slot--main {
        grid-column: 2;
      }

      & > .gallery__thumbs {
        grid-column: 1;
        grid-row: 1 / span 2;
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
        justify-content: flex-start;
        max-height: min(80vh, 46rem);
        overflow-y: auto;
        scrollbar-width: none;
      }
    }
  }

  .gallery__thumb {
    width: 4.5rem;
    height: auto;
    aspect-ratio: var(--gallery-ratio, 1);
    overflow: hidden;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    opacity: 0.65;
    transition:
      opacity var(--duration-fast) ease,
      border-color var(--duration-fast) ease;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &:hover,
    &[aria-current='true'] {
      opacity: 1;
    }

    &[aria-current='true'] {
      border-color: var(--color-text);
    }
  }

  /* Empty photo slots */
  .gallery__slot {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(var(--gold-rgb) / 0.22);
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, var(--palette-warm-white) 0%, #f6e4e7 100%);
    color: rgb(var(--gold-rgb) / 0.8);
  }

  .gallery__slot--main {
    aspect-ratio: var(--gallery-ratio, 1);
  }

  .gallery__slot--thumb {
    width: 4.5rem;
    aspect-ratio: var(--gallery-ratio, 1);
    border-radius: var(--radius-sm);
    --icon-size: 1.25rem;
  }

  .gallery__thumbs--slots {
    display: flex;
    gap: var(--space-2xs);
    justify-content: center;
  }

  .gallery__slot-art {
    position: absolute;
    inset: 0;
  }

  .gallery__slot-drop {
    position: absolute;
    top: 40%;
    left: 50%;
    width: 22%;
    aspect-ratio: 1;
    translate: -50% -50%;
    rotate: -45deg;
    border-radius: 50% 0 50% 50%;
    background:
      radial-gradient(circle at 44% 30%, rgb(255 255 255 / 0.95) 0 5%, transparent 16%),
      linear-gradient(225deg, #f9e3e7 0%, #ecbcc5 55%, #dc97a4 100%);
    box-shadow:
      inset 0 0 0 1px rgb(var(--gold-rgb) / 0.5),
      0 20px 34px -20px rgb(160 90 105 / 0.55);
  }

  .gallery__slot-ripple {
    position: absolute;
    top: 68%;
    left: 50%;
    width: 40%;
    aspect-ratio: 4 / 1;
    translate: -50% -50%;
    border: 1px solid rgb(var(--gold-rgb) / 0.55);
    border-radius: 50%;
  }

  .gallery__slot-hint {
    position: absolute;
    inset-inline: var(--space-sm);
    inset-block-end: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border: 1px dashed rgb(var(--gold-rgb) / 0.8);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text);
    background-color: rgb(var(--palette-warm-white-rgb) / 0.9);
  }

  .gallery__lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: var(--space-xl) var(--gutter);
    border: 0;
    background-color: var(--palette-warm-white);

    &::backdrop {
      background-color: rgb(48 39 36 / 0.6);
    }
  }

  .gallery__lightbox-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery__lightbox-close {
    position: fixed;
    inset-block-start: var(--space-sm);
    inset-inline-end: var(--space-sm);
    background-color: var(--palette-warm-white);
    box-shadow: var(--shadow-sm);
  }
{% endstylesheet %}
