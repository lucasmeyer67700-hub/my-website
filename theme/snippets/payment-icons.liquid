{% doc %}
  Lists the payment methods actually enabled on the store (from Shopify
  payment settings — nothing is hardcoded).

  @param {string} [class] - Extra CSS classes

  @example
  {% render 'payment-icons' %}
{% enddoc %}
{%- if shop.enabled_payment_types.size > 0 -%}
  <ul class="payment-icons{% if class %} {{ class }}{% endif %}" role="list" aria-label="{{ 'general.payment_methods' | t }}">
    {%- for type in shop.enabled_payment_types -%}
      <li class="payment-icons__item">{{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .payment-icons__icon {
    width: 2.375rem;
    height: 1.5rem;
  }
{% endstylesheet %}
