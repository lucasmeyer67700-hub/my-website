{% doc %}
  Variant selector as radio buttons. An "Offre" option (1 ceinture, Duo…)
  shows as large offer cards with the price per unit and the real saving
  compared with buying the items one by one; other options show as pills
  (with a colour dot for colour options). Values that do not exist for the
  selected offer are hidden. Real variant data only.

  @param {object} product - Product object
  @param {string} section_id - Section id, for unique element ids
  @param {string} [offer_heading] - Title above the offer cards
  @param {string} [offer_note_single] - Line under the single-item offer
  @param {string} [offer_note_multi] - Line under the multi-item offers
  @param {string} [multi_hint] - Help line under the colours for multi-item offers
  @param {string} [unit_label] - Unit after the per-item price (e.g. "la ceinture")
  @param {string} [best_label] - Tab on the multi-item offer with a real saving (e.g. "Le plus avantageux")
  @param {string} [perks_single] - Lines listed in the single-item offer card ("Text | Right text")
  @param {string} [perks_multi] - Lines listed in the multi-item offer cards ("Text | Right text")

  @example
  {% render 'variant-picker', product: product, section_id: section.id %}
{% enddoc %}
{%- unless product.has_only_default_variant -%}
  {%- liquid
    comment
      Reference unit price: the cheapest variant of the first offer value,
      one item. Used to show the saving of multi-item offers.
    endcomment
    assign offer_index = -1
    for option in product.options_with_values
      assign option_handle = option.name | handleize
      if option_handle == 'offre' or option_handle == 'offer' or option_handle == 'pack' or option_handle == 'lot'
        assign offer_index = forloop.index0
      endif
    endfor
    assign unit_text = unit_label
    if unit_text == blank
      assign unit_text = 'products.offer_unit' | t
    endif
    assign unit_price = 0
    if offer_index >= 0
      assign first_offer = product.options_with_values[offer_index].values.first.name
      for variant in product.variants
        if variant.options[offer_index] == first_offer
          if unit_price == 0 or variant.price < unit_price
            assign unit_price = variant.price
          endif
        endif
      endfor
    endif
  -%}
  <variant-picker class="variant-picker">
    {%- for option in product.options_with_values -%}
      {%- liquid
        comment
          Kept in a variable: nested loops below must not change it.
        endcomment
        assign option_position = forloop.index
        assign option_handle = option.name | handleize
        assign is_color = false
        if option_handle == 'couleur' or option_handle == 'coloris' or option_handle == 'color' or option_handle == 'colour'
          assign is_color = true
        endif
        assign is_offer = false
        assign offer_position = offer_index | plus: 1
        if option_position == offer_position
          assign is_offer = true
        endif
      -%}
      <fieldset
        class="variant-picker__fieldset{% if is_offer %} variant-picker__fieldset--offers{% endif %}"
        data-option-name="{{ option.name | escape }}"
      >
        {%- if is_offer -%}
          {%- if offer_heading != blank -%}
            <legend class="variant-picker__offers-title">
              <span>{{ offer_heading | escape }}</span>
            </legend>
          {%- else -%}
            <legend class="visually-hidden">{{ option.name | escape }}</legend>
          {%- endif -%}
        {%- else -%}
          <legend class="variant-picker__legend">
            {{ option.name | escape }} : <span class="variant-picker__selected" data-selected-value>{{ option.selected_value | escape }}</span>
          </legend>
        {%- endif -%}

        <div class="variant-picker__values{% if is_offer %} variant-picker__values--offers{% endif %}">
          {%- for value in option.values -%}
            {%- liquid
              assign input_id = 'Option-' | append: section_id | append: '-' | append: option_position | append: '-' | append: forloop.index
              assign value_exists = true
              if option_position > 1 and value.variant == blank
                assign value_exists = false
              endif

              assign swatch_color = ''
              assign swatch_color_2 = ''
              if is_color
                if value.swatch.color
                  assign swatch_color = value.swatch.color
                else
                  assign value_handle = value.name | handleize
                  case value_handle
                    when 'rose'
                      assign swatch_color = '#E5AEB9'
                    when 'blanc'
                      assign swatch_color = '#FFFFFF'
                    when 'rose-blanc'
                      assign swatch_color = '#E5AEB9'
                      assign swatch_color_2 = '#FFFFFF'
                    when 'noir'
                      assign swatch_color = '#2B2523'
                    when 'gris'
                      assign swatch_color = '#BDB6B3'
                    when 'beige'
                      assign swatch_color = '#E8DCCB'
                  endcase
                endif
              endif

              if is_offer
                assign offer_qty = 1
                if value.name contains '2'
                  assign offer_qty = 2
                elsif value.name contains '3'
                  assign offer_qty = 3
                endif
                assign offer_price = 0
                for variant in product.variants
                  if variant.options[offer_index] == value.name
                    if offer_price == 0 or variant.price < offer_price
                      assign offer_price = variant.price
                    endif
                  endif
                endfor
                assign offer_reference = unit_price | times: offer_qty
                assign offer_saving = offer_reference | minus: offer_price
                assign offer_unit = offer_price | divided_by: offer_qty
              endif
            -%}
            {%- if is_offer -%}
              <span class="variant-picker__value" data-option-value>
                <input
                  class="offer-card__input"
                  type="radio"
                  id="{{ input_id }}"
                  name="Option-{{ section_id }}-{{ option_position }}"
                  value="{{ value | escape }}"
                  data-offer-qty="{{ offer_qty }}"
                  {% if value.selected %}
                    checked
                  {% endif %}
                >
                {%- liquid
                  if offer_qty > 1
                    assign perks = perks_multi
                  else
                    assign perks = perks_single
                  endif
                  assign perk_lines = perks | newline_to_br | split: '<br />'
                -%}
                <label class="offer-card{% if offer_saving > 0 %} offer-card--deal{% endif %}" for="{{ input_id }}">
                  {%- if offer_saving > 0 and best_label != blank -%}
                    <span class="offer-card__tab">{{ best_label | escape }}</span>
                  {%- endif -%}
                  <span class="offer-card__radio" aria-hidden="true"></span>
                  <span class="offer-card__body">
                    <span class="offer-card__heading">
                      <span class="offer-card__title">{{ value | escape }}</span>
                      {%- if offer_saving > 0 -%}
                        {%- assign saving_text = offer_saving | money_without_trailing_zeros -%}
                        <span class="offer-card__saving">{{ 'products.offer_saving' | t: amount: saving_text }}</span>
                      {%- endif -%}
                    </span>
                    <span class="offer-card__sub">
                      {%- if offer_qty > 1 -%}
                        {{ offer_unit | money }} {{ unit_text | escape }}
                        {%- if offer_note_multi != blank %} · {{ offer_note_multi | escape }}{% endif -%}
                      {%- else -%}
                        {{ offer_note_single | escape }}
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="offer-card__price">
                    <span class="offer-card__amount">{{ offer_price | money_without_trailing_zeros }}</span>
                    {%- if offer_saving > 0 -%}
                      <span class="offer-card__reference">
                        <span class="visually-hidden">{{ 'products.offer_reference_label' | t }}</span>
                        <s>{{ offer_reference | money_without_trailing_zeros }}</s>
                      </span>
                    {%- endif -%}
                  </span>
                  {%- if perks != blank -%}
                    <span class="offer-card__perks">
                      {%- for line in perk_lines -%}
                        {%- liquid
                          assign perk_parts = line | split: '|'
                          assign perk_text = perk_parts[0] | strip
                          assign perk_value = perk_parts[1] | strip
                          assign perk_key = perk_text | downcase
                          assign perk_icon = 'check'
                          if perk_key contains 'livraison'
                            assign perk_icon = 'truck'
                          elsif perk_key contains 'câble' or perk_key contains 'cable' or perk_key contains 'charge'
                            assign perk_icon = 'battery'
                          elsif perk_key contains 'rembours' or perk_key contains 'retour' or perk_key contains 'garantie'
                            assign perk_icon = 'return'
                          elsif perk_key contains 'ceinture'
                            assign perk_icon = 'heat'
                          elsif perk_key contains 'colis' or perk_key contains 'coffret'
                            assign perk_icon = 'box'
                          endif
                        -%}
                        {%- if perk_text != blank -%}
                          <span class="offer-card__perk">
                            <span class="offer-card__perk-icon" aria-hidden="true">{% render 'icon', icon: perk_icon %}</span>
                            <span class="offer-card__perk-text">{{ perk_text | escape }}</span>
                            {%- if perk_value != blank -%}
                              <span class="offer-card__perk-value">{{ perk_value | escape }}</span>
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                  {%- endif -%}
                </label>
              </span>
            {%- else -%}
              <span class="variant-picker__value" data-option-value {% unless value_exists %}hidden{% endunless %}>
                <input
                  class="variant-pill__input"
                  type="radio"
                  id="{{ input_id }}"
                  name="Option-{{ section_id }}-{{ option_position }}"
                  value="{{ value | escape }}"
                  {% if value.selected %}
                    checked
                  {% endif %}
                  {% unless value_exists %}
                    disabled
                  {% endunless %}
                >
                <label class="variant-pill{% unless value.available %} variant-pill--unavailable{% endunless %}" for="{{ input_id }}">
                  {%- if swatch_color != blank -%}
                    <span
                      class="variant-pill__swatch"
                      style="--swatch-color: {{ swatch_color }};{% if swatch_color_2 != blank %} --swatch-color-2: {{ swatch_color_2 }};{% endif %}"
                      aria-hidden="true"
                    ></span>
                  {%- endif -%}
                  <span>{{ value | escape }}</span>
                  {%- unless value.available -%}
                    <span class="visually-hidden">({{ 'products.sold_out' | t }})</span>
                  {%- endunless -%}
                </label>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if is_color and offer_index >= 0 and multi_hint != blank -%}
          <p class="variant-picker__hint" data-multi-hint hidden>{{ multi_hint | escape }}</p>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}

    <script type="application/json" data-variants>
      [
        {%- for variant in product.variants -%}
          {%- liquid
            assign variant_availability = 'available'
            if variant.available == false
              assign variant_availability = 'unavailable'
            elsif variant.inventory_management == 'shopify' and variant.inventory_quantity > 0
              assign variant_availability = 'in_stock'
            endif
          -%}
          {
            "id": {{ variant.id }},
            "availability": {{ variant_availability | json }},
            "image": {% if variant.featured_media %}{{ variant.featured_media.preview_image | image_url: width: 120, height: 120, crop: 'center' | json }}{% else %}null{% endif %},
            "title": {{ variant.title | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | money | strip_html | json }},
            "compare_at_price": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
            "options": {{ variant.options | json }},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </variant-picker>
{%- endunless -%}

{% stylesheet %}
  .variant-picker {
    display: grid;
    gap: var(--space-md);
  }

  .variant-picker__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .variant-picker__legend {
    margin-block-end: var(--space-xs);
    padding: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
  }

  .variant-picker__selected {
    font-weight: var(--font-body-weight);
    color: var(--color-text-muted);
  }

  .variant-picker__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .variant-pill__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .variant-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap-target);
    padding: 0.5rem 1.1rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.22);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;

    &:hover {
      border-color: rgb(var(--color-text-rgb) / 0.55);
    }
  }

  .variant-pill__input:checked + .variant-pill {
    border-color: var(--color-text);
    background-color: rgb(var(--color-text-rgb) / 0.04);
    box-shadow: inset 0 0 0 1px var(--color-text);
  }

  .variant-pill__input:focus-visible + .variant-pill {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .variant-pill--unavailable {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .variant-pill__swatch {
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.25);
    border-radius: 50%;
    background: linear-gradient(90deg, var(--swatch-color) 50%, var(--swatch-color-2, var(--swatch-color)) 50%);
  }

  /* Offer cards ("Choisissez votre offre") */
  .variant-picker__offers-title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    margin-block-end: var(--space-sm);
    padding: 0;
    font-size: var(--text-xs);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);

    &::before,
    &::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--warm-gradient);
      opacity: 0.6;
    }
  }

  .variant-picker__values--offers {
    display: grid;
    gap: var(--space-xs);
  }

  .variant-picker__value[hidden] {
    display: none;
  }

  .offer-card__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .offer-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background-color: #f7f4f4;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease,
      background-color var(--duration-fast) ease;

    &:hover {
      border-color: rgb(var(--rose-strong-rgb) / 0.35);
    }
  }

  .offer-card--deal {
    margin-block-start: 0.75rem;
  }

  .offer-card__input:checked + .offer-card {
    border-color: var(--rose-strong);
    background-color: #fff;
    box-shadow: 0 0 0 4px rgb(var(--rose-strong-rgb) / 0.08);
  }

  .offer-card__input:focus-visible + .offer-card {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .offer-card__radio {
    width: 1.375rem;
    height: 1.375rem;
    border: 2px solid rgb(var(--color-text-rgb) / 0.25);
    border-radius: 50%;
    background-color: #fff;
    transition: border-color var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .offer-card__input:checked + .offer-card .offer-card__radio {
    border-color: var(--rose-strong);
    background-color: var(--rose-strong);
    box-shadow: inset 0 0 0 0.2rem #fff;
  }

  .offer-card__body {
    display: grid;
    gap: 0.2rem;
  }

  .offer-card__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem var(--space-2xs);
  }

  .offer-card__title {
    font-size: var(--text-lg);
    font-weight: var(--font-body-weight-bold);
    line-height: 1.2;
  }

  .offer-card__saving {
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-xs);
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rose-text);
    background-color: var(--rose-soft);
    box-shadow: inset 0 0 0 1px rgb(var(--rose-strong-rgb) / 0.35);
  }

  .offer-card__sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .offer-card__price {
    display: grid;
    justify-items: end;
    gap: 0.1rem;
    text-align: end;
  }

  .offer-card__amount {
    font-size: var(--text-lg);
    font-weight: var(--font-body-weight-bold);
    font-variant-numeric: tabular-nums;
  }

  .offer-card__reference {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .offer-card__tab {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: var(--space-md);
    translate: 0 -60%;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-xs);
    font-size: var(--text-xs);
    font-weight: var(--font-body-weight-bold);
    color: #fff;
    background-color: #1f1a19;
  }

  /* What the offer includes */
  .offer-card__perks {
    display: grid;
    grid-column: 1 / -1;
    gap: var(--space-2xs);
    margin-block-start: var(--space-sm);
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid rgb(var(--color-text-rgb) / 0.08);
  }

  .offer-card__perk {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }

  .offer-card__perk-icon {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: var(--radius-xs);
    color: var(--rose-strong);
    background-color: var(--rose-soft);

    & .icon {
      --icon-size: 1rem;
    }
  }

  .offer-card__perk-text {
    font-weight: var(--font-body-weight-medium);
  }

  .offer-card__perk-value {
    font-size: var(--text-xs);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rose-text);
  }

  .variant-picker__hint {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

{% endstylesheet %}
