{% doc %}
  Renders a decorative line icon from the theme icon set (24 × 24 grid,
  1.5px stroke). Icons are hidden from assistive technologies: always pair
  them with visible text or an aria-label on the parent control.

  @param {string} icon - Icon name (e.g. 'truck', 'heat', 'bag')
  @param {string} [class] - Extra CSS classes

  @example
  {% render 'icon', icon: 'truck' %}
{% enddoc %}
<svg
  class="icon icon--{{ icon }}{% if class %} {{ class }}{% endif %}"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="M15 18l-6-6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="M9 18l6-6-6-6"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'menu' -%}
      <path d="M3.5 8.5h17M3.5 15.5h17"/>
    {%- when 'bag' -%}
      <path d="M5.5 8h13l-1.1 12.1a1 1 0 0 1-1 .9H7.6a1 1 0 0 1-1-.9L5.5 8z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.4-3.7 4.2-5.5 7.5-5.5s6.1 1.8 7.5 5.5"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'star' -%}
      <path fill="currentColor" stroke="none" d="M12 2.2l2.95 6.2 6.75.8-4.98 4.62 1.3 6.78L12 17.27 5.98 20.6l1.3-6.78L2.3 9.2l6.75-.8z"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 9.5h3.8l3.2 3.3v3.7h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'return' -%}
      <path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5.2c0 4.4-2.9 8.2-7 9.8-4.1-1.6-7-5.4-7-9.8V6l7-3z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'chat' -%}
      <path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.3-4A8 8 0 1 1 20 11.5z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>
    {%- when 'heat' -%}
      <path d="M13.5 14.6V5a1.5 1.5 0 0 0-3 0v9.6a3.5 3.5 0 1 0 3 0z"/><path d="M12 17.5V11"/><path d="M17 6h2.5M17 9.5h2.5"/>
    {%- when 'battery' -%}
      <rect x="2.5" y="7" width="16" height="10" rx="2"/><path d="M21.5 10.5v3"/><path d="M6.5 10v4M10 10v4"/>
    {%- when 'vibration' -%}
      <circle cx="12" cy="12" r="1.8"/><path d="M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7"/><path d="M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8"/>
    {%- when 'feather' -%}
      <path d="M20 12.2a6.2 6.2 0 0 0-8.8-8.8L5 9.6V19h9.4z"/><path d="M15.5 8.5L3 21"/><path d="M17 15H9.5"/>
    {%- when 'cloud' -%}
      <path d="M7 18.5h10a4 4 0 0 0 .6-7.95 6 6 0 0 0-11.3 1.2A3.4 3.4 0 0 0 7 18.5z"/>
    {%- when 'power' -%}
      <path d="M12 3.5v8"/><path d="M6.6 7a7.5 7.5 0 1 0 10.8 0"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'home' -%}
      <path d="M3.5 11L12 4l8.5 7"/><path d="M6 9.5V20h12V9.5"/>
    {%- when 'briefcase' -%}
      <rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/><path d="M3 12.5h18"/>
    {%- when 'map-pin' -%}
      <path d="M12 21s-7-6.2-7-11.2a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.5"/>
    {%- when 'box' -%}
      <path d="M3.5 7.5L12 3.5l8.5 4v9L12 20.5l-8.5-4z"/><path d="M3.5 7.5L12 11.5l8.5-4"/><path d="M12 11.5v9"/>
    {%- when 'info' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5"/><path d="M12 7.8v.1"/>
    {%- when 'alert' -%}
      <path d="M10.3 4.1L2.6 17.6A2 2 0 0 0 4.3 20.5h15.4a2 2 0 0 0 1.7-2.9L13.7 4.1a2 2 0 0 0-3.4 0z"/><path d="M12 9.5v4"/><path d="M12 16.8v.1"/>
    {%- when 'pause' -%}
      <path d="M9 6v12M15 6v12"/>
    {%- when 'play' -%}
      <path d="M8 5.5v13l10.5-6.5z"/>
    {%- when 'volume' -%}
      <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/>
    {%- when 'volume-off' -%}
      <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M16 9.5l5 5M21 9.5l-5 5"/>
    {%- when 'image' -%}
      <rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M4 17l5-4.5 3.5 3 2.5-2 5 4"/>
    {%- when 'zoom' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.3-4.3"/><path d="M11 8.5v5M8.5 11h5"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.2 6.8v.1"/>
    {%- when 'tiktok' -%}
      <path d="M14 3.5v11.3a3.6 3.6 0 1 1-3.6-3.6"/><path d="M14 3.5c.5 2.6 2.4 4.4 5 4.6"/>
    {%- when 'facebook' -%}
      <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.6 1.6-1.6h1.6V4.3a19 19 0 0 0-2.4-.1c-2.4 0-4 1.4-4 4.1v2.2H8.6v3h2.7V21"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M10.8 20.2l1.7-7.1"/><path d="M9.6 13.4c-.9-2.6.8-5.4 3.4-5.4 2.2 0 3.4 1.5 3.4 3.4 0 2.3-1.3 4.1-3 4.1-.9 0-1.6-.7-1.4-1.7"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.3v5.4l4.6-2.7z"/>
  {%- endcase -%}
</svg>
