{% doc %}
  Social proof under the product banner: the first reviewers and the
  average rating with the number of reviews, linking to the reviews
  section. Built only from real data: the product's "Avis clientes"
  (custom.avis) entries; without them, the selection of reviews of this model
  published elsewhere (custom.avis_selection, then custom.avis_externes), with
  that site's overall rating and total; or the standard
  rating fields filled by a review app. Renders nothing when there is no review.

  @param {object} product - Product object
  @param {string} [anchor] - Id of the reviews section to link to
  @param {string} [url] - Page holding that section, when it is another page (e.g. the product page)

  @example
  {% render 'product-rating', product: product, anchor: 'avis' %}
{% enddoc %}
{%- liquid
  assign reviews_key = 'avis'
  assign own_count = product.metafields.custom.avis.value.size | default: 0
  if own_count == 0
    assign reviews_key = 'avis_externes'
    if product.metafields.custom.avis_selection.value.size > 0
      assign reviews_key = 'avis_selection'
    endif
  endif
  assign review_count = product.metafields.custom[reviews_key].value.size | default: 0
  assign link = url | append: '#' | append: anchor
-%}
{%- if review_count > 0 -%}
  {%- comment -%} Up to 250 reviews (list.max): one paginate page covers them all. {%- endcomment -%}
  {%- paginate product.metafields.custom[reviews_key].value by 250 -%}
    {%- liquid
      assign rating_sum = 0
      assign source_name = ''
      for review in product.metafields.custom[reviews_key].value
        assign rating_sum = rating_sum | plus: review.note.value.rating
        if source_name == blank and review.source.value != blank
          assign source_name = review.source.value | strip | escape
        endif
      endfor
      assign average = rating_sum | times: 1.0 | divided_by: review_count
      assign display_count = review_count
      if source_name != blank
        comment
          Reviews from another site: that site's overall rating and total, when filled in.
        endcomment
        if product.metafields.custom.avis_externes_note.value != blank
          assign average = product.metafields.custom.avis_externes_note.value.rating
        endif
        assign source_total = product.metafields.custom.avis_externes_total.value | default: 0
        if reviews_key == 'avis_selection'
          assign source_total = product.metafields.custom.avis_selection_total.value | default: source_total
        endif
        if source_total > review_count
          assign display_count = source_total
        endif
      endif
      assign average_text_x10 = average | times: 10 | round
      assign average_text_int = average_text_x10 | divided_by: 10 | floor
      assign average_text_dec = average_text_x10 | modulo: 10
      assign average_text = average_text_int | append: ',' | append: average_text_dec
    -%}
    <div class="product-rating">
      {%- comment -%} "… ont donné leur avis" speaks of shop customers: not for reviews from another site. {%- endcomment -%}
      {%- if source_name == blank -%}
      <p class="product-rating__proof">
        <span class="product-rating__avatars" aria-hidden="true">
          {%- for review in product.metafields.custom[reviews_key].value limit: 3 -%}
            <span class="product-rating__avatar product-rating__avatar--{{ forloop.index }}">
              {{- review.auteur.value | strip | slice: 0 | upcase -}}
            </span>
          {%- endfor -%}
        </span>
        {%- for review in product.metafields.custom[reviews_key].value limit: 1 -%}
          <span>
            <strong>{{ review.auteur.value | escape }}</strong>
            {%- if review.achat_verifie.value and review.source.value == blank -%}
              <span class="product-rating__verified">
                {%- render 'icon', icon: 'check' -%}
                <span class="visually-hidden">{{ 'reviews.verified' | t }}</span>
              </span>
            {%- endif %}
            {% if review_count == 1 -%}
              {{ 'reviews.proof_one' | t }}
            {%- else -%}
              {%- assign others = review_count | minus: 1 -%}
              {{ 'reviews.proof_other' | t: count: others }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </p>
      {%- endif -%}
      <a class="product-rating__summary" href="{{ link }}">
        {% render 'stars', rating: average %}
        <span>
          {{- average_text }}/5
          {{ 'reviews.count_short' | t: count: display_count -}}
        </span>
      </a>
    </div>
  {%- endpaginate -%}
{%- elsif product.metafields.reviews.rating.value and product.metafields.reviews.rating_count.value > 0 -%}
  {%- liquid
    assign average = product.metafields.reviews.rating.value.rating
    assign app_total = product.metafields.reviews.rating_count.value
    assign average_text_x10 = average | times: 10 | round
    assign average_text_int = average_text_x10 | divided_by: 10 | floor
    assign average_text_dec = average_text_x10 | modulo: 10
    assign average_text = average_text_int | append: ',' | append: average_text_dec
  -%}
  <div class="product-rating">
    <a class="product-rating__summary" href="{{ link }}">
      {% render 'stars', rating: average %}
      <span>{{ average_text }}/5 {{ 'reviews.count_short' | t: count: app_total }}</span>
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-rating {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
  }

  .product-rating__proof {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text-muted);

    & strong {
      font-weight: var(--font-body-weight-medium);
      color: var(--color-text);
    }
  }

  .product-rating__avatars {
    display: flex;
    flex: none;
  }

  .product-rating__avatar {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid var(--color-background);
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: var(--font-body-weight-medium);
    color: var(--color-text);
    background-color: #f3dfe2;

    & + & {
      margin-inline-start: -0.55rem;
    }
  }

  .product-rating__avatar--2 {
    background-color: #e8c7cd;
  }

  .product-rating__avatar--3 {
    background-color: #f6e9dc;
  }

  .product-rating__verified {
    display: inline-grid;
    place-items: center;
    width: 0.95rem;
    height: 0.95rem;
    margin-inline-start: 0.2rem;
    vertical-align: -0.12em;
    border-radius: 50%;
    color: #fff;
    background-color: #3a86d1;

    & .icon {
      --icon-size: 0.6rem;
      stroke-width: 3;
    }
  }

  .product-rating__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    width: fit-content;
    color: var(--color-text);
    text-decoration: none;

    &:hover span {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
{% endstylesheet %}
