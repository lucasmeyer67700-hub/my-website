{% doc %}
  Renders a multi-line text metafield as a list, one item per line.
  Renders nothing when the value is empty.

  @param {string} value - Multi-line text
  @param {boolean} [ordered] - Numbered list (steps) instead of bullets
  @param {boolean} [plain] - Plain lines without list markers

  @example
  {% render 'metafield-lines', value: product.metafields.custom.mode_emploi.value, ordered: true %}
{% enddoc %}
{%- if value != blank -%}
  {%- liquid
    assign lines = value | newline_to_br | split: '<br />'
    if ordered
      assign list_tag = 'ol'
      assign list_class = 'lines-list lines-list--ordered'
    elsif plain
      assign list_tag = 'ul'
      assign list_class = 'lines-list lines-list--plain'
    else
      assign list_tag = 'ul'
      assign list_class = 'lines-list'
    endif
  -%}
  <{{ list_tag }} class="{{ list_class }}" role="list">
    {%- for raw_line in lines -%}
      {%- assign line = raw_line | strip -%}
      {%- if line != blank -%}
        <li>{{ line | escape }}</li>
      {%- endif -%}
    {%- endfor -%}
  </{{ list_tag }}>
{%- endif -%}

{% stylesheet %}
  .lines-list {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;

    & li {
      position: relative;
      padding-inline-start: 1.25rem;
    }

    & li::before {
      content: '';
      position: absolute;
      inset-inline-start: 0.2rem;
      inset-block-start: 0.7em;
      width: 0.35rem;
      height: 0.35rem;
      border-radius: 50%;
      background-color: var(--color-accent);
    }
  }

  .lines-list--ordered {
    counter-reset: lines;

    & li {
      padding-inline-start: 2rem;
      counter-increment: lines;
    }

    & li::before {
      content: counter(lines);
      inset-block-start: 0.1em;
      width: 1.45rem;
      height: 1.45rem;
      display: grid;
      place-items: center;
      font-size: var(--text-xs);
      font-weight: var(--font-body-weight-medium);
      color: var(--color-text);
      background-color: var(--palette-rose-soft);
    }
  }

  .lines-list--plain li {
    padding-inline-start: 0;

    &::before {
      display: none;
    }
  }
{% endstylesheet %}
