{% doc %}
  Cart totals, reassurance and checkout button, shared by the cart drawer
  and the cart page. The checkout is Shopify's own secure checkout. Under the
  button, the secure-payment promise with the enabled payment methods; the
  cart page also offers the express buttons (Shop Pay, Apple Pay…) that are
  enabled on the store.

  @param {string} form_id - id of the cart form the checkout button submits
  @param {boolean} [compact] - Drawer: a one-line promise, no express buttons

  @example
  {% render 'cart-summary', form_id: 'CartDrawerForm', compact: true %}
{% enddoc %}
<div class="cart-summary">
  <p class="form-message form-message--error" role="alert" data-cart-error hidden></p>

  {%- if cart.cart_level_discount_applications.size > 0 -%}
    <ul class="cart-summary__discounts" role="list">
      {%- for discount in cart.cart_level_discount_applications -%}
        <li class="cart-summary__row">
          <span>{{ 'cart.discount' | t }} – {{ discount.title | escape }}</span>
          <span>−{{ discount.total_allocated_amount | money }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <p class="cart-summary__row cart-summary__subtotal">
    <span>{{ 'cart.subtotal' | t }}</span>
    <span>{{ cart.total_price | money }}</span>
  </p>

  <p class="cart-summary__note text-muted text-small">
    {%- if cart.taxes_included %}{{ 'cart.taxes_included' | t }} {% endif -%}
    {{- 'cart.shipping_at_checkout' | t -}}
  </p>

  {%- if settings.shipping_info != blank -%}
    <ul class="trust-list" role="list">
      <li>
        {% render 'icon', icon: 'truck' %}
        <span>
          {{- settings.shipping_info | escape -}}
          {%- if settings.shipping_delay != blank %} · {{ settings.shipping_delay | escape }}{% endif -%}
        </span>
      </li>
    </ul>
  {%- endif -%}

  <button type="submit" name="checkout" form="{{ form_id }}" class="button button--full cart-summary__checkout">
    {% render 'icon', icon: 'lock' %}
    {{ 'cart.checkout' | t }}
  </button>

  {%- comment -%} Right under the checkout button: secure payment and the enabled methods. {%- endcomment -%}
  {%- if compact -%}
    {% render 'secure-payment', style: 'compact' %}
  {%- else -%}
    {% render 'secure-payment', style: 'card' %}
    {%- if additional_checkout_buttons and settings.cart_express_checkout -%}
      <div class="cart-summary__express">
        <p class="cart-summary__or"><span>{{ 'payment.express_label' | t }}</span></p>
        {{ content_for_additional_checkout_buttons }}
      </div>
    {%- endif -%}
  {%- endif -%}

  <p class="cart-summary__hint text-muted text-small">{{ 'cart.discount_hint' | t }}</p>
</div>

{% stylesheet %}
  .cart-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .cart-summary__discounts {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-success);
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .cart-summary__subtotal {
    font-size: var(--text-lg);
    font-weight: var(--font-body-weight-medium);
  }

  .cart-summary__checkout .icon {
    --icon-size: 1.05rem;
  }

  .cart-summary__hint {
    text-align: center;
  }

  /* Express buttons from Shopify, under a fine "or" line */
  .cart-summary__express {
    display: grid;
    gap: var(--space-xs);
  }

  .cart-summary__or {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);

    &::before,
    &::after {
      content: '';
      flex: 1;
      height: 1px;
      background-color: var(--color-border);
    }
  }
{% endstylesheet %}
