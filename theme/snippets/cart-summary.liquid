{% doc %}
  Cart totals, reassurance and checkout button, shared by the cart drawer
  and the cart page. The checkout is Shopify's own secure checkout. Under the
  button, the secure-payment promise with the enabled payment methods; the
  cart page also offers the express buttons (Shop Pay, Apple Pay…) that are
  enabled on the store.

  @param {string} form_id - id of the cart form the checkout button submits
  @param {boolean} [compact] - Drawer: a one-line promise, no express buttons

  @example
  {% render 'cart-summary', form_id: 'CartDrawerForm', compact: true %}
{% enddoc %}
<div class="cart-summary">
  <p class="form-message form-message--error" role="alert" data-cart-error hidden></p>

  {%- if cart.cart_level_discount_applications.size > 0 -%}
    <ul class="cart-summary__discounts" role="list">
      {%- for discount in cart.cart_level_discount_applications -%}
        <li class="cart-summary__row">
          <span>{{ 'cart.discount' | t }} – {{ discount.title | escape }}</span>
          <span>−{{ discount.total_allocated_amount | money }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- comment -%}
    One pink and one white belt bought one by one cost more than the Duo
    (which is exactly one of each): the cart offers to switch, in one click.
  {%- endcomment -%}
  {%- liquid
    assign duo_rose_qty = 0
    assign duo_blanc_qty = 0
    assign duo_variant = blank
    for item in cart.items
      if item.variant.option1 == '1 ceinture'
        if item.variant.option2 == 'Rose'
          assign duo_rose_qty = duo_rose_qty | plus: item.quantity
          assign duo_rose_id = item.variant.id
          assign duo_rose_price = item.variant.price
        elsif item.variant.option2 == 'Blanc'
          assign duo_blanc_qty = duo_blanc_qty | plus: item.quantity
          assign duo_blanc_id = item.variant.id
          assign duo_blanc_price = item.variant.price
        endif
        for variant in item.product.variants
          if variant.option1 contains 'Duo' and variant.available
            assign duo_variant = variant
          endif
        endfor
      endif
    endfor
    assign duo_pairs = duo_rose_qty | at_most: duo_blanc_qty
    assign duo_in_cart = 0
    if duo_variant != blank
      for item in cart.items
        if item.variant.id == duo_variant.id
          assign duo_in_cart = duo_in_cart | plus: item.quantity
        endif
      endfor
      assign duo_separate = duo_rose_price | plus: duo_blanc_price | times: duo_pairs
      assign duo_total = duo_variant.price | times: duo_pairs
      assign duo_saving = duo_separate | minus: duo_total
    endif
  -%}
  {%- if duo_variant != blank and duo_pairs > 0 and duo_saving > 0 -%}
    <div class="cart-duo" data-duo-offer>
      <p class="cart-duo__text">
        <strong>{{ 'cart.duo_title' | t }}</strong>
        {%- liquid
          assign duo_total_text = duo_total | money
          assign duo_separate_text = duo_separate | money
          assign duo_saving_text = duo_saving | money
        -%}
        {{ 'cart.duo_text' | t: duo: duo_total_text, separate: duo_separate_text, saving: duo_saving_text }}
      </p>
      <button
        type="button"
        class="cart-duo__button"
        data-duo-swap
        data-rose-id="{{ duo_rose_id }}"
        data-rose-qty="{{ duo_rose_qty | minus: duo_pairs }}"
        data-blanc-id="{{ duo_blanc_id }}"
        data-blanc-qty="{{ duo_blanc_qty | minus: duo_pairs }}"
        data-duo-id="{{ duo_variant.id }}"
        data-duo-qty="{{ duo_in_cart | plus: duo_pairs }}"
      >
        {{- 'cart.duo_button' | t -}}
      </button>
    </div>
  {%- endif -%}

  <p class="cart-summary__row cart-summary__subtotal">
    <span>{{ 'cart.subtotal' | t }}</span>
    <span>{{ cart.total_price | money }}</span>
  </p>

  {%- if settings.shipping_info != blank -%}
    <p class="cart-summary__shipping">
      {% render 'icon', icon: 'truck' %}
      <span>
        {{- settings.shipping_info | escape -}}
        {%- if settings.shipping_delay != blank %} · {{ settings.shipping_delay | escape }}{% endif -%}
      </span>
    </p>
  {%- endif -%}

  {%- if compact -%}
    {%- comment -%} Drawer: one button that says it all, the enabled methods under it. {%- endcomment -%}
    <button type="submit" name="checkout" form="{{ form_id }}" class="button button--full cart-summary__checkout cart-summary__checkout--secure">
      {% render 'icon', icon: 'lock' %}
      {{ 'cart.checkout' | t }}
    </button>
    {% render 'payment-icons', class: 'cart-summary__payments' %}
  {%- else -%}
    <button type="submit" name="checkout" form="{{ form_id }}" class="button button--full cart-summary__checkout">
      {{ 'cart.checkout' | t }}
      {% render 'icon', icon: 'arrow-right' %}
    </button>
    {% render 'secure-payment', style: 'card' %}
    {%- if additional_checkout_buttons and settings.cart_express_checkout -%}
      <div class="cart-summary__express">
        <p class="cart-summary__or"><span>{{ 'payment.express_label' | t }}</span></p>
        {{ content_for_additional_checkout_buttons }}
      </div>
    {%- endif -%}
  {%- endif -%}

  <p class="cart-summary__hint text-muted text-small">{{ 'cart.discount_hint' | t }}</p>
</div>

{% stylesheet %}
  .cart-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .cart-summary__discounts {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-success);
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .cart-summary__subtotal {
    font-size: var(--text-lg);
    font-weight: var(--font-body-weight-medium);
  }

  .cart-summary__checkout {
    gap: 0.6rem;
    min-height: 3.5rem;
    letter-spacing: 0.04em;

    & .icon {
      --icon-size: 1.05rem;
      transition: transform var(--duration-base, 0.25s) var(--ease-out, ease-out);
    }

    &:hover .icon {
      transform: translateX(3px);
    }
  }

  .cart-summary__shipping {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: -0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);

    & .icon {
      --icon-size: 1.05rem;
      flex: none;
      color: var(--rose-strong);
    }
  }

  /* The Duo suggestion: a soft rose card right above the total */
  .cart-duo {
    display: grid;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgb(var(--rose-strong-rgb) / 0.25);
    border-radius: var(--radius-md, 0.75rem);
    background-color: #fbf1f3;
  }

  .cart-duo__text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;

    & strong {
      display: block;
      font-weight: var(--font-body-weight-medium);
    }
  }

  .cart-duo__button {
    justify-self: start;
    min-height: 2.5rem;
    padding: 0.4rem 1.1rem;
    border: 1px solid #a14a5c;
    border-radius: 999px;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
    color: #fff;
    background-color: #a14a5c;
    cursor: pointer;

    &[aria-busy='true'] {
      opacity: 0.6;
      cursor: progress;
    }

    &:focus-visible {
      outline: 2px solid var(--rose-strong);
      outline-offset: 3px;
    }
  }

  .cart-summary__hint {
    text-align: center;
  }

  /* Express buttons from Shopify, under a fine "or" line */
  .cart-summary__express {
    display: grid;
    gap: var(--space-xs);
  }

  .cart-summary__or {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);

    &::before,
    &::after {
      content: '';
      flex: 1;
      height: 1px;
      background-color: var(--color-border);
    }
  }
{% endstylesheet %}
