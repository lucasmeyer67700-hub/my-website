{% doc %}
  Review cards gliding past in an endless loop, shared by the home "Avis
  défilants" section and the product reviews section. No buttons and no stop:
  the band keeps moving, even under the mouse. "Lire la suite" and the photos
  open the whole review in a window, while the band goes on behind it. It only
  waits while a card has the keyboard focus. Visitors who reduce motion (and
  browsers without JavaScript) get a still row they can scroll themselves.
  Each card has a photo place: the review's photo when there is one (with the
  number of photos), an empty place shown only in the theme editor otherwise.
  A review without a first name shows no name at all (never "Anonyme").
  Built from the product's own reviews (custom.avis), or else from the
  selection of reviews of this model (custom.avis_selection, then
  custom.avis_externes). Renders nothing without reviews.

  @param {object} product - Product object
  @param {number} [limit] - Maximum number of cards (default 12)
  @param {number} [speed] - Seconds for one card to go by (default 7, 0 = still)

  @example
  {% render 'reviews-band', product: product, limit: 10, speed: 7 %}
{% enddoc %}
{%- liquid
  assign reviews_key = 'avis'
  assign own_count = product.metafields.custom.avis.value.size | default: 0
  if own_count == 0
    assign reviews_key = 'avis_externes'
    if product.metafields.custom.avis_selection.value.size > 0
      assign reviews_key = 'avis_selection'
    endif
  endif
  assign review_count = product.metafields.custom[reviews_key].value.size | default: 0
  assign max_cards = limit | default: 12
  assign seconds = speed | default: 7
  assign months = 'reviews.months' | t | split: '|'
-%}
{%- if review_count > 0 -%}
  {%- comment -%} Up to 250 reviews (list.max): one paginate page covers them all. {%- endcomment -%}
  {%- paginate product.metafields.custom[reviews_key].value by 250 -%}
    {%- assign position = 0 -%}
    <reviews-loop class="reviews-loop" data-speed="{{ seconds }}" data-photo-label="{{ 'reviews.photo_number' | t }}">
      <div
        class="reviews-loop__viewport"
        role="region"
        aria-label="{{ 'reviews.carousel_label' | t }}"
        data-loop-viewport
      >
        <ul class="reviews-loop__track" role="list" data-loop-track>
          {%- for review in product.metafields.custom[reviews_key].value -%}
            {%- if review.texte.value == blank -%}{%- continue -%}{%- endif -%}
            {%- if position >= max_cards -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign position = position | plus: 1
              assign review_day = review.date.value | date: '%d' | plus: 0
              assign review_year = review.date.value | date: '%Y'
              assign month_index = review.date.value | date: '%m' | plus: 0 | minus: 1
              assign review_month = months[month_index]
              assign avatar = review.avatar.value
              assign first_photo = review.photo.value | default: review.photos.value.first
              assign photo_total = review.photos.value.size | default: 0
              if review.photo.value != blank
                assign photo_total = photo_total | plus: 1
              endif
            -%}
            {%- capture author -%}{% render 'review-name', name: review.auteur.value %}{%- endcapture -%}
            {%- liquid
              if author != blank
                assign photo_alt = 'reviews.photo_label' | t: name: author
              else
                assign photo_alt = 'reviews.photo_label_anonymous' | t
              endif
            -%}
            <li
              class="review-card{% if first_photo != blank %} review-card--photo{% elsif request.design_mode %} review-card--slot{% endif %}"
              style="--card-index: {{ position | minus: 1 }};"
              data-loop-card
            >
              <article class="review-card__inner">
                {%- if first_photo != blank -%}
                  <button
                    type="button"
                    class="review-card__media"
                    data-review-photo="0"
                    aria-haspopup="dialog"
                    aria-label="{{ 'reviews.photos_open' | t: count: photo_total }}"
                  >
                    {{ first_photo | image_url: width: 760, height: 480, crop: 'center' | image_tag: width: 380, height: 240, alt: '', loading: 'lazy', class: 'review-card__media-image' }}
                    {%- if photo_total > 1 -%}
                      <span class="review-card__media-count" aria-hidden="true">
                        {%- render 'icon', icon: 'image' -%}
                        {{- photo_total -}}
                      </span>
                    {%- endif -%}
                  </button>
                  <span hidden>
                    {%- if review.photo.value != blank -%}
                      <span
                        data-photo-src="{{ review.photo.value | image_url: width: 1400 }}"
                        data-photo-thumb="{{ review.photo.value | image_url: width: 120, height: 120, crop: 'center' }}"
                        data-photo-alt="{{ photo_alt }}"
                      ></span>
                    {%- endif -%}
                    {%- for extra in review.photos.value -%}
                      <span
                        data-photo-src="{{ extra | image_url: width: 1400 }}"
                        data-photo-thumb="{{ extra | image_url: width: 120, height: 120, crop: 'center' }}"
                        data-photo-alt="{{ photo_alt }}"
                      ></span>
                    {%- endfor -%}
                  </span>
                {%- elsif request.design_mode -%}
                  <div class="review-card__media review-card__media--slot">
                    {%- render 'icon', icon: 'image' -%}
                    <span>{{ 'reviews.photo_slot' | t }}</span>
                  </div>
                {%- endif -%}

                <div class="review-card__head">
                  {% render 'stars', rating: review.note.value.rating, class: 'review-card__stars' %}
                  {%- if review.date.value != blank -%}
                    <time class="review-card__date" datetime="{{ review.date.value | date: '%Y-%m-%d' }}">
                      {{- 'reviews.date' | t: day: review_day, month: review_month, year: review_year -}}
                    </time>
                  {%- endif -%}
                  <span class="review-card__mark" aria-hidden="true">&ldquo;</span>
                </div>
                {%- if review.titre.value != blank -%}
                  <p class="review-card__title">{{ review.titre.value | escape }}</p>
                {%- endif -%}
                <blockquote class="review-card__quote">
                  <p data-review-text>{{ review.texte.value | escape | newline_to_br }}</p>
                </blockquote>
                <button type="button" class="review-card__more" aria-haspopup="dialog" data-review-more hidden>
                  {{- 'reviews.read_more' | t -}}
                </button>

                {%- if author != blank or review.coloris.value != blank or avatar != blank -%}
                  <div class="review-card__author">
                    <span class="review-card__avatar" aria-hidden="true">
                      {%- if avatar != blank -%}
                        {{ avatar | image_url: width: 120, height: 120, crop: 'center' | image_tag: width: 44, height: 44, alt: '', loading: 'lazy' }}
                      {%- elsif author != blank -%}
                        {{- author | slice: 0 | upcase | escape -}}
                      {%- else -%}
                        {% render 'icon', icon: 'user' %}
                      {%- endif -%}
                    </span>
                    <span class="review-card__who">
                      {%- if author != blank -%}
                        <strong>{{ author | escape }}</strong>
                      {%- endif -%}
                      {%- if review.achat_verifie.value and review.source.value == blank -%}
                        <span class="review-card__verified">
                          {%- render 'icon', icon: 'check' -%}
                          {{- 'reviews.verified' | t -}}
                        </span>
                      {%- endif -%}
                      {%- if review.coloris.value != blank -%}
                        <span>{{ 'reviews.color' | t: color: review.coloris.value | escape }}</span>
                      {%- endif -%}
                    </span>
                  </div>
                {%- endif -%}
              </article>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <dialog class="reviews-reader" aria-label="{{ 'reviews.reader_label' | t }}" data-loop-dialog>
        <button
          type="button"
          class="icon-button reviews-reader__close"
          aria-label="{{ 'general.close' | t }}"
          data-loop-dialog-close
        >
          {%- render 'icon', icon: 'close' -%}
        </button>
        <div class="reviews-reader__layout">
          <div class="reviews-reader__media" data-reader-media hidden>
            <div class="reviews-reader__frame">
              <img class="reviews-reader__image" src="data:," alt="" width="1200" height="1200" data-reader-image>
            </div>
            <div class="reviews-reader__thumbs" data-reader-thumbs></div>
          </div>
          <div class="reviews-reader__body" data-reader-body></div>
        </div>
      </dialog>
    </reviews-loop>
  {%- endpaginate -%}
{%- endif -%}

{% stylesheet %}
  /*
    A row of cards wider than the screen, faded at both ends. With motion it
    glides left in an endless loop (the cards are repeated by the script);
    without, it is a row the visitor scrolls.
  */
  .reviews-loop {
    --loop-gap: var(--space-sm);
    --loop-fade: clamp(1.25rem, 7vw, 7rem);
    --loop-ease: cubic-bezier(0.22, 1, 0.36, 1);

    display: block;

    @media screen and (min-width: 750px) {
      --loop-gap: var(--space-md);
    }
  }

  .reviews-loop__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--loop-fade);
    scrollbar-width: none;
    outline-offset: -3px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--loop-fade), #000 calc(100% - var(--loop-fade)), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 var(--loop-fade), #000 calc(100% - var(--loop-fade)), transparent);

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .reviews-loop.is-moving .reviews-loop__viewport {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
  }

  /* Two classes: wins over the reset of lists with role="list" */
  .reviews-loop .reviews-loop__track {
    display: flex;
    align-items: stretch;
    gap: var(--loop-gap);
    width: max-content;
    margin: 0;
    padding: var(--space-sm) var(--loop-fade) var(--space-xl);
    list-style: none;
  }

  .reviews-loop.is-moving .reviews-loop__track {
    padding-inline: 0;
    will-change: transform;
  }

  .review-card {
    display: flex;
    flex: none;
    width: min(80vw, 23.5rem);
    scroll-snap-align: start;

    @media screen and (min-width: 990px) {
      width: 25.5rem;
    }
  }

  /* Card: a soft white page with a rose glow, the words, then who wrote them */
  .review-card__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
    margin: 0;
    padding: var(--space-md);
    border: 1px solid rgb(var(--rose-strong-rgb) / 0.18);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    background-image: radial-gradient(120% 70% at 100% 0%, rgb(var(--rose-strong-rgb) / 0.08), transparent 62%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.8),
      0 28px 52px -40px rgb(73 53 47 / 0.6);
    transition:
      transform 0.6s var(--loop-ease),
      box-shadow 0.6s var(--loop-ease),
      border-color 0.6s var(--loop-ease);

    @media screen and (min-width: 750px) {
      padding: var(--space-md) var(--space-lg) var(--space-md);
    }
  }

  /* The photo place: the review's photo, or (theme editor only) an empty frame */
  .review-card__media {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    aspect-ratio: 19 / 12;
    border: 0;
    border-radius: calc(var(--radius-lg) - 0.5rem);
    background-color: #f6ecec;
    cursor: zoom-in;
  }

  .review-card__media-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--loop-ease);
  }

  .review-card__media-count {
    position: absolute;
    inset-block-end: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: var(--font-body-weight-medium);
    color: var(--color-text);
    background-color: rgb(255 255 255 / 0.92);
    box-shadow: 0 6px 16px -10px rgb(43 37 35 / 0.6);

    & .icon {
      --icon-size: 0.85rem;
    }
  }

  .review-card__media--slot {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    border: 1.5px dashed rgb(var(--rose-strong-rgb) / 0.45);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
    color: var(--color-text-muted);
    background-color: rgb(var(--rose-strong-rgb) / 0.05);
    cursor: default;

    & .icon {
      --icon-size: 1.5rem;
      color: var(--rose-text);
    }
  }

  .review-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    padding-block-start: var(--space-2xs);
  }

  .review-card__stars {
    --stars-size: 1rem;
  }

  .review-card__date {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .review-card__mark {
    margin-inline-start: auto;
    height: 1.75rem;
    font-family: var(--font-heading-family);
    font-size: 4rem;
    line-height: 0.95;
    color: rgb(var(--rose-strong-rgb) / 0.32);
    pointer-events: none;
  }

  .review-card__title {
    margin: 0;
    font-weight: var(--font-body-weight-medium);
  }

  .review-card__quote {
    flex: 1 1 auto;
    margin: 0;

    & p {
      display: -webkit-box;
      overflow: hidden;
      margin: 0;
      font-size: 1rem;
      line-height: 1.65;
      color: var(--color-text);
      text-wrap: pretty;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 7;
      line-clamp: 7;
    }
  }

  /* With a photo (or its empty place), fewer lines keep the cards the same height */
  .review-card--photo .review-card__quote p,
  .review-card--slot .review-card__quote p {
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  /* "Lire la suite": a text link with a 44px tall hit area */
  .review-card__more {
    align-self: flex-start;
    min-height: 2.75rem;
    margin-block: calc(var(--space-sm) * -1) calc(var(--space-2xs) * -1);
    padding: 0;
    border: 0;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: rgb(var(--rose-strong-rgb) / 0.6);
    text-underline-offset: 0.25em;
    background: none;
    cursor: pointer;

    &[hidden] {
      display: none;
    }
  }

  .review-card__author {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid rgb(var(--rose-strong-rgb) / 0.16);
  }

  .review-card__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    border-radius: 50%;
    font-family: var(--font-heading-family);
    font-size: 1.125rem;
    color: var(--color-text);
    background: linear-gradient(145deg, #fbeef0, #efd2d8);
    box-shadow:
      0 0 0 2px var(--color-surface),
      0 0 0 3px rgb(var(--rose-strong-rgb) / 0.35);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    & .icon {
      --icon-size: 1.1rem;
      color: rgb(var(--warm-rgb) / 0.85);
    }
  }

  .review-card__who {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);

    & strong {
      font-size: var(--text-sm);
      font-weight: var(--font-body-weight-medium);
      color: var(--color-text);
    }
  }

  .review-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-success);

    & .icon {
      --icon-size: 0.8rem;
      stroke-width: 2.5;
    }
  }

  /* The whole review in a window: its photos on one side, its words on the other */
  .reviews-reader {
    width: min(92vw, 34rem);
    max-height: 90dvh;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 0;
    border-radius: var(--radius-lg);
    color: var(--color-text);
    background-color: var(--color-surface);
    box-shadow: 0 40px 90px -30px rgb(43 37 35 / 0.6);

    &.has-media {
      width: min(92vw, 60rem);
    }

    &::backdrop {
      background-color: rgb(43 37 35 / 0.55);
      backdrop-filter: blur(5px);
    }

    &[open] {
      animation: reviews-reader-in 0.45s var(--loop-ease);
    }
  }

  @keyframes reviews-reader-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.98);
    }
  }

  .reviews-reader__layout {
    display: grid;

    .reviews-reader.has-media & {
      @media screen and (min-width: 750px) {
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      }
    }
  }

  .reviews-reader__media {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    background-color: #f6ecec;

    &[hidden] {
      display: none;
    }
  }

  .reviews-reader__frame {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: calc(var(--radius-lg) - 0.5rem);
    background-color: #efe2e2;
  }

  .reviews-reader__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .reviews-reader__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);

    &[hidden] {
      display: none;
    }
  }

  .reviews-reader__thumb {
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    box-shadow: inset 0 0 0 1px rgb(var(--rose-strong-rgb) / 0.25);
    opacity: 0.7;
    cursor: pointer;
    transition: opacity 0.3s ease, box-shadow 0.3s ease;

    & img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &[aria-current='true'] {
      opacity: 1;
      box-shadow: 0 0 0 2px var(--color-text);
    }
  }

  .reviews-reader__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-xl) var(--space-lg) var(--space-lg);

    & .review-card__quote p {
      display: block;
      font-size: 1.0625rem;
      line-height: 1.7;
      -webkit-line-clamp: unset;
      line-clamp: none;
    }

    & .review-card__mark {
      display: none;
    }

    & .review-card__author {
      margin-block-start: auto;
    }
  }

  .reviews-reader__close {
    position: absolute;
    inset-block-start: var(--space-xs);
    inset-inline-end: var(--space-xs);
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-text);
    background-color: rgb(255 255 255 / 0.92);
    box-shadow: 0 6px 18px -8px rgb(43 37 35 / 0.5);
  }

  @media (hover: hover) {
    .review-card:hover .review-card__inner {
      border-color: rgb(var(--rose-strong-rgb) / 0.32);
      transform: translateY(-0.35rem);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.8),
        0 38px 66px -38px rgb(73 53 47 / 0.72);
    }

    .review-card__media:hover .review-card__media-image {
      transform: scale(1.05);
    }
  }

  /*
    While the band glides, the review in the middle is the one you read: full
    size and colour; the ones on the sides step back a little (--focus, 0 to 1,
    set by the script).
  */
  .reviews-loop.is-moving .review-card__inner {
    scale: calc(0.95 + 0.05 * var(--focus, 1));
    opacity: calc(0.6 + 0.4 * var(--focus, 1));
  }

  /* Entrance: the cards rise one after the other when the band comes into view */
  .js [data-reveal-enabled] .reviews-loop .review-card {
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 0.7s var(--loop-ease),
      transform 0.7s var(--loop-ease);
    transition-delay: calc(min(var(--card-index, 0), 4) * 90ms);
  }

  .js [data-reveal-enabled] .reviews-loop.is-in .review-card {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .review-card:hover .review-card__inner,
    .review-card__media:hover .review-card__media-image {
      transform: none;
    }

    .reviews-reader[open] {
      animation: none;
    }
  }
{% endstylesheet %}
