{% doc %}
  The promises under a buy button (delivery, returns, warranty or secure
  payment), from the theme settings "Réassurance", written as one quiet line
  of text, the way a shop assistant would say it. Items whose setting is
  empty are left out.

  @param {string} [class] - Extra CSS classes
  @param {boolean} [hide_payment] - Leave out "Paiement sécurisé" (already shown under the buy buttons)

  @example
  {% render 'reassurance-row' %}
{% enddoc %}
<ul class="reassurance-row{% if class %} {{ class }}{% endif %}" role="list">
  {%- if settings.shipping_info != blank -%}
    <li class="reassurance-row__item">
      {{- settings.shipping_info | escape -}}
      {%- if settings.shipping_delay != blank %}, <span class="reassurance-row__detail">{{ settings.shipping_delay | escape }}</span>{% endif -%}
    </li>
  {%- endif -%}
  {%- if settings.returns_info != blank -%}
    <li class="reassurance-row__item">{{ settings.returns_info | escape }}</li>
  {%- endif -%}
  {%- if hide_payment -%}
    {%- if settings.warranty_info != blank -%}
      <li class="reassurance-row__item">{{ settings.warranty_info | escape }}</li>
    {%- endif -%}
  {%- else -%}
    <li class="reassurance-row__item">{{ 'products.secure_payment' | t }}</li>
  {%- endif -%}
</ul>

{% stylesheet %}
  .reassurance-row {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0.9rem 0 0;
    border-block-start: 1px solid rgb(var(--warm-rgb) / 0.18);
    list-style: none;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text);
  }

  .reassurance-row__item {
    position: relative;
    padding-inline-start: 1rem;

    &::before {
      content: '';
      position: absolute;
      inset-block-start: 0.62em;
      inset-inline-start: 0;
      width: 0.375rem;
      height: 1px;
      background-color: var(--rose-strong);
    }
  }

  .reassurance-row__detail {
    color: var(--color-text-muted);
  }
{% endstylesheet %}
