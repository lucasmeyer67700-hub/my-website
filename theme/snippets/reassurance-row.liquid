{% doc %}
  The promises under a buy button (delivery, returns, warranty or secure
  payment), from the theme settings "Réassurance", written as one quiet line
  of text, the way a shop assistant would say it. Items whose setting is
  empty are left out.

  @param {string} [class] - Extra CSS classes
  @param {boolean} [hide_payment] - Leave out "Paiement sécurisé" (already shown under the buy buttons)
  @param {object} [product] - The product sold: the 30-day guarantee is only for the belt; period pants and
    pads (templates "culotte" and "serviette") follow the hygiene rule. Return costs are always stated.

  @example
  {% render 'reassurance-row' %}
{% enddoc %}
<ul class="reassurance-row{% if class %} {{ class }}{% endif %}" role="list">
  {%- if settings.shipping_info != blank -%}
    <li class="reassurance-row__item">
      {{- settings.shipping_info | escape -}}
      {%- if settings.shipping_delay != blank %}, <span class="reassurance-row__detail">{{ settings.shipping_delay | escape }}</span>{% endif -%}
    </li>
  {%- endif -%}
  {%- liquid
    assign hygiene = false
    if product.template_suffix == 'culotte' or product.template_suffix == 'serviette'
      assign hygiene = true
    endif
  -%}
  {%- if hygiene -%}
    <li class="reassurance-row__item">
      {%- if settings.returns_page != blank -%}
        <a class="reassurance-row__link" href="{{ settings.returns_page.url }}">{{ 'products.returns_hygiene' | t }}</a>
      {%- else -%}
        {{ 'products.returns_hygiene' | t }}
      {%- endif -%}
      , <span class="reassurance-row__detail">{{ 'products.returns_cost' | t }}</span>
    </li>
  {%- elsif settings.returns_info != blank -%}
    <li class="reassurance-row__item">
      {%- if settings.returns_page != blank -%}
        <a class="reassurance-row__link" href="{{ settings.returns_page.url }}">{{ settings.returns_info | escape }}</a>
      {%- else -%}
        {{ settings.returns_info | escape }}
      {%- endif -%}
      , <span class="reassurance-row__detail">{{ 'products.returns_cost' | t }}</span>
    </li>
  {%- endif -%}
  {%- if hide_payment -%}
    {%- if settings.warranty_info != blank -%}
      <li class="reassurance-row__item">{{ settings.warranty_info | escape }}</li>
    {%- endif -%}
  {%- else -%}
    <li class="reassurance-row__item">{{ 'products.secure_payment' | t }}</li>
  {%- endif -%}
</ul>

{% stylesheet %}
  .reassurance-row {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0.9rem 0 0;
    border-block-start: 1px solid rgb(var(--warm-rgb) / 0.18);
    list-style: none;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text);
  }

  .reassurance-row__item {
    position: relative;
    padding-inline-start: 1rem;

    &::before {
      content: '';
      position: absolute;
      inset-block-start: 0.62em;
      inset-inline-start: 0;
      width: 0.375rem;
      height: 1px;
      background-color: var(--rose-strong);
    }
  }

  .reassurance-row__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgb(var(--rose-strong-rgb) / 0.45);
    text-underline-offset: 0.18em;
  }

  .reassurance-row__detail {
    color: var(--color-text-muted);
  }
{% endstylesheet %}
