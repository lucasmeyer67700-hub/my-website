{% doc %}
  One question of the FAQ page: a card that opens on its answer (followed,
  if asked, by the logos of the enabled payment methods). The card has an id
  built from the block id, so a link such as /pages/faq#q-battery opens it
  directly.

  @param {object} block - A "question" block of the faq-hub section

  @example
  {% render 'faq-item', block: block %}
{% enddoc %}
<details class="faq-item" id="q-{{ block.id }}" data-faq-item {{ block.shopify_attributes }}>
  <summary class="faq-item__summary">
    <h3 class="faq-item__question">{{ block.settings.question | escape }}</h3>
    <span class="faq-item__toggle" aria-hidden="true"></span>
  </summary>
  <div class="faq-item__answer">
    <div class="rte">{{ block.settings.answer }}</div>
    {%- if block.settings.show_payment_icons -%}
      {% render 'payment-icons', class: 'faq-item__payments' %}
    {%- endif -%}
  </div>
</details>
