{% doc %}
  Decorative pink drops for a section background. The parent element needs
  the `has-drops` class. Animated drops fall slowly and come with a pause
  button. They stay still when the visitor prefers reduced motion.

  @param {boolean} [animated] - Drops fall continuously (with a pause button)
  @param {string} [density] - 'light' (5 drops) or 'regular' (10 drops)

  @example
  {% render 'drops', animated: true %}
{% enddoc %}
{%- liquid
  comment
    x: horizontal position, size, o: opacity, rest: resting height (still
    drops), duration and delay (negative delays spread the drops on load).
  endcomment
  assign presets = '5,28,0.9,22,14,-2|18,16,0.75,64,12,-7|33,38,0.85,38,17,-11|46,14,0.7,12,11,-4|58,26,0.85,74,15,-9|71,18,0.8,30,13,-1|84,34,0.9,56,18,-6|93,15,0.7,84,12,-3|26,22,0.75,88,14,-12|65,30,0.8,8,16,-5' | split: '|'
  assign limit = 10
  if density == 'light'
    assign limit = 5
  endif
-%}
<drops-layer class="drops{% if animated %} drops--animated{% endif %}">
  <div class="drops__field" aria-hidden="true">
    {%- for preset in presets limit: limit -%}
      {%- assign values = preset | split: ',' -%}
      <span
        class="drops__drop{% if forloop.index == 3 or forloop.index == 7 %} drops__drop--gold{% endif %}"
        style="--x: {{ values[0] }}%; --size: {{ values[1] }}px; --o: {{ values[2] }}; --rest: {{ values[3] }}%; --duration: {{ values[4] }}s; --delay: {{ values[5] }}s;"
      ></span>
    {%- endfor -%}
  </div>
  {%- if animated -%}
    <button
      type="button"
      class="icon-button drops__toggle"
      data-drops-toggle
      aria-pressed="false"
      aria-label="{{ 'sections.drops_pause' | t }}"
      hidden
    >
      <span class="drops__toggle-icon drops__toggle-icon--pause">{% render 'icon', icon: 'pause' %}</span>
      <span class="drops__toggle-icon drops__toggle-icon--play">{% render 'icon', icon: 'play' %}</span>
    </button>
  {%- endif -%}
</drops-layer>
