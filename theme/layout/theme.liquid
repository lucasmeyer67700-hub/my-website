<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#F3DFE2">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- liquid
      assign meta_title = page_title
      if request.page_type == 'index' and page_title == shop.name and settings.seo_home_title != blank
        assign meta_title = settings.seo_home_title
      endif
      assign meta_description = page_description | default: settings.seo_description
    -%}
    <title>
      {{- meta_title -}}
      {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} – {{ 'general.page_number' | t: number: current_page }}{% endif -%}
      {%- unless meta_title contains shop.name %} – {{ shop.name }}{% endunless -%}
    </title>

    {%- if meta_description != blank -%}
      <meta name="description" content="{{ meta_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          adding: {{ 'products.adding' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          productError: {{ 'products.error_generic' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          cartUpdated: {{ 'cart.updated' | t | json }},
          upsellChoose: {{ 'cart.upsell_choose_error' | t | json }},
          upsellAdded: {{ 'cart.upsell_added' | t | json }},
          copied: {{ 'gift_card.copied' | t | json }},
          cookiesSaved: {{ 'cookies.saved' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}

    {%- if request.page_type == 'index' -%}
      {% render 'structured-data-organization' %}
    {%- endif -%}
  </head>

  <body
    class="color-scheme-1 template-{{ request.page_type | handle }}"
    data-buy-now="{{ settings.buy_now_style | default: 'accent' }}"
    {% if settings.buy_now_large %}
      data-buy-now-large
    {% endif %}
    {% if settings.animations_reveal %}
      data-reveal-enabled
    {% endif %}
  >
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and request.page_type != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-live-region></div>
  </body>
</html>
