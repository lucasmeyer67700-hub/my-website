{%- comment -%} Ventes croisées « Complète ton cocon » : ajout au panier en un clic. {%- endcomment -%}
{%- liquid
  if section.settings.products.count > 0
    assign items = section.settings.products
  else
    assign items = collections['tous-nos-produits'].products
  endif
-%}
{%- if items.size > 0 or request.design_mode -%}
  {%- render 'vl-padding' -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <section class="vl-xsell color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="vl-heading vl-heading--center">
        {%- if section.settings.eyebrow != blank %}<p class="vl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
        <h2 class="h1">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank %}<p class="vl-heading__text">{{ section.settings.text | escape }}</p>{% endif -%}
      </div>
      <ul class="vl-xsell__grid" role="list">
        {%- assign shown = 0 -%}
        {%- for p in items -%}
          {%- if p.id == product.id or shown >= section.settings.limit -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          {%- assign xform_id = 'vl-xsell-' | append: section.id | append: '-' | append: p.id -%}
          <li class="vl-pcard">
            <a class="vl-pcard__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 70vw', widths: '350, 500, 700', alt: '' }}
              {%- else -%}
                <span class="vl-pcard__placeholder">{% render 'vl-icon', icon: 'heart' %}</span>
              {%- endif -%}
              {%- if p.metafields.velea.badge != blank %}<span class="vl-pcard__badge">{{ p.metafields.velea.badge | escape }}</span>{% endif -%}
            </a>
            <div class="vl-pcard__body">
              <h3 class="vl-pcard__title"><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
              {%- assign first_benefit = p.metafields.velea.benefices.value | first -%}
              {%- if first_benefit != blank %}<p class="vl-pcard__text">{{ first_benefit | escape }}</p>{% endif -%}
              <p class="vl-pcard__price">
                {%- if p.price_varies %}Dès {% endif -%}{{ p.price | money }}
                {%- if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif -%}
              </p>
              {%- if section.settings.quick_add and v.available -%}
                <product-form class="product-form" data-section-id="{{ section.id }}">
                  {%- form 'product', p, id: xform_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ v.id }}">
                    <div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
                    <button type="submit" name="add" class="product-form__submit button button--secondary button--full-width">
                      <span>{{ section.settings.button_label | escape }}</span>
                      {%- render 'loading-spinner' -%}
                    </button>
                  {%- endform -%}
                </product-form>
              {%- else -%}
                <a class="button button--secondary button--full-width" href="{{ p.url }}">Découvrir</a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Ventes croisées",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Petit titre", "default": "Pour aller plus loin" },
    { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Complète ton <em>cocon</em>" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "product_list", "id": "products", "label": "Produits", "limit": 6, "info": "Vide : produits de la collection « Tous nos produits »." },
    { "type": "range", "id": "limit", "label": "Nombre maximum", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "quick_add", "label": "Ajout au panier en un clic", "default": true },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Ajouter au panier" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "VELEA · Ventes croisées" }]
}
{% endschema %}
