<section class="main-page section color-{{ section.settings.color_scheme }}{% if section.settings.compact %} section--compact{% endif %}" aria-labelledby="PageTitle">
  <div class="page-width page-width--text main-page__inner">
    <header class="main-page__header{% if section.settings.center %} main-page__header--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="h1 main-page__title" id="PageTitle">{{ page.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="lead">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>
    {%- if section.settings.show_content and page.content != blank -%}
      <div class="rte main-page__content">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .main-page__inner {
    display: grid;
    gap: var(--space-xl);
  }

  .main-page__header {
    display: grid;
    gap: var(--space-sm);
  }

  .main-page__header--center {
    justify-items: center;
    text-align: center;
  }

  .main-page__title {
    font-size: var(--heading-2);
  }

  .main-page__content {
    font-size: var(--text-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contenu de la page",
  "tag": "div",
  "class": "section-main-page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Afficher le contenu de la page (admin)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Centrer le titre",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Espacement réduit",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
