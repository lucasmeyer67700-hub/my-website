{%- comment -%}
  Customer reviews of the product, from its "Avis clientes" entries
  (custom.avis metaobjects): average, star breakdown, filters, customer
  photos, sorting and the list. Authentic reviews only. Without them, the
  selection of reviews of this model published elsewhere (custom.avis_selection,
  then custom.avis_externes) is shown instead: never marked as verified, with
  "Comment les avis sont-ils sélectionnés ?" under the rating. Without reviews the
  section stays invisible for visitors (a notice shows in the theme editor).
  Review apps can be added as app blocks.
{%- endcomment -%}
{%- liquid
  comment
    custom.avis can hold up to 250 reviews (list.max): one paginate page
    covers them all. Without paginate, Liquid would only loop over 50.
  endcomment
  assign reviews_key = 'avis'
  assign own_count = product.metafields.custom.avis.value.size | default: 0
  if own_count == 0
    assign reviews_key = 'avis_externes'
    if product.metafields.custom.avis_selection.value.size > 0
      assign reviews_key = 'avis_selection'
    endif
  endif
  assign has_reviews = false
  if product.metafields.custom[reviews_key].value.size > 0
    assign has_reviews = true
  endif
  assign has_app_reviews = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app_reviews = true
    endif
  endfor
-%}

{%- if has_reviews -%}
  {%- paginate product.metafields.custom[reviews_key].value by 250 -%}
    {%- liquid
      assign review_count = 0
      assign rating_sum = 0
      assign verified_count = 0
      assign photo_count = 0
      assign c5 = 0
      assign c4 = 0
      assign c3 = 0
      assign c2 = 0
      assign c1 = 0
      assign color_handles = '|'
      assign color_labels = ''
      assign source_name = ''
      for review in product.metafields.custom[reviews_key].value
        assign review_count = review_count | plus: 1
        comment
          A 4.5/5 counts as a 4-star review: a rating is never moved up.
        endcomment
        assign note = review.note.value.rating | floor
        assign rating_sum = rating_sum | plus: review.note.value.rating
        if review.source.value != blank
          if source_name == blank
            assign source_name = review.source.value | strip | escape
          endif
        elsif review.achat_verifie.value
          assign verified_count = verified_count | plus: 1
        endif
        if review.photo.value != blank
          assign photo_count = photo_count | plus: 1
        endif
        case note
          when 5
            assign c5 = c5 | plus: 1
          when 4
            assign c4 = c4 | plus: 1
          when 3
            assign c3 = c3 | plus: 1
          when 2
            assign c2 = c2 | plus: 1
          else
            assign c1 = c1 | plus: 1
        endcase
        assign color = review.coloris.value | strip
        if color != blank
          assign color_handle = color | handle
          assign color_token = '|' | append: color_handle | append: '|'
          unless color_handles contains color_token
            assign color_handles = color_handles | append: color_handle | append: '|'
            assign color_labels = color_labels | append: color | append: '|'
          endunless
        endif
      endfor

      assign average = rating_sum | times: 1.0 | divided_by: review_count
      comment
        Reviews from another site: that site's overall rating and total, when
        filled in on the product (custom.avis_externes_note / _total).
      endcomment
      assign display_count = review_count
      if source_name != blank
        if product.metafields.custom.avis_externes_note.value != blank
          assign average = product.metafields.custom.avis_externes_note.value.rating
        endif
        assign source_total = product.metafields.custom.avis_externes_total.value | default: 0
        if reviews_key == 'avis_selection'
          assign source_total = product.metafields.custom.avis_selection_total.value | default: source_total
        endif
        if source_total > review_count
          assign display_count = source_total
        endif
      endif
      assign average_text_x10 = average | times: 10 | round
      assign average_text_int = average_text_x10 | divided_by: 10 | floor
      assign average_text_dec = average_text_x10 | modulo: 10
      assign average_text = average_text_int | append: ',' | append: average_text_dec
      assign color_handle_list = color_handles | remove_first: '|' | split: '|'
      assign color_label_list = color_labels | split: '|'
      assign keyword_lines = section.settings.keywords | newline_to_br | split: '<br />'
      assign page_size = section.settings.per_page
    -%}

  {%- if section.settings.layout == 'list' -%}
  <section
    class="reviews section color-{{ section.settings.color_scheme }}"
    id="avis"
    aria-labelledby="ReviewsTitle-{{ section.id }}"
  >
    <product-reviews class="page-width reviews__inner" data-page-size="{{ page_size }}">
      <div class="reviews__head">
        <h2 class="reviews__title" id="ReviewsTitle-{{ section.id }}">
          {{- section.settings.heading | escape -}}
          <span class="reviews__sep" aria-hidden="true">|</span>
          <span class="reviews__average">{{ average_text }}</span>
        </h2>
        {% render 'stars', rating: average, class: 'reviews__stars' %}
        <span class="reviews__total">
          {%- if source_name != blank -%}
            {{ 'reviews.total' | t: count: display_count }}
          {%- else -%}
            {{ 'reviews.count' | t: count: review_count }}
          {%- endif -%}
        </span>
        {%- if verified_count > 0 -%}
          <span class="reviews__verified">
            {% render 'icon', icon: 'check' %}
            {%- if verified_count == review_count -%}
              {{ 'reviews.all_verified' | t }}
            {%- else -%}
              {{ 'reviews.some_verified' | t: count: verified_count }}
            {%- endif -%}
          </span>
        {%- endif -%}
        {%- if source_name != blank -%}
          {% render 'reviews-about', rating: average_text, count: display_count, class: 'reviews__about-selection' %}
        {%- endif -%}
      </div>

      {%- comment -%} The bars describe the reviews listed here: not shown next to another site's total. {%- endcomment -%}
      {%- if section.settings.show_breakdown and display_count == review_count -%}
        <ul class="reviews__bars" role="list">
          {%- for stars in (1..5) reversed -%}
            {%- liquid
              case stars
                when 5
                  assign star_total = c5
                when 4
                  assign star_total = c4
                when 3
                  assign star_total = c3
                when 2
                  assign star_total = c2
                else
                  assign star_total = c1
              endcase
              assign star_percent = star_total | times: 100.0 | divided_by: review_count | round
            -%}
            <li class="reviews__bar">
              <span class="reviews__bar-label">{{ 'reviews.stars_row' | t: count: stars }}</span>
              <span class="reviews__bar-track" aria-hidden="true">
                <span class="reviews__bar-fill" style="width: {{ star_percent }}%;"></span>
              </span>
              <span class="reviews__bar-value">{{ star_percent }}&nbsp;%</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="reviews__filters" role="group" aria-label="{{ 'reviews.filters_label' | t }}">
        <label class="visually-hidden" for="ReviewsRating-{{ section.id }}">{{ 'reviews.rating_filter' | t }}</label>
        <span class="reviews__select">
          <select id="ReviewsRating-{{ section.id }}" data-reviews-rating>
            <option value="all">{{ 'reviews.all_ratings' | t }}</option>
            {%- for stars in (1..5) reversed -%}
              {%- liquid
                case stars
                  when 5
                    assign star_total = c5
                  when 4
                    assign star_total = c4
                  when 3
                    assign star_total = c3
                  when 2
                    assign star_total = c2
                  else
                    assign star_total = c1
                endcase
              -%}
              {%- if star_total > 0 -%}
                <option value="{{ stars }}">{{ 'reviews.stars_row' | t: count: stars }} ({{ star_total }})</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
          {% render 'icon', icon: 'chevron-down' %}
        </span>
        {%- if photo_count > 0 -%}
          <button type="button" class="reviews__chip" data-reviews-filter="photo" aria-pressed="false">
            {% render 'icon', icon: 'image' %}
            <span>{{ 'reviews.with_photos' | t }} ({{ photo_count }})</span>
          </button>
        {%- endif -%}
        {%- if verified_count > 0 and verified_count < review_count -%}
          <button type="button" class="reviews__chip" data-reviews-filter="verified" aria-pressed="false">
            {% render 'icon', icon: 'check' %}
            <span>{{ 'reviews.verified_filter' | t }} ({{ verified_count }})</span>
          </button>
        {%- endif -%}
        {%- for color_handle in color_handle_list -%}
          {%- liquid
            assign color_label = color_label_list[forloop.index0]
            assign color_total = 0
            for review in product.metafields.custom[reviews_key].value
              assign review_color = review.coloris.value | strip | handle
              if review_color == color_handle
                assign color_total = color_total | plus: 1
              endif
            endfor
          -%}
          <button type="button" class="reviews__chip" data-reviews-filter="color:{{ color_handle }}" aria-pressed="false">
            <span>{{ color_label | escape }} ({{ color_total }})</span>
          </button>
        {%- endfor -%}
        {%- for line in keyword_lines -%}
          {%- liquid
            assign keyword = line | strip | downcase
            assign keyword_total = 0
            if keyword != blank
              for review in product.metafields.custom[reviews_key].value
                assign haystack = review.texte.value | append: ' ' | append: review.titre.value | downcase
                if haystack contains keyword
                  assign keyword_total = keyword_total | plus: 1
                endif
              endfor
            endif
          -%}
          {%- if keyword_total > 0 -%}
            <button type="button" class="reviews__chip reviews__chip--keyword" data-reviews-filter="kw:{{ keyword | escape }}" aria-pressed="false">
              <span>{{ keyword | escape }} ({{ keyword_total }})</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if photo_count > 0 -%}
        <ul class="reviews__photos" role="list">
          {%- assign shown_photos = 0 -%}
          {%- for review in product.metafields.custom[reviews_key].value -%}
            {%- if review.photo.value != blank and shown_photos < 6 -%}
              {%- assign shown_photos = shown_photos | plus: 1 -%}
              <li>
                <button
                  type="button"
                  class="reviews__photo"
                  data-reviews-photo="{{ forloop.index }}"
                >
                  {{ review.photo.value | image_url: width: 480 | image_tag: width: 240, height: 240, alt: '', loading: 'lazy', class: 'reviews__photo-image' }}
                  <span class="reviews__photo-rating">
                    {% render 'icon', icon: 'star' %}
                    {%- liquid
                      assign badge_x10 = review.note.value.rating | times: 10 | round
                      assign badge_int = badge_x10 | divided_by: 10 | floor
                      assign badge_dec = badge_x10 | modulo: 10
                      echo badge_int | append: ',' | append: badge_dec
                    -%}
                  </span>
                  {%- if shown_photos == 6 and photo_count > 6 -%}
                    <span class="reviews__photo-more">{{ 'reviews.see_more_photos' | t }}</span>
                  {%- endif -%}
                  {%- capture photo_author -%}{% render 'review-name', name: review.auteur.value %}{%- endcapture -%}
                  <span class="visually-hidden">
                    {%- if photo_author != blank -%}
                      {{- 'reviews.photo_label' | t: name: photo_author -}}
                    {%- else -%}
                      {{- 'reviews.photo_label_anonymous' | t -}}
                    {%- endif -%}
                  </span>
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="reviews__toolbar">
        <label class="reviews__sort-label" for="ReviewsSort-{{ section.id }}">{{ 'reviews.sort_label' | t }}</label>
        <span class="reviews__select reviews__select--plain">
          <select id="ReviewsSort-{{ section.id }}" data-reviews-sort>
            <option value="recent">{{ 'reviews.sort_recent' | t }}</option>
            <option value="high">{{ 'reviews.sort_high' | t }}</option>
            <option value="low">{{ 'reviews.sort_low' | t }}</option>
            <option value="photo">{{ 'reviews.sort_photo' | t }}</option>
          </select>
          {% render 'icon', icon: 'chevron-down' %}
        </span>
        <p
          class="reviews__status"
          role="status"
          data-reviews-status
          data-template="{{ 'reviews.showing' | t: shown: '[shown]', total: '[total]' }}"
        ></p>
      </div>

      <ul class="reviews__list" role="list" data-reviews-list>
        {%- for review in product.metafields.custom[reviews_key].value -%}
          {%- liquid
            assign review_note = review.note.value.rating
            assign review_color = review.coloris.value | strip
            assign review_text = review.texte.value | append: ' ' | append: review.titre.value | downcase | strip_newlines
          -%}
          {%- capture author -%}{% render 'review-name', name: review.auteur.value %}{%- endcapture -%}
          <li
            class="review"
            data-review
            data-index="{{ forloop.index }}"
            data-rating="{{ review_note | floor }}"
            data-date="{{ review.date.value | date: '%Y%m%d' }}"
            data-photo="{% if review.photo.value != blank %}1{% else %}0{% endif %}"
            data-verified="{% if review.achat_verifie.value and review.source.value == blank %}1{% else %}0{% endif %}"
            data-color="{{ review_color | handle }}"
            data-text="{{ review_text | escape }}"
            {% if forloop.index > page_size %}
              hidden
            {% endif %}
          >
            <span class="review__avatar" aria-hidden="true">
              {%- if review.avatar.value != blank -%}
                {{ review.avatar.value | image_url: width: 120, height: 120, crop: 'center' | image_tag: width: 44, height: 44, alt: '', loading: 'lazy' }}
              {%- elsif author != blank -%}
                {{- author | slice: 0 | upcase | escape -}}
              {%- else -%}
                {% render 'icon', icon: 'user' %}
              {%- endif -%}
            </span>
            <div class="review__body">
              {% render 'stars', rating: review_note, class: 'review__stars' %}
              {%- if review_color != blank -%}
                <p class="review__meta">{{ 'reviews.color' | t: color: review_color }}</p>
              {%- endif -%}
              {%- if review.titre.value != blank -%}
                <p class="review__title">{{ review.titre.value | escape }}</p>
              {%- endif -%}
              <p class="review__text">{{ review.texte.value | escape | newline_to_br }}</p>
              {%- if review.photo.value != blank -%}
                <button type="button" class="review__photo" data-reviews-photo="{{ forloop.index }}">
                  {{ review.photo.value | image_url: width: 240 | image_tag: width: 96, height: 96, alt: '', loading: 'lazy' }}
                  <span class="visually-hidden">
                    {%- if author != blank -%}
                      {{- 'reviews.photo_label' | t: name: author -}}
                    {%- else -%}
                      {{- 'reviews.photo_label_anonymous' | t -}}
                    {%- endif -%}
                  </span>
                </button>
              {%- endif -%}
              <p class="review__footer">
                {%- if author != blank -%}
                  <span class="review__author">{{ author | escape }}</span>
                {%- endif -%}
                {%- if review.achat_verifie.value and review.source.value == blank -%}
                  <span class="review__verified">{% render 'icon', icon: 'check' %}{{ 'reviews.verified' | t }}</span>
                {%- endif -%}
                {%- if author != blank -%}
                  <span class="review__sep" aria-hidden="true">|</span>
                {%- endif -%}
                <time datetime="{{ review.date.value | date: '%Y-%m-%d' }}">{{ review.date.value | date: '%d/%m/%Y' }}</time>
              </p>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <p class="reviews__empty" data-reviews-empty hidden>
        {{ 'reviews.none_match' | t }}
        <button type="button" class="text-button" data-reviews-reset>{{ 'reviews.reset' | t }}</button>
      </p>

      <button
        type="button"
        class="button button--secondary reviews__more"
        data-reviews-more
        {% if review_count <= page_size %}
          hidden
        {% endif %}
      >
        {{ 'reviews.more' | t }}
      </button>

      {%- if source_name == blank and section.settings.about != blank -%}
        <details class="reviews__about">
          <summary>{% render 'icon', icon: 'info' %}<span>{{ 'reviews.about_title' | t }}</span></summary>
          <div class="rte">{{ section.settings.about }}</div>
        </details>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="reviews__app">{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      <dialog class="reviews__lightbox" data-reviews-lightbox aria-label="{{ 'reviews.lightbox_label' | t }}">
        <button type="button" class="icon-button reviews__lightbox-close" data-reviews-lightbox-close>
          {% render 'icon', icon: 'close' %}
          <span class="visually-hidden">{{ 'general.close' | t }}</span>
        </button>
        <div class="reviews__lightbox-content" data-reviews-lightbox-content></div>
      </dialog>

      {%- comment -%} Large photos for the lightbox, loaded only when opened. {%- endcomment -%}
      <template data-reviews-photos>
        {%- for review in product.metafields.custom[reviews_key].value -%}
          {%- if review.photo.value != blank -%}
            {%- capture photo_author -%}{% render 'review-name', name: review.auteur.value %}{%- endcapture -%}
            {%- if photo_author != blank -%}
              {%- assign photo_alt = 'reviews.photo_label' | t: name: photo_author -%}
            {%- else -%}
              {%- assign photo_alt = 'reviews.photo_label_anonymous' | t -%}
            {%- endif -%}
            <img
              data-for="{{ forloop.index }}"
              src="{{ review.photo.value | image_url: width: 1400 }}"
              alt="{{ photo_alt }}"
              width="1400"
              height="1400"
            >
          {%- endif -%}
        {%- endfor -%}
      </template>
    </product-reviews>
  </section>
  {%- endif -%}
  {%- endpaginate -%}

  {%- comment -%}
    Showcase layout: the overall rating, then the reviews moving on their own
    (snippet "reviews-band", outside the paginate block above).
  {%- endcomment -%}
  {%- if section.settings.layout != 'list' -%}
    <section
      class="reviews reviews--carousel section color-{{ section.settings.color_scheme }}"
      id="avis"
      aria-labelledby="ReviewsTitle-{{ section.id }}"
    >
      <div class="page-width reviews__showcase reveal">
        {%- if section.settings.heading != blank -%}
          <h2 class="reviews__showcase-title" id="ReviewsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="reviews__score">
          <span class="reviews__score-value">{{ average_text }}</span>
          <span class="reviews__score-meta">
            {% render 'stars', rating: average, class: 'reviews__score-stars' %}
            <span class="reviews__score-count">
              {%- if source_name != blank -%}
                {{ 'reviews.total' | t: count: display_count }}
              {%- else -%}
                {{ 'reviews.count' | t: count: review_count }}
              {%- endif -%}
            </span>
          </span>
        </div>
        {%- if source_name != blank -%}
          {% render 'reviews-about', rating: average_text, count: display_count, class: 'reviews__about-selection' %}
        {%- elsif verified_count > 0 -%}
          <p class="reviews__verified">
            {% render 'icon', icon: 'check' %}
            {%- if verified_count == review_count -%}
              {{ 'reviews.all_verified' | t }}
            {%- else -%}
              {{ 'reviews.some_verified' | t: count: verified_count }}
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>

      {% render 'reviews-band', product: product, limit: section.settings.band_limit, speed: section.settings.band_speed %}

      <div class="page-width reviews__foot">
        {%- if source_name == blank and section.settings.about != blank -%}
          <details class="reviews__about">
            <summary>{% render 'icon', icon: 'info' %}<span>{{ 'reviews.about_title' | t }}</span></summary>
            <div class="rte">{{ section.settings.about }}</div>
          </details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="reviews__app">{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
{%- elsif has_app_reviews or product.metafields.reviews.rating_count.value > 0 -%}
  {%- comment -%} Reviews from an app: its block, and how reviews are collected. {%- endcomment -%}
  <section class="reviews section color-{{ section.settings.color_scheme }}" id="avis" aria-labelledby="ReviewsTitle-{{ section.id }}">
    <div class="page-width reviews__inner">
      <h2 class="reviews__title" id="ReviewsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="reviews__app">{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.about != blank -%}
        <details class="reviews__about">
          <summary>{% render 'icon', icon: 'info' %}<span>{{ 'reviews.about_title' | t }}</span></summary>
          <div class="rte">{{ section.settings.about }}</div>
        </details>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width section section--compact">
    <p class="form-message">{% render 'icon', icon: 'info' %}{{ 'reviews.editor_empty' | t }}</p>
  </div>
{%- endif -%}

{% stylesheet %}
  .reviews__inner {
    display: grid;
    gap: var(--space-md);
  }

  .reviews__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
  }

  /* Showcase layout: centred score, moving reviews, notes underneath */
  .reviews--carousel {
    overflow: hidden;
  }

  .reviews__showcase {
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    margin-block-end: var(--space-lg);
    text-align: center;
  }

  .reviews__showcase-title {
    font-size: var(--heading-2);
  }

  .reviews__score {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .reviews__score-value {
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 2.4rem + 2.4vw, 4.25rem);
    line-height: 1;
    color: var(--color-text);
  }

  .reviews__score-meta {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    text-align: start;
  }

  .reviews__score-stars {
    --stars-size: 1.15rem;
  }

  .reviews__score-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .reviews__about-selection {
    margin-block-start: var(--space-2xs);

    .reviews__head & {
      flex-basis: 100%;
    }
  }

  /* The overall stars fill from left to right as the score comes into view */
  .js [data-reveal-enabled] .reviews__showcase .reviews__score-stars::before {
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
  }

  .js [data-reveal-enabled] .reviews__showcase.is-visible .reviews__score-stars::before {
    transform: none;
  }

  .reviews__foot {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
  }

  .reviews__title {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--heading-3);
    line-height: 1.1;
  }

  .reviews__sep {
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .reviews__average {
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight-bold);
  }

  .reviews__stars {
    --stars-size: 1.35rem;
  }

  .reviews__total {
    font-size: var(--text-sm);
  }

  .reviews__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
    color: var(--color-success);

    & .icon {
      --icon-size: 1rem;
      stroke-width: 2.5;
    }
  }

  /* Star breakdown, in boxes */
  .reviews__bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reviews__bar {
    display: grid;
    grid-template-columns: auto minmax(3rem, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-xs);
    font-size: var(--text-sm);
    background-color: #f6f3f2;
  }

  .reviews__bar-track {
    height: 0.4rem;
    overflow: hidden;
    border-radius: var(--radius-round);
    background-color: rgb(var(--color-text-rgb) / 0.1);
  }

  .reviews__bar-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background-color: var(--color-text);
  }

  .reviews__bar-value {
    font-variant-numeric: tabular-nums;
  }

  /* Filters */
  .reviews__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .reviews__select {
    position: relative;
    display: inline-flex;
    align-items: center;

    & select {
      min-height: 2.75rem;
      padding: 0 2.25rem 0 var(--space-sm);
      border: 0;
      border-radius: var(--radius-xs);
      font: inherit;
      font-size: var(--text-sm);
      font-weight: var(--font-body-weight-medium);
      color: var(--color-text);
      background-color: #f6f3f2;
      appearance: none;
      cursor: pointer;
    }

    & .icon {
      position: absolute;
      inset-inline-end: 0.75rem;
      --icon-size: 0.85rem;
      pointer-events: none;
    }
  }

  .reviews__select--plain select {
    min-height: 2.25rem;
    padding-inline-start: 0;
    background: none;
    color: var(--rose-text);
  }

  .reviews__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 var(--space-sm);
    border: 1px solid transparent;
    border-radius: var(--radius-xs);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-text);
    background-color: #f6f3f2;
    cursor: pointer;
    transition: background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;

    & .icon {
      --icon-size: 1rem;
    }

    &:hover {
      border-color: rgb(var(--color-text-rgb) / 0.2);
    }

    &[aria-pressed='true'] {
      border-color: var(--rose-strong);
      color: var(--rose-text);
      background-color: var(--rose-soft);
    }
  }

  .reviews__chip--keyword {
    background-color: #fdf3e7;
  }

  /* Customer photos */
  .reviews__photos {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (max-width: 749px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .reviews__photo {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: var(--radius-xs);
    background-color: var(--gallery-bg);
    cursor: zoom-in;
  }

  .reviews__photo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-out);

    .reviews__photo:hover & {
      transform: scale(1.04);
    }
  }

  .reviews__photo-rating {
    position: absolute;
    inset-block-end: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-bold);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-xs);
    color: #fff;
    background-color: rgb(30 24 22 / 0.72);

    & .icon {
      --icon-size: 0.95rem;
      color: #f5c04a;
    }
  }

  .reviews__photo-more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: var(--text-lg);
    color: #fff;
    background-color: rgb(48 39 36 / 0.55);
  }

  /* Sort + count */
  .reviews__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    font-size: var(--text-sm);
  }

  .reviews__status {
    margin-inline-start: auto;
    color: var(--color-text-muted);
  }

  /* Review list */
  .reviews__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .review {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--color-border);

    &[hidden] {
      display: none;
    }
  }

  .review__avatar {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    border-radius: 50%;
    font-weight: var(--font-body-weight-medium);
    color: var(--rose-text);
    background-color: var(--rose-soft);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    & .icon {
      --icon-size: 1.1rem;
    }
  }

  .review__body {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }

  .review__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review__title {
    font-weight: var(--font-body-weight-bold);
  }

  .review__text {
    max-width: 75ch;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .review__photo {
    width: 6rem;
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: var(--radius-xs);
    cursor: zoom-in;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .review__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review__author {
    font-weight: var(--font-body-weight-medium);
    color: var(--color-text);
  }

  .review__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--color-success);

    & .icon {
      --icon-size: 0.85rem;
      stroke-width: 2.5;
    }
  }

  .reviews__empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text-muted);

    &[hidden] {
      display: none;
    }
  }

  .reviews__more {
    justify-self: center;

    &[hidden] {
      display: none;
    }
  }

  .reviews__about {
    font-size: var(--text-sm);
    color: var(--color-text-muted);

    & summary {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      min-height: var(--tap-target);
      cursor: pointer;
    }

    & .icon {
      --icon-size: 1rem;
    }

    & .rte {
      max-width: 75ch;
      padding-block-end: var(--space-sm);
    }
  }

  .reviews__lightbox {
    width: min(100% - 2rem, 46rem);
    max-height: min(100dvh - 2rem, 52rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background-color: var(--palette-warm-white);

    &::backdrop {
      background-color: rgb(48 39 36 / 0.6);
    }
  }

  .reviews__lightbox-close {
    position: absolute;
    inset-block-start: var(--space-xs);
    inset-inline-end: var(--space-xs);
    z-index: 1;
    background-color: var(--palette-warm-white);
    box-shadow: var(--shadow-sm);
  }

  .reviews__lightbox-content {
    display: grid;

    & > img {
      width: 100%;
      height: auto;
      max-height: 70dvh;
      object-fit: contain;
      background-color: var(--gallery-bg);
    }

    & .review {
      padding: var(--space-md);
      border: 0;
    }

    & .review__photo {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avis clientes (produit)",
  "tag": "div",
  "class": "section-product-reviews",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Les avis viennent du champ méta « Avis clientes » du produit. Sans avis de vos clientes, la sélection d'avis de ce modèle (champ « Avis — sélection affichée ») s'affiche, avec « Comment les avis sont-ils sélectionnés ? » sous la note. Sans avis, la section reste invisible."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Avis"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Présentation",
      "options": [
        { "value": "carousel", "label": "Note + carrousel d'avis" },
        { "value": "list", "label": "Liste avec filtres et tri" }
      ],
      "default": "carousel"
    },
    {
      "type": "paragraph",
      "content": "Modifier un avis, son prénom ou ses photos : Contenu > Métaobjets > Avis client. Choisir les avis affichés et leur ordre : Produits > votre produit > Métachamps > Avis affichés sur le site."
    },
    {
      "type": "range",
      "id": "band_limit",
      "label": "Nombre d'avis du carrousel",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "band_speed",
      "label": "Vitesse du défilement (secondes par avis)",
      "info": "Les avis défilent sans arrêt, en boucle. Plus le nombre est petit, plus ça va vite.",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Afficher la répartition des notes",
      "default": true
    },
    {
      "type": "textarea",
      "id": "keywords",
      "label": "Mots-clés à proposer en filtre",
      "info": "Un mot par ligne. Seuls les mots présents dans les avis s'affichent, avec leur nombre.",
      "default": "chaleur\nconfort\nbatterie\nlivraison"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Avis affichés avant « Voir plus »",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "richtext",
      "id": "about",
      "label": "Comment les avis sont-ils collectés ?",
      "info": "Information obligatoire (article L111-7-2 du Code de la consommation). Décrivez votre vraie méthode.",
      "default": "<p>Les avis sont publiés par des clientes VELEA, avec leur accord. La mention « Évaluation vérifiée » signifie que nous avons retrouvé la commande correspondante sur notre boutique. Les avis ne font l'objet d'aucune contrepartie. Par défaut, ils sont classés du plus récent au plus ancien.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Avis clientes (produit)" }]
}
{% endschema %}
