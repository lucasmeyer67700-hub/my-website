{%- comment -%}
  A slim band that speaks to the visitor before selling: a small label, a
  large title (its second part in italics), a few lines that name the
  moment, a ruled sub-title with one sentence, a button; a photo beside it
  on an offset coloured block, with a hand-drawn heart. Everything enters
  in turn as the band comes into view.
{%- endcomment -%}
{%- liquid
  assign link = section.settings.button_link
  if link == blank and section.settings.product != blank
    assign link = section.settings.product.url
  endif
  assign image = section.settings.image
  if image == blank and section.settings.product != blank
    assign image = section.settings.product.featured_media.preview_image
  endif
-%}
<section
  class="empathy-band section{% if section.settings.image_side == 'left' %} empathy-band--image-left{% endif %}"
  style="--empathy-accent: {{ section.settings.accent }};"
  {% if section.settings.heading != blank %}
    aria-labelledby="EmpathyTitle-{{ section.id }}"
  {% endif %}
>
  <div class="empathy-band__grid page-width">
    <div class="empathy-band__copy reveal">
      {%- if section.settings.show_heart -%}
        <svg class="empathy-band__heart" viewBox="0 0 120 110" aria-hidden="true" focusable="false">
          <path pathLength="1" d="M61 101C40 84 14 64 10 39 7 20 21 7 36 9c12 2 20 12 24 24 4-13 13-25 27-26 17-1 28 15 24 33-5 25-30 45-50 61Z" />
        </svg>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="empathy-band__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2 empathy-band__title" id="EmpathyTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="empathy-band__text" style="--i: 1;">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.subheading != blank or section.settings.subtext != blank -%}
        <span class="empathy-band__rule" aria-hidden="true"></span>
        {%- if section.settings.subheading != blank -%}
          <h3 class="empathy-band__subtitle" style="--i: 2;">{{ section.settings.subheading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="empathy-band__subtext" style="--i: 3;">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.button_label != blank and link != blank -%}
        <a class="empathy-band__button" href="{{ link }}" style="--i: 4;">
          <span>{{ section.settings.button_label | escape }}</span>
          <span class="empathy-band__arrow" aria-hidden="true">{% render 'icon', icon: 'arrow-right' %}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="empathy-band__visual reveal">
      <span class="empathy-band__block" aria-hidden="true"></span>
      <div class="empathy-band__frame" data-parallax="4">
        {%- if image != blank -%}
          {% render 'responsive-image',
            image: image,
            sizes: '(min-width: 990px) 34vw, 90vw',
            widths: '400, 600, 800, 1000, 1200',
            alt: image.alt,
            class: 'empathy-band__image'
          %}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg empathy-band__image' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .empathy-band {
    --empathy-accent: #6b3a4d;
    overflow: hidden;
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
    background-color: var(--color-surface, #fbf7f6);
  }

  .empathy-band__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 6vw, 6.5rem);
    }
  }

  .empathy-band--image-left .empathy-band__grid {
    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);

      & .empathy-band__visual {
        order: -1;
      }
    }
  }

  .empathy-band__copy {
    position: relative;
    max-width: 38rem;
  }

  .empathy-band__heart {
    position: absolute;
    inset-block-start: -0.75rem;
    inset-inline-end: 0;
    width: clamp(3.25rem, 2.5rem + 2.5vw, 5rem);
    height: auto;
    overflow: visible;
    rotate: 12deg;

    & path {
      fill: none;
      stroke: var(--empathy-accent);
      stroke-width: 3.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }

  .empathy-band__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--empathy-accent);
  }

  .empathy-band__title {
    max-width: 17ch;
    margin: 0;
    font-size: calc(clamp(2.2rem, 1.5rem + 2.6vw, 3.75rem) * var(--font-heading-scale, 1));
    line-height: 1.02;
    letter-spacing: -0.02em;

    & em {
      display: block;
      font-style: italic;
      color: var(--empathy-accent);
    }
  }

  .empathy-band__text {
    margin-block-start: clamp(1.25rem, 2.5vw, 2rem);
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-text);

    & p {
      margin: 0;
    }

    & p + p {
      margin-block-start: 0.5rem;
    }
  }

  .empathy-band__rule {
    display: block;
    height: 1px;
    margin-block: clamp(1.5rem, 3vw, 2.25rem);
    background-color: rgb(var(--color-text-rgb) / 0.18);
    transform-origin: left center;
  }

  .empathy-band__subtitle {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
    line-height: 1.2;
  }

  .empathy-band__subtext {
    margin: 0.6rem 0 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .empathy-band__button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: clamp(1.5rem, 3vw, 2rem);
    padding: 1rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-button-label, #fff);
    background-color: var(--color-button, #2b2422);
    transition:
      background-color var(--duration-fast, 0.2s) ease,
      translate 0.3s ease;

    &:hover {
      background-color: var(--empathy-accent);
    }

    &:focus-visible {
      outline: 2px solid var(--empathy-accent);
      outline-offset: 3px;
    }

    & .icon {
      width: 1rem;
      height: 1rem;
    }
  }

  .empathy-band__arrow {
    display: inline-flex;
    transition: translate 0.35s var(--ease-power3-out, ease);
  }

  .empathy-band__button:hover .empathy-band__arrow {
    translate: 0.3rem 0;
  }

  /* The photo on an offset coloured block */
  .empathy-band__visual {
    position: relative;
    width: min(100%, 23rem);
    justify-self: center;
    margin-inline-end: 1.25rem;
    margin-block-end: 1.25rem;
  }

  .empathy-band__block {
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    background-color: var(--empathy-accent);
  }

  .empathy-band__frame {
      aspect-ratio: 5 / 4;
    }
  }

  .empathy-band__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #f2e4e6;

    & .empathy-band__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* Phone: the photo comes first, wider and shorter, so it is seen at once */
  @media screen and (max-width: 989px) {
    .empathy-band__grid {
      gap: 2.75rem;
    }

    .empathy-band__visual {
      order: -1;
      width: calc(100% - 1rem);
      justify-self: start;
      margin-inline-end: 1rem;
      margin-block-end: 0;
    }

    .empathy-band__block {
      inset: 1rem -1rem -1rem 1rem;
    }

    /* Entrance, in turn: heart drawn, title lines rise, lines fade up, rule draws,
     photo opens, block slides into place. */
  @media (prefers-reduced-motion: no-preference) {
    .js [data-reveal-enabled] .empathy-band__copy.reveal,
    .js [data-reveal-enabled] .empathy-band__visual.reveal {
      opacity: 1;
      translate: none;
    }

    .js [data-reveal-enabled] .empathy-band__heart path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    .js [data-reveal-enabled] .is-visible .empathy-band__heart path {
      transition: stroke-dashoffset 1.6s var(--ease-power3-in-out, ease) 0.5s;
      stroke-dashoffset: 0;
    }

    .js [data-reveal-enabled] .is-visible .empathy-band__heart {
      animation: empathy-heart 4s ease-in-out 2.2s infinite;
    }

    .js [data-reveal-enabled] .empathy-band__eyebrow,
    .js [data-reveal-enabled] :is(.empathy-band__text, .empathy-band__subtitle, .empathy-band__subtext, .empathy-band__button) {
      opacity: 0;
      translate: 0 1.25rem;
      transition:
        opacity 0.9s var(--ease-power3-out, ease),
        translate 0.9s var(--ease-power3-out, ease),
        background-color var(--duration-fast, 0.2s) ease;
      transition-delay: calc(0.35s + var(--i, 0) * 0.14s);
    }

    .js [data-reveal-enabled] .is-visible .empathy-band__eyebrow,
    .js [data-reveal-enabled] .is-visible :is(.empathy-band__text, .empathy-band__subtitle, .empathy-band__subtext, .empathy-band__button) {
      opacity: 1;
      translate: none;
    }

    .js [data-reveal-enabled] .is-visible .empathy-band__button:hover {
      transition-delay: 0s;
    }

    .js [data-reveal-enabled] .empathy-band__rule {
      scale: 0 1;
      transition: scale 1.1s var(--ease-power3-in-out, ease) 0.6s;
    }

    .js [data-reveal-enabled] .is-visible .empathy-band__rule {
      scale: 1 1;
    }

    .js [data-reveal-enabled] .empathy-band__frame {
      clip-path: inset(100% 0 0 0);
      transition: clip-path 1.2s var(--ease-power3-in-out, ease) 0.15s;
    }

    .js [data-reveal-enabled] .is-visible .empathy-band__frame {
      clip-path: inset(0);
    }

    .js [data-reveal-enabled] .empathy-band__block {
      translate: -1.25rem -1.25rem;
      opacity: 0;
      transition:
        translate 1.1s var(--ease-power3-out, ease) 0.9s,
        opacity 0.6s ease 0.9s;
    }

    .js [data-reveal-enabled] .is-visible .empathy-band__block {
      translate: none;
      opacity: 1;
    }
  }

  @keyframes empathy-heart {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    50% {
      transform: translateY(-4px) scale(1.04);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "On vous comprend",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "Les jours de règles"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "info": "Mettez la deuxième partie en italique : elle passe à la ligne, dans la couleur d'accent.",
      "default": "On connaît ces jours-là, <em>et on vous comprend.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Ce tiraillement qui revient chaque mois, souvent au mauvais moment. On ralentit, on serre les dents, on attend que ça passe.</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Une chaleur douce, qui vous suit."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Phrase sous le sous-titre",
      "default": "La ceinture VELEA se fixe à la taille et diffuse une chaleur réglable sur le bas du ventre, sans fil : à la maison, au bureau ou en déplacement."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Découvrir la ceinture"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produit (lien du bouton et photo par défaut)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton (sinon, le produit)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Sans photo, celle du produit choisi."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Photo à",
      "options": [
        { "value": "right", "label": "Droite" },
        { "value": "left", "label": "Gauche" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Couleur d'accent (bloc, cœur, italique)",
      "default": "#6b3a4d"
    },
    {
      "type": "checkbox",
      "id": "show_heart",
      "label": "Cœur dessiné",
      "default": true
    }
  ],
  "presets": [{ "name": "On vous comprend" }]
}
{% endschema %}
