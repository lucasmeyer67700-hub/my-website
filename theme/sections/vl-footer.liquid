{%- comment -%} Pied de page sombre en 4 colonnes, réseaux sociaux et moyens de paiement. {%- endcomment -%}
<footer class="vl-footer color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="vl-footer__grid">
      <div class="vl-footer__col vl-footer__col--news">
        <h2 class="vl-footer__title">{{ section.settings.news_title | escape }}</h2>
        <p>{{ section.settings.news_text | escape }}</p>
        {%- form 'customer', id: 'vl-footer-news', class: 'vl-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="vl-footer__ok" role="status">Merci, tu es inscrite 💕</p>
          {%- else -%}
            <div class="vl-footer__field">
              <label class="visually-hidden" for="vl-footer-email">E-mail</label>
              <input id="vl-footer-email" type="email" name="contact[email]" placeholder="E-mail" required autocomplete="email">
              <button type="submit" aria-label="S'inscrire"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
            </div>
            <label class="vl-footer__consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" required> J'accepte de recevoir les e-mails VELEA.</label>
          {%- endif -%}
        {%- endform -%}
      </div>
      {%- for block in section.blocks -%}
        <div class="vl-footer__col" {{ block.shopify_attributes }}>
          <h2 class="vl-footer__title">{{ block.settings.title | escape }}</h2>
          <ul role="list">
            {%- if block.settings.show_email and section.settings.email != blank -%}
              <li><a href="mailto:{{ section.settings.email }}">Écris-nous : {{ section.settings.email }}</a></li>
            {%- endif -%}
            {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="vl-footer__bottom">
      <ul class="vl-footer__social" role="list">
        {%- if section.settings.instagram != blank -%}<li><a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a></li>{%- endif -%}
        {%- if section.settings.pinterest != blank -%}<li><a href="{{ section.settings.pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.5 1.8-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.9 1.6 1.9 1.9 0 3.3-2 3.3-4.9 0-2.6-1.8-4.3-4.5-4.3-3 0-4.8 2.3-4.8 4.6 0 .9.4 1.9.8 2.4.1.1.1.2.1.3l-.3 1.2c0 .2-.2.3-.4.2-1.4-.6-2.2-2.6-2.2-4.2 0-3.4 2.5-6.6 7.2-6.6 3.8 0 6.7 2.7 6.7 6.3 0 3.7-2.4 6.8-5.6 6.8-1.1 0-2.2-.6-2.5-1.3l-.7 2.6c-.2 1-.9 2.2-1.4 2.9A10 10 0 1 0 12 2z"/></svg></a></li>{%- endif -%}
        {%- if section.settings.facebook != blank -%}<li><a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.8c0-.8.5-1 .9-1h2.4V2.1L14 2c-3.6 0-4.4 2.7-4.4 4.4v2.1H7.5v3.8h2.1V22H14v-9.7h3l.4-3.8H14z"/></svg></a></li>{%- endif -%}
      </ul>
      <ul class="vl-footer__pay list-payment" role="list" aria-label="Moyens de paiement">
        {%- for type in shop.enabled_payment_types -%}<li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}
      </ul>
    </div>
    <p class="vl-footer__copy">© {{ 'now' | date: '%Y' }}, {{ shop.name }}. Accessoire de bien-être, ne remplace pas un avis médical.</p>
  </div>
</footer>

{% schema %}
{
  "name": "VELEA · Pied de page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "news_title", "label": "Titre newsletter", "default": "RESTONS EN CONTACT" },
    { "type": "textarea", "id": "news_text", "label": "Texte newsletter", "default": "-10 % sur ta première commande, des conseils doux pour tes règles et nos nouveautés en avant-première." },
    { "type": "text", "id": "email", "label": "E-mail de contact", "default": "velea.officiel@gmail.com" },
    { "type": "url", "id": "instagram", "label": "Lien Instagram" },
    { "type": "url", "id": "pinterest", "label": "Lien Pinterest" },
    { "type": "url", "id": "facebook", "label": "Lien Facebook" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-5" }
  ],
  "blocks": [{ "type": "column", "name": "Colonne de liens", "limit": 3, "settings": [{ "type": "text", "id": "title", "label": "Titre" }, { "type": "link_list", "id": "menu", "label": "Menu" }, { "type": "checkbox", "id": "show_email", "label": "Afficher l'e-mail de contact en premier", "default": false }] }]
}
{% endschema %}
