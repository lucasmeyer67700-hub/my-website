{%- liquid
  assign anchor = section.settings.anchor | handleize
  assign reassurance_blocks = section.blocks | where: 'type', 'reassurance'
  assign question_blocks = section.blocks | where: 'type', 'question'
-%}

<section
  class="faq section color-{{ section.settings.color_scheme }}"
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
  aria-labelledby="FaqTitle-{{ section.id }}"
>
  {%- if reassurance_blocks.size > 0 -%}
    <div class="page-width faq__reassurance-wrap">
      <ul class="faq__reassurance reveal" role="list">
        {%- for block in reassurance_blocks -%}
          <li class="faq__reassurance-item" {{ block.shopify_attributes }}>
            <span class="icon-badge">{% render 'icon', icon: block.settings.icon %}</span>
            <div class="faq__reassurance-body">
              <p class="faq__reassurance-title">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                {%- else -%}
                  {{ block.settings.title | escape }}
                {%- endif -%}
              </p>
              {%- if block.settings.text != blank -%}
                <p class="faq__reassurance-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  <div class="page-width faq__grid">
    <div class="faq__intro reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="h2" id="FaqTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="text-muted">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="link link--arrow" href="{{ section.settings.link }}">
          {{- section.settings.link_label | escape -}}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <div class="faq__list reveal">
      {%- for block in question_blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <h3 class="accordion__title title-sm">{{ block.settings.question | escape }}</h3>
            {% render 'icon', icon: 'plus', class: 'icon--toggle' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .faq__grid {
    display: grid;
    gap: var(--space-xl);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }
  }

  .faq__intro {
    display: grid;
    justify-items: start;
    gap: var(--space-md);

    @media screen and (min-width: 990px) {
      position: sticky;
      inset-block-start: calc(var(--header-height) + 2rem);
    }
  }

  .faq .accordion__title {
    font-size: var(--text-md);
  }

  /* Reassurance row above the questions (3 items at most) */
  .faq__reassurance-wrap {
    margin-block-end: var(--space-xl);
    padding-block-end: var(--space-xl);
    border-block-end: 1px solid var(--color-border);
  }

  .faq__reassurance {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }

  .faq__reassurance-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .faq__reassurance-body {
    display: grid;
    gap: 0.2rem;
  }

  .faq__reassurance-title {
    font-weight: var(--font-body-weight-medium);

    & a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--warm-hairline);
      text-underline-offset: 0.25em;

      &:hover {
        text-decoration-color: currentColor;
      }
    }
  }

  .faq__reassurance-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Questions fréquentes",
  "tag": "div",
  "class": "section-faq",
  "max_blocks": 23,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Questions fréquentes"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Vos questions, <em>nos réponses.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Lien : texte"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien : destination"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre (lien interne)",
      "default": "faq"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "reassurance",
      "name": "Réassurance",
      "limit": 3,
      "settings": [
        {
          "type": "paragraph",
          "content": "Trois éléments au plus, uniquement des informations réelles (livraison, retours, service client…)."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retour" },
            { "value": "lock", "label": "Paiement sécurisé" },
            { "value": "chat", "label": "Service client" },
            { "value": "shield", "label": "Garantie" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Livraison offerte"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Précision"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Votre question ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Une réponse claire et vérifiée.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions fréquentes",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
