{%- liquid
  assign menu = section.settings.menu
  if menu == blank or menu.links.size == 0
    assign menu = linklists['main-menu']
  endif
  assign secondary_menu = section.settings.secondary_menu
  assign cta_product = section.settings.cta_product
  assign wordmark_font = section.settings.wordmark_font
  assign wordmark_tracking = section.settings.wordmark_spacing | divided_by: 100.0
-%}

{%- unless settings.logo or wordmark_font.system? -%}
  {%- comment -%} The shop name is the logo: its font is fetched first so it never flashes. {%- endcomment -%}
  {{ wordmark_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endunless -%}
{%- style -%}
  {%- unless settings.logo or wordmark_font.system? -%}
    {{ wordmark_font | font_face: font_display: 'swap' }}
  {%- endunless %}
  .site-header {
    --wordmark-font: {{ wordmark_font.family }}, {{ wordmark_font.fallback_families }};
    --wordmark-weight: {{ wordmark_font.weight }};
    --wordmark-tracking: {{ wordmark_tracking }}em;
  }
{%- endstyle -%}

<site-header
  class="site-header color-{{ section.settings.color_scheme }}"
  style="--wordmark-size: {{ section.settings.wordmark_size | divided_by: 16.0 }}rem; --mark-size: {{ section.settings.logo_mark_size | divided_by: 16.0 }}rem;"
>
  <div class="site-header__inner page-width{% if section.settings.full_width %} page-width--wide{% endif %}">
    <div class="site-header__start">
      <button
        type="button"
        class="icon-button site-header__menu-toggle"
        data-menu-trigger
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="MenuDrawer"
      >
        {% render 'icon', icon: 'menu' %}
        <span class="visually-hidden">{{ 'general.open_menu' | t }}</span>
      </button>

      <a class="site-header__logo" href="{{ routes.root_url }}">
        {%- if settings.logo -%}
          {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'site-header__logo-image',
              widths: '200, 300, 400, 600',
              height: logo_height,
              width: settings.logo_width,
              alt: shop.name,
              loading: 'eager'
          }}
        {%- else -%}
          {%- if section.settings.logo_mark != blank -%}
            {%- liquid
              comment
                Decorative symbol next to the shop name (the name stays the link text).
                Sharp on every screen: 1x, 2x and 3x versions of the set height.
              endcomment
              assign mark = section.settings.logo_mark
              assign mark_height = section.settings.logo_mark_size
              assign mark_width = mark_height | times: mark.aspect_ratio | round
              assign mark_2x = mark_height | times: 2
              assign mark_3x = mark_height | times: 3
            -%}
            <img
              class="site-header__mark"
              src="{{ mark | image_url: height: mark_2x }}"
              srcset="{{ mark | image_url: height: mark_height }} 1x, {{ mark | image_url: height: mark_2x }} 2x, {{ mark | image_url: height: mark_3x }} 3x"
              width="{{ mark_width }}"
              height="{{ mark_height }}"
              alt=""
              fetchpriority="high"
            >
          {%- endif -%}
          <span class="site-header__wordmark{% if section.settings.wordmark_uppercase %} site-header__wordmark--caps{% endif %}">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="site-header__nav" aria-label="{{ 'general.main_navigation' | t }}">
      <ul class="site-header__menu" role="list">
        {%- for link in menu.links -%}
          <li>
            <a
              class="site-header__menu-link"
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a class="icon-button site-header__account" href="{{ routes.account_url }}">
          {% render 'icon', icon: 'user' %}
          <span class="visually-hidden">
            {%- if customer -%}{{ 'header.account' | t }}{%- else -%}{{ 'header.login' | t }}{%- endif -%}
          </span>
        </a>
      {%- endif -%}
      <a
        class="icon-button site-header__cart"
        href="{{ routes.cart_url }}"
        data-cart-trigger
        {% if settings.cart_type == 'drawer' %}
          aria-haspopup="dialog"
        {% endif %}
      >
        <span class="site-header__cart-icon" data-cart-icon>
          {% render 'cart-icon' %}
        </span>
      </a>
    </div>
  </div>
</site-header>

{%- liquid
  comment
    Mobile menu: the brand, the links from its own menu or else the main
    menu, a button, an optional editorial card, and the help links not
    already listed plus the account link. Fonts and colours are set in the
    section so the menu keeps its own look.
  endcomment
  assign drawer_menu = section.settings.drawer_menu
  if drawer_menu == blank or drawer_menu.links.size == 0
    assign drawer_menu = menu
  endif

  assign cta_url = section.settings.cta_link
  if cta_url == blank and cta_product != blank
    assign cta_url = cta_product.url
  endif

  assign editorial_image = section.settings.editorial_image
  assign editorial_title = section.settings.editorial_title
  assign editorial_text = section.settings.editorial_text
  assign editorial_link = section.settings.editorial_link

  assign menu_heading_font = section.settings.menu_heading_font
  assign menu_heading_italic = menu_heading_font | font_modify: 'style', 'italic'
  assign menu_body_font = section.settings.menu_body_font
  assign menu_body_medium = menu_body_font | font_modify: 'weight', '500'

  capture warm_fonts
    unless menu_heading_font.system?
      echo '|' | append: menu_heading_font.weight | append: ' 1em ' | append: menu_heading_font.family
    endunless
    unless menu_body_font.system?
      echo '|' | append: menu_body_font.weight | append: ' 1em ' | append: menu_body_font.family
      if menu_body_medium
        echo '|500 1em ' | append: menu_body_font.family
      endif
    endunless
  endcapture
-%}

{%- style -%}
  {{ menu_heading_font | font_face: font_display: 'swap' }}
  {%- if menu_heading_italic %}{{ menu_heading_italic | font_face: font_display: 'swap' }}{% endif %}
  {{ menu_body_font | font_face: font_display: 'swap' }}
  {%- if menu_body_medium %}{{ menu_body_medium | font_face: font_display: 'swap' }}{% endif %}

  .velea-menu {
    --velea-menu-background: {{ section.settings.menu_background }};
    --velea-menu-text: {{ section.settings.menu_text }};
    --velea-menu-text-muted: {{ section.settings.menu_text_muted }};
    --velea-menu-border: {{ section.settings.menu_border }};
    --velea-menu-button: {{ section.settings.menu_button }};
    --velea-menu-button-label: {{ section.settings.menu_button_label }};
    --velea-menu-font-heading: {{ menu_heading_font.family }}, {{ menu_heading_font.fallback_families }};
    --velea-menu-font-heading-weight: {{ menu_heading_font.weight }};
    --velea-menu-font-body: {{ menu_body_font.family }}, {{ menu_body_font.fallback_families }};
    --velea-menu-font-body-weight: {{ menu_body_font.weight }};
    --velea-menu-font-body-weight-medium: {% if menu_body_medium %}500{% else %}{{ menu_body_font.weight }}{% endif %};
  }
{%- endstyle -%}

<modal-drawer
  class="velea-menu-drawer"
  data-trigger="[data-menu-trigger]"
  data-warm-fonts="{{ warm_fonts | strip | remove_first: '|' | escape }}"
>
  <dialog
    id="MenuDrawer"
    class="drawer drawer--left velea-menu color-{{ section.settings.color_scheme }}"
    aria-labelledby="MenuDrawerTitle"
  >
    <div class="drawer__inner">
      <div class="velea-menu__header">
        <a class="velea-menu__brand" href="{{ routes.root_url }}">
          {%- if section.settings.logo_mark != blank -%}
            {%- assign drawer_mark = section.settings.logo_mark -%}
            <img
              class="velea-menu__mark"
              src="{{ drawer_mark | image_url: height: 56 }}"
              srcset="{{ drawer_mark | image_url: height: 28 }} 1x, {{ drawer_mark | image_url: height: 56 }} 2x, {{ drawer_mark | image_url: height: 84 }} 3x"
              width="{{ 28 | times: drawer_mark.aspect_ratio | round }}"
              height="28"
              alt=""
              loading="lazy"
            >
          {%- endif -%}
          <span class="velea-menu__logo" id="MenuDrawerTitle">{{ shop.name | escape }}</span>
        </a>
        <button type="button" class="velea-menu__close" data-drawer-close autofocus>
          {% render 'icon', icon: 'close' %}
          <span class="visually-hidden">{{ 'general.close_menu' | t }}</span>
        </button>
      </div>

      <div class="velea-menu__body">
        <p class="velea-menu__eyebrow velea-menu__reveal" style="--velea-menu-index: 0;" aria-hidden="true">
          {{- 'general.menu' | t -}}
        </p>
        <nav class="velea-menu__nav" aria-label="{{ 'general.main_navigation' | t }}">
          <ul class="velea-menu__list" role="list">
            {%- capture drawer_urls -%}|{%- for link in drawer_menu.links -%}{{ link.url }}|{%- endfor -%}{%- endcapture -%}
            {%- for link in drawer_menu.links -%}
              <li class="velea-menu__item" style="--velea-menu-index: {{ forloop.index }};">
                <a
                  class="velea-menu__link"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="velea-menu__link-label">{{ link.title | escape }}</span>
                  {% render 'icon', icon: 'arrow-right', class: 'velea-menu__chevron' %}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>

        {%- if cta_url != blank and section.settings.cta_label != blank -%}
          <a class="velea-menu__cta velea-menu__reveal" href="{{ cta_url }}" style="--velea-menu-index: 5;">
            <span>{{ section.settings.cta_label | escape }}</span>
            {% render 'icon', icon: 'arrow-right' %}
          </a>
        {%- endif -%}

        {%- if editorial_image != blank or editorial_title != blank -%}
          {%- if editorial_link != blank -%}
            <a class="velea-menu__editorial velea-menu__editorial--link velea-menu__reveal" href="{{ editorial_link }}" style="--velea-menu-index: 6;">
          {%- else -%}
            <div class="velea-menu__editorial velea-menu__reveal" style="--velea-menu-index: 6;">
          {%- endif -%}
          {%- if editorial_image != blank -%}
            <div class="velea-menu__editorial-media">
              {{
                editorial_image
                | image_url: width: 1000
                | image_tag:
                  class: 'velea-menu__editorial-image',
                  widths: '400, 600, 800, 1000',
                  sizes: '(min-width: 480px) 25rem, calc(100vw - 5.5rem)',
                  loading: 'lazy',
                  alt: editorial_image.alt
              }}
            </div>
          {%- endif -%}
          {%- if editorial_title != blank or editorial_text != blank -%}
            <div class="velea-menu__editorial-text">
              {%- if editorial_title != blank -%}
                <p class="velea-menu__editorial-title">{{ editorial_title | escape }}</p>
              {%- endif -%}
              {%- if editorial_text != blank -%}
                <p class="velea-menu__editorial-subtitle">{{ editorial_text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if editorial_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} Help links not already in the menu above, so nothing shows twice. {%- endcomment -%}
        {%- capture help_links -%}
          {%- if secondary_menu != blank -%}
            {%- for link in secondary_menu.links -%}
              {%- assign link_key = '|' | append: link.url | append: '|' -%}
              {%- unless drawer_urls contains link_key -%}
                <li>
                  <a
                    class="velea-menu__secondary-link"
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                </li>
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
            <li>
              <a class="velea-menu__secondary-link" href="{{ routes.account_url }}">
                {%- if customer -%}{{ 'header.account' | t }}{%- else -%}{{ 'header.login' | t }}{%- endif -%}
              </a>
            </li>
          {%- endif -%}
        {%- endcapture -%}
        {%- if help_links != blank -%}
          <nav class="velea-menu__help velea-menu__reveal" aria-label="{{ 'general.help_navigation' | t }}" style="--velea-menu-index: 7;">
            <p class="velea-menu__help-title" aria-hidden="true">{{ 'general.help_title' | t }}</p>
            <ul class="velea-menu__secondary" role="list">
              {{- help_links -}}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    </div>
  </dialog>
</modal-drawer>

{% stylesheet %}
  .section-header-wrapper {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
  }

  .site-header {
    display: block;
    border-block-end: 1px solid transparent;
    transition:
      border-color var(--duration-base) ease,
      box-shadow var(--duration-base) ease;

    &.is-scrolled {
      border-block-end-color: var(--warm-hairline);
      box-shadow: var(--shadow-sm);
    }
  }

  /*
    Phones and tablets: the menu button on the left, the name exactly in the
    middle, the account and bag on the right (two equal side columns).
    Computers: the name, the menu, the icons.
  */
  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0;
    min-height: var(--header-height);

    @media screen and (min-width: 990px) {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: clamp(2rem, 3.5vw, 3.75rem);
    }
  }

  .site-header__start {
    display: contents;

    @media screen and (min-width: 990px) {
      display: flex;
      align-items: center;
      gap: var(--space-3xs);
      min-width: 0;
    }
  }

  .site-header__menu-toggle {
    justify-self: start;
    margin-inline-start: -0.6rem;

    @media screen and (min-width: 990px) {
      display: none;
    }
  }

  .site-header__logo {
    display: inline-flex;
    justify-self: center;
    align-items: center;
    gap: clamp(0.4rem, 0.3rem + 0.4vw, 0.65rem);
    min-height: var(--tap-target);
    min-width: 0;
    text-decoration: none;
  }

  .site-header__mark {
    flex: none;
    width: auto;
    height: max(2rem, calc(var(--mark-size, 2.75rem) * 0.82));

    @media screen and (min-width: 990px) {
      height: var(--mark-size, 2.75rem);
    }
  }

  .site-header__logo-image {
    width: var(--logo-width);
    max-width: 50vw;
    height: auto;
  }

  /* Shop name as the logo: its own font, even letter spacing, crisp edges */
  .site-header__wordmark {
    margin-inline-end: calc(var(--wordmark-tracking, 0em) * -1); /* trailing letter spacing */
    font-family: var(--wordmark-font, var(--font-heading-family));
    font-size: max(1.375rem, min(calc(var(--wordmark-size, 2.25rem) * 0.8), 7.5vw));
    font-weight: var(--wordmark-weight, 400);
    font-kerning: normal;
    font-synthesis: none;
    line-height: 1;
    letter-spacing: var(--wordmark-tracking, 0.015em);
    white-space: nowrap;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;

    @media screen and (min-width: 990px) {
      font-size: var(--wordmark-size, 2.25rem);
    }
  }

  /* Capitals sit a touch low in the line box: lift them to the optical centre */
  .site-header__wordmark--caps {
    padding-block-start: 0.06em;
    text-transform: uppercase;
  }

  .site-header__nav {
    display: none;

    @media screen and (min-width: 990px) {
      display: block;
      justify-self: start;
    }
  }

  .site-header__menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1.25rem, 2.2vw, 2.25rem);
  }

  .site-header__menu-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-size: var(--text-base);
    letter-spacing: 0.01em;
    text-decoration: none;
    background-image: var(--warm-gradient);
    background-position: 0 calc(100% - 0.55rem);
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size var(--duration-base) var(--ease-out);

    &:hover,
    &[aria-current='page'] {
      background-size: 100% 1px;
    }
  }

  .site-header__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-3xs);
    margin-inline-end: -0.6rem;
  }

  .site-header__cart-icon {
    position: relative;
    display: inline-flex;
  }

  .cart-count {
    position: absolute;
    inset-block-start: -0.45rem;
    inset-inline-end: -0.6rem;
    display: grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.25rem;
    border-radius: var(--radius-round);
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    line-height: 1;
    color: var(--color-button-label);
    background-color: var(--color-button);
  }

  /* Mobile menu ------------------------------------------------------------ */

  .drawer.velea-menu {
    --color-text: var(--velea-menu-text);
    width: min(26.5rem, calc(100vw - 2.5rem));
    font-family: var(--velea-menu-font-body);
    font-weight: var(--velea-menu-font-body-weight);
    color: var(--velea-menu-text);
    background-color: var(--velea-menu-background);
    background-image:
      radial-gradient(90% 40% at 100% 0%, rgb(var(--rose-strong-rgb) / 0.09), transparent 70%),
      radial-gradient(70% 35% at 0% 100%, rgb(var(--rose-strong-rgb) / 0.07), transparent 70%);
    box-shadow: 0 0 3rem rgb(73 53 47 / 0.18);

    &::backdrop {
      background-color: rgb(73 53 47 / 0.36);
      backdrop-filter: blur(3px);
    }
  }

  /* Brand on the left, a round close button on the right */
  /* The name in the middle of the menu's top bar, the close button on the right */
  .velea-menu__header {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 0.75rem;
    padding: max(1rem, env(safe-area-inset-top)) 1.25rem 1rem;
    border-block-end: 1px solid var(--velea-menu-border);
  }

  .velea-menu__brand {
    display: inline-flex;
    grid-column: 2;
    justify-self: center;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
  }

  .velea-menu__mark {
    display: block;
    width: auto;
    height: 1.75rem;
  }

  .velea-menu__logo {
    margin: 0 -0.3em 0 0; /* trailing letter spacing: keeps the name optically centred */
    font-family: var(--velea-menu-font-heading);
    font-size: 1.25rem;
    font-weight: var(--velea-menu-font-heading-weight);
    line-height: 1;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .velea-menu__close {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--velea-menu-border);
    border-radius: 50%;
    color: var(--velea-menu-text);
    background-color: rgb(255 255 255 / 0.55);
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease,
      transform var(--duration-base) var(--ease-out);

    & .icon {
      --icon-size: 1rem;
    }

    &:hover {
      border-color: var(--velea-menu-text-muted);
      background-color: #fff;
      transform: rotate(90deg);
    }
  }

  .velea-menu__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.75rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
  }

  .velea-menu__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 -0.75rem;
    font-size: 0.6875rem;
    font-weight: var(--velea-menu-font-body-weight-medium);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--velea-menu-text-muted);

    &::after {
      content: '';
      flex: 1;
      height: 1px;
      background-color: var(--velea-menu-border);
    }
  }

  .velea-menu__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .velea-menu__item + .velea-menu__item {
    border-block-start: 1px solid var(--velea-menu-border);
  }

  /* Links: the name in the serif font, an arrow */
  .velea-menu__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.75rem;
    padding-block: 0.5rem;
    color: inherit;
    text-decoration: none;

    /* The page you are on: same letters as the others, in rose */
    &[aria-current='page'] .velea-menu__link-label,
    &[aria-current='page'] .velea-menu__chevron {
      color: var(--rose-text);
    }

    &:hover .velea-menu__chevron {
      color: var(--velea-menu-text);
      transform: translateX(0.25rem);
    }

    &:hover .velea-menu__link-label {
      transform: translateX(0.15rem);
    }
  }

  .velea-menu__link-label {
    min-width: 0;
    font-family: var(--velea-menu-font-heading);
    font-size: 1.625rem;
    font-weight: var(--velea-menu-font-heading-weight);
    line-height: 1.15;
    overflow-wrap: anywhere;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .velea-menu__chevron {
    --icon-size: 1.125rem;
    flex: none;
    color: var(--velea-menu-text-muted);
    transition:
      color var(--duration-base) ease,
      transform var(--duration-base) var(--ease-out);
  }

  .velea-menu__cta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.625rem;
    min-height: 3.25rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-family: var(--velea-menu-font-heading);
    font-size: 1.0625rem;
    font-weight: var(--velea-menu-font-heading-weight);
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-align: center;
    text-decoration: none;
    color: var(--velea-menu-button-label);
    background-color: var(--velea-menu-button);
    box-shadow: 0 16px 30px -18px rgb(73 53 47 / 0.75);
    transition:
      background-color var(--duration-base) ease,
      transform var(--duration-fast) ease;

    & .icon {
      --icon-size: 1rem;
      transition: transform var(--duration-base) var(--ease-out);
    }

    &:hover {
      background-color: color-mix(in srgb, var(--velea-menu-button) 86%, black);
    }

    &:hover .icon {
      transform: translateX(0.2rem);
    }

    &:active {
      transform: scale(0.99);
    }

    &:focus-visible {
      outline: 2px solid var(--velea-menu-button);
      outline-offset: 3px;
    }
  }

  .velea-menu__editorial {
    display: grid;
    gap: 0.875rem;
    color: inherit;
    text-decoration: none;
  }

  .velea-menu__editorial-media {
    overflow: hidden;
    aspect-ratio: 19 / 10;
    border-radius: 0.625rem;
    background-color: var(--velea-menu-border);
  }

  .velea-menu__editorial-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .velea-menu__editorial--link:hover .velea-menu__editorial-image {
    transform: scale(1.03);
  }

  .velea-menu__editorial-text {
    display: grid;
    gap: 0.5rem;
  }

  .velea-menu__editorial-title {
    margin: 0;
    font-family: var(--velea-menu-font-heading);
    font-size: 1.375rem;
    font-weight: var(--velea-menu-font-heading-weight);
    line-height: 1.25;
    text-wrap: balance;
  }

  .velea-menu__editorial-subtitle {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--velea-menu-text-muted);
  }

  /* Help: a quiet card with the links that are not in the menu above */
  .velea-menu__help {
    padding: 1rem 1.125rem;
    border: 1px solid var(--velea-menu-border);
    border-radius: 1rem;
    background-color: rgb(255 255 255 / 0.55);
  }

  .velea-menu__help-title {
    margin: 0 0 0.25rem;
    font-family: var(--velea-menu-font-heading);
    font-size: 1.0625rem;
    font-weight: var(--velea-menu-font-heading-weight);
  }

  .velea-menu__secondary {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .velea-menu__secondary-link {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--velea-menu-text-muted);
    text-decoration: none;
    transition: color var(--duration-base) ease;

    &:hover,
    &[aria-current='page'] {
      color: var(--velea-menu-text);
    }
  }

  /* Phone held sideways: shorter rows and a side-by-side editorial card. */
  @media screen and (orientation: landscape) and (max-height: 32rem) {
    .velea-menu__link {
      min-height: 3rem;
    }

    .velea-menu__editorial {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
    }

    .velea-menu__body {
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .velea-menu[open] .velea-menu__item,
    .velea-menu[open] .velea-menu__reveal {
      animation: velea-menu-rise 0.55s var(--ease-out) both;
      animation-delay: calc(80ms + var(--velea-menu-index, 1) * 50ms);
    }
  }

  @keyframes velea-menu-rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
{% endstylesheet %}

