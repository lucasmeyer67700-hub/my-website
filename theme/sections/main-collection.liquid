<section class="main-collection section section--compact color-{{ section.settings.color_scheme }}" aria-labelledby="CollectionTitle">
  <div class="page-width">
    <header class="section-header">
      <h1 class="h2" id="CollectionTitle">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte lead">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="product-grid" role="list">
          {%- for product in collection.products -%}
            <li>{% render 'product-card', product: product, heading_tag: 'h2' %}</li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="text-muted">{{ 'templates.collection_empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produits par page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
