<cart-drawer class="cart-drawer" data-trigger="[data-cart-trigger]">
  <dialog class="drawer color-scheme-1" aria-labelledby="CartDrawerTitle">
    <div class="drawer__inner" data-cart-drawer-content>
      <div class="drawer__header">
        <h2 class="drawer__title" id="CartDrawerTitle" tabindex="-1" data-cart-title>
          {{ 'cart.title' | t }}
          {%- if cart.item_count > 0 %}
            <span class="cart-drawer__count" aria-label="{{ 'cart.item_count' | t: count: cart.item_count }}">{{ cart.item_count }}</span>
          {%- endif -%}
        </h2>
        <button type="button" class="icon-button" data-drawer-close>
          {% render 'icon', icon: 'close' %}
          <span class="visually-hidden">{{ 'general.close' | t }}</span>
        </button>
      </div>

      {%- if cart.item_count == 0 -%}
        <div class="drawer__body">
          {% render 'cart-empty', context: 'drawer' %}
        </div>
      {%- else -%}
        <div class="drawer__body">
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" novalidate>
          <ul class="cart-lines" role="list">
            {%- for item in cart.items -%}
              {% render 'cart-line', item: item, index: forloop.index, context: 'drawer' %}
            {%- endfor -%}
          </ul>

          {%- if settings.cart_note -%}
            <div class="field cart-drawer__note">
              <label class="field__label" for="CartDrawerNote">{{ 'cart.note' | t }}</label>
              <textarea class="field__input" id="CartDrawerNote" name="note">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
        </form>
        {%- comment -%} Outside the cart form: each add-on has its own add form. {%- endcomment -%}
        {% render 'cart-upsell', context: 'drawer' %}
        </div>

        <div class="drawer__footer">
          {% render 'cart-summary', form_id: 'CartDrawerForm', compact: true %}
        </div>
      {%- endif -%}
    </div>
  </dialog>
</cart-drawer>

{% stylesheet %}
  /* Clean, editorial drawer (rose & blanc): bold uppercase title, products on
     hairlines, suggestions in a soft rose band, one secure-checkout button. */
  .cart-drawer .drawer {
    --cd-line: rgb(var(--warm-rgb) / 0.14);
    --cd-band: #f8e9ea;
  }

  .cart-drawer .drawer__header {
    padding-block: 1.35rem;
    border-block-end: 1px solid var(--cd-line);
  }

  .cart-drawer .drawer__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart-drawer__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: 0.45rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-button-label);
    background-color: var(--color-button);
  }

  /* The count says "1 article": keep only the figure in the pill */
  .cart-drawer__count-text {
    display: none;
  }

  /* The title gets focus when the drawer opens (for screen readers): no ring on it. */
  .cart-drawer [data-cart-title]:focus {
    outline: none;
  }

  .cart-drawer .drawer__body {
    padding: 0;
  }

  .cart-drawer #CartDrawerForm {
    padding-inline: var(--space-md);
  }

  /* Product lines: no boxes, a fine line between them */
  .cart-drawer .cart-lines {
    gap: 0;
  }

  .cart-drawer .cart-line {
    grid-template-columns: 6rem 1fr auto;
    gap: 1rem;
    padding-block: 1.25rem;
    border-block-end: 1px solid var(--cd-line);
  }

  .cart-drawer .cart-line__media {
    --media-ratio: 4 / 5;
    border-radius: var(--radius-sm);
    background-color: var(--gallery-bg);
  }

  .cart-drawer .cart-line__details {
    gap: 0.3rem;
  }

  .cart-drawer .cart-line__title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .cart-drawer .cart-line__meta {
    font-size: 0.8125rem;
  }

  .cart-drawer .cart-line__price {
    font-size: 1rem;
    font-weight: 700;
  }

  /* Minimal quantity: − 1 + without a frame */
  .cart-drawer .cart-line .quantity {
    border-color: transparent;
    background-color: rgb(var(--warm-rgb) / 0.06);
  }

  .cart-drawer .cart-line .quantity .icon-button {
    width: 2.1rem;
    min-width: 2.1rem;
    height: 2.1rem;
    min-height: 2.1rem;
  }

  .cart-drawer .cart-line .quantity__input {
    width: 1.9rem;
    min-height: 2.1rem;
    font-weight: 600;
  }

  .cart-drawer .cart-line .text-button {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Suggestions: a rose band with cards side by side (swipe on mobile) */
  .cart-drawer .cart-upsell {
    margin-block-start: var(--space-md);
    padding: var(--space-md) 0 var(--space-md) var(--space-md);
    border: 0;
    background-color: var(--cd-band);
  }

  .cart-drawer .cart-upsell__heading {
    padding-inline-end: var(--space-md);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .cart-drawer .cart-upsell__list {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-inline-end: var(--space-md);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .cart-drawer .cart-upsell__item {
    flex: 0 0 min(85%, 19rem);
    grid-template-columns: 4.25rem minmax(0, 1fr);
    border: 0;
    border-radius: var(--radius-sm);
    scroll-snap-align: start;
    box-shadow: 0 6px 18px -14px rgb(var(--warm-rgb) / 0.5);
  }

  .cart-drawer .cart-upsell__text {
    display: none;
  }

  .cart-drawer .cart-upsell__title {
    font-family: var(--font-body-family);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .cart-drawer .cart-upsell__price {
    font-weight: 600;
  }

  /* Footer: subtotal, one secure button, the payment logos */
  .cart-drawer .drawer__footer {
    display: grid;
    gap: 0.85rem;
    padding: 1.1rem var(--space-md) var(--space-sm);
    border-block-start: 1px solid var(--cd-line);
    background-color: var(--color-background);
  }

  .cart-drawer .cart-summary {
    gap: 0.85rem;
  }

  .cart-drawer .cart-summary__subtotal {
    align-items: baseline;
    font-size: 1rem;

    & span:first-child {
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.8125rem;
    }

    & span:last-child {
      font-size: 1.375rem;
      font-weight: 700;
    }
  }

  .cart-drawer .cart-summary__checkout--secure {
    gap: 0.6rem;
    min-height: 3.6rem;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    letter-spacing: 0.06em;

    & .icon {
      --icon-size: 1.1rem;
    }
  }

  .cart-drawer .cart-summary__payments {
    justify-content: center;
  }

  .cart-drawer .cart-summary__hint {
    font-size: 0.75rem;
  }

  .cart-drawer__note {
    margin-block-start: var(--space-lg);
  }

  @media screen and (max-width: 749px) {
    .cart-drawer .cart-line {
      grid-template-columns: 5rem 1fr auto;
      gap: 0.85rem;
    }

    .cart-drawer .cart-line__actions {
      flex-wrap: nowrap;
      gap: 0.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Panier latéral",
  "settings": []
}
{% endschema %}
