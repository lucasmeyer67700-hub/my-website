<section class="contact section section--flush-top color-{{ section.settings.color_scheme }}" aria-labelledby="ContactTitle-{{ section.id }}">
  <div class="page-width page-width--text">
    <h2 class="h3 contact__title" id="ContactTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>

    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">
          {% render 'icon', icon: 'check' %}
          {{ 'contact.success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert" id="ContactFormErrors">
          {% render 'icon', icon: 'alert' %}
          <ul class="form-message__list">
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="contact__row">
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label>
          <input class="field__input" type="text" id="ContactName" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" value="{{ form.name }}">
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail">
            {{- 'contact.email' | t }} <span aria-hidden="true">*</span>
            <span class="visually-hidden">({{ 'general.required' | t }})</span>
          </label>
          <input
            class="field__input"
            type="email"
            id="ContactEmail"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            value="{{ form.email }}"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true" aria-describedby="ContactFormErrors"
            {% endif %}
          >
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="ContactOrder">{{ 'contact.order_number' | t }}</label>
        <input class="field__input" type="text" id="ContactOrder" name="contact[{{ 'contact.order_number' | t }}]">
      </div>

      <div class="field">
        <label class="field__label" for="ContactBody">
          {{- 'contact.message' | t }} <span aria-hidden="true">*</span>
          <span class="visually-hidden">({{ 'general.required' | t }})</span>
        </label>
        <textarea
          class="field__input"
          id="ContactBody"
          name="contact[body]"
          required
          aria-required="true"
          {% if form.errors contains 'body' %}
            aria-invalid="true" aria-describedby="ContactFormErrors"
          {% endif %}
        >
          {{- form.body -}}
        </textarea>
      </div>

      <button type="submit" class="button">{{ 'contact.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .contact__title {
    margin-block-end: var(--space-lg);
  }

  .contact__form {
    display: grid;
    gap: var(--space-md);
    justify-items: start;

    & .field {
      width: 100%;
    }
  }

  .contact__row {
    display: grid;
    gap: var(--space-md);
    width: 100%;

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Formulaire de contact",
  "tag": "div",
  "class": "section-contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Écrivez-nous"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
