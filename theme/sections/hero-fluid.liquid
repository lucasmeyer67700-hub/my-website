{%- comment -%}
  Opening of the home page: a white page on which the pointer (or a finger)
  leaves trails of rose ink that swirl and fade (assets/hero-fluid.js).
  Small columns of text at the top, the title set large at the bottom, the
  button beside it. Without WebGL, or for visitors who ask for less motion,
  a still rose wash takes the place of the ink.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign primary_link = section.settings.button_link
  if primary_link == blank and product != blank
    assign primary_link = product.url
  endif
  if primary_link == blank
    assign primary_link = routes.all_products_collection_url
  endif

  capture heading_text
    echo section.settings.line_1
    if section.settings.line_2 != blank
      echo ' ' | append: section.settings.line_2
    endif
    if section.settings.line_3 != blank
      echo ' ' | append: section.settings.line_3
    endif
  endcapture
  assign heading_text = heading_text | strip

  assign colors = section.settings.color_1 | append: ',' | append: section.settings.color_2 | append: ',' | append: section.settings.color_3 | append: ',' | append: section.settings.color_4 | append: ',' | append: section.settings.color_5
-%}

<script src="{{ 'hero-fluid.js' | asset_url }}" defer="defer"></script>

<hero-fluid
  class="hero-fl"
  {% if section.settings.explode %}
    data-explode
  {% endif %}
  id="HeroFluid-{{ section.id }}"
  style="--fluid-colors: {{ colors }}; --fl-c1: {{ section.settings.color_1 }}; --fl-c2: {{ section.settings.color_2 }}; --fl-c3: {{ section.settings.color_3 }}; --fl-c4: {{ section.settings.color_4 }}; --fl-c5: {{ section.settings.color_5 }}; --fl-drop: {{ section.settings.drop_color }};"
>
  {%- if section.settings.intro -%}
    {%- comment -%}
      Decided before the first paint, so the title is never seen twice: the
      drop on the first visit of the session, the usual arrival afterwards.
      Nothing for visitors who ask for less motion.
    {%- endcomment -%}
    <script>
      (function (el) {
        if (!el || !window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var mode = 'full';
        try {
          if (sessionStorage.getItem('velea-intro')) mode = 'short';
        } catch (e) {
          mode = 'short';
        }
        el.setAttribute('data-intro', mode);
      })(document.getElementById('HeroFluid-{{ section.id }}'));
    </script>
  {%- endif -%}
  <section class="hero-fl__inner" aria-labelledby="HeroFluidTitle-{{ section.id }}">
    <canvas class="hero-fl__canvas" aria-hidden="true"></canvas>
    {%- if section.settings.clouds -%}
      <div class="hero-fl__clouds" aria-hidden="true">
        <span class="hero-fl__cloud hero-fl__cloud--1"></span>
        <span class="hero-fl__cloud hero-fl__cloud--2"></span>
        <span class="hero-fl__cloud hero-fl__cloud--3"></span>
        <span class="hero-fl__cloud hero-fl__cloud--4"></span>
      </div>
    {%- endif -%}

    <div class="hero-fl__columns">
      <p class="hero-fl__col hero-fl__col--1">{{ section.settings.column_1 | escape | newline_to_br }}</p>
      <p class="hero-fl__col hero-fl__col--2">{{ section.settings.column_2 | escape | newline_to_br }}</p>
      <p class="hero-fl__col hero-fl__col--3">
        {%- if section.settings.show_price and product != blank -%}
          <span class="hero-fl__price">{{ product.price | money }}</span><br>
        {%- endif -%}
        {{- section.settings.column_3 | escape | newline_to_br -}}
      </p>
      <p class="hero-fl__col hero-fl__col--4" aria-hidden="true"></p>
    </div>

    <div class="hero-fl__bottom">
      <h1 class="hero-fl__title" id="HeroFluidTitle-{{ section.id }}" aria-label="{{ heading_text | escape }}">
        {%- if section.settings.line_1 != blank -%}
          <span class="hero-fl__line" aria-hidden="true"><span class="hero-fl__line-inner">{{ section.settings.line_1 | escape }}</span></span>
        {%- endif -%}
        {%- if section.settings.line_2 != blank -%}
          <span class="hero-fl__line" aria-hidden="true"><span class="hero-fl__line-inner">{{ section.settings.line_2 | escape }}</span></span>
        {%- endif -%}
        {%- if section.settings.line_3 != blank -%}
          <span class="hero-fl__line hero-fl__line--offset" aria-hidden="true"><span class="hero-fl__line-inner">{{ section.settings.line_3 | escape }}</span></span>
        {%- endif -%}
      </h1>

      <div class="hero-fl__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="hero-fl__btn" href="{{ primary_link }}"><span>{{ section.settings.button_label | escape }}</span></a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a class="hero-fl__quiet" href="{{ section.settings.secondary_link }}"><span>{{ section.settings.secondary_label | escape }}</span></a>
        {%- endif -%}
      </div>
    </div>
  </section>
</hero-fluid>

{% stylesheet %}
  .hero-fl {
    --fl-pad: 20px;
    --fl-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --fl-soft: cubic-bezier(0.22, 1, 0.36, 1);
    display: block;
    color: #2b2422;
    background: #fff;
  }

  .hero-fl__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: max(calc(88svh - var(--header-offset, 100px)), 520px);
    padding: 18px var(--fl-pad) 24px;
    overflow: hidden;
    isolation: isolate;
    touch-action: pan-y;
  }

  /* Before the ink starts (and when it cannot): a still rose wash */
  .hero-fl__inner::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(38% 46% at 68% 44%, rgb(232 160 176 / 0.55), transparent 70%),
      radial-gradient(30% 36% at 44% 64%, rgb(242 195 204 / 0.6), transparent 72%),
      radial-gradient(26% 30% at 82% 70%, rgb(241 178 158 / 0.45), transparent 70%),
      #fff;
    background:
      radial-gradient(38% 46% at 68% 44%, color-mix(in srgb, var(--fl-c1, #e8a0b0) 55%, transparent), transparent 70%),
      radial-gradient(30% 36% at 44% 64%, color-mix(in srgb, var(--fl-c2, #f2c3cc) 60%, transparent), transparent 72%),
      radial-gradient(26% 30% at 82% 70%, color-mix(in srgb, var(--fl-c3, #f1b29e) 45%, transparent), transparent 70%),
      #fff;
    filter: blur(6px);
    transition: opacity 1.2s ease;
  }

  .hero-fl__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s ease 0.1s;
  }

  .hero-fl.is-live .hero-fl__canvas {
    opacity: 1;
  }

  .hero-fl.is-live .hero-fl__inner::before {
    opacity: 0;
  }

  /* Small columns at the top, like the first lines of a page */
  .hero-fl__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 16px;
    pointer-events: none;
  }

  .hero-fl__col {
    margin: 0;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.005em;
    color: #2b2422;
  }

  .hero-fl__col--3 {
    display: none;
  }

  .hero-fl__col--4 {
    grid-column: 1 / -1;
    color: #6f6461;
  }

  .hero-fl__price {
    font-family: var(--font-heading-family);
    font-size: 1.35em;
    font-weight: 400;
  }

  .hero-fl__hint--mouse {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-fl__hint--mouse {
      display: inline;
    }

    .hero-fl__hint--touch {
      display: none;
    }
  }

  /* The title, large, at the bottom */
  .hero-fl__bottom {
    display: grid;
    gap: 20px;
    margin-top: 48px;
  }

  .hero-fl__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(40px, 11.5vw, 54px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #2b2422;
    text-wrap: initial;
    pointer-events: none;
  }

  .hero-fl__line {
    display: block;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    clip-path: inset(-0.3em -100vw 0 -100vw);
  }

  .hero-fl__line-inner {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-fl__line--offset {
    margin-left: 0.9em;
  }

  .hero-fl__actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-fl__btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    padding: 0 32px;
    overflow: hidden;
    border: 1px solid #a14a5c;
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: #fff;
    background: #a14a5c;
    transition: color 0.22s ease-out 0.04s;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      background: #2b2422;
      transform: scaleY(0);
      transform-origin: bottom;
      transition: transform 0.46s var(--fl-soft);
    }

    & > span {
      position: relative;
      z-index: 1;
    }

    &:is(:hover, :focus-visible)::before {
      transform: scaleY(1);
    }

    &:focus-visible {
      outline: 2px solid #a14a5c;
      outline-offset: 3px;
    }
  }

  .hero-fl__quiet {
    display: inline-flex;
    align-self: center;
    align-items: center;
    min-height: 44px;
    font-size: 11.5px;
    font-weight: 500;
    text-decoration: none;
    color: #2b2422;

    & span {
      padding-bottom: 3px;
      border-bottom: 1px solid #a14a5c;
    }

    &:hover {
      color: #a14a5c;
    }
  }

  @media screen and (min-width: 750px) {
    .hero-fl {
      --fl-pad: 40px;
    }

    .hero-fl__inner {
      min-height: max(calc(100svh - var(--header-offset, 100px)), 600px);
      padding-block: 22px 96px;
    }

    .hero-fl__columns {
      grid-template-columns: 1.1fr 1.3fr 1fr auto;
      gap: 24px;
    }

    .hero-fl__col {
      font-size: 12.5px;
    }

    .hero-fl__col--3 {
      display: block;
    }

    .hero-fl__col--4 {
      grid-column: auto;
      text-align: end;
    }

    .hero-fl__bottom {
      gap: 28px;
    }

    .hero-fl__title {
      font-size: clamp(56px, 8.4vw, 132px);
    }

    .hero-fl__actions {
      flex-direction: row;
      align-items: center;
      gap: 24px;
      padding-bottom: 0.6em;
    }

    .hero-fl__btn {
      width: auto;
      height: 54px;
      font-size: 11px;
    }
  }

  /* Wide screens: the button sits beside the end of the title */
  @media screen and (min-width: 1280px) {
    .hero-fl__bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 32px;
    }
  }

  @media screen and (min-width: 1200px) {
    .hero-fl {
      --fl-pad: 56px;
    }

    .hero-fl__columns {
      grid-template-columns: 1fr 1.25fr 1fr 1fr;
    }
  }

  /* Arrival: the columns, then the title line by line, then the button */
  @media (prefers-reduced-motion: no-preference) {
    .hero-fl__col {
      animation: hero-fl-up 0.8s var(--fl-ease) both;
    }

    .hero-fl__col--2 {
      animation-delay: 0.08s;
    }

    .hero-fl__col--3 {
      animation-delay: 0.16s;
    }

    .hero-fl__col--4 {
      animation-delay: 0.6s;
    }

    .hero-fl__line-inner {
      animation: hero-fl-rise 1.05s var(--fl-soft) both;
    }

    .hero-fl__line:nth-child(1) .hero-fl__line-inner {
      animation-delay: 0.3s;
    }

    .hero-fl__line:nth-child(2) .hero-fl__line-inner {
      animation-delay: 0.42s;
    }

    .hero-fl__line:nth-child(3) .hero-fl__line-inner {
      animation-delay: 0.54s;
    }

    .hero-fl__actions {
      animation: hero-fl-up 0.8s var(--fl-ease) 0.9s both;
    }
  }

  /* Clouds of ink in the colours of the burst: they gather once the opening
     has played, then drift slowly for as long as the page is open. Only
     transform moves (no blur filter), so the work stays on the compositor. */
  .hero-fl__clouds {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 2.8s ease;
  }

  .hero-fl:not([data-intro]) .hero-fl__clouds,
  .hero-fl.is-playful .hero-fl__clouds {
    opacity: 1;
  }

  .hero-fl__cloud {
    --cloud: var(--fl-c1, #e8a0b0);
    position: absolute;
    width: 62vmax;
    aspect-ratio: 1.7;
    background:
      radial-gradient(38% 52% at 32% 56%, var(--cloud) 0%, transparent 72%),
      radial-gradient(34% 48% at 63% 44%, var(--cloud) 0%, transparent 72%);
    background:
      radial-gradient(38% 52% at 32% 56%, color-mix(in srgb, var(--cloud) 85%, transparent) 0%, transparent 72%),
      radial-gradient(34% 48% at 63% 44%, color-mix(in srgb, var(--cloud) 78%, transparent) 0%, transparent 72%),
      radial-gradient(28% 40% at 50% 68%, color-mix(in srgb, var(--cloud) 68%, transparent) 0%, transparent 74%);
    will-change: transform;
    animation: hero-fl-drift-a 46s ease-in-out infinite alternate;
  }

  .hero-fl__cloud--1 {
    inset-block-start: -12%;
    inset-inline-start: -18%;
  }

  .hero-fl__cloud--2 {
    --cloud: var(--fl-c2, #f2c3cc);
    inset-block-start: 22%;
    inset-inline-start: 38%;
    width: 70vmax;
    animation-name: hero-fl-drift-b;
    animation-duration: 58s;
    animation-delay: -20s;
  }

  .hero-fl__cloud--3 {
    --cloud: var(--fl-c3, #f1b29e);
    inset-block-end: -28%;
    inset-inline-start: 4%;
    width: 52vmax;
    animation-duration: 64s;
    animation-delay: -34s;
  }

  .hero-fl__cloud--4 {
    --cloud: var(--fl-c4, #d98da6);
    inset-block-start: -20%;
    inset-inline-end: -22%;
    width: 46vmax;
    animation-name: hero-fl-drift-b;
    animation-duration: 52s;
    animation-delay: -12s;
  }

  @keyframes hero-fl-drift-a {
    from {
      transform: translate3d(-6%, 2%, 0) scale(1);
    }

    to {
      transform: translate3d(14%, -6%, 0) scale(1.12);
    }
  }

  @keyframes hero-fl-drift-b {
    from {
      transform: translate3d(8%, -3%, 0) scale(1.08);
    }

    to {
      transform: translate3d(-12%, 7%, 0) scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fl__cloud {
      animation: none;
    }
  }

  /* The drop (first visit of the session): the title waits for the splash */
  .hero-fl[data-intro='full'] .hero-fl__line,
  .hero-fl.is-playful .hero-fl__line {
    clip-path: none;
  }

  .hero-fl[data-intro='full'] .hero-fl__line-inner {
    animation: none;
  }

  /* If the script never comes, the page still shows itself */
  .hero-fl[data-intro='full']:not([data-intro-run]) .hero-fl__title {
    animation: hero-fl-wait 0.6s ease 3.2s both;
  }

  .hero-fl[data-intro='full']:not([data-intro-run]) .hero-fl__inner::before {
    animation: hero-fl-wait 1.2s ease 3.2s both;
  }

  /* White paper until the splash; without WebGL the rose wash blooms then */
  .hero-fl[data-intro-run]:not(.is-splashed) .hero-fl__inner::before {
    opacity: 0;
    transition: none;
  }

  .hero-fl[data-intro='full'] .hero-fl__canvas {
    transition-duration: 0.5s;
    transition-delay: 0s;
  }

  .hero-fl__word {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-fl__char {
    display: inline-block;
    transform-origin: 50% 50%;
  }

  .hero-fl[data-intro='full'] .hero-fl__char {
    transition: color 0.9s ease 0.05s;
  }

  .hero-fl__char.is-wet {
    color: var(--fl-drop, #a3304a);
  }

  .hero-fl__char.is-moving {
    will-change: transform;
  }

  .hero-fl.is-playful .hero-fl__char {
    pointer-events: auto;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-fl.is-playful .hero-fl__char {
      cursor: grab;
    }
  }

  .hero-fl.is-grabbing,
  .hero-fl.is-grabbing .hero-fl__char {
    cursor: grabbing;
  }

  .hero-fl__drop,
  .hero-fl__spl,
  .hero-fl__ring {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .hero-fl__drop {
    z-index: 3;
    display: block;
    color: var(--fl-drop, #a3304a);
    transform-origin: 50% 100%;
    will-change: transform;
  }

  .hero-fl__drop svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero-fl__spl {
    z-index: 3;
    display: block;
    border-radius: 50%;
    background: var(--fl-drop, #a3304a);
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .hero-fl__ring {
    z-index: 0;
    box-sizing: border-box;
    border: 2px solid var(--fl-drop, #a3304a);
    border-radius: 50%;
    opacity: 0;
  }

  @keyframes hero-fl-wait {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-fl-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes hero-fl-rise {
    from {
      transform: translateY(112%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Accueil encre rose",
  "tag": "div",
  "class": "section-hero-fluid",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "La souris (ou le doigt sur téléphone) laisse des traînées d'encre rose qui ondulent puis s'effacent. Sans mouvement, une traînée passe d'elle-même."
    },
    {
      "type": "textarea",
      "id": "column_1",
      "label": "Colonne 1",
      "default": "VELEA\nCeinture chauffante\net massante, sans fil."
    },
    {
      "type": "textarea",
      "id": "column_2",
      "label": "Colonne 2",
      "default": "Trois niveaux de chaleur,\nquatre modes de vibration,\nenviron deux heures d’autonomie."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Prix en tête de la colonne 3",
      "default": true
    },
    {
      "type": "textarea",
      "id": "column_3",
      "label": "Colonne 3",
      "default": "Rose ou blanc."
    },
    {
      "type": "text",
      "id": "line_1",
      "label": "Titre, ligne 1",
      "default": "La chaleur d’une"
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Titre, ligne 2",
      "default": "bouillotte."
    },
    {
      "type": "text",
      "id": "line_3",
      "label": "Titre, ligne 3 (décalée)",
      "default": "Sans le fil."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Voir la ceinture"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton",
      "info": "Sans lien : la fiche du produit choisi."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Texte du lien discret",
      "default": "Toute la collection"
