    },
    {
      "type": "color",
      "id": "color_2",
      "label": "Encre 2",
      "default": "#f2c3cc"
    },
    {
      "type": "color",
      "id": "color_3",
      "label": "Encre 3",
      "default": "#f1b29e"
    },
    {
      "type": "color",
      "id": "color_4",
      "label": "Encre 4",
      "default": "#d98da6"
    },
    {
      "type": "color",
      "id": "color_5",
      "label": "Encre 5",
      "default": "#c9727e"
    }
  ],
