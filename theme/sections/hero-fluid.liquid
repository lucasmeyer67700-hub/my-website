      "default": "#a3304a"
    },
    {
      "type": "checkbox",
      "id": "clouds",
      "label": "Nuages d'encre en fond",
      "info": "Des nuages aux couleurs de l'encre apparaissent après l'animation d'entrée et dérivent lentement.",
      "default": true
