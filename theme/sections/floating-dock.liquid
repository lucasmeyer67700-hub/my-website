{%- comment -%}
  Floating menu at the bottom of the screen (« Nuit rosée » style): the brand,
  a few links and the bag. On phones it keeps the brand, the first link, a
  Menu button (opens the full menu) and the bag.
{%- endcomment -%}
{%- liquid
  assign dock_menu = section.settings.menu
  if dock_menu == blank or dock_menu.links.size == 0
    assign dock_menu = linklists['main-menu']
  endif
-%}

{%- if settings.nuit_rosee or request.design_mode -%}
  <nav class="nuit-dock" aria-label="{{ 'general.dock_navigation' | t }}" data-nuit-dock>
    <a class="nuit-dock__brand" href="{{ routes.root_url }}">
      {{- section.settings.brand | default: shop.name | escape -}}
    </a>

    <ul class="nuit-dock__links" role="list">
      {%- for link in dock_menu.links limit: 4 -%}
        <li class="nuit-dock__item{% if forloop.index > 1 %} nuit-dock__item--wide{% endif %}">
          <a
            class="nuit-dock__link"
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <button
      type="button"
      class="nuit-dock__link nuit-dock__menu"
      data-menu-trigger
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="MenuDrawer"
    >
      {{- 'general.menu' | t -}}
    </button>

    <a
      class="nuit-dock__cart"
      href="{{ routes.cart_url }}"
      data-cart-trigger
      {% if settings.cart_type == 'drawer' %}
        aria-haspopup="dialog"
      {% endif %}
    >
      <span class="nuit-dock__cart-label">{{ 'general.dock_cart' | t }}</span>
      <span class="nuit-dock__cart-icon" data-cart-icon>
        {% render 'cart-icon' %}
      </span>
    </a>
  </nav>
{%- endif -%}

{% stylesheet %}
  .nuit-dock {
    position: fixed;
    inset-block-end: max(1rem, env(safe-area-inset-bottom, 0px));
    inset-inline-start: 50%;
    z-index: 32;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.32rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    color: #fff;
    background-color: rgb(22 12 18 / 0.62);
    box-shadow:
      0 24px 50px -24px rgb(0 0 0 / 0.75),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    translate: -50% 0;
    transition:
      translate 0.5s var(--ease-reveal),
      opacity 0.4s ease;
  }

  .nuit-dock__brand {
    padding: 0.55rem 0.85rem 0.55rem 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nuit-dock__links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nuit-dock__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.95rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.84);
    text-decoration: none;
    white-space: nowrap;
    background: none;
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      color var(--duration-base) ease;

    &:hover,
    &[aria-current='page'] {
      color: #fff;
      background-color: rgb(255 255 255 / 0.1);
    }
  }

  .nuit-dock__menu {
    display: none;
  }

  .nuit-dock__cart {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: var(--font-body-weight-medium);
    color: #1d1016;
    text-decoration: none;
    white-space: nowrap;
    background-color: #fff;
    transition: background-color var(--duration-base) ease;

    &:hover {
      background-color: #fde7ee;
    }
  }

  .nuit-dock__cart-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background-color: #f6dbe3;

    & .icon {
      --icon-size: 1rem;
    }

    & .cart-count {
      position: absolute;
      inset-block-start: -0.3rem;
      inset-inline-end: -0.3rem;
      display: grid;
      place-items: center;
      min-width: 1.1rem;
      height: 1.1rem;
      padding-inline: 0.2rem;
      border-radius: 999px;
      font-size: 0.65rem;
      line-height: 1;
      color: #fff;
      background-color: #a14a5c;
    }
  }

  .nuit-dock :focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Phones: brand, first link, Menu, bag */
  @media screen and (max-width: 749px) {
    .nuit-dock__item--wide {
      display: none;
    }

    .nuit-dock__menu {
      display: inline-flex;
    }

    .nuit-dock__brand {
      padding-inline: 0.85rem 0.5rem;
    }

    .nuit-dock__link {
      padding-inline: 0.75rem;
    }
  }

  @media screen and (max-width: 359px) {
    .nuit-dock__cart-label {
      display: none;
    }

    .nuit-dock__cart {
      padding-inline-start: 0.5rem;
    }
  }

  /* Product page: the buy bar takes the bottom of the screen */
  body.has-sticky-bar .nuit-dock {
    opacity: 0;
    translate: -50% 150%;
    pointer-events: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Menu flottant (bas)",
  "tag": "div",
  "class": "section-floating-dock",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "S'affiche quand l'ambiance « Nuit rosée » est activée (Paramètres du thème → Mise en page)."
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Nom affiché",
      "default": "VELEA"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Les 4 premiers liens (ordinateur), le 1er seulement sur téléphone.",
      "default": "main-menu"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
