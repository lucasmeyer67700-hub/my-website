{%- comment -%}
  "Le fil de la goutte": the drop of the opening becomes the guide of the
  home page (assets/thread-nav.js).
  - Computer and phone: a thin rose thread on the right, one small drop per section;
    a drop slides along it as the page is read. Hover shows the name, a
    click glides to the section.
  - Phone: the same thread, nearer the edge, with drops easy to tap.
  - Each section opens with a stain of ink spreading from the thread
    (setting). Visitors who ask for less motion keep the navigation only.
  The sections are named in the setting below, by their key in the home
  template (the part after "__" in the section id).
{%- endcomment -%}
<script src="{{ 'thread-nav.js' | asset_url }}" defer="defer"></script>

<velea-thread
  class="vthread"
  {% if section.settings.ink %}
    data-ink
  {% endif %}
  data-labels="{{ section.settings.labels | escape }}"
  data-title="{{ section.settings.menu_title | escape }}"
  style="--vthread-drop: {{ section.settings.drop_color }};"
  hidden
>
  <nav class="vthread__rail" aria-label="{{ section.settings.menu_title | escape }}">
    <span class="vthread__line" aria-hidden="true"><span class="vthread__fill" data-thread-fill></span></span>
    <span class="vthread__drop" aria-hidden="true" data-thread-drop>
      <svg viewBox="0 0 20 30" focusable="false"><path d="M10 0C10 0 20 13.4 20 20A10 10 0 0 1 0 20C0 13.4 10 0 10 0Z" fill="currentColor"/></svg>
    </span>
    <ol class="vthread__list" role="list" data-thread-rail></ol>
  </nav>
</velea-thread>

{% stylesheet %}
  .vthread {
    --vthread-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --vthread-gap: 2.1rem;
    display: contents;
  }

  .vthread[hidden] {
    display: none;
  }

  /* ---------------------------------------------------------- computer */
  .vthread__rail {
    position: fixed;
    inset-block-start: 50%;
    inset-inline-end: max(1.4rem, env(safe-area-inset-right));
    z-index: calc(var(--z-sticky-bar) + 1);
    display: block;
    width: 1.5rem;
    opacity: 0;
    transform: translate(0.6rem, -50%);
    pointer-events: none;
    transition:
      opacity 0.5s var(--vthread-ease),
      transform 0.5s var(--vthread-ease);
  }

  .vthread.is-shown .vthread__rail {
    opacity: 1;
    transform: translate(0, -50%);
    pointer-events: auto;
  }

  .vthread__line {
    position: absolute;
    inset-block: 0.45rem;
    inset-inline-start: 50%;
    width: 1px;
    background: color-mix(in srgb, var(--vthread-drop) 22%, transparent);
    transform: translateX(-50%);
  }

  .vthread__fill {
    position: absolute;
    inset: 0;
    background: var(--vthread-drop);
    transform: scaleY(0);
    transform-origin: top;
  }

  .vthread__list {
    position: relative;
    display: grid;
    gap: calc(var(--vthread-gap) - 0.9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vthread__link {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 0.9rem;
    color: var(--color-text, #2b2422);
    text-decoration: none;

    &::before {
      content: '';
      width: 0.5rem;
      height: 0.5rem;
      border: 1.5px solid color-mix(in srgb, var(--vthread-drop) 70%, transparent);
      border-radius: 50%;
      background: #fff;
      transition:
        transform 0.35s var(--vthread-ease),
        background-color 0.35s ease,
        border-color 0.35s ease;
    }

    &.is-passed::before {
      border-color: var(--vthread-drop);
      background: color-mix(in srgb, var(--vthread-drop) 35%, #fff);
    }

    &[aria-current='true']::before {
      border-color: var(--vthread-drop);
      background: var(--vthread-drop);
      transform: scale(1.35);
    }

    &:hover::before,
    &:focus-visible::before {
      transform: scale(1.5);
    }

    &:focus-visible {
      outline: 2px solid var(--vthread-drop);
      outline-offset: 2px;
      border-radius: 999px;
    }
  }

  /* The name, to the left of its drop: on hover, and briefly on arrival */
  .vthread__name {
    position: absolute;
    inset-inline-end: calc(100% + 0.4rem);
    inset-block-start: 50%;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
    text-transform: uppercase;
    color: #2b2422;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 6px 18px -8px rgb(43 36 34 / 0.35);
    opacity: 0;
    transform: translate(0.4rem, -50%);
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--vthread-ease);
  }

  .vthread__link:is(:hover, :focus-visible) .vthread__name,
  .vthread__link.is-announced .vthread__name {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .vthread__drop {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    z-index: 1;
    width: 0.7rem;
    margin-inline-start: -0.35rem;
    color: var(--vthread-drop);
    filter: drop-shadow(0 2px 3px rgb(163 48 74 / 0.35));
    pointer-events: none;
    will-change: transform;

    & svg {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  /* The ink that spreads where a section opens */
  .vthread-splat {
    position: fixed;
    z-index: calc(var(--z-sticky-bar) - 1);
    width: 9rem;
    height: 9rem;
    margin: -4.5rem 0 0 -4.5rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--vthread-drop, #a3304a) 45%, transparent), transparent);
    pointer-events: none;
  }

  /* Phone: the same thread, closer to the edge, with drops easy to tap */
  @media screen and (max-width: 989px) {
    .vthread__rail {
      inset-inline-end: max(0.35rem, env(safe-area-inset-right));
    }

    .vthread__list {
      gap: 0.1rem;
    }

    .vthread__link {
      height: 1.55rem;
    }

    .vthread__name {
      font-size: 0.66rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vthread__rail {
      transition: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fil de la goutte",
  "tag": "div",
  "class": "section-thread-nav",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Un fil rose à droite, sur ordinateur comme sur téléphone, avec une goutte par section. Il apparaît après l'ouverture et disparaît au pied de page."
    },
    {
      "type": "text",
      "id": "menu_title",
      "label": "Titre du menu",
      "default": "Sur cette page"
    },
    {
      "type": "textarea",
      "id": "labels",
      "label": "Sections et leur nom",
      "info": "Une ligne par section : clé de la section, deux-points, nom affiché. Une section absente de la liste n'a pas de goutte.",
      "default": "shop_row: La boutique\nempathy: On vous comprend\npack_banner: Le pack\nbefore_after: Avant / après\nvideos: En vidéo\nstatement: Qui sommes-nous\nreviews: Les avis\nfaq: Vos questions"
    },
    {
      "type": "checkbox",
      "id": "ink",
      "label": "Passage d'encre entre les sections",
      "info": "Chaque section s'ouvre comme une tache d'encre qui s'étale depuis le fil.",
      "default": true
    },
    {
      "type": "color",
      "id": "drop_color",
      "label": "Couleur du fil",
      "default": "#a3304a"
    }
  ],
  "presets": [{ "name": "Fil de la goutte" }]
}
{% endschema %}
