{%- comment -%}
  Collection shown as large photo cards that slide sideways, with arrows
  (« Nuit rosée » style): the product name over the photo, its type and price
  in the corners.
{%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  assign products = collection.products
  if collection == blank
    assign products = collections.all.products
  endif
  assign limit = section.settings.limit
-%}

<section class="rail section" aria-labelledby="RailTitle-{{ section.id }}">
  <div class="page-width">
    <div class="rail__header reveal">
      <div class="section-header rail__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="h2" id="RailTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p class="rail__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <product-rail class="rail__body">
    <ul class="rail__track" role="list" data-rail-track tabindex="0" aria-label="{{ section.settings.heading | strip_html | escape }}">
      {%- for product in products limit: limit -%}
        <li class="rail__item">
          <a class="rail__card" href="{{ product.url }}">
            <span class="rail__media">
              {%- if product.featured_media -%}
                {% render 'responsive-image',
                  image: product.featured_media.preview_image,
                  sizes: '(min-width: 990px) 30vw, 78vw',
                  widths: '400, 600, 800, 1000, 1200',
                  alt: '',
                  class: 'rail__image'
                %}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg rail__image' }}
              {%- endif -%}
            </span>
            <span class="rail__name">{{ product.title | escape }}</span>
            <span class="rail__meta">
              <span>{{ product.type | default: collection.title | escape }}</span>
              <span class="rail__price">
                {%- if product.price_varies -%}
                  {%- assign rail_price_min = product.price_min | money -%}
                  {{ 'products.price_from' | t: price: rail_price_min }}
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </span>
            </span>
          </a>
        </li>
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="rail__item">
            <span class="rail__card">
              <span class="rail__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg rail__image' }}</span>
              <span class="rail__name">{{ 'sections.rail_placeholder' | t }}</span>
            </span>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>

    <div class="page-width rail__controls">
      <button type="button" class="rail__arrow" data-rail-prev aria-label="{{ 'general.slider_previous' | t }}">
        {% render 'icon', icon: 'arrow-right' %}
      </button>
      <button type="button" class="rail__arrow" data-rail-next aria-label="{{ 'general.slider_next' | t }}">
        {% render 'icon', icon: 'arrow-right' %}
      </button>
      {%- if section.settings.link_label != blank -%}
        <a class="rail__all" href="{{ collection.url | default: routes.all_products_collection_url }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </product-rail>
</section>

{% stylesheet %}
  .rail__header {
    display: grid;
    gap: 1rem 3rem;
    margin-block-end: clamp(1.75rem, 1.3rem + 2vw, 3rem);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .rail__intro {
    margin: 0;
    text-align: start;
    justify-items: start;
  }

  .rail__text {
    max-width: 26rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .rail__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 22rem);
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    margin: 0;
    padding-block: 0.25rem;
    padding-inline: max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter)));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter)));
    scrollbar-width: none;
    list-style: none;

    &::-webkit-scrollbar {
      display: none;
    }

    &:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 4px;
    }

    @media screen and (min-width: 990px) {
      grid-auto-columns: calc((min(100vw, var(--page-width)) - 2 * var(--gutter) - 2 * 1.25rem) / 3);
    }
  }

  ul.rail__track[role='list'] {
    padding-inline: max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter)));
  }

  .rail__item {
    scroll-snap-align: start;
  }

  .rail__card {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    color: #fff;
    text-decoration: none;
    background-color: var(--gallery-bg);
    isolation: isolate;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      background: linear-gradient(180deg, rgb(15 8 12 / 0) 45%, rgb(15 8 12 / 0.72) 100%);
      pointer-events: none;
    }

    &:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }
  }

  .rail__media {
    position: absolute;
    inset: 0;
  }

  .rail__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1.2s var(--ease-reveal);
  }

  .rail__card:hover .rail__image {
    scale: 1.05;
  }

  .rail__name {
    position: absolute;
    inset-inline: 1.25rem;
    inset-block-end: 3.4rem;
    z-index: 1;
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-align: center;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
  }

  .rail__meta {
    position: absolute;
    inset-inline: 1.25rem;
    inset-block-end: 1.1rem;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.88);
  }

  .rail__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .rail__arrow {
    display: inline-grid;
    place-items: center;
    width: var(--tap-target);
    height: var(--tap-target);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: inherit;
    background: none;
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      opacity var(--duration-base) ease;

    &:hover {
      background-color: rgb(var(--color-text-rgb) / 0.08);
    }

    &[disabled] {
      opacity: 0.35;
      cursor: default;
    }

    &[hidden] {
      display: none;
    }

    &[data-rail-prev] .icon {
      rotate: 180deg;
    }

    & .icon {
      --icon-size: 1rem;
    }
  }

  .rail__all {
    margin-inline-start: auto;
    font-size: var(--text-sm);
    color: inherit;
    text-underline-offset: 0.35em;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('product-rail')) {
    customElements.define(
      'product-rail',
      class ProductRail extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-rail-track]');
          this.prev = this.querySelector('[data-rail-prev]');
          this.next = this.querySelector('[data-rail-next]');
          if (!this.track) return;
          const step = () => {
            const item = this.track.querySelector('li');
            return item ? item.getBoundingClientRect().width + parseFloat(getComputedStyle(this.track).columnGap || 0) : 300;
          };
          const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
          this.prev?.addEventListener('click', () => this.track.scrollBy({ left: -step(), behavior }));
          this.next?.addEventListener('click', () => this.track.scrollBy({ left: step(), behavior }));
          const sync = () => {
            const max = this.track.scrollWidth - this.track.clientWidth - 2;
            // All cards already visible: no arrows.
            const fits = max <= 0;
            if (this.prev) {
              this.prev.hidden = fits;
              this.prev.disabled = this.track.scrollLeft <= 2;
            }
            if (this.next) {
              this.next.hidden = fits;
              this.next.disabled = this.track.scrollLeft >= max;
            }
          };
          this.track.addEventListener('scroll', sync, { passive: true });
          window.addEventListener('resize', sync);
          sync();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Collection défilante",
  "tag": "div",
  "class": "section-product-rail",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "La collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Explorez <em>nos essentiels.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nombre de produits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texte du lien vers la collection",
      "default": "Tout voir"
    }
  ],
  "presets": [{ "name": "Collection défilante" }]
}
{% endschema %}
