{%- comment -%}
  The VELEA assistant: a pink button bottom right that opens a chat-like
  panel. The visitor types any question (or picks a suggested topic): the
  assistant answers at once with the merchant's own texts when the question
  matches a topic's keywords (real prices from the store). Health questions
  get the theme's caution notice. Anything else goes to the Shopify Inbox
  chat and its AI agent when the chat option is on, otherwise to the contact
  form with the question already written in. Nothing is stored by this panel.
{%- endcomment -%}
{%- liquid
  assign contact_link = section.settings.contact_link | default: routes.root_url
-%}
{%- if section.settings.enabled -%}
  <velea-assistant
    class="assistant"
    data-section-id="{{ section.id }}"
    data-replace-inbox="{% if section.settings.use_chat %}{{ section.settings.replace_inbox }}{% else %}true{% endif %}"
    data-nudge="{{ section.settings.show_nudge }}"
    data-chat="{{ section.settings.use_chat }}"
    data-contact-url="{{ contact_link }}"
    data-health-keywords="{{ 'assistant.health_keywords' | t | escape }}"
    data-hello-keywords="{{ 'assistant.hello_keywords' | t | escape }}"
    data-thanks-keywords="{{ 'assistant.thanks_keywords' | t | escape }}"
  >
    <p class="assistant__nudge" data-assistant-nudge hidden>
      <button type="button" class="assistant__nudge-open" data-assistant-open>
        {{- section.settings.nudge | escape -}}
      </button>
      <button type="button" class="assistant__nudge-close" data-assistant-nudge-close aria-label="{{ 'assistant.nudge_close' | t }}">
        {%- render 'icon', icon: 'close' -%}
      </button>
    </p>

    <div
      class="assistant__panel"
      id="Assistant-{{ section.id }}"
      role="dialog"
      aria-modal="false"
      aria-labelledby="AssistantTitle-{{ section.id }}"
      data-assistant-panel
      hidden
    >
      <div class="assistant__header">
        <span class="assistant__avatar{% if section.settings.avatar != blank %} assistant__avatar--logo{% endif %}" aria-hidden="true">
          {%- if section.settings.avatar != blank -%}
            {%- assign avatar = section.settings.avatar -%}
            <img
              class="assistant__avatar-logo"
              src="{{ avatar | image_url: height: 64 }}"
              srcset="{{ avatar | image_url: height: 32 }} 1x, {{ avatar | image_url: height: 64 }} 2x, {{ avatar | image_url: height: 96 }} 3x"
              width="{{ 32 | times: avatar.aspect_ratio | round }}"
              height="32"
              alt=""
              loading="lazy"
            >
          {%- else -%}
            <span class="assistant__avatar-drop"></span>
          {%- endif -%}
        </span>
        <div class="assistant__identity">
          <p class="assistant__title" id="AssistantTitle-{{ section.id }}" tabindex="-1" data-assistant-title>
            {{- section.settings.title | escape -}}
          </p>
          <p class="assistant__status">
            <span class="assistant__status-dot" aria-hidden="true"></span>
            {{- section.settings.status | escape -}}
          </p>
        </div>
        <button type="button" class="assistant__icon-button" data-assistant-restart aria-label="{{ 'assistant.restart' | t }}">
          {%- render 'icon', icon: 'refresh' -%}
        </button>
        <button type="button" class="assistant__icon-button" data-assistant-close aria-label="{{ 'general.close' | t }}">
          {%- render 'icon', icon: 'close' -%}
        </button>
      </div>

      <div class="assistant__log" role="log" aria-live="polite" data-assistant-log></div>

      <div class="assistant__choices" role="group" aria-label="{{ 'assistant.topics_label' | t }}" data-assistant-choices hidden>
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="assistant__chip"
            data-assistant-topic="{{ block.id }}"
            data-keywords="{{ block.settings.keywords | escape }}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.question | escape -}}
          </button>
        {%- endfor -%}
      </div>

      <form class="assistant__composer" novalidate data-assistant-form>
        <label class="visually-hidden" for="AssistantQuestion-{{ section.id }}">{{ 'assistant.question_label' | t }}</label>
        <textarea
          class="assistant__input"
          id="AssistantQuestion-{{ section.id }}"
          rows="1"
          maxlength="400"
          placeholder="{{ section.settings.input_placeholder | escape }}"
          enterkeyhint="send"
          autocomplete="off"
          data-assistant-input
        ></textarea>
        <button type="submit" class="assistant__send" aria-label="{{ 'assistant.send' | t }}" disabled data-assistant-send>
          {%- render 'icon', icon: 'arrow-up' -%}
        </button>
      </form>

      <p class="assistant__fineprint">
        {%- if section.settings.fineprint != blank -%}
          <span>{{ section.settings.fineprint | escape }}</span>
        {%- endif -%}
        {%- if section.settings.use_chat -%}
          <button type="button" class="assistant__fineprint-link" data-assistant-ai>{{ section.settings.ai_label | escape }}</button>
        {%- else -%}
          <a class="assistant__fineprint-link" href="{{ contact_link }}" data-assistant-contact>{{ section.settings.contact_button_label | escape }}</a>
        {%- endif -%}
      </p>
    </div>

    <button
      type="button"
      class="assistant__launcher"
      aria-expanded="false"
      aria-controls="Assistant-{{ section.id }}"
      data-assistant-toggle
    >
      <span class="assistant__launcher-icon" aria-hidden="true">
        {%- render 'icon', icon: 'chat', class: 'assistant__launcher-chat' -%}
        {%- render 'icon', icon: 'close', class: 'assistant__launcher-close' -%}
      </span>
      <span class="assistant__launcher-label">{{ section.settings.launcher_label | escape }}</span>
    </button>

    {%- comment -%} Messages, cloned into the conversation by theme.js {%- endcomment -%}
    <template data-assistant-template="greeting">{{ section.settings.greeting }}</template>
    <template data-assistant-template="next"><p>{{ section.settings.next_text | escape }}</p></template>
    <template data-assistant-template="ai-missing">
      <p>{{ 'assistant.ai_missing' | t }}</p>
      <a class="assistant__link" href="{{ contact_link }}" data-assistant-mail>
        {{- section.settings.contact_button_label | escape -}}
        {%- render 'icon', icon: 'arrow-right' -%}
      </a>
    </template>
    <template data-assistant-template="unknown">
      <p>{{ section.settings.unknown_text | escape }}</p>
      <a class="assistant__link" href="{{ contact_link }}" data-assistant-mail>
        {{- section.settings.contact_button_label | escape -}}
        {%- render 'icon', icon: 'arrow-right' -%}
      </a>
    </template>
    <template data-assistant-template="handover"><p>{{ 'assistant.handover' | t }}</p></template>
    <template data-assistant-template="health">
      {%- if settings.health_notice != blank -%}
        <p>{{ settings.health_notice | escape }}</p>
      {%- endif -%}
      <p>{{ 'assistant.health_more' | t }}</p>
      {%- if section.settings.health_link != blank -%}
        <a class="assistant__link" href="{{ section.settings.health_link }}">
          {{- 'assistant.health_link' | t -}}
          {%- render 'icon', icon: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </template>
    <template data-assistant-template="hello"><p>{{ 'assistant.hello_text' | t }}</p></template>
    <template data-assistant-template="thanks"><p>{{ 'assistant.thanks_text' | t }}</p></template>
    {%- for block in section.blocks -%}
      {%- liquid
        assign topic_product = block.settings.product
        assign topic_link = block.settings.link
        if topic_link == blank and topic_product != blank
          assign topic_link = topic_product.url
        endif
      -%}
      <template data-assistant-template="{{ block.id }}">
        {{ block.settings.answer }}
        {%- if topic_product != blank -%}
          <a class="assistant__product" href="{{ topic_product.url }}">
            <span class="assistant__product-media media">
              {%- if topic_product.featured_media -%}
                {% render 'responsive-image', image: topic_product.featured_media.preview_image, sizes: '64px', widths: '64, 128, 192', decorative: true %}
              {%- else -%}
                <span class="product-card__soon-art" aria-hidden="true">
                  <span class="product-card__soon-drop"></span>
                </span>
              {%- endif -%}
            </span>
            <span class="assistant__product-info">
              <span class="assistant__product-title">{{ topic_product.title | escape }}</span>
              <span class="assistant__product-price">
                {%- if topic_product.price_varies -%}
                  {%- assign price_min_text = topic_product.price_min | money -%}
                  {{ 'products.price_from' | t: price: price_min_text }}
                {%- else -%}
                  {{ topic_product.price | money }}
                {%- endif -%}
              </span>
            </span>
          </a>
        {%- endif -%}
        {%- if topic_link != blank and block.settings.link_label != blank -%}
          <a class="assistant__link" href="{{ topic_link }}">
            {{- block.settings.link_label | escape -}}
            {%- render 'icon', icon: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </template>
    {%- endfor -%}
  </velea-assistant>
{%- endif -%}

{% stylesheet %}
  /* While the assistant is on, Shopify Inbox's own bubble stays hidden until
     the visitor asks for the chat (then Inbox takes over the corner). Without
     the chat option, the bubble stays hidden. */
  html.has-assistant:not(.is-inbox-open) #shopify-chat,
  html.has-assistant:not(.is-inbox-open) #ShopifyChat,
  html.has-assistant:not(.is-inbox-open) inbox-online-store-chat {
    /* !important: Inbox sets its own inline display */
    display: none !important;
  }

  html.is-inbox-open .assistant__launcher,
  html.is-inbox-open .assistant__nudge {
    display: none;
  }

  .assistant {
    /* White text stays readable (4.5:1 or more) across the whole gradient */
    --assistant-rose: #a24c5d;
    --assistant-rose-light: #b4596a;
    --assistant-edge: max(1rem, env(safe-area-inset-right));
    --assistant-bottom: max(1rem, env(safe-area-inset-bottom));

    position: fixed;
    inset-inline-end: var(--assistant-edge);
    inset-block-end: var(--assistant-bottom);
    z-index: calc(var(--z-sticky-bar) + 2);
    display: grid;
    justify-items: end;
    gap: var(--space-xs);
    font-family: var(--font-body-family);
    pointer-events: none;
    transition: inset-block-end var(--duration-base) var(--ease-out);

    & > * {
      pointer-events: auto;
    }
  }

  /* Product page: when the floating buy bar shows, the assistant sits above it */
  body.has-sticky-bar .assistant {
    inset-block-end: calc(var(--assistant-bottom) + 5rem);
  }

  /* Launcher: a rose pill that slides in, then breathes twice */
  .assistant__launcher {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.5rem;
    padding: 0.4rem 1.25rem 0.4rem 0.4rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.02em;
    color: #fff;
    background-color: var(--assistant-rose);
    background-image: linear-gradient(135deg, var(--assistant-rose-light) 0%, var(--assistant-rose) 100%);
    box-shadow:
      0 14px 30px -12px rgb(162 76 93 / 0.65),
      inset 0 1px 0 rgb(255 255 255 / 0.25);
    cursor: pointer;
    animation: assistant-arrive 0.7s var(--ease-out) 0.8s both;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: 0 0 0 0 rgb(201 114 126 / 0.55);
      animation: assistant-breathe 2.4s ease-out 1.8s 2;
      pointer-events: none;
    }

    &:hover {
      transform: translateY(-2px);
      box-shadow:
        0 18px 36px -12px rgb(180 89 106 / 0.75),
        inset 0 1px 0 rgb(255 255 255 / 0.25);
    }

    &:focus-visible {
      outline: 2px solid var(--assistant-rose);
      outline-offset: 3px;
    }

    @media screen and (max-width: 749px) {
      min-height: 3.5rem;
      padding: 0.4rem;

      & .assistant__launcher-label {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }
  }

  .assistant.is-tucked .assistant__launcher {
    opacity: 0;
    transform: translateY(1rem) scale(0.9);
    pointer-events: none;
  }

  .assistant__launcher-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    color: var(--assistant-rose);
    background-color: #fff;

    & .icon {
      --icon-size: 1.25rem;

      grid-area: 1 / 1;
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out);
    }
  }

  .assistant__launcher-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .assistant__launcher[aria-expanded='true'] {
    & .assistant__launcher-chat {
      opacity: 0;
      transform: rotate(90deg) scale(0.6);
    }

    & .assistant__launcher-close {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes assistant-arrive {
    from {
      opacity: 0;
      transform: translateY(1.25rem) scale(0.92);
    }
  }

  @keyframes assistant-breathe {
    to {
      box-shadow: 0 0 0 1rem rgb(201 114 126 / 0);
    }
  }

  /* A small note above the button, once per visit */
  .assistant__nudge {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    max-width: min(18rem, calc(100vw - 2rem));
    margin: 0;
    padding: 0.35rem 0.35rem 0.35rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg) var(--radius-lg) 0.4rem var(--radius-lg);
    background-color: var(--color-surface, #fff);
    box-shadow: var(--shadow-md);
    animation: assistant-pop 0.5s var(--ease-out) both;

    &[hidden] {
      display: none;
    }
  }

  .assistant__nudge-open {
    padding: 0.4rem 0;
    border: 0;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.4;
    text-align: start;
    color: var(--color-text);
    background: none;
    cursor: pointer;
  }

  .assistant__nudge-close {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--color-text-muted);
    background: none;
    cursor: pointer;

    & .icon {
      --icon-size: 0.9rem;
    }
  }

  @keyframes assistant-pop {
    from {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.96);
    }
  }

  /* Panel: opens from the button, like a card lifting off the page */
  .assistant__panel {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto auto;
    width: min(25rem, calc(100vw - 2rem));
    height: min(40rem, calc(100dvh - 7.5rem));
    overflow: hidden;
    border: 1px solid rgb(var(--warm-rgb) / 0.18);
    border-radius: 1.5rem;
    color: var(--color-text);
    background: linear-gradient(180deg, #fffdfc 0%, var(--color-background) 100%);
    box-shadow:
      0 40px 80px -30px rgb(48 39 36 / 0.45),
      0 0 0 1px rgb(255 255 255 / 0.6) inset;
    opacity: 0;
    transform: translateY(1rem) scale(0.95);
    transform-origin: bottom right;
    transition:
      opacity 0.28s var(--ease-out),
      transform 0.38s var(--ease-out);

    &[hidden] {
      display: none;
    }

    .assistant.is-open & {
      opacity: 1;
      transform: none;
    }

    @media screen and (max-width: 749px) {
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      width: 100%;
      height: min(85dvh, 40rem);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      transform: translateY(100%);
      transform-origin: bottom center;
    }
  }

  .assistant__header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-sm) var(--space-sm) var(--space-md);
    border-block-end: 1px solid rgb(var(--warm-rgb) / 0.14);
    background: linear-gradient(135deg, #fbf1f2 0%, #f6e3e6 100%);
  }

  .assistant__avatar {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: #fff;
    box-shadow: 0 6px 14px -8px rgb(180 89 106 / 0.6);
  }

  /* The shop's logo in the avatar: the same monogram as in the header */
  .assistant__avatar--logo {
    box-shadow:
      0 0 0 1px rgb(var(--rose-strong-rgb) / 0.25),
      0 6px 14px -8px rgb(180 89 106 / 0.6);
  }

  .assistant__avatar-logo {
    display: block;
    width: auto;
    max-width: 1.875rem;
    height: 1.75rem;
    object-fit: contain;
  }

  .assistant__avatar-drop {
    width: 1.15rem;
    aspect-ratio: 1;
    border-radius: 50% 0 50% 50%;
    background:
      radial-gradient(circle at 44% 30%, rgb(255 255 255 / 0.95) 0 7%, transparent 20%),
      linear-gradient(225deg, #f9e3e7 0%, #ecbcc5 55%, #dc97a4 100%);
    rotate: -45deg;
    animation: assistant-float 4.8s ease-in-out infinite;
  }

  @keyframes assistant-float {
    50% {
      translate: 0 -0.15rem;
    }
  }

  .assistant__title {
    font-family: var(--font-heading-family);
    font-size: 1.1875rem;
    line-height: 1.2;

    &:focus {
      outline: none;
    }
  }

  .assistant__status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    overflow: hidden;
    white-space: nowrap;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .assistant__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: #3f8f5b;
    box-shadow: 0 0 0 3px rgb(63 143 91 / 0.18);
  }

  .assistant__icon-button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--color-text);
    background: rgb(255 255 255 / 0.55);
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease-out);

    &:hover {
      background-color: #fff;
    }

    & .icon {
      --icon-size: 1.05rem;
    }
  }

  /* Conversation */
  .assistant__log {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    overflow-y: auto;
    padding: var(--space-md);
    overscroll-behavior: contain;
    scroll-behavior: smooth;
  }

  .assistant__msg {
    max-width: 88%;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
    animation: assistant-message 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;

    & p + p {
      margin-block-start: 0.5rem;
    }
  }

  .assistant__msg--bot {
    align-self: flex-start;
    display: grid;
    gap: 0.65rem;
    border: 1px solid rgb(var(--warm-rgb) / 0.16);
    border-radius: 0.4rem 1.25rem 1.25rem 1.25rem;
    background-color: #fff;
    box-shadow: 0 12px 28px -22px rgb(48 39 36 / 0.55);
  }

  .assistant__msg--user {
    align-self: flex-end;
    border-radius: 1.25rem 0.4rem 1.25rem 1.25rem;
    color: #fff;
    background-color: var(--color-button, #49352f);
    white-space: pre-line;
  }

  @keyframes assistant-message {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
  }

  .assistant__typing {
    align-self: flex-start;
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem var(--radius-lg) var(--radius-lg) var(--radius-lg);
    background-color: var(--color-surface, #fff);

    & span {
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      background-color: var(--assistant-rose-light);
      animation: assistant-dot 1s ease-in-out infinite;
    }

    & span:nth-child(2) {
      animation-delay: 0.15s;
    }

    & span:nth-child(3) {
      animation-delay: 0.3s;
    }
  }

  @keyframes assistant-dot {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }

    30% {
      opacity: 1;
      transform: translateY(-0.25rem);
    }
  }

  .assistant__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: start;
    font-weight: var(--font-body-weight-medium);
    color: var(--assistant-rose);
    text-decoration: none;

    & .icon {
      --icon-size: 0.9rem;
      transition: transform var(--duration-base) var(--ease-out);
    }

    &:hover .icon {
      transform: translateX(0.2rem);
    }
  }

  .assistant__product {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    background-color: var(--color-background);
    transition: border-color var(--duration-base) var(--ease-out);

    &:hover {
      border-color: var(--assistant-rose-light);
    }
  }

  .assistant__product-media {
    --media-ratio: 1;

    border-radius: var(--radius-sm);
  }

  .assistant__product-info {
    display: grid;
    gap: 0.1rem;
  }

  .assistant__product-title {
    font-family: var(--font-heading-family);
    font-size: 1rem;
    line-height: 1.25;
  }

  .assistant__product-price {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Suggested topics: one row of pills that scrolls sideways */
  .assistant__choices {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding: 0.15rem var(--space-md) var(--space-xs);
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent);
    mask-image: linear-gradient(90deg, #000 88%, transparent);

    &::-webkit-scrollbar {
      display: none;
    }

    &[hidden] {
      display: none;
    }
  }

  .assistant__chip {
    flex: none;
    min-height: 2.75rem;
    padding: 0.45rem 1rem;
    border: 1px solid rgb(var(--rose-cta-rgb, 162 76 93) / 0.35);
    border-radius: 999px;
    font: inherit;
    font-size: var(--text-sm);
    white-space: nowrap;
    color: var(--assistant-rose);
    background-color: #fff;
    cursor: pointer;
    animation: assistant-message 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    transition:
      color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);

    &:nth-child(2) {
      animation-delay: 0.06s;
    }

    &:nth-child(3) {
      animation-delay: 0.12s;
    }

    &:nth-child(4) {
      animation-delay: 0.18s;
    }

    &:nth-child(n + 5) {
      animation-delay: 0.24s;
    }

    &[data-seen] {
      border-color: var(--color-border);
      color: var(--color-text-muted);
    }

    /* Hover only with a mouse: a tapped chip must not stay filled on phones */
    @media (hover: hover) {
      &:hover {
        border-color: var(--assistant-rose);
        color: #fff;
        background-color: var(--assistant-rose);
      }
    }
  }

  /* Question field: a soft pill with a round send button */
  .assistant__composer {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    margin: 0 var(--space-sm);
    padding: 0.35rem 0.35rem 0.35rem 1.1rem;
    border: 1px solid rgb(var(--warm-rgb) / 0.3);
    border-radius: 1.6rem;
    background-color: #fff;
    box-shadow: 0 12px 26px -22px rgb(48 39 36 / 0.6);
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);

    &:focus-within {
      border-color: var(--assistant-rose);
      box-shadow:
        0 0 0 3px rgb(162 76 93 / 0.14),
        0 12px 26px -22px rgb(48 39 36 / 0.6);
    }
  }

  .assistant__input {
    flex: 1 1 auto;
    min-width: 0;
    max-height: 7.5rem;
    margin: 0;
    padding: 0.65rem 0;
    border: 0;
    outline: none;
    /* 16px: no zoom on iPhone when the field gets focus */
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-text);
    background: none;
    resize: none;

    &::placeholder {
      color: var(--color-text-muted);
      opacity: 1;
    }
  }

  .assistant__send {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background-color: var(--assistant-rose);
    background-image: linear-gradient(135deg, var(--assistant-rose-light) 0%, var(--assistant-rose) 100%);
    cursor: pointer;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);

    & .icon {
      --icon-size: 1.15rem;
      stroke-width: 2;
    }

    &:disabled {
      opacity: 0.4;
      cursor: default;
    }

    &:not(:disabled):active {
      transform: scale(0.92);
    }

    &:focus-visible {
      outline: 2px solid var(--assistant-rose);
      outline-offset: 2px;
    }
  }

  .assistant__fineprint {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 0.35rem;
    margin: 0;
    padding: 0.35rem var(--space-md) max(0.6rem, env(safe-area-inset-bottom));
    font-size: var(--text-xs);
    line-height: 1.4;
    text-align: center;
    color: var(--color-text-muted);
  }

  .assistant__fineprint-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    font: inherit;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: rgb(var(--warm-rgb) / 0.5);
    text-underline-offset: 0.2em;
    background: none;
    cursor: pointer;
  }

  /* Phones: the panel is a sheet; the button hides while it is open */
  @media screen and (max-width: 749px) {
    .assistant.is-open .assistant__launcher {
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .assistant__launcher,
    .assistant__launcher::after,
    .assistant__nudge,
    .assistant__avatar-drop,
    .assistant__msg,
    .assistant__chip,
    .assistant__typing span {
      animation: none;
    }

    .assistant__panel {
      transition: none;
    }
  }
{% endstylesheet %}

