{%- liquid
  assign form_id = 'WelcomeForm-' | append: section.id
  assign offer_product = section.settings.product
  assign percent = section.settings.percent

  comment
    Shopify applies a code from /discount/CODE and then opens the redirect page.
  endcomment
  assign discount_base = routes.root_url | append: '/discount/' | replace: '//', '/'
  assign redirect_url = section.settings.redirect
  if redirect_url == blank and offer_product
    assign redirect_url = offer_product.url
  endif
  assign redirect_url = redirect_url | default: routes.all_products_collection_url

  comment
    Price with the code, rounded the way the checkout rounds a percentage.
  endcomment
  if offer_product
    assign offer_price = offer_product.price_min
    assign offer_saving = offer_price | times: percent | divided_by: 100.0 | round
    assign offer_new_price = offer_price | minus: offer_saving
    assign offer_new_price_text = offer_new_price | money
  endif

  assign visual_image = section.settings.image
  if visual_image == blank and offer_product.featured_media
    assign visual_image = offer_product.featured_media.preview_image
  endif

  assign show_popup = section.settings.enabled
  if customer and customer.accepts_marketing
    assign show_popup = false
  endif
  if request.page_type == 'password'
    assign show_popup = false
  endif
-%}
{%- if show_popup or request.design_mode -%}
  <welcome-popup
    data-delay="{{ section.settings.delay | times: 1000 }}"
    data-snooze-days="{{ section.settings.snooze_days }}"
    data-section-id="{{ section.id }}"
    {% if request.design_mode %}
      data-design-mode
    {% endif %}
  >
    <dialog
      class="welcome-popup color-{{ section.settings.color_scheme }}"
      aria-labelledby="WelcomeTitle-{{ section.id }}"
      aria-describedby="WelcomeText-{{ section.id }}"
      data-welcome-dialog
    >
      <div class="welcome-popup__panel">
        <button
          type="button"
          class="icon-button welcome-popup__close"
          data-welcome-close
          aria-label="{{ 'general.close' | t }}"
        >
          {% render 'icon', icon: 'close' %}
        </button>

        <div
          class="welcome-popup__visual{% if visual_image != blank %} welcome-popup__visual--image{% else %} has-drops{% endif %}"
          aria-hidden="true"
        >
          {%- if visual_image != blank -%}
            {% render 'responsive-image',
              image: visual_image,
              sizes: '(min-width: 750px) 24rem, 100vw',
              widths: '400, 600, 800, 1000',
              decorative: true,
              class: 'welcome-popup__image'
            %}
          {%- else -%}
            {% render 'drops', density: 'light' %}
          {%- endif -%}
          <span class="welcome-popup__seal">
            <span class="welcome-popup__seal-value">−{{ percent }}&nbsp;%</span>
            <span class="welcome-popup__seal-label">{{ section.settings.seal_label | escape }}</span>
          </span>
          {%- if settings.brand_tagline != blank and visual_image == blank -%}
            <span class="welcome-popup__tagline">{{ settings.brand_tagline | escape }}</span>
          {%- endif -%}
        </div>

        <div class="welcome-popup__body">
          {%- form 'customer', id: form_id, class: 'welcome-popup__form', novalidate: 'novalidate' -%}
            {%- if form.posted_successfully? -%}
              <div class="welcome-popup__content" data-welcome-success>
                <span class="welcome-popup__check">{% render 'icon', icon: 'check' %}</span>
                <p class="eyebrow eyebrow--center">{{ 'welcome.success_eyebrow' | t }}</p>
                <h2 class="welcome-popup__title h3" id="WelcomeTitle-{{ section.id }}" tabindex="-1" autofocus>
                  {{- section.settings.success_heading | escape -}}
                </h2>
                <p class="welcome-popup__text" id="WelcomeText-{{ section.id }}">
                  {{- section.settings.success_text | escape -}}
                </p>
                {%- if section.settings.code != blank -%}
                  <copy-button class="welcome-popup__code" data-copy="{{ section.settings.code | escape }}">
                    <span class="welcome-popup__code-value">{{ section.settings.code | escape }}</span>
                    <button type="button" class="button button--secondary button--small">{{ 'gift_card.copy' | t }}</button>
                    <span class="visually-hidden" data-copy-status hidden>{{ 'gift_card.copied' | t }}</span>
                  </copy-button>
                  <a
                    class="button button--full"
                    href="{{ discount_base }}{{ section.settings.code | url_encode }}?redirect={{ redirect_url | url_encode }}"
                  >
                    {%- if offer_product -%}
                      {{- 'welcome.use_code_price' | t: price: offer_new_price_text -}}
                    {%- else -%}
                      {{- 'welcome.use_code' | t -}}
                    {%- endif -%}
                    {% render 'icon', icon: 'arrow-right' %}
                  </a>
                  <p class="welcome-popup__note">{{ 'welcome.auto_applied' | t }}</p>
                {%- endif -%}
                <button type="button" class="text-button welcome-popup__later" data-welcome-close>
                  {{- 'welcome.keep_browsing' | t -}}
                </button>
                {%- if section.settings.conditions != blank -%}
                  <p class="welcome-popup__legal">{{ section.settings.conditions | escape }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="welcome-popup__content">
                <input type="hidden" name="contact[tags]" value="newsletter,popup-bienvenue">
                {%- if section.settings.eyebrow != blank -%}
                  <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
                {%- endif -%}
                <h2 class="welcome-popup__title h2" id="WelcomeTitle-{{ section.id }}" tabindex="-1" autofocus>
                  {{- section.settings.heading -}}
                </h2>
                <p class="welcome-popup__text" id="WelcomeText-{{ section.id }}">
                  {{- section.settings.text | escape -}}
                </p>

                {%- if offer_product -%}
                  <div class="welcome-popup__offer">
                    <span class="welcome-popup__offer-thumb">
                      {%- if offer_product.featured_media -%}
                        {{
                          offer_product.featured_media.preview_image
                          | image_url: width: 160
                          | image_tag: width: 56, height: 56, alt: '', loading: 'lazy', class: 'welcome-popup__offer-image'
                        }}
                      {%- else -%}
                        <span class="welcome-popup__offer-drop"></span>
                      {%- endif -%}
                    </span>
                    <span class="welcome-popup__offer-details">
                      <span class="welcome-popup__offer-name">{{ section.settings.offer_label | escape }}</span>
                      <span class="welcome-popup__offer-prices">
                        <s class="welcome-popup__offer-old">
                          <span class="visually-hidden">{{ 'welcome.regular_price' | t }}</span>
                          {{- offer_price | money -}}
                        </s>
                        <strong class="welcome-popup__offer-new">
                          <span class="visually-hidden">{{ 'welcome.price_with_code' | t }}</span>
                          {{- offer_new_price_text -}}
                        </strong>
                        <span class="welcome-popup__offer-hint" aria-hidden="true">{{ 'welcome.with_code' | t }}</span>
                      </span>
                    </span>
                  </div>
                {%- endif -%}

                {%- if form.errors -%}
                  <p
                    class="form-message form-message--error"
                    role="alert"
                    id="WelcomeError-{{ section.id }}"
                    data-welcome-error
                  >
                    {% render 'icon', icon: 'alert' %}
                    <span>{{ 'welcome.error' | t }}</span>
                  </p>
                {%- endif -%}

                <div class="welcome-popup__fields">
                  <div class="field">
                    <label class="visually-hidden" for="WelcomeEmail-{{ section.id }}">
                      {{- 'newsletter.label' | t -}}
                    </label>
                    <input
                      class="field__input"
                      type="email"
                      id="WelcomeEmail-{{ section.id }}"
                      name="contact[email]"
                      autocomplete="email"
                      autocapitalize="off"
                      spellcheck="false"
                      required
                      placeholder="{{ 'newsletter.placeholder' | t }}"
                      {% if form.errors %}
                        aria-invalid="true"
                        aria-describedby="WelcomeError-{{ section.id }}"
                      {% endif %}
                    >
                  </div>
                  <button type="submit" class="button button--full">
                    {{- section.settings.button_label | escape -}}
                  </button>
                </div>

                {%- if settings.shipping_info != blank or settings.returns_info != blank -%}
                  <ul class="welcome-popup__perks" role="list">
                    {%- if settings.shipping_info != blank -%}
                      <li>{% render 'icon', icon: 'truck' %}<span>{{ settings.shipping_info | escape }}</span></li>
                    {%- endif -%}
                    {%- if settings.returns_info != blank -%}
                      <li>{% render 'icon', icon: 'return' %}<span>{{ settings.returns_info | escape }}</span></li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}

                <p class="welcome-popup__legal">
                  {{ 'welcome.consent' | t }}
                  {%- if section.settings.conditions != blank %} {{ section.settings.conditions | escape }}{% endif -%}
                  {%- if shop.privacy_policy %}
                    <a href="{{ shop.privacy_policy.url }}">{{ 'welcome.privacy' | t }}</a>
                  {%- endif -%}
                </p>
                <button type="button" class="text-button welcome-popup__later" data-welcome-close>
                  {{- 'welcome.no_thanks' | t -}}
                </button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </dialog>
  </welcome-popup>
{%- endif -%}

{% stylesheet %}
  .welcome-popup {
    width: min(100% - 2rem, 56rem);
    max-height: min(100dvh - 2rem, 46rem);
    padding: 0;
    border: 1px solid var(--warm-hairline);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    box-shadow: 0 40px 100px -40px rgb(48 39 36 / 0.55);
    overflow: auto;
    overscroll-behavior: contain;

    &::backdrop {
      background-color: rgb(var(--palette-scrim-rgb) / 0.5);
      backdrop-filter: blur(4px);
    }

    &[open] {
      animation: welcome-in var(--duration-slow) var(--ease-out);
    }

    &[open]::backdrop {
      animation: welcome-fade var(--duration-slow) var(--ease-out);
    }

    /* Phones: a bottom sheet, easy to reach with the thumb */
    @media screen and (max-width: 749px) {
      width: 100%;
      max-width: 100%;
      max-height: 94dvh;
      margin: auto 0 0;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      border-inline: 0;
      border-block-end: 0;
    }
  }

  @keyframes welcome-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.985);
    }
  }

  @keyframes welcome-fade {
    from {
      opacity: 0;
    }
  }

  .welcome-popup__panel {
    position: relative;
    display: grid;

    @media screen and (min-width: 750px) {
      grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
      min-height: 32rem;
    }
  }

  .welcome-popup__close {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    z-index: 2;
    border-radius: 50%;
    background-color: rgb(var(--palette-warm-white-rgb) / 0.85);
  }

  /* Visual: pink with drops, or the product photo, and a warm seal */
  .welcome-popup__visual {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: 8.5rem;
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(255 255 255 / 0.55), transparent 60%),
      linear-gradient(180deg, #f3dfe2 0%, #e8c7cd 100%);

    @media screen and (min-width: 750px) {
      min-height: 100%;
    }

    /* The drop behind the seal would peek out from under it. */
    & .drops__drop:nth-child(3) {
      display: none;
    }

    /* Phones: a short band, so the drops move to the sides of the seal. */
    @media screen and (max-width: 749px) {
      & .drops__drop:nth-child(4) {
        left: 76%;
      }

      & .drops__drop:nth-child(5) {
        left: 89%;
      }
    }

    & .welcome-popup__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .welcome-popup__visual--image {
    place-items: end start;
    padding: var(--space-sm);

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgb(48 39 36 / 0.28), transparent 45%);
    }
  }

  .welcome-popup__seal {
    position: relative;
    z-index: 1;
    display: grid;
    place-content: center;
    gap: 0.35rem;
    width: clamp(6.75rem, 5rem + 8vw, 11.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    text-align: center;
    background:
      radial-gradient(circle at 35% 25%, rgb(255 255 255 / 0.95), rgb(var(--palette-warm-white-rgb) / 0.88) 70%);
    box-shadow:
      0 0 0 1px rgb(var(--warm-rgb) / 0.6),
      0 0 0 6px rgb(var(--palette-warm-white-rgb) / 0.45),
      0 0 0 7px rgb(var(--warm-rgb) / 0.35),
      0 24px 50px -24px rgb(120 60 72 / 0.55);

    .welcome-popup__visual--image & {
      width: clamp(5.5rem, 4.5rem + 4vw, 7.5rem);
    }

    @media screen and (max-width: 749px) {
      width: 6.25rem;

      .welcome-popup__visual--image & {
        width: 5.5rem;
      }
    }
  }

  .welcome-popup__seal-value {
    font-family: var(--font-heading-family);
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
    line-height: 1;
    color: var(--warm-text);

    .welcome-popup__visual--image & {
      font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    }

    @media screen and (max-width: 749px) {
      font-size: 1.75rem;

      .welcome-popup__visual--image & {
        font-size: 1.5rem;
      }
    }
  }

  .welcome-popup__seal-label {
    max-width: 8ch;
    margin-inline: auto;
    font-size: 0.625rem;
    font-weight: var(--font-body-weight-medium);
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  /* Computers: the seal in the middle, the brand line at the bottom */
  .welcome-popup__visual.has-drops {
    @media screen and (min-width: 750px) {
      grid-template-rows: 1fr auto 1fr;

      & .welcome-popup__seal {
        grid-row: 2;
      }
    }
  }

  .welcome-popup__tagline {
    grid-row: 3;
    align-self: end;
    padding: 0 var(--space-md) var(--space-lg);
    font-family: var(--font-heading-family);
    font-size: var(--text-lg);
    font-style: italic;
    text-align: center;
    color: var(--color-text);
    opacity: 0.8;

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .welcome-popup__body {
    display: grid;
    align-content: center;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) clamp(1.25rem, 0.75rem + 2vw, 2.75rem);
  }

  .welcome-popup__content {
    display: grid;
    gap: var(--space-xs);
    justify-items: center;
    text-align: center;
  }

  .welcome-popup__title {
    margin-block-end: var(--space-3xs);
    text-wrap: balance;

    &.h2 {
      font-size: calc(clamp(2rem, 1.6rem + 1.4vw, 2.75rem) * var(--font-heading-scale, 1));
    }

    /* Focused on opening so screen readers start here; it is not a control. */
    &:focus {
      outline: none;
    }

    & em {
      font-style: normal;
      color: var(--warm-text);
    }
  }

  .welcome-popup__text {
    max-width: 34ch;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* The product and its price with the code */
  .welcome-popup__offer {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--warm-hairline);
    border-radius: var(--radius-md);
    background-color: rgb(var(--palette-warm-white-rgb) / 0.75);
    text-align: start;
  }

  .welcome-popup__offer-thumb {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, #f8ebed, #f3dfe2);

    & .welcome-popup__offer-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .welcome-popup__offer-drop {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50% 0 50% 50%;
    rotate: -45deg;
    background:
      radial-gradient(circle at 46% 30%, rgb(255 255 255 / 0.9) 0 6%, transparent 18%),
      linear-gradient(225deg, #f7dde2 0%, #eab6c0 55%, var(--palette-rose-deep) 100%);
    box-shadow: 0 0 0 1px rgb(var(--warm-rgb) / 0.6);
  }

  .welcome-popup__offer-details {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .welcome-popup__offer-name {
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
  }

  .welcome-popup__offer-prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
  }

  .welcome-popup__offer-old {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .welcome-popup__offer-new {
    font-family: var(--font-heading-family);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.1;
    color: var(--warm-text);
  }

  .welcome-popup__offer-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .welcome-popup__fields {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
    margin-block-start: var(--space-3xs);

    & .field {
      width: 100%;
    }
  }

  .welcome-popup__perks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3xs) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--color-text);

    & li {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    & .icon {
      width: 1rem;
      height: 1rem;
      color: var(--warm-text);
    }
  }

  .welcome-popup__legal,
  .welcome-popup__note {
    max-width: 52ch;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: pretty;

    & a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .welcome-popup__later {
    min-height: var(--tap-target);
  }

  .welcome-popup__check {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: var(--warm-text);
    background-color: rgb(var(--palette-warm-white-rgb) / 0.8);
    box-shadow: 0 0 0 1px rgb(var(--warm-rgb) / 0.6);

    & .icon {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  .welcome-popup__code {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    width: 100%;
    padding: var(--space-sm);
    border: 1px dashed rgb(var(--warm-rgb) / 0.8);
    border-radius: var(--radius-md);
    background-color: rgb(var(--palette-warm-white-rgb) / 0.75);
  }

  .welcome-popup__code-value {
    font-family: var(--font-heading-family);
    font-size: var(--heading-4);
    letter-spacing: 0.12em;
  }

  /*
    Computers: an editorial layout. The photo on the left, the offer on a warm
    ivory page on the right, read from the left like a magazine page: the
    −10 % large in italic, the e-mail and its button on one line.
  */
  @media screen and (min-width: 750px) {
    .welcome-popup {
      width: min(100% - 3rem, 62rem);
      max-height: min(100dvh - 3rem, 44rem);
      border: 0;
      border-radius: 1.75rem;
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.5),
        0 50px 120px -40px rgb(48 39 36 / 0.65);
    }

    .welcome-popup__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: 36rem;
    }

    .welcome-popup__visual--image {
      padding: var(--space-md);

      &::after {
        background:
          linear-gradient(0deg, rgb(48 39 36 / 0.38), transparent 40%),
          linear-gradient(90deg, transparent 70%, rgb(252 249 247 / 0.18));
      }

      & .welcome-popup__seal {
        width: 7.25rem;
        background: rgb(255 255 255 / 0.82);
        backdrop-filter: blur(6px);
      }
    }

    .welcome-popup__body {
      align-content: center;
      padding: 3.25rem 3.25rem 2.5rem;
      background-color: #fcf9f7;
      background-image:
        radial-gradient(80% 55% at 100% 0%, rgb(var(--rose-strong-rgb) / 0.1), transparent 65%),
        radial-gradient(60% 45% at 0% 100%, rgb(var(--rose-strong-rgb) / 0.06), transparent 70%);
    }

    .welcome-popup__content {
      gap: var(--space-sm);
      justify-items: start;
      text-align: start;

      & .eyebrow--center {
        justify-content: flex-start;
      }

      & .eyebrow--center::after {
        display: none;
      }
    }

    .welcome-popup__title {
      margin-block: 0;

      &.h2 {
        font-size: calc(2.125rem * var(--font-heading-scale, 1));
        line-height: 1.12;
      }

      & em {
        display: block;
        margin-block-end: 0.2rem;
        font-size: calc(4.5rem * var(--font-heading-scale, 1));
        font-style: italic;
        line-height: 0.95;
        letter-spacing: -0.02em;
        color: var(--rose-text);
      }
    }

    .welcome-popup__text {
      max-width: 36ch;
    }

    .welcome-popup__offer {
      padding: 0.875rem 1rem;
      border-color: rgb(var(--rose-strong-rgb) / 0.2);
      border-radius: 1rem;
      background-color: #fff;
      box-shadow: 0 18px 36px -30px rgb(73 53 47 / 0.6);
    }

    /* The e-mail and its button share one rounded line */
    .welcome-popup__fields {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.375rem;
      margin-block-start: var(--space-2xs);
      padding: 0.375rem;
      border: 1px solid rgb(var(--color-text-rgb) / 0.2);
      border-radius: 999px;
      background-color: #fff;
      transition:
        border-color var(--duration-fast) ease,
        box-shadow var(--duration-fast) ease;

      &:focus-within {
        border-color: var(--color-text);
        box-shadow: 0 0 0 4px rgb(var(--rose-strong-rgb) / 0.15);
      }

      & .field__input {
        min-height: 3rem;
        padding-inline: 1.25rem 0.5rem;
        border: 0;
        border-radius: 999px;
        background-color: transparent;
        outline: none;
      }

      & .button {
        width: auto;
        min-height: 3rem;
        padding-inline: 1.75rem;
        border-radius: 999px;
        white-space: nowrap;
      }
    }

    .welcome-popup__perks {
      justify-content: flex-start;
      width: 100%;
      padding-block-start: var(--space-sm);
      border-block-start: 1px solid rgb(var(--rose-strong-rgb) / 0.16);
    }

    .welcome-popup__legal,
    .welcome-popup__note {
      max-width: none;
      font-size: 0.6875rem;
    }

    .welcome-popup__later {
      min-height: 2.25rem;
      margin-block-start: calc(var(--space-2xs) * -1);
    }

    .welcome-popup__code {
      justify-content: flex-start;
    }
  }

  /* Tablets: narrower columns, so a little less padding and a taller frame */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .welcome-popup {
      max-height: min(100dvh - 3rem, 54rem);
    }

    .welcome-popup__body {
      padding: 2.5rem 2rem 2rem;
    }

    .welcome-popup__title em {
      font-size: calc(3.75rem * var(--font-heading-scale, 1));
    }
  }
{% endstylesheet %}

