{%- liquid
  assign form_id = 'WelcomeForm-' | append: section.id
  assign offer_product = section.settings.product
  assign percent = section.settings.percent

  comment
    Shopify applies a code from /discount/CODE and then opens the redirect page.
  endcomment
  assign discount_base = routes.root_url | append: '/discount/' | replace: '//', '/'
  assign redirect_url = section.settings.redirect
  if redirect_url == blank and offer_product
    assign redirect_url = offer_product.url
  endif
  assign redirect_url = redirect_url | default: routes.all_products_collection_url

  comment
    Price with the code, rounded the way the checkout rounds a percentage.
  endcomment
  if offer_product
    assign offer_price = offer_product.price_min
    assign offer_saving = offer_price | times: percent | divided_by: 100.0 | round
    assign offer_new_price = offer_price | minus: offer_saving
    assign offer_new_price_text = offer_new_price | money
  endif

  comment
    The photo is only the one chosen in the section. Without it the pop-up is a
    single column; in the theme editor an empty photo place shows where it goes.
  endcomment
  assign visual_image = section.settings.image
  assign show_slot = false
  if visual_image == blank and request.design_mode
    assign show_slot = true
  endif
  assign has_media = false
  if visual_image != blank or show_slot
    assign has_media = true
  endif

  assign heading_font = section.settings.heading_font
  assign heading_italic = heading_font | font_modify: 'style', 'italic'
  capture warm_fonts
    unless heading_font.system?
      echo heading_font.weight | append: ' 1em ' | append: heading_font.family
      if heading_italic
        echo '|italic ' | append: heading_italic.weight | append: ' 1em ' | append: heading_font.family
      endif
    endunless
  endcapture

  assign show_popup = section.settings.enabled
  if customer and customer.accepts_marketing
    assign show_popup = false
  endif
  if request.page_type == 'password'
    assign show_popup = false
  endif
-%}
{%- if show_popup or request.design_mode -%}
  {%- style -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- if heading_italic %}{{ heading_italic | font_face: font_display: 'swap' }}{% endif %}
    .section-welcome-popup .welcome-popup {
      --welcome-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --welcome-font-weight: {{ heading_font.weight }};
    }
  {%- endstyle -%}

  <welcome-popup
    data-delay="{{ section.settings.delay | times: 1000 }}"
    data-snooze-days="{{ section.settings.snooze_days }}"
    data-section-id="{{ section.id }}"
    data-warm-fonts="{{ warm_fonts | strip | escape }}"
    {% if request.design_mode %}
      data-design-mode
    {% endif %}
  >
    <dialog
      class="welcome-popup color-{{ section.settings.color_scheme }}{% if has_media %} welcome-popup--media{% endif %}"
      aria-labelledby="WelcomeTitle-{{ section.id }}"
      aria-describedby="WelcomeText-{{ section.id }}"
      data-welcome-dialog
    >
      <div class="welcome-popup__panel">
        <button
          type="button"
          class="welcome-popup__close"
          data-welcome-close
          aria-label="{{ 'general.close' | t }}"
        >
          {% render 'icon', icon: 'close' %}
        </button>

        {%- if has_media -%}
          <div
            class="welcome-popup__media{% if show_slot %} welcome-popup__media--slot{% endif %}"
            {% unless show_slot %}
              aria-hidden="true"
            {% endunless %}
          >
            {%- if visual_image != blank -%}
              {%- capture image_style -%}object-position: {{ visual_image.presentation.focal_point | default: 'center' }};{%- endcapture -%}
              {{
                visual_image
                | image_url: width: 1400
                | image_tag:
                  class: 'welcome-popup__image',
                  widths: '480, 720, 960, 1200, 1400',
                  sizes: '(min-width: 750px) 27rem, 100vw',
                  loading: 'lazy',
                  alt: '',
                  style: image_style
              }}
            {%- else -%}
              <span class="welcome-popup__slot">
                {% render 'icon', icon: 'image' %}
                <span class="welcome-popup__slot-title">{{ 'welcome.photo_slot_title' | t }}</span>
                <span class="welcome-popup__slot-text">{{ 'welcome.photo_slot_text' | t }}</span>
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="welcome-popup__body">
          {%- form 'customer', id: form_id, class: 'welcome-popup__form', novalidate: 'novalidate' -%}
            {%- if form.posted_successfully? -%}
              <div class="welcome-popup__content" data-welcome-success>
                <p class="welcome-popup__brand" aria-hidden="true">{{ shop.name | escape }}</p>
                <p class="welcome-popup__eyebrow">{{ 'welcome.success_eyebrow' | t }}</p>
                <h2 class="welcome-popup__title welcome-popup__title--success" id="WelcomeTitle-{{ section.id }}" tabindex="-1" autofocus>
                  {{- section.settings.success_heading | escape -}}
                </h2>
                <span class="welcome-popup__rule" aria-hidden="true"></span>
                <p class="welcome-popup__text" id="WelcomeText-{{ section.id }}">
                  {{- section.settings.success_text | escape -}}
                </p>
                {%- if section.settings.code != blank -%}
                  <copy-button class="welcome-popup__code" data-copy="{{ section.settings.code | escape }}">
                    <span class="welcome-popup__code-label">{{ 'welcome.your_code' | t }}</span>
                    <span class="welcome-popup__code-value">{{ section.settings.code | escape }}</span>
                    <button type="button" class="welcome-popup__copy">{{ 'gift_card.copy' | t }}</button>
                    <span class="visually-hidden" data-copy-status hidden>{{ 'gift_card.copied' | t }}</span>
                  </copy-button>
                  <a
                    class="button button--full welcome-popup__submit"
                    href="{{ discount_base }}{{ section.settings.code | url_encode }}?redirect={{ redirect_url | url_encode }}"
                  >
                    {%- if offer_product -%}
                      {{- 'welcome.use_code_price' | t: price: offer_new_price_text -}}
                    {%- else -%}
                      {{- 'welcome.use_code' | t -}}
                    {%- endif -%}
                  </a>
                  <p class="welcome-popup__note">{{ 'welcome.auto_applied' | t }}</p>
                {%- endif -%}
                {%- if section.settings.conditions != blank -%}
                  <p class="welcome-popup__legal">{{ section.settings.conditions | escape }}</p>
                {%- endif -%}
                <button type="button" class="welcome-popup__later" data-welcome-close>
                  {{- 'welcome.keep_browsing' | t -}}
                </button>
              </div>
            {%- else -%}
              <div class="welcome-popup__content">
                <input type="hidden" name="contact[tags]" value="newsletter,popup-bienvenue">
                <p class="welcome-popup__brand" aria-hidden="true">{{ shop.name | escape }}</p>
                {%- if section.settings.eyebrow != blank -%}
                  <p class="welcome-popup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
                {%- endif -%}
                <h2 class="welcome-popup__title" id="WelcomeTitle-{{ section.id }}" tabindex="-1" autofocus>
                  <span class="welcome-popup__figure">
                    <span class="welcome-popup__number">{{ percent }}</span>
                    <span class="welcome-popup__percent">%</span>
                  </span>
                  {% if section.settings.seal_label != blank -%}
                    <span class="welcome-popup__subtitle">{{ section.settings.seal_label | escape }}</span>
                  {%- endif %}
                </h2>
                <span class="welcome-popup__rule" aria-hidden="true"></span>

                {%- if offer_product -%}
                  <p class="welcome-popup__price">
                    {%- if section.settings.offer_label != blank -%}
                      <span class="welcome-popup__price-label">{{ section.settings.offer_label | escape }}</span>
                    {%- endif -%}
                    <span class="welcome-popup__price-values">
                      <s class="welcome-popup__price-old">
                        <span class="visually-hidden">{{ 'welcome.regular_price' | t }}</span>
                        {{- offer_price | money -}}
                      </s>
                      <strong class="welcome-popup__price-new">
                        <span class="visually-hidden">{{ 'welcome.price_with_code' | t }}</span>
                        {{- offer_new_price_text -}}
                      </strong>
                      <span class="welcome-popup__price-hint" aria-hidden="true">{{ 'welcome.with_code' | t }}</span>
                    </span>
                  </p>
                {%- endif -%}

                <p class="welcome-popup__text" id="WelcomeText-{{ section.id }}">
                  {{- section.settings.text | escape -}}
                </p>

                {%- if form.errors -%}
                  <p
                    class="form-message form-message--error welcome-popup__error"
                    role="alert"
                    id="WelcomeError-{{ section.id }}"
                    data-welcome-error
                  >
                    {% render 'icon', icon: 'alert' %}
                    <span>{{ 'welcome.error' | t }}</span>
                  </p>
                {%- endif -%}

                <div class="welcome-popup__fields">
                  <label class="visually-hidden" for="WelcomeEmail-{{ section.id }}">
                    {{- 'newsletter.label' | t -}}
                  </label>
                  <input
                    class="welcome-popup__input"
                    type="email"
                    id="WelcomeEmail-{{ section.id }}"
                    name="contact[email]"
                    autocomplete="email"
                    autocapitalize="off"
                    spellcheck="false"
                    required
                    placeholder="{{ 'welcome.email_placeholder' | t }}"
                    {% if form.errors %}
                      aria-invalid="true"
                      aria-describedby="WelcomeError-{{ section.id }}"
                    {% endif %}
                  >
                  <button type="submit" class="button button--full welcome-popup__submit">
                    {{- section.settings.button_label | escape -}}
                  </button>
                </div>

                <p class="welcome-popup__legal">
                  {{ 'welcome.consent' | t }}
                  {%- if section.settings.conditions != blank %} {{ section.settings.conditions | escape }}{% endif -%}
                  {%- if shop.privacy_policy %}
                    <a href="{{ shop.privacy_policy.url }}">{{ 'welcome.privacy' | t }}</a>
                  {%- endif -%}
                </p>
                <button type="button" class="welcome-popup__later" data-welcome-close>
                  {{- 'welcome.no_thanks' | t -}}
                </button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </dialog>
  </welcome-popup>
{%- endif -%}

{% stylesheet %}
  /*
    Welcome offer. One calm column: the brand, the offer set large in the
    serif, the price with the code, then the e-mail. With a photo, the photo
    takes the left half on computers and a band at the top on phones.
  */
  .welcome-popup {
    --welcome-gutter: clamp(1.5rem, 1rem + 2.5vw, 3.25rem);
    --welcome-line: rgb(var(--color-text-rgb) / 0.16);

    width: min(100% - 2rem, 32rem);
    max-height: min(100dvh - 2rem, 48rem);
    padding: 0;
    border: 0;
    border-radius: 1.5rem;
    color: var(--color-text);
    background-color: var(--color-background);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.45),
      0 40px 110px -40px rgb(48 39 36 / 0.6);
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;

    &::backdrop {
      background-color: rgb(var(--palette-scrim-rgb) / 0.48);
      backdrop-filter: blur(6px);
    }

    &[open] {
      animation: welcome-in 700ms var(--ease-out);
    }

    &[open]::backdrop {
      animation: welcome-fade 500ms ease-out;
    }

    /* Phones: a sheet rising from the bottom, within reach of the thumb */
    @media screen and (max-width: 749px) {
      width: 100%;
      max-width: 100%;
      max-height: 92dvh;
      margin: auto 0 0;
      border-radius: 1.5rem 1.5rem 0 0;
    }
  }

  .welcome-popup--media {
    @media screen and (min-width: 750px) {
      width: min(100% - 3rem, 58rem);
    }
  }

  @keyframes welcome-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @keyframes welcome-fade {
    from {
      opacity: 0;
    }
  }

  .welcome-popup__panel {
    position: relative;
    display: grid;

    .welcome-popup--media & {
      @media screen and (min-width: 750px) {
        grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
        min-height: 35rem;
      }
    }
  }

  .welcome-popup__close {
    position: absolute;
    inset-block-start: 0.875rem;
    inset-inline-end: 0.875rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--welcome-line);
    border-radius: 50%;
    color: var(--color-text);
    background-color: rgb(var(--palette-warm-white-rgb) / 0.82);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      transform var(--duration-base) var(--ease-out),
      background-color var(--duration-base) ease;

    & .icon {
      width: 1rem;
      height: 1rem;
    }

    &:hover {
      background-color: rgb(var(--palette-warm-white-rgb));
      transform: rotate(90deg);
    }
  }

  /* The photo the shop chose, or the empty place for it in the theme editor */
  .welcome-popup__media {
    position: relative;
    overflow: hidden;
    height: clamp(8.5rem, 24dvh, 12.5rem);
    background: linear-gradient(160deg, #f8ebed 0%, #efd3d8 100%);

    @media screen and (min-width: 750px) {
      height: auto;
      min-height: 100%;
    }
  }

  .welcome-popup__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .welcome-popup__media--slot {
    display: grid;
    padding: 0.875rem;
    background: rgb(var(--palette-warm-white-rgb) / 0.55);
  }

  .welcome-popup__slot {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    border: 1.5px dashed rgb(var(--rose-strong-rgb) / 0.55);
    border-radius: 1rem;
    text-align: center;
    color: var(--color-text-muted);

    & .icon {
      width: 1.75rem;
      height: 1.75rem;
      color: var(--rose-text);
    }
  }

  .welcome-popup__slot-title {
    font-family: var(--welcome-font);
    font-size: 1.125rem;
    color: var(--color-text);
  }

  .welcome-popup__slot-text {
    max-width: 30ch;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .welcome-popup__body {
    display: grid;
    align-content: center;
    padding: 2.75rem var(--welcome-gutter) calc(1.25rem + env(safe-area-inset-bottom));
    background-image:
      radial-gradient(90% 60% at 50% 0%, rgb(255 255 255 / 0.55), transparent 70%),
      radial-gradient(70% 50% at 100% 100%, rgb(var(--rose-strong-rgb) / 0.08), transparent 70%);

    @media screen and (min-width: 750px) {
      padding-block: 3.25rem 1.75rem;
    }
  }

  .welcome-popup__content {
    display: grid;
    justify-items: center;
    text-align: center;

    & > * {
      animation: welcome-rise 700ms var(--ease-out) backwards;
    }

    & > :nth-child(3) {
      animation-delay: 60ms;
    }

    & > :nth-child(4) {
      animation-delay: 120ms;
    }

    & > :nth-child(n + 5) {
      animation-delay: 180ms;
    }
  }

  @keyframes welcome-rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  .welcome-popup__brand {
    margin: 0 0 1.5rem;
    padding-inline-start: 0.42em;
    font-family: var(--welcome-font);
    font-size: 0.9375rem;
    font-weight: var(--welcome-font-weight);
    line-height: 1;
    letter-spacing: 0.42em;
    text-transform: uppercase;
  }

  .welcome-popup__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    line-height: 1.4;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-text-muted);

    &::before,
    &::after {
      content: '';
      width: 1.75rem;
      height: 1px;
      background-color: currentColor;
      opacity: 0.45;
    }
  }

  .welcome-popup__title {
    display: grid;
    justify-items: center;
    margin: 0;
    font-family: var(--welcome-font);
    font-weight: var(--welcome-font-weight);
    line-height: 1;

    /* Focused on opening so screen readers start here; it is not a control. */
    &:focus {
      outline: none;
    }
  }

  .welcome-popup__figure {
    display: flex;
    align-items: flex-start;
    gap: 0.06em;
    font-size: clamp(5rem, 4rem + 4vw, 6.75rem);
    font-variant-numeric: lining-nums;
    letter-spacing: -0.03em;
    line-height: 0.88;
  }

  .welcome-popup__percent {
    margin-block-start: 0.12em;
    font-size: 0.4em;
    letter-spacing: 0;
  }

  .welcome-popup__subtitle {
    margin-block-start: 0.875rem;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.625rem);
    font-style: italic;
    line-height: 1.2;
    color: var(--rose-text);
    text-wrap: balance;
  }

  .welcome-popup__title--success {
    font-size: clamp(1.875rem, 1.6rem + 1vw, 2.375rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .welcome-popup__rule {
    width: 2.5rem;
    height: 1px;
    margin-block: 1.25rem;
    background-color: var(--rose-text);
    opacity: 0.5;
  }

  .welcome-popup__price {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    margin: 0 0 1rem;
  }

  .welcome-popup__price-label {
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .welcome-popup__price-values {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    column-gap: 0.625rem;
  }

  .welcome-popup__price-old {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .welcome-popup__price-new {
    font-family: var(--welcome-font);
    font-size: 1.5rem;
    font-weight: var(--welcome-font-weight);
    line-height: 1.1;
  }

  .welcome-popup__price-hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .welcome-popup__text {
    max-width: 30ch;
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .welcome-popup__error {
    margin-block-end: 0.75rem;
  }

  .welcome-popup__fields {
    display: grid;
    gap: 0.875rem;
    width: 100%;
    max-width: 22rem;
  }

  /* A single underlined line, like a signature field */
  .welcome-popup__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0.25rem;
    border: 0;
    border-block-end: 1px solid rgb(var(--color-text-rgb) / 0.4);
    border-radius: 0;
    font: inherit;
    font-size: 1rem;
    text-align: center;
    color: var(--color-text);
    background: transparent;
    transition:
      border-color var(--duration-base) ease,
      box-shadow var(--duration-base) ease;

    &::placeholder {
      color: var(--color-text-muted);
      opacity: 1;
    }

    &:focus {
      outline: none;
    }

    &:focus-visible {
      border-block-end-color: var(--color-text);
      box-shadow: 0 1px 0 0 var(--color-text);
    }

    &[aria-invalid='true'] {
      border-block-end-color: var(--color-error, #a33a3a);
    }
  }

  .welcome-popup__submit {
    min-height: 3.25rem;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .welcome-popup__legal,
  .welcome-popup__note {
    max-width: 46ch;
    margin: 1.25rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    text-wrap: pretty;

    & a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .welcome-popup__note {
    margin-block-start: 0.75rem;
  }

  .welcome-popup__later {
    min-height: var(--tap-target);
    margin-block-start: 0.25rem;
    padding: 0 0.5rem;
    border: 0;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    background: none;
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-text-rgb) / 0.35);
    text-underline-offset: 0.3em;
    cursor: pointer;

    &:hover {
      color: var(--color-text);
      text-decoration-color: currentColor;
    }
  }

  /* After the sign-up: the code, ready to copy */
  .welcome-popup__code {
    display: grid;
    justify-items: center;
    gap: 0.375rem;
    width: 100%;
    max-width: 22rem;
    margin-block-end: 1rem;
    padding: 1.125rem 1rem 0.75rem;
    border: 1px dashed rgb(var(--rose-strong-rgb) / 0.6);
    border-radius: 1rem;
    background-color: rgb(255 255 255 / 0.55);
  }

  .welcome-popup__code-label {
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .welcome-popup__code-value {
    padding-inline-start: 0.2em;
    font-family: var(--welcome-font);
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: 0.2em;
  }

  .welcome-popup__copy {
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 0;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--color-text);
    background: none;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  /* Short computer screens (laptops): the same page, set a little tighter */
  @media screen and (min-width: 750px) and (max-height: 50rem) {
    .welcome-popup__body {
      padding-block: 2.25rem 1.25rem;
    }

    .welcome-popup__brand {
      margin-block-end: 1rem;
    }

    .welcome-popup__figure {
      font-size: 4.75rem;
    }

    .welcome-popup__subtitle {
      margin-block-start: 0.625rem;
    }

    .welcome-popup__rule {
      margin-block: 0.875rem;
    }

    .welcome-popup__price {
      margin-block-end: 0.75rem;
    }

    .welcome-popup__text {
      margin-block-end: 1rem;
    }

    .welcome-popup__legal {
      margin-block-start: 1rem;
    }

    .welcome-popup--media .welcome-popup__panel {
      min-height: 0;
    }
  }

  /* Phones with a photo: a slimmer band and tighter spacing, so the form stays in view */
  @media screen and (max-width: 749px) {
    .welcome-popup--media {
      & .welcome-popup__media {
        height: clamp(7rem, 18dvh, 9.5rem);
      }

      & .welcome-popup__body {
        padding-block-start: 1.75rem;
      }

      & .welcome-popup__brand {
        margin-block-end: 1rem;
      }

      & .welcome-popup__figure {
        font-size: 4.25rem;
      }

      & .welcome-popup__subtitle {
        margin-block-start: 0.625rem;
      }

      & .welcome-popup__rule {
        margin-block: 0.875rem;
      }

      & .welcome-popup__price {
        margin-block-end: 0.75rem;
      }

      & .welcome-popup__text {
        margin-block-end: 1rem;
      }

      & .welcome-popup__legal {
        margin-block-start: 1rem;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome-popup[open],
    .welcome-popup[open]::backdrop,
    .welcome-popup__content > * {
      animation: none;
    }
  }
{% endstylesheet %}

