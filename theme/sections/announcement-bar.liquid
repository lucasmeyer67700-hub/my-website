{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
  assign interval = section.settings.interval | times: 1000
  assign has_links = false
  assign message_count = 0
  for block in messages
    if block.settings.text != blank
      assign message_count = message_count | plus: 1
      if block.settings.link != blank
        assign has_links = true
      endif
    endif
  endfor
  comment
    Screen readers get every message at once (a static, visually hidden line)
    instead of a rotating one, unless a message contains a link that must stay
    reachable in the visible list.
  endcomment
  assign summarize = false
  if message_count > 1 and has_links == false
    assign summarize = true
  endif
  capture summary
    assign separator = ''
    for block in messages
      if block.settings.text != blank
        echo separator
        echo block.settings.text | escape
        assign separator = ' · '
      endif
    endfor
  endcapture
-%}

{%- if message_count > 0 and section.settings.mode == 'marquee' -%}
  {%- comment -%}
    Continuous strip: the messages run from right to left in a loop (two
    identical halves, the track slides by one half). Paused on hover; a
    still, centred line for visitors who ask for less motion. Screen
    readers get the plain text once.
  {%- endcomment -%}
  <div class="announcement-bar announcement-bar--marquee color-{{ section.settings.color_scheme }}">
    <p class="visually-hidden">{{ summary }}</p>
    <div class="announcement-marquee" aria-hidden="true" style="--marquee-duration: {{ section.settings.speed | default: 45 }}s;">
      <div class="announcement-marquee__track">
        {%- for half in (1..2) -%}
          <div class="announcement-marquee__group">
            {%- for repeat in (1..6) -%}
              {%- for block in messages -%}
                {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
                {%- if block.settings.link != blank -%}
                  <a class="announcement-marquee__item" href="{{ block.settings.link }}" tabindex="-1">{{ block.settings.text | escape }}</a>
                {%- else -%}
                  <span class="announcement-marquee__item">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
      <p class="announcement-marquee__still">{{ summary }}</p>
    </div>
    {%- if has_links -%}
      <ul class="visually-hidden" role="list">
        {%- for block in messages -%}
          {%- if block.settings.link != blank and block.settings.text != blank -%}
            <li><a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
{%- elsif message_count > 0 -%}
  <div class="announcement-bar color-{{ section.settings.color_scheme }}">
    <announcement-rotator
      class="announcement-bar__inner page-width page-width--wide"
      data-interval="{{ interval }}"
    >
      {%- if summarize -%}
        <p class="visually-hidden">{{ summary }}</p>
      {%- endif -%}
      <ul
        class="announcement-bar__list"
        role="list"
        aria-label="{{ 'sections.announcement_label' | t }}"
        {% if summarize %}
          aria-hidden="true"
        {% endif %}
      >
        {%- assign rendered = 0 -%}
        {%- for block in messages -%}
          {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
          {%- assign rendered = rendered | plus: 1 -%}
          <li
            class="announcement-bar__item{% if rendered == 1 %} is-active{% endif %}"
            data-announcement
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a
                class="announcement-bar__link"
                href="{{ block.settings.link }}"
                {% if rendered > 1 %}
                  tabindex="-1"
                {% endif %}
              >
                {{- block.settings.text | escape -}}
                {% render 'icon', icon: 'arrow-right' %}
              </a>
            {%- else -%}
              {{- block.settings.text | escape -}}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

    </announcement-rotator>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    border-block-end: 1px solid var(--warm-hairline);
  }

  .announcement-bar__inner {
    position: relative;
    display: block;
    padding-inline: var(--gutter-wide);
  }

  /* Every message sits in the same grid cell: they cross-fade in place,
     and the bar keeps the height of the longest one (no layout shift). */
  .announcement-bar__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .announcement-bar__item {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding-block: 0.45rem;
    font-size: clamp(0.5625rem, 2.3vw, 0.65rem);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: clamp(0.05em, 0.6vw, 0.1em);
    text-transform: uppercase;
    text-align: center;
    color: var(--color-text-muted);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      visibility 0s linear var(--duration-slow);

    &.is-active {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
  }

  .announcement-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;

    & .icon {
      --icon-size: 0.95rem;
    }

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  /* Continuous strip */
  .announcement-marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }

  .announcement-marquee__track {
    display: flex;
    width: max-content;
    animation: announcement-marquee var(--marquee-duration, 45s) linear infinite;
  }

  .announcement-marquee:hover .announcement-marquee__track {
    animation-play-state: paused;
  }

  .announcement-marquee__group {
    display: flex;
    flex: none;
  }

  .announcement-marquee__item,
  .announcement-marquee__still {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    margin: 0;
    font-size: clamp(0.5625rem, 2.3vw, 0.65rem);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  /* A small rose dot between two messages */
  .announcement-marquee__item::after {
    content: '';
    width: 0.25rem;
    height: 0.25rem;
    margin-inline: 2.25rem;
    border-radius: 50%;
    background-color: var(--rose-cta);
  }

  .announcement-marquee__still {
    display: none;
    justify-content: center;
    padding-inline: var(--gutter);
    white-space: normal;
    text-align: center;
  }

  @keyframes announcement-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .announcement-marquee__track {
      display: none;
    }

    .announcement-marquee__still {
      display: flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barre d'annonce",
  "tag": "aside",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Des messages courts et vérifiés, qui défilent en continu ou s'enchaînent en fondu."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Animation",
      "options": [
        { "value": "marquee", "label": "Défilement continu" },
        { "value": "fade", "label": "Messages en fondu" }
      ],
      "default": "marquee"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Durée d'un tour du défilement",
      "info": "Plus le nombre est petit, plus le texte défile vite.",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 45
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Durée d'affichage de chaque message (fondu)",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "info": "Une promesse réelle uniquement (livraison, retours, paiement…).",
          "default": "Livraison offerte en France"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (facultatif)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
