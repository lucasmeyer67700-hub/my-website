{%- if section.settings.text != blank -%}
  <div class="announcement-bar color-{{ section.settings.color_scheme }}">
    <p class="announcement-bar__text page-width">
      {%- if section.settings.link != blank -%}
        <a class="announcement-bar__link" href="{{ section.settings.link }}">
          {{- section.settings.text | escape -}}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- else -%}
        {{- section.settings.text | escape -}}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    border-block-end: 1px solid var(--color-border);
  }

  .announcement-bar__text {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding-block: 0.5rem;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    text-align: center;
  }

  .announcement-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;

    & .icon {
      --icon-size: 0.95rem;
    }

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barre d'annonce",
  "tag": "aside",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Un seul message, sobre et vérifié (par exemple une politique de livraison réelle). Laissez vide pour masquer la barre."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "default": "Livraison offerte en France"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien (facultatif)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-3"
    }
  ],
  "presets": [{ "name": "Barre d'annonce" }]
}
{% endschema %}
