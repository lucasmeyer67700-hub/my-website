{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
  assign interval = section.settings.interval | times: 1000
  assign has_links = false
  assign message_count = 0
  for block in messages
    if block.settings.text != blank
      assign message_count = message_count | plus: 1
      if block.settings.link != blank
        assign has_links = true
      endif
    endif
  endfor
  comment
    Screen readers get every message at once (a static, visually hidden line)
    instead of a rotating one, unless a message contains a link that must stay
    reachable in the visible list.
  endcomment
  assign summarize = false
  if message_count > 1 and has_links == false
    assign summarize = true
  endif
  capture summary
    assign separator = ''
    for block in messages
      if block.settings.text != blank
        echo separator
        echo block.settings.text | escape
        assign separator = ' · '
      endif
    endfor
  endcapture
-%}

{%- if message_count > 0 -%}
  <div class="announcement-bar color-{{ section.settings.color_scheme }}">
    <announcement-rotator
      class="announcement-bar__inner page-width page-width--wide"
      data-interval="{{ interval }}"
    >
      {%- if summarize -%}
        <p class="visually-hidden">{{ summary }}</p>
      {%- endif -%}
      <ul
        class="announcement-bar__list"
        role="list"
        aria-label="{{ 'sections.announcement_label' | t }}"
        {% if summarize %}
          aria-hidden="true"
        {% endif %}
      >
        {%- assign rendered = 0 -%}
        {%- for block in messages -%}
          {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
          {%- assign rendered = rendered | plus: 1 -%}
          <li
            class="announcement-bar__item{% if rendered == 1 %} is-active{% endif %}"
            data-announcement
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a
                class="announcement-bar__link"
                href="{{ block.settings.link }}"
                {% if rendered > 1 %}
                  tabindex="-1"
                {% endif %}
              >
                {{- block.settings.text | escape -}}
                {% render 'icon', icon: 'arrow-right' %}
              </a>
            {%- else -%}
              {{- block.settings.text | escape -}}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

    </announcement-rotator>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    border-block-end: 1px solid var(--gold-hairline);
  }

  .announcement-bar__inner {
    position: relative;
    display: block;
    padding-inline: var(--gutter-wide);
  }

  /* Every message sits in the same grid cell: they cross-fade in place,
     and the bar keeps the height of the longest one (no layout shift). */
  .announcement-bar__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .announcement-bar__item {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding-block: 0.45rem;
    font-size: var(--text-sm);
    letter-spacing: 0.03em;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      visibility 0s linear var(--duration-slow);

    &.is-active {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
  }

  .announcement-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;

    & .icon {
      --icon-size: 0.95rem;
    }

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barre d'annonce",
  "tag": "aside",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Des messages courts et vérifiés, qui s'enchaînent en fondu en continu."
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Durée d'affichage de chaque message",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "info": "Une promesse réelle uniquement (livraison, retours, paiement…).",
          "default": "Livraison offerte en France"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (facultatif)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
