{%- liquid
  assign privacy_url = shop.privacy_policy.url
  if section.settings.policy_page != blank
    assign privacy_url = section.settings.policy_page.url
  endif
  assign heading_font = section.settings.heading_font
-%}
{%- if section.settings.enabled or request.design_mode -%}
  {%- style -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    .section-cookie-banner {
      --cookie-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --cookie-font-weight: {{ heading_font.weight }};
      --cookie-bg: {{ section.settings.background }};
      --cookie-bg-rgb: {{ section.settings.background.rgb }};
      --cookie-text: {{ section.settings.text_color }};
      --cookie-text-rgb: {{ section.settings.text_color.rgb }};
      --cookie-accent: {{ section.settings.accent }};
      --cookie-accent-rgb: {{ section.settings.accent.rgb }};
      --cookie-button: {{ section.settings.button }};
      --cookie-button-label: {{ section.settings.button_label }};
    }
  {%- endstyle -%}
  <cookie-consent
    class="cookie-consent"
    data-section-id="{{ section.id }}"
    {% if request.design_mode %}
      data-design-mode
    {% endif %}
  >
    <div
      class="cookie-banner"
      role="dialog"
      aria-modal="false"
      aria-labelledby="CookieTitle-{{ section.id }}"
      aria-describedby="CookieText-{{ section.id }}"
      tabindex="-1"
      data-cookie-banner
      hidden
    >
      <div class="cookie-banner__copy">
        <h2 class="cookie-banner__title" id="CookieTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
        <p class="cookie-banner__text" id="CookieText-{{ section.id }}">
          {{- section.settings.text | escape -}}
          {%- if privacy_url != blank %}
            <a href="{{ privacy_url }}">{{ 'cookies.learn_more' | t }}</a>
          {%- endif -%}
        </p>
      </div>
      <div class="cookie-banner__actions">
        <button type="button" class="cookie-banner__button" data-cookie-choice="reject">
          {{- 'cookies.reject' | t -}}
        </button>
        <button type="button" class="cookie-banner__button" data-cookie-choice="accept">
          {{- 'cookies.accept' | t -}}
        </button>
        <button type="button" class="cookie-banner__customize" data-cookie-open-prefs aria-haspopup="dialog">
          {{- 'cookies.customize' | t -}}
        </button>
      </div>
    </div>

    <dialog
      class="cookie-prefs"
      aria-labelledby="CookiePrefsTitle-{{ section.id }}"
      data-cookie-prefs
    >
      <div class="cookie-prefs__inner">
        <div class="cookie-prefs__header">
          <h2 class="cookie-prefs__title" id="CookiePrefsTitle-{{ section.id }}">{{ 'cookies.prefs_title' | t }}</h2>
          <button type="button" class="cookie-prefs__close" data-cookie-close aria-label="{{ 'general.close' | t }}">
            {% render 'icon', icon: 'close' %}
          </button>
        </div>
        <p class="cookie-prefs__intro">{{ 'cookies.prefs_intro' | t }}</p>

        <ul class="cookie-prefs__list" role="list">
          <li class="cookie-prefs__item">
            <div class="cookie-prefs__label cookie-prefs__label--static">
              <span class="cookie-prefs__name">{{ 'cookies.necessary' | t }}</span>
              <span class="cookie-prefs__desc">{{ 'cookies.necessary_text' | t }}</span>
            </div>
            <span class="cookie-prefs__always">{{ 'cookies.always_on' | t }}</span>
          </li>
          <li class="cookie-prefs__item">
            <label class="cookie-prefs__label" for="CookiePreferences-{{ section.id }}">
              <span class="cookie-prefs__name">{{ 'cookies.preferences' | t }}</span>
              <span class="cookie-prefs__desc">{{ 'cookies.preferences_text' | t }}</span>
            </label>
            <input
              class="cookie-prefs__switch"
              type="checkbox"
              role="switch"
              id="CookiePreferences-{{ section.id }}"
              data-cookie-purpose="preferences"
            >
          </li>
          <li class="cookie-prefs__item">
            <label class="cookie-prefs__label" for="CookieAnalytics-{{ section.id }}">
              <span class="cookie-prefs__name">{{ 'cookies.analytics' | t }}</span>
              <span class="cookie-prefs__desc">{{ 'cookies.analytics_text' | t }}</span>
            </label>
            <input
              class="cookie-prefs__switch"
              type="checkbox"
              role="switch"
              id="CookieAnalytics-{{ section.id }}"
              data-cookie-purpose="analytics"
            >
          </li>
          <li class="cookie-prefs__item">
            <label class="cookie-prefs__label" for="CookieMarketing-{{ section.id }}">
              <span class="cookie-prefs__name">{{ 'cookies.marketing' | t }}</span>
              <span class="cookie-prefs__desc">{{ 'cookies.marketing_text' | t }}</span>
            </label>
            <input
              class="cookie-prefs__switch"
              type="checkbox"
              role="switch"
              id="CookieMarketing-{{ section.id }}"
              data-cookie-purpose="marketing"
            >
          </li>
        </ul>

        <div class="cookie-prefs__actions">
          <button type="button" class="cookie-prefs__button cookie-prefs__button--quiet" data-cookie-choice="reject">
            {{- 'cookies.reject_all' | t -}}
          </button>
          <button type="button" class="cookie-prefs__button cookie-prefs__button--quiet" data-cookie-choice="accept">
            {{- 'cookies.accept_all' | t -}}
          </button>
          <button type="button" class="cookie-prefs__button cookie-prefs__save" data-cookie-choice="save">
            {{- 'cookies.save' | t -}}
          </button>
        </div>
      </div>
    </dialog>
  </cookie-consent>
{%- endif -%}

{% stylesheet %}
  /*
    Cookie banner, shown as the site opens: a dark espresso bar centred at the
    bottom on computers, a card at the bottom on phones. It never blocks the
    page. Refusing takes exactly the same effort as accepting: two identical
    buttons side by side.
  */
  .cookie-banner {
    position: fixed;
    inset-inline: 0.75rem;
    inset-block-end: calc(0.75rem + env(safe-area-inset-bottom));
    z-index: calc(var(--z-drawer) - 1);
    display: grid;
    gap: 0.875rem;
    padding: 1.125rem 1.125rem 0.625rem;
    border-radius: 1.375rem;
    color: var(--cookie-text);
    background-color: var(--cookie-bg);
    background-image:
      radial-gradient(90% 140% at 0% 0%, rgb(var(--cookie-accent-rgb) / 0.2), transparent 60%),
      radial-gradient(70% 120% at 100% 100%, rgb(var(--cookie-accent-rgb) / 0.1), transparent 65%);
    box-shadow:
      inset 0 1px 0 rgb(var(--cookie-accent-rgb) / 0.28),
      0 0 0 1px rgb(var(--cookie-text-rgb) / 0.06),
      0 30px 70px -24px rgb(20 12 10 / 0.6);
    opacity: 0;
    transform: translateY(calc(100% + 1.5rem));
    transition:
      opacity 500ms ease,
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1);

    &.is-visible {
      opacity: 1;
      transform: none;
    }

    &:focus {
      outline: none;
    }

    /* Computers: one slim bar, the words on the left, the choices on the right */
    @media screen and (min-width: 750px) {
      inset-inline: 0;
      inset-block-end: 1.5rem;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2.5rem;
      width: min(100% - 3rem, 64rem);
      margin-inline: auto;
      padding: 1.125rem 1.25rem 1.125rem 2rem;
      border-radius: 1.5rem;
    }
  }

  .cookie-banner__title,
  .cookie-prefs__title {
    margin: 0;
    font-family: var(--cookie-font);
    font-size: 1.25rem;
    font-weight: var(--cookie-font-weight);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .cookie-banner__copy {
    display: grid;
    gap: 0.375rem;
  }

  .cookie-banner__text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgb(var(--cookie-text-rgb) / 0.78);
    text-wrap: pretty;

    & a {
      margin-inline-start: 0.25rem;
      color: var(--cookie-text);
      text-decoration: underline;
      text-decoration-color: rgb(var(--cookie-accent-rgb) / 0.8);
      text-underline-offset: 0.25em;
      white-space: nowrap;
    }
  }

  /* Phones: refuse and accept side by side, « Personnaliser » underneath */
  .cookie-banner__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'reject accept'
      'custom custom';
    align-items: center;
    gap: 0.625rem;

    & [data-cookie-choice='reject'] {
      grid-area: reject;
    }

    & [data-cookie-choice='accept'] {
      grid-area: accept;
    }

    @media screen and (min-width: 750px) {
      grid-template-columns: auto 8.5rem 8.5rem;
      grid-template-areas: 'custom reject accept';
      gap: 0.75rem;
    }
  }

  .cookie-banner__button {
    min-height: 2.875rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--cookie-button);
    border-radius: 999px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cookie-button-label);
    background-color: var(--cookie-button);
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      color var(--duration-base) ease,
      transform var(--duration-base) var(--ease-out);

    /* Hover only with a mouse: on phones a tap would leave it stuck */
    @media (hover: hover) {
      &:hover {
        color: var(--cookie-text);
        background-color: transparent;
      }
    }

    &:active {
      transform: scale(0.98);
    }

    &:focus-visible {
      outline: 2px solid var(--cookie-text);
      outline-offset: 3px;
    }
  }

  .cookie-banner__customize {
    grid-area: custom;
    justify-self: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 0;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--cookie-text);
    background: none;
    text-decoration: underline;
    text-decoration-color: rgb(var(--cookie-accent-rgb) / 0.7);
    text-underline-offset: 0.3em;
    cursor: pointer;

    &:hover {
      text-decoration-color: currentColor;
    }

    &:focus-visible {
      outline: 2px solid var(--cookie-text);
      outline-offset: 2px;
      border-radius: 0.25rem;
    }
  }

  /* While the banner is up, the help button and its bubble step aside. */
  html[data-cookie-banner-open] .assistant {
    visibility: hidden;
  }

  /* Preferences: a calm ivory window, one line per kind of cookie, with a switch */
  .cookie-prefs {
    --prefs-text: #49352f;
    --prefs-text-rgb: 73 53 47;
    --prefs-muted: #6e574c;

    width: min(100% - 2rem, 32rem);
    max-height: min(100dvh - 2rem, 44rem);
    padding: 0;
    border: 0;
    border-radius: 1.5rem;
    color: var(--prefs-text);
    background-color: #fcf9f7;
    background-image: radial-gradient(90% 50% at 100% 0%, rgb(var(--cookie-accent-rgb) / 0.14), transparent 70%);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.45),
      0 40px 110px -40px rgb(48 39 36 / 0.6);
    overflow: auto;
    overscroll-behavior: contain;

    &::backdrop {
      background-color: rgb(var(--palette-scrim-rgb) / 0.5);
      backdrop-filter: blur(6px);
    }

    &[open] {
      animation: cookie-prefs-in 600ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    @media screen and (max-width: 749px) {
      width: 100%;
      max-width: 100%;
      max-height: 92dvh;
      margin: auto 0 0;
      border-radius: 1.5rem 1.5rem 0 0;
    }
  }

  @keyframes cookie-prefs-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  .cookie-prefs__inner {
    padding: 1.75rem clamp(1.25rem, 0.75rem + 2vw, 2.25rem) calc(1.25rem + env(safe-area-inset-bottom));
  }

  .cookie-prefs__header {
    position: relative;
    padding-inline-end: 3rem;
  }

  .cookie-prefs__title {
    font-size: 1.5rem;
  }

  .cookie-prefs__close {
    position: absolute;
    inset-block-start: -0.5rem;
    inset-inline-end: -0.25rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(var(--prefs-text-rgb) / 0.16);
    border-radius: 50%;
    color: var(--prefs-text);
    background-color: rgb(255 255 255 / 0.7);
    cursor: pointer;

    & .icon {
      width: 1rem;
      height: 1rem;
    }
  }

  .cookie-prefs__intro {
    margin: 0.5rem 0 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--prefs-muted);
  }

  .cookie-prefs__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cookie-prefs__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.9375rem;
    border-block-start: 1px solid rgb(var(--prefs-text-rgb) / 0.12);
  }

  .cookie-prefs__label {
    display: grid;
    flex: 1;
    gap: 0.2rem;
    min-width: 0;
    cursor: pointer;
  }

  .cookie-prefs__label--static {
    cursor: default;
  }

  .cookie-prefs__name {
    font-family: var(--cookie-font);
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .cookie-prefs__desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--prefs-muted);
  }

  .cookie-prefs__always {
    flex: none;
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--prefs-muted);
  }

  /* A switch drawn from a checkbox: a pale knob on the left when off, on the right over espresso when on */
  .cookie-prefs__switch {
    position: relative;
    flex: none;
    width: 2.75rem;
    height: 1.625rem;
    margin: 0;
    border: 1px solid rgb(var(--prefs-text-rgb) / 0.55);
    border-radius: 999px;
    background-color: rgb(var(--prefs-text-rgb) / 0.12);
    appearance: none;
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;

    &::after {
      content: '';
      position: absolute;
      inset-block-start: 0.1875rem;
      inset-inline-start: 0.1875rem;
      width: 1.125rem;
      height: 1.125rem;
      border-radius: 50%;
      background-color: #fff;
      box-shadow:
        0 0 0 1px rgb(var(--prefs-text-rgb) / 0.35),
        0 1px 3px rgb(48 39 36 / 0.25);
      transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    &:checked {
      border-color: var(--cookie-bg);
      background-color: var(--cookie-bg);

      &::after {
        box-shadow: none;
        transform: translateX(1.125rem);
      }
    }

    &:focus-visible {
      outline: 2px solid var(--prefs-text);
      outline-offset: 3px;
    }
  }

  /* Refuse and accept side by side, alike; saving the switches below, full width */
  .cookie-prefs__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.625rem;
    margin-block-start: 0.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid rgb(var(--prefs-text-rgb) / 0.12);
  }

  .cookie-prefs__button {
    min-height: 2.875rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--cookie-bg);
    border-radius: 999px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background-color: var(--cookie-bg);
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      color var(--duration-base) ease;

    &:focus-visible {
      outline: 2px solid var(--prefs-text);
      outline-offset: 3px;
    }
  }

  .cookie-prefs__button--quiet {
    color: var(--cookie-bg);
    background-color: transparent;

    @media (hover: hover) {
      &:hover {
        color: #fff;
        background-color: var(--cookie-bg);
      }
    }
  }

  .cookie-prefs__save {
    grid-column: 1 / -1;
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-banner,
    .cookie-banner__button,
    .cookie-prefs__switch,
    .cookie-prefs__switch::after {
      transition: none;
    }

    .cookie-prefs[open] {
      animation: none;
    }
  }

  @media (forced-colors: active) {
    .cookie-prefs__switch::after {
      background-color: ButtonText;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bannière cookies",
  "tag": "div",
  "class": "section-cookie-banner",
  "limit": 1,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Afficher la bannière cookies",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Elle s'affiche dès l'ouverture du site tant qu'aucun choix n'est fait, et enregistre ce choix auprès de Shopify (outil de confidentialité intégré). Si la bannière cookies de Shopify est activée dans Paramètres > Confidentialité des clients, c'est elle qui s'affiche et celle-ci s'efface, pour ne jamais en montrer deux. Le lien « Gérer les cookies » du pied de page rouvre les préférences."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Cookies"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "Nous les utilisons pour mesurer l'audience et personnaliser nos offres."
    },
    {
      "type": "page",
      "id": "policy_page",
      "label": "Page « En savoir plus »",
      "info": "Par défaut, la politique de confidentialité de la boutique."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Police du titre",
      "default": "playfair_display_n4"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fond",
      "default": "#2b201d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#f7efe9"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Reflet",
      "default": "#d9a58f"
    },
    {
      "type": "color",
      "id": "button",
      "label": "Boutons",
      "default": "#f7efe9"
    },
    {
      "type": "color",
      "id": "button_label",
      "label": "Texte des boutons",
      "default": "#2b201d"
    }
  ],
  "presets": [{ "name": "Bannière cookies" }]
}
{% endschema %}
