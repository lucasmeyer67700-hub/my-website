{%- comment -%}
  Home band of reviews: title, average rating with the number of reviews, and
  the moving cards (snippet "reviews-band"). Built from the product's own
  reviews (custom.avis), or else from the reviews published on another site
  (custom.avis_externes): then the rating and total come from that site
  (custom.avis_externes_note, custom.avis_externes_total) and the source is
  named under the title. No review, no section.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign review_count = 0
  assign reviews_key = 'avis'
  if product != blank
    assign own_count = product.metafields.custom.avis.value.size | default: 0
    if own_count == 0
      assign reviews_key = 'avis_externes'
    endif
    assign review_count = product.metafields.custom[reviews_key].value.size | default: 0
  endif
-%}

{%- if review_count > 0 -%}
  {%- comment -%} Up to 250 reviews (list.max): one paginate page covers them all. {%- endcomment -%}
  {%- paginate product.metafields.custom[reviews_key].value by 250 -%}
    {%- liquid
      assign rating_sum = 0
      assign source_name = ''
      for review in product.metafields.custom[reviews_key].value
        assign rating_sum = rating_sum | plus: review.note.value.rating
        if source_name == blank and review.source.value != blank
          assign source_name = review.source.value | strip | escape
        endif
      endfor
      assign average = rating_sum | times: 1.0 | divided_by: review_count
    -%}
  {%- endpaginate -%}
  {%- liquid
    assign display_average = average
    assign display_count = review_count
    if source_name != blank
      if product.metafields.custom.avis_externes_note.value != blank
        assign display_average = product.metafields.custom.avis_externes_note.value.rating
      endif
      assign source_total = product.metafields.custom.avis_externes_total.value | default: 0
      if source_total > review_count
        assign display_count = source_total
      endif
    endif
    assign average_x10 = display_average | times: 10 | round
    assign average_int = average_x10 | divided_by: 10 | floor
    assign average_dec = average_x10 | modulo: 10
    assign average_text = average_int | append: ',' | append: average_dec
  -%}

  <section
    class="reviews-band section color-{{ section.settings.color_scheme }}"
    aria-labelledby="ReviewsBandTitle-{{ section.id }}"
  >
    <div class="page-width">
      <div class="section-header section-header--center reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="h2" id="ReviewsBandTitle-{{ section.id }}">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ 'reviews.band_heading' | t }}
          {%- endif -%}
        </h2>
        <a class="reviews-band__summary" href="{{ product.url }}#avis">
          {% render 'stars', rating: display_average %}
          <span>
            {{- average_text }}/5 ·
            {% if source_name != blank -%}
              {{- 'reviews.source_total' | t: count: display_count, source: source_name -}}
            {%- else -%}
              {{- 'reviews.see_all' | t: count: review_count -}}
            {%- endif -%}
          </span>
        </a>
        {%- if source_name != blank -%}
          <p class="reviews-band__note">{{ 'reviews.source_note' | t: source: source_name }}</p>
        {%- endif -%}
      </div>
    </div>

    {% render 'reviews-band',
      product: product,
      limit: section.settings.limit,
      speed: section.settings.speed,
      direction: section.settings.direction
    %}
  </section>
{%- elsif request.design_mode -%}
  <section class="reviews-band section color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <p class="reviews-band__editor-note">{{ 'reviews.band_editor_empty' | t }}</p>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .reviews-band {
    overflow: hidden;
  }

  .reviews-band__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;

    &:hover span {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .reviews-band__note {
    max-width: 34rem;
    margin: var(--space-2xs) auto 0;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .reviews-band__editor-note {
    padding: var(--space-md);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avis défilants",
  "tag": "div",
  "class": "section-reviews-marquee",
  "settings": [
    {
      "type": "paragraph",
      "content": "Avis réels du champ méta « Avis clientes » du produit choisi. Sans avis publié, la section reste invisible pour vos visiteuses."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Avis clientes"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Elles en parlent"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nombre d'avis",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Sens du défilement",
      "options": [
        { "value": "ltr", "label": "De gauche à droite" },
        { "value": "rtl", "label": "De droite à gauche" }
      ],
      "default": "ltr"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Vitesse (secondes par avis)",
      "info": "Plus le nombre est grand, plus le défilement est lent.",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Avis défilants"
    }
  ]
}
{% endschema %}
