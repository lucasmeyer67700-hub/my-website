{%- comment -%}
  Avis clients : carrousel animé + photos clientes.
  - Vrais avis : bloc de l'app d'avis (Judge.me) ou blocs « Avis ».
  - Simulation : avis de démonstration affichés UNIQUEMENT tant que le thème n'est pas publié
    (aperçu et éditeur). Dès la publication, ils disparaissent automatiquement : de faux avis
    visibles par les clientes sont interdits (Code de la consommation, art. L121-2 et s.).
{%- endcomment -%}
{%- liquid
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign photo_blocks = section.blocks | where: 'type', 'photo'
  assign simulate = false
  if section.settings.simulate and review_blocks.size == 0 and app_blocks.size == 0
    if theme.role != 'main' or request.design_mode
      assign simulate = true
    endif
  endif
-%}
{%- if review_blocks.size > 0 or app_blocks.size > 0 or simulate -%}
  {%- render 'vl-padding' -%}
  <section class="vl-reviews color-{{ section.settings.color_scheme }} gradient" id="{{ section.settings.anchor | default: 'avis' | handle }}">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="vl-heading vl-heading--center">
        <h2 class="h1">{{ section.settings.title | escape }}</h2>
        {%- if simulate -%}
          <p class="vl-reviews__summary"><span class="vl-reviews__stars">★★★★★</span> <strong>{{ section.settings.sim_rating }}/5</strong> · {{ section.settings.sim_count }} avis</p>
        {%- endif -%}
      </div>
      {%- for block in app_blocks -%}<div class="vl-reviews__app">{% render block %}</div>{%- endfor -%}

      {%- capture cards -%}
        {%- if simulate -%}
          {%- capture demo -%}Camille|Enfin un truc qui me permet de bosser pendant mes règles. Je la mets sous mon pull au bureau et personne ne voit rien.|5~Sarah|La chaleur est douce, je reste au niveau 1 et ça me suffit. Le massage est un vrai plus le soir.|5~Inès|Livraison un peu longue mais le produit est top. Je ne ressors plus la bouillotte.|4~Julie|Je l'ai offerte à ma sœur, elle en a recommandé une pour sa fille.|5~Manon|Discrète, rechargeable, elle tient bien en place. Mon rituel du soir avec une tisane.|5~Léa|Très agréable sur le bas du dos aussi, je ne m'y attendais pas.|5~Chloé|Je la recharge le dimanche et elle me suit toute la semaine.|5~Emma|Simple à utiliser, trois boutons et c'est parti. Je la conseille.|4~Nora|Je l'emmène en cours, elle est vraiment fine sous un sweat.|5~Lucie|Le meilleur achat de l'année pour mes règles. Merci VELEA !|5{%- endcapture -%}
          {%- assign items = demo | split: '~' -%}
          {%- for it in items -%}
            {%- assign f = it | split: '|' -%}
            {%- assign stars = f[2] | plus: 0 -%}
            <li class="vl-review">
              <p class="vl-review__head"><strong>{{ f[0] }}</strong></p>
              <p class="vl-review__stars" aria-label="{{ stars }} sur 5">{%- for i in (1..5) -%}<span class="{% if i <= stars %}is-on{% endif %}">★</span>{%- endfor -%}</p>
              <blockquote class="vl-review__text">« {{ f[1] }} »</blockquote>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in review_blocks -%}
            <li class="vl-review" {{ block.shopify_attributes }}>
              <p class="vl-review__head"><strong>{{ block.settings.author | escape }}</strong>{%- if block.settings.detail != blank %} · {{ block.settings.detail | escape }}{% endif -%}</p>
              <p class="vl-review__stars" aria-label="{{ block.settings.rating }} sur 5">{%- for i in (1..5) -%}<span class="{% if i <= block.settings.rating %}is-on{% endif %}">★</span>{%- endfor -%}</p>
              <blockquote class="vl-review__text">« {{ block.settings.text | escape }} »</blockquote>
            </li>
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}

      {%- if cards != blank -%}
        <div class="vl-carousel" style="--vl-carousel-speed: {{ section.settings.speed }}s">
          <ul class="vl-carousel__track" role="list">{{ cards }}</ul>
          <ul class="vl-carousel__track" role="list" aria-hidden="true">{{ cards }}</ul>
        </div>
      {%- endif -%}

      <div class="vl-ugc-photos">
        {%- for n in (1..2) -%}
          {%- assign blk = photo_blocks[forloop.index0] -%}
          <figure class="vl-ugc-photo" {% if blk %}{{ blk.shopify_attributes }}{% endif %}>
            {%- if blk.settings.image != blank -%}
              {{ blk.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 750px) 40vw, 90vw', alt: blk.settings.caption | default: 'Cliente VELEA' }}
            {%- else -%}
              <span class="vl-ugc-photo__empty">{% render 'vl-icon', icon: 'heart' %}<span>Photo cliente {{ n }}</span></span>
            {%- endif -%}
            {%- if blk.settings.caption != blank %}<figcaption>{{ blk.settings.caption | escape }}</figcaption>{% endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Avis clients",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "simulate", "label": "Simulation d'avis (thème non publié)", "default": true, "info": "Visible dans l'aperçu et l'éditeur uniquement. Disparaît automatiquement quand le thème est publié." },
    { "type": "text", "id": "sim_rating", "label": "Note simulée", "default": "4,7" },
    { "type": "text", "id": "sim_count", "label": "Nombre d'avis simulé", "default": "298" },
    { "type": "range", "id": "speed", "label": "Vitesse du défilement", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 60 },
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "avis" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce qu'en disent nos clientes" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review", "name": "Avis réel",
      "settings": [
        { "type": "text", "id": "author", "label": "Prénom" },
        { "type": "text", "id": "detail", "label": "Détail (ville, date…)" },
        { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Avis" }
      ]
    },
    {
      "type": "photo", "name": "Photo cliente", "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (avec l'accord de la cliente)" },
        { "type": "text", "id": "caption", "label": "Légende" }
      ]
    }
  ],
  "presets": [{ "name": "VELEA · Avis clients" }]
}
{% endschema %}
