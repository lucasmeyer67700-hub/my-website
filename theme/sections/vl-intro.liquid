{%- comment -%} Présentation de la marque : titre centré, texte, badges. Uniquement des affirmations vraies. {%- endcomment -%}
{%- render 'vl-padding' -%}
<section class="vl-intro color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <h2 class="vl-intro__title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank %}<div class="vl-intro__text rte">{{ section.settings.text }}</div>{% endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="vl-intro__badges" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'vl-icon', icon: 'check' %}<span>{{ block.settings.text | escape }}</span></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VELEA · Présentation",
  "tag": "div",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "VELEA, la douceur par la chaleur" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [{ "type": "badge", "name": "Badge", "limit": 6, "settings": [{ "type": "text", "id": "text", "label": "Texte (uniquement vrai et vérifiable)" }] }],
  "presets": [{ "name": "VELEA · Présentation" }]
}
{% endschema %}
