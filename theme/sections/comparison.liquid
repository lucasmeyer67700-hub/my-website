{%- assign anchor = section.settings.anchor | handleize -%}

{%- if section.blocks.size > 0 -%}
  <section
    class="comparison section color-{{ section.settings.color_scheme }}"
    {% if anchor != blank %}
      id="{{ anchor }}"
    {% endif %}
    aria-labelledby="ComparisonTitle-{{ section.id }}"
  >
    <div class="page-width page-width--narrow">
      <div class="section-header section-header--center reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="h2" id="ComparisonTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="lead">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      <div
        class="comparison__scroller reveal"
        role="region"
        aria-labelledby="ComparisonTitle-{{ section.id }}"
        tabindex="0"
      >
        {%- liquid
          assign checks_only = true
          for block in section.blocks
            assign values = block.settings.value_1 | append: '§' | append: block.settings.value_2 | append: '§' | append: block.settings.value_3 | downcase | split: '§'
            for v in values
              assign cell = v | strip
              unless cell == 'oui' or cell == 'non' or cell == ''
                assign checks_only = false
              endunless
            endfor
          endfor
        -%}
        <table class="comparison__table{% if checks_only %} comparison__table--checks{% endif %}">
          <caption class="visually-hidden">{{ section.settings.heading | strip_html }}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{{ 'sections.comparison_criterion' | t }}</span></th>
              <th scope="col" class="comparison__highlight">{{ section.settings.column_1 | escape }}</th>
              <th scope="col">{{ section.settings.column_2 | escape }}</th>
              {%- if section.settings.column_3 != blank -%}
                <th scope="col">{{ section.settings.column_3 | escape }}</th>
              {%- endif -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label | escape }}</th>
                <td class="comparison__highlight">{% render 'comparison-value', value: block.settings.value_1 %}</td>
                <td>{% render 'comparison-value', value: block.settings.value_2 %}</td>
                {%- if section.settings.column_3 != blank -%}
                  <td>{% render 'comparison-value', value: block.settings.value_3 %}</td>
                {%- endif -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      {% render 'section-cta', label: section.settings.cta_label, link: section.settings.cta_link, note: section.settings.cta_note %}

      {%- if section.settings.note != blank -%}
        <p class="comparison__note text-muted text-small">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /* Only "oui" / "non": ticks and crosses, narrow enough for a phone */
  .comparison__table.comparison__table--checks {
    min-width: 0;

    & th,
    & td {
      padding: 0.85rem 0.6rem;
    }

    & td,
    & thead th:not(:first-child) {
      text-align: center;
    }

    & tbody th {
      font-size: var(--text-sm);
    }
  }

  .comparison__yes,
  .comparison__no {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;

    & .icon {
      --icon-size: 0.95rem;
    }
  }

  .comparison__yes {
    color: #fff;
    background-color: var(--rose-cta, #a14a5c);
  }

  .comparison__no {
    color: var(--color-text-muted);
    background-color: rgb(var(--color-text-rgb) / 0.07);
  }

  .comparison__scroller {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-background);
    -webkit-overflow-scrolling: touch;
  }

  .comparison__table {
    width: 100%;
    min-width: 36rem;
    font-size: var(--text-base);

    & th,
    & td {
      padding: 1rem 1.1rem;
      border-block-end: 1px solid var(--color-border);
      text-align: start;
      vertical-align: top;
    }

    & tbody tr:last-child th,
    & tbody tr:last-child td {
      border-block-end: 0;
    }

    & thead th {
      font-size: var(--text-sm);
      font-weight: var(--font-body-weight-medium);
      color: var(--color-text-muted);
    }

    & tbody th {
      position: sticky;
      inset-inline-start: 0;
      font-weight: var(--font-body-weight-medium);
      background-color: var(--color-background);
    }

    & td {
      color: var(--color-text-muted);
    }
  }

  .comparison__table .comparison__highlight {
    color: var(--color-text);
    background-color: rgb(var(--color-button-rgb) / 0.05);
  }

  .comparison__table thead .comparison__highlight {
    font-family: var(--font-heading-family);
    font-size: var(--text-xl);
    font-weight: var(--font-heading-weight);
    color: var(--color-text);
  }

  .comparison__note {
    margin-block-start: var(--space-md);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comparatif",
  "tag": "div",
  "class": "section-comparison",
  "max_blocks": 10,
  "settings": [
    {
      "type": "paragraph",
      "content": "Comparez uniquement des faits vérifiables et restez juste avec les alternatives."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Bouillotte, patch ou ceinture ?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "column_1",
      "label": "Colonne 1 (mise en avant)",
      "default": "Ceinture chauffante"
    },
    {
      "type": "text",
      "id": "column_2",
      "label": "Colonne 2",
      "default": "Bouillotte"
    },
    {
      "type": "text",
      "id": "column_3",
      "label": "Colonne 3 (facultative)",
      "default": "Patch chauffant"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note sous le tableau"
    },
    {
      "type": "header",
      "content": "Bouton d'achat"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "info": "Vide : pas de bouton. Sur une fiche produit, il ramène au bouton d'achat."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien (hors fiche produit)"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Phrase sous le bouton",
      "info": "Par exemple votre garantie, telle qu'écrite dans votre politique de remboursement."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre (lien interne)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Critère",
          "default": "Critère"
        },
        {
          "type": "text",
          "id": "value_1",
          "label": "Colonne 1"
        },
        {
          "type": "text",
          "id": "value_2",
          "label": "Colonne 2"
        },
        {
          "type": "text",
          "id": "value_3",
          "label": "Colonne 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparatif",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
