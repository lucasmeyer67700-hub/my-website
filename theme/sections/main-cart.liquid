<section class="main-cart section section--compact color-{{ section.settings.color_scheme }}" aria-labelledby="CartTitle">
  <div class="page-width" data-main-cart data-section-id="{{ section.id }}">
    <h1 class="h2 main-cart__title" id="CartTitle" tabindex="-1" data-cart-title>{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      {%- comment -%} Empty cart: the sentence only, nothing else. {%- endcomment -%}
      <div class="main-cart__empty">
        <p class="lead">{{ 'cart.empty' | t }}</p>
      </div>
    {%- else -%}
      <div class="main-cart__grid">
        <cart-items class="main-cart__items">
          <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" novalidate>
            <ul class="cart-lines" role="list">
              {%- for item in cart.items -%}
                {% render 'cart-line', item: item, index: forloop.index, context: 'page' %}
              {%- endfor -%}
            </ul>

            {%- if settings.cart_note -%}
              <div class="field main-cart__note">
                <label class="field__label" for="CartPageNote">{{ 'cart.note' | t }}</label>
                <textarea class="field__input" id="CartPageNote" name="note">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            <noscript>
              <button type="submit" class="button button--secondary" name="update">{{ 'cart.update' | t }}</button>
            </noscript>
          </form>
          {% render 'cart-upsell', context: 'page' %}
        </cart-items>

        <aside class="main-cart__summary" aria-label="{{ 'cart.subtotal' | t }}">
          {% render 'cart-summary', form_id: 'CartPageForm' %}
        </aside>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .main-cart__title {
    margin-block-end: var(--space-xl);
  }

  .main-cart__empty {
    display: grid;
    justify-items: start;
    gap: var(--space-lg);
  }

  .main-cart__title:focus {
    outline: none;
  }

  .main-cart__grid {
    display: grid;
    gap: var(--space-xl);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
  }

  .main-cart__note {
    margin-block-start: var(--space-xl);
  }

  .main-cart__summary {
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);

    @media screen and (min-width: 990px) {
      position: sticky;
      inset-block-start: calc(var(--header-height) + 1.5rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Panier",
  "tag": "div",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
