{%- if section.blocks.size > 0 -%}
  <div class="vl-announce color-{{ section.settings.color_scheme }}" role="region" aria-label="Annonces">
    <div class="vl-announce__wrap page-width">
    {%- if section.blocks.size > 1 -%}<button type="button" class="vl-announce__arrow" data-dir="-1" aria-label="Annonce précédente"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>{%- endif -%}
    <div class="vl-announce__track" data-interval="{{ section.settings.interval | times: 1000 }}">
      {%- for block in section.blocks -%}
        <p class="vl-announce__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}{% render 'vl-icon', icon: block.settings.icon %}{%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}<button type="button" class="vl-announce__arrow" data-dir="1" aria-label="Annonce suivante"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>{%- endif -%}
    </div>
  </div>
  {%- if section.blocks.size > 1 -%}
    <script>
      (function () {
        var track = document.querySelector('#shopify-section-{{ section.id }} .vl-announce__track');
        if (!track || track.dataset.ready) return;
        track.dataset.ready = '1';
        var items = track.querySelectorAll('.vl-announce__item');
        var i = 0, paused = false;
        function go(d) {
          items[i].classList.remove('is-active');
          i = (i + d + items.length) % items.length;
          items[i].classList.add('is-active');
        }
        document.querySelectorAll('#shopify-section-{{ section.id }} .vl-announce__arrow').forEach(function (b) {
          b.addEventListener('click', function () { paused = true; go(parseInt(b.dataset.dir, 10)); });
        });
        setInterval(function () {
          if (document.hidden || paused) return;
          go(1);
        }, parseInt(track.dataset.interval, 10) || 4000);
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Annonces",
  "class": "vl-announce-section",
  "settings": [
    { "type": "range", "id": "interval", "label": "Défilement (secondes)", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-5" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte en France métropolitaine" },
        { "type": "url", "id": "link", "label": "Lien" },
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "truck",
          "options": [
            { "value": "none", "label": "Aucune" },
            { "value": "truck", "label": "Camion" },
            { "value": "return", "label": "Retour" },
            { "value": "heart", "label": "Cœur" },
            { "value": "gift", "label": "Cadeau" },
            { "value": "lock", "label": "Cadenas" },
            { "value": "heat", "label": "Chaleur" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "VELEA · Annonces", "blocks": [{ "type": "message" }] }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
