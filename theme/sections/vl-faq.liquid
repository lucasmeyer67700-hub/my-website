{%- render 'vl-padding' -%}
<section class="vl-faq color-{{ section.settings.color_scheme }} gradient"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="vl-heading vl-heading--center">
      {%- if section.settings.eyebrow != blank %}<p class="vl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
      <h2 class="h1">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.text != blank %}<div class="vl-heading__text rte">{{ section.settings.text }}</div>{% endif -%}
    </div>
    <div class="vl-faq__list">
      {%- for block in section.blocks -%}
        <details class="vl-faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            <span class="vl-faq__toggle" aria-hidden="true">{% render 'vl-icon', icon: 'plus' %}</span>
          </summary>
          <div class="vl-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.contact_label != blank -%}
      <p class="vl-faq__contact">
        {{ section.settings.contact_text | escape }}
        <a href="{{ section.settings.contact_link }}">{{ section.settings.contact_label | escape }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Questions",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (ex. faq)" },
    { "type": "text", "id": "eyebrow", "label": "Petit titre", "default": "Vos questions" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Questions fréquentes" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": true },
    { "type": "checkbox", "id": "schema_markup", "label": "Données structurées FAQ pour Google", "default": true, "info": "N'activez que sur une seule section de questions par page." },
    { "type": "text", "id": "contact_text", "label": "Texte de contact", "default": "Une autre question ?" },
    { "type": "text", "id": "contact_label", "label": "Lien de contact", "default": "Écrivez-nous" },
    { "type": "url", "id": "contact_link", "label": "Adresse du lien" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Combien de temps l'utiliser ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Entre 30 minutes et 1 heure, 2 à 3 fois par jour.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "VELEA · Questions", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
