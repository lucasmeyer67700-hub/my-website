<section class="password section color-{{ section.settings.color_scheme }}" aria-labelledby="PasswordTitle">
  <div class="page-width page-width--text password__inner">
    <p class="password__brand">{{ shop.name }}</p>
    <h1 class="h2" id="PasswordTitle">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="lead">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error" role="alert" id="PasswordError">
          {% render 'icon', icon: 'alert' %}
          {{ form.errors.messages['form'] }}
        </p>
      {%- endif -%}
      <label class="visually-hidden" for="PasswordInput">{{ 'password.label' | t }}</label>
      <div class="password__field">
        <input
          class="field__input"
          id="PasswordInput"
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="{{ 'password.label' | t }}"
          required
          {% if form.errors %}
            aria-invalid="true" aria-describedby="PasswordError"
          {% endif %}
        >
        <button type="submit" class="button">{{ 'password.submit' | t }}</button>
      </div>
    {%- endform -%}

    <p class="text-muted text-small">
      {{ 'password.admin' | t }}
      <a class="link" href="/admin" rel="nofollow">{{ 'password.login' | t }}</a>
    </p>
  </div>
</section>

{% stylesheet %}
  .password {
    display: grid;
    min-height: 100dvh;
    align-items: center;
  }

  .password__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .password__brand {
    font-family: var(--font-heading-family);
    font-size: 2rem;
  }

  .password__form {
    width: min(100%, 26rem);
  }

  .password__field {
    display: grid;
    gap: var(--space-2xs);

    @media screen and (min-width: 480px) {
      grid-template-columns: 1fr auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mot de passe",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Bientôt disponible"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
