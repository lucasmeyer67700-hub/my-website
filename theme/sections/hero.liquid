{%- liquid
  assign product = section.settings.product
  assign hero_image = section.settings.image
  if hero_image == blank and product != blank and product.media.size > 0
    assign media_index = section.settings.fallback_media_position | minus: 1 | at_least: 0
    assign hero_media = product.media[media_index] | default: product.featured_media
    assign hero_image = hero_media.preview_image
  endif
  assign mobile_image = section.settings.image_mobile

  assign primary_link = section.settings.button_link
  if primary_link == blank and product != blank
    assign primary_link = product.url
  endif
  if primary_link == blank
    assign primary_link = routes.all_products_collection_url
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign layout = section.settings.layout | default: 'pink'

  assign tone = section.settings.text_tone
  if hero_image == blank
    assign tone = 'dark'
  endif

  assign display_font = section.settings.display_font
  assign display_italic = display_font | font_modify: 'style', 'italic'
-%}

{%- style -%}
  {%- unless display_font.system? %}
    {{ display_font | font_face: font_display: 'swap' }}
    {%- if display_italic %}{{ display_italic | font_face: font_display: 'swap' }}{% endif -%}
  {%- endunless %}
  #Hero-{{ section.id }} {
    --hero-display-font: {{ display_font.family }}, {{ display_font.fallback_families }};
    --hero-display-weight: {{ display_font.weight }};
  }
{%- endstyle -%}

{%- capture hero_content -%}
  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <{{ heading_tag }} class="hero__title h1" id="HeroTitle-{{ section.id }}">
      {{- section.settings.heading -}}
    </{{ heading_tag }}>

    {%- if section.settings.text != blank -%}
      <p class="hero__text lead">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="button hero__button" href="{{ primary_link }}">
          {{- section.settings.button_label | escape -}}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <a class="button button--secondary hero__button" href="{{ section.settings.secondary_link }}">
          {{- section.settings.secondary_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_price and product != blank -%}
      <p class="hero__price">
        <span class="hero__price-amount">{{ product.price | money }}</span>
        {%- if settings.shipping_info != blank %}
          <span aria-hidden="true">·</span>
          <span>{{ settings.shipping_info | escape }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="trust-list trust-list--inline hero__trust" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'icon', icon: block.settings.icon %}
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- if layout == 'photo' -%}
  {%- liquid
    assign photo_width = section.settings.photo_width | default: 70
    assign photo_ratio = hero_image.aspect_ratio | default: 1.7778
    assign photo_sizes = '(min-width: 990px) ' | append: photo_width | append: 'vw, 100vw'
  -%}
  <section
    id="Hero-{{ section.id }}"
    class="hero hero--photo color-{{ section.settings.color_scheme }}{% if hero_image == blank %} hero--no-image{% endif %}"
    style="--photo-width: {{ photo_width }}%; --photo-ratio: {{ photo_ratio }}; --photo-crop-x: {{ section.settings.photo_crop_x | default: 50 }}%;"
    aria-labelledby="HeroTitle-{{ section.id }}"
  >
    {%- if hero_image != blank -%}
      <div class="hero__photo">
        <picture>
          {%- if mobile_image != blank -%}
            {%- capture mobile_srcset -%}
              {%- assign mobile_widths = '375,550,750,1100,1500' | split: ',' -%}
              {%- for width in mobile_widths -%}
                {%- assign width_number = width | plus: 0 -%}
                {%- if width_number <= mobile_image.width or forloop.first -%}
                  {%- unless forloop.first %}, {% endunless -%}
                  {{ mobile_image | image_url: width: width_number }} {{ width_number }}w
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            <source media="(max-width: 989px)" srcset="{{ mobile_srcset | strip }}" sizes="100vw">
          {%- endif -%}
          {% render 'responsive-image',
            image: hero_image,
            sizes: photo_sizes,
            widths: '600, 900, 1200, 1500, 1800, 2100, 2400',
            eager: true,
            alt: section.settings.image_alt,
            class: 'hero__photo-image'
          %}
        </picture>
      </div>
    {%- endif -%}

    <div class="hero__photo-inner page-width page-width--wide">
      {{ hero_content }}
    </div>
  </section>
{%- elsif layout == 'pink' -%}
  <section
    id="Hero-{{ section.id }}"
    class="hero hero--pink color-{{ section.settings.color_scheme }}{% if section.settings.image_position == 'left' %} hero--media-left{% endif %}{% if section.settings.show_drops %} has-drops{% endif %}"
    aria-labelledby="HeroTitle-{{ section.id }}"
  >
    {%- if section.settings.show_drops -%}
      {% render 'drops', animated: true, density: 'light' %}
    {%- endif -%}
    <div class="hero__pink-grid page-width page-width--wide">
      {{ hero_content }}

      <div class="hero__visual">
        <div class="hero__arch">
          {%- if hero_image != blank -%}
            {% render 'responsive-image',
              image: hero_image,
              sizes: '(min-width: 990px) 36vw, (min-width: 750px) 60vw, 80vw',
              widths: '400, 600, 800, 1000, 1300, 1600',
              eager: true,
              alt: section.settings.image_alt,
              class: 'hero__arch-image'
            %}
          {%- else -%}
            <div class="hero__arch-art" aria-hidden="true">
              <span class="hero__arch-ripple hero__arch-ripple--outer"></span>
              <span class="hero__arch-ripple"></span>
              <span class="hero__arch-drop"></span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- elsif layout == 'full' -%}
  {%- liquid
    assign overlay = section.settings.overlay_opacity | divided_by: 100.0
    if hero_image == blank
      assign overlay = 0
    endif
  -%}
  <section
    id="Hero-{{ section.id }}"
    class="hero hero--full hero--tone-{{ tone }} hero--{{ section.settings.content_position }} hero--height-{{ section.settings.height }} color-{{ section.settings.color_scheme }}{% if hero_image == blank %} hero--no-image{% endif %}{% if section.settings.mobile_stack %} hero--stack-mobile{% endif %}"
    style="--hero-overlay: {{ overlay }};"
    aria-labelledby="HeroTitle-{{ section.id }}"
  >
    <div class="hero__backdrop">
      {%- if hero_image != blank -%}
        <picture>
          {%- if mobile_image != blank -%}
            {%- capture mobile_srcset -%}
              {%- assign mobile_widths = '375,550,750,1100,1500' | split: ',' -%}
              {%- for width in mobile_widths -%}
                {%- assign width_number = width | plus: 0 -%}
                {%- if width_number <= mobile_image.width or forloop.first -%}
                  {%- unless forloop.first %}, {% endunless -%}
                  {{ mobile_image | image_url: width: width_number }} {{ width_number }}w
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            <source media="(max-width: 749px)" srcset="{{ mobile_srcset | strip }}" sizes="100vw">
          {%- endif -%}
          {%- liquid
            comment
              In portrait screens the landscape photo is cropped to fill the height,
              so it renders wider than the viewport: request a matching width.
            endcomment
            assign portrait_vh = hero_image.aspect_ratio | times: 90 | round | at_least: 100
            assign hero_sizes = '(orientation: portrait) ' | append: portrait_vh | append: 'vh, 100vw'
          -%}
          {% render 'responsive-image',
            image: hero_image,
            sizes: hero_sizes,
            widths: '750, 1100, 1500, 1800, 2200, 2600, 3000, 3600',
            eager: true,
            alt: section.settings.image_alt,
            class: 'hero__image'
          %}
        </picture>
        {%- liquid
          assign focal_point = hero_image.presentation.focal_point | default: '50% 50%'
          assign mobile_focal_point = mobile_image.presentation.focal_point | default: '50% 50%'
        -%}
        {%- assign focal_x = focal_point | split: ' ' | first -%}
        {% style %}
          /* !important: image_tag can write its own inline object-position. */
          #Hero-{{ section.id }} .hero__image {
            object-position: {{ focal_point }} !important;
          }
          @media screen and (min-width: 750px) {
            #Hero-{{ section.id }} .hero__image {
              object-position: {{ focal_x }} {{ section.settings.image_focus_y }}% !important;
            }
          }
          {%- if mobile_image != blank %}
            @media screen and (max-width: 749px) {
              #Hero-{{ section.id }} .hero__image {
                object-position: {{ mobile_focal_point }} !important;
              }
            }
          {%- endif %}
        {% endstyle %}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hero__placeholder' }}
      {%- endif -%}
    </div>

    <div class="hero__inner page-width page-width--wide">
      {{ hero_content }}
    </div>
  </section>
{%- else -%}
  <section
    id="Hero-{{ section.id }}"
    class="hero hero--split color-{{ section.settings.color_scheme }}{% if section.settings.image_position == 'left' %} hero--media-left{% endif %}"
    aria-labelledby="HeroTitle-{{ section.id }}"
  >
    <div class="hero__grid page-width">
      {{ hero_content }}

      <div class="hero__media media">
        {%- if hero_image != blank -%}
          {% render 'responsive-image',
            image: hero_image,
            sizes: '(min-width: 990px) 55vw, 100vw',
            eager: true,
            alt: section.settings.image_alt
          %}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /* ------------------------------------------------------------------ */
  /* Shared content                                                      */
  /* ------------------------------------------------------------------ */

  .hero__content {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    max-width: 34rem;
  }

  /* Display font of the banner (Playfair Display by default, like the logo) */
  .hero__title {
    font-family: var(--hero-display-font, var(--font-heading-family));
    font-weight: var(--hero-display-weight, 400);
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .hero__title em {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero--tone-light .hero__title em {
    color: var(--palette-rose-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-2xs);

    @media screen and (max-width: 479px) {
      width: 100%;

      & .button {
        flex: 1 1 100%;
      }
    }
  }

  .hero__price {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__price-amount {
    font-weight: var(--font-body-weight-medium);
    color: var(--color-text);
  }

  /* Two classes: must outrank the ul[role='list'] reset in base.css. */
  .hero__content .hero__trust {
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
  }

  /* ------------------------------------------------------------------ */
  /* Full-screen layout: landscape visual with text on top               */
  /* ------------------------------------------------------------------ */

  .hero--full {
    /* The palette's own colours, for the text under the photo on phones */
    --hero-base-text: var(--color-text);
    --hero-base-text-rgb: var(--color-text-rgb);
    --hero-base-muted: var(--color-text-muted);
    --hero-base-accent: var(--color-accent);
    --hero-base-border: var(--color-border);
    --hero-base-button: var(--color-button);
    --hero-base-button-rgb: var(--color-button-rgb);
    --hero-base-button-label: var(--color-button-label);

    position: relative;
    display: grid;
    min-height: max(32rem, calc(100vh - var(--header-offset, 7rem)));
    min-height: max(32rem, calc(100svh - var(--header-offset, 7rem)));
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-surface);
  }

  .hero--height-large {
    min-height: max(30rem, calc((100svh - var(--header-offset, 7rem)) * 0.82));
  }

  .hero--height-medium {
    min-height: max(28rem, calc((100svh - var(--header-offset, 7rem)) * 0.66));
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;

    & picture,
    & .hero__image,
    & .hero__placeholder {
      display: block;
      width: 100%;
      height: 100%;
    }

    & .hero__image {
      object-fit: cover;
    }
  }

  .hero__placeholder {
    opacity: 0.3;
  }

  /* Legibility veil: neutral and soft. Two crossed gradients darken the text
     column (left) and the bottom of the image, so the subject on the right
     stays bright. Strength is set by --hero-overlay (theme editor). */
  .hero--full::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to right,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.9)) 0%,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.4)) 40%,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 0.6)) 60%,
        rgb(var(--hero-scrim) / 0) 85%
      ),
      linear-gradient(
        to top,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.6)) 0%,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 0.9)) 50%,
        rgb(var(--hero-scrim) / 0) 85%
      );

    @media screen and (max-width: 749px) {
      background: linear-gradient(
        to top,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 2.4)) 0%,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 2)) 60%,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.5)) 85%,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 0.8)) 100%
      );
    }
  }

  @media screen and (min-width: 750px) {
    .hero--center-left::after {
      background: linear-gradient(
        to right,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.9)) 0%,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.2)) 45%,
        rgb(var(--hero-scrim) / 0) 80%
      );
    }

    .hero--center::after {
      background: rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.6));
    }

    /* Text at the bottom: the veil rises from the bottom, the product above stays bright */
    .hero--bottom-left::after {
      background:
        linear-gradient(
          to top,
          rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 2.1)) 0%,
          rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.5)) 28%,
          rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 0.45)) 50%,
          rgb(var(--hero-scrim) / 0) 66%
        ),
        linear-gradient(
          to right,
          rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 0.8)) 0%,
          rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 0.3)) 38%,
          rgb(var(--hero-scrim) / 0) 60%
        );
    }
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: end;
    padding-block: clamp(2rem, 5vh, 4.5rem);
  }

  .hero--bottom-left .hero__inner {
    @media screen and (min-width: 750px) {
      padding-block-end: clamp(1.75rem, 4vh, 3.5rem);
    }
  }

  .hero--center-left .hero__inner {
    @media screen and (min-width: 750px) {
      align-content: center;
    }
  }

  .hero--center .hero__inner {
    align-content: center;
    justify-items: center;

    & .hero__content {
      justify-items: center;
      text-align: center;
    }

    & .hero__actions,
    & .hero__trust {
      justify-content: center;
    }
  }

  .hero--full .hero__content {
    max-width: 46rem;
  }

  .hero--full .hero__text {
    max-width: 36rem;
  }

  .hero--full .hero__title {
    font-size: calc(clamp(2.6rem, 1.6rem + 3.6vw, 5.25rem) * var(--font-heading-scale, 1));
    line-height: 1.04;
  }

  /* Short laptop screens: a slightly smaller title keeps the product clear */
  @media screen and (min-width: 750px) and (max-height: 800px) {
    .hero--full .hero__title {
      font-size: calc(clamp(2.4rem, 1.4rem + 3vw, 4.25rem) * var(--font-heading-scale, 1));
    }
  }

  .hero--full .hero__eyebrow {
    letter-spacing: 0.22em;
  }

  .hero--full .hero__text {
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.6;
  }

  /* Entrance: the photo settles slowly, the text rises line after line */
  @media (prefers-reduced-motion: no-preference) {
    /* …then keeps breathing, very slowly, as long as the page is open */
    .hero--full .hero__image {
      animation:
        hero-settle 2.8s var(--ease-out) both,
        hero-breathe 26s ease-in-out 2.8s infinite alternate;
    }

    .hero--full .hero__content > * {
      animation: hero-rise 0.9s var(--ease-out) both;
    }

    .hero--full .hero__content > :nth-child(2) {
      animation-delay: 0.12s;
    }

    .hero--full .hero__content > :nth-child(3) {
      animation-delay: 0.24s;
    }

    .hero--full .hero__content > :nth-child(n + 4) {
      animation-delay: 0.36s;
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.06);
    }
  }

  @keyframes hero-breathe {
    to {
      scale: 1.05;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }

  .hero--full .hero__trust {
    gap: var(--space-2xs) var(--space-md);

    /* On phones the announcement bar already carries these reassurances. */
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  /* Soft halo attached to the text block: follows the text on every screen
     size (the section veil alone depends on the image proportions). Fades out
     at its edges so it reads as a shadow, not as a box. */
  .hero--full .hero__content {
    position: relative;
  }

  .hero--full .hero__content::before {
    content: '';
    position: absolute;
    inset-block: -3rem;
    inset-inline: calc(var(--gutter-wide) * -1 - 1px) -14rem;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.75)) 0%,
      rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.75)) 70%,
      rgb(var(--hero-scrim) / 0) 100%
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 3rem, #000 calc(100% - 3rem), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 3rem, #000 calc(100% - 3rem), transparent 100%);
  }

  .hero--center .hero__content::before {
    @media screen and (min-width: 750px) {
      inset-inline: -10rem;
      background: radial-gradient(
        closest-side,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.75)) 0%,
        rgb(var(--hero-scrim) / calc(var(--hero-overlay) * 1.75)) 60%,
        rgb(var(--hero-scrim) / 0) 100%
      );
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* Light text over a darkened photo */
  .hero--tone-light {
    --hero-scrim: var(--palette-scrim-rgb);

    & .hero__content {
      --color-text: var(--palette-warm-white);
      --color-text-rgb: var(--palette-warm-white-rgb);
      --color-text-muted: rgb(var(--palette-warm-white-rgb) / 0.88);
      --color-accent: rgb(var(--palette-warm-white-rgb) / 0.92);
      --color-border: rgb(var(--palette-warm-white-rgb) / 0.28);
      --color-button: var(--palette-warm-white);
      --color-button-rgb: var(--palette-warm-white-rgb);
      --color-button-label: var(--palette-ink);

      color: var(--color-text);
    }

    & .hero__title,
    & .hero__text,
    & .hero__eyebrow {
      text-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 0 28px rgb(0 0 0 / 0.2);
    }

    & .button--secondary {
      border-color: rgb(var(--palette-warm-white-rgb) / 0.7);
      background-color: rgb(var(--palette-ink-rgb) / 0.12);
      backdrop-filter: blur(6px);

      &:hover {
        border-color: var(--palette-warm-white);
        background-color: rgb(var(--palette-warm-white-rgb) / 0.14);
      }
    }
  }

  /* Phones and tablets (option): the photo on top, fading into the page, the
     text below it in the palette's colours, so the product is never hidden.
     Wide screens keep the text over the photo. */
  @media screen and (max-width: 749px), screen and (max-width: 1199px) and (max-aspect-ratio: 3 / 2) {
    .hero--full.hero--stack-mobile {
      display: block;
      min-height: 0;
      background-color: var(--color-background);

      &::after {
        display: none;
      }

      & .hero__backdrop {
        position: relative;
        inset: auto;
        width: 100%;
        aspect-ratio: 1.15;
        max-height: 54svh;

        @media (orientation: landscape) {
          max-height: 46svh;
        }

        -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 72%, transparent 100%);
        mask-image: linear-gradient(to bottom, #000 0, #000 72%, transparent 100%);
      }

      & .hero__inner {
        margin-block-start: -1.5rem;
        padding-block: 0 var(--space-xl);
      }

      & .hero__content::before {
        display: none;
      }

      & .hero__content {
        --color-text: var(--hero-base-text);
        --color-text-rgb: var(--hero-base-text-rgb);
        --color-text-muted: var(--hero-base-muted);
        --color-accent: var(--hero-base-accent);
        --color-border: var(--hero-base-border);
        --color-button: var(--hero-base-button);
        --color-button-rgb: var(--hero-base-button-rgb);
        --color-button-label: var(--hero-base-button-label);
      }

      & .hero__title,
      & .hero__text,
      & .hero__eyebrow {
        text-shadow: none;
      }

      & .hero__eyebrow {
        color: var(--color-text-muted);
      }

      & .button--secondary {
        border-color: rgb(var(--color-text-rgb) / 0.35);
        background-color: transparent;
        backdrop-filter: none;
      }
    }
  }

  /* Dark text over a light photo (or when no photo is set yet) */
  .hero--tone-dark {
    --hero-scrim: var(--palette-warm-white-rgb);
  }

  /* ------------------------------------------------------------------ */
  /* Photo layout: a real photo that dissolves into the rose page.       */
  /* Phones and tablets: photo on top, text over its faded foreground.   */
  /* Computers: photo on the right, text on the rose on the left.        */
  /* ------------------------------------------------------------------ */

  .hero--photo {
    --hero-h: max(34rem, calc(100svh - var(--header-offset, 7rem)));

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    overflow: hidden;
    isolation: isolate;

    /* Phones: photo and text fill the first screen (computers: see below). */
    @media screen and (max-width: 749px) {
      min-height: var(--hero-h);
    }
  }

  .hero__photo {
    position: relative;
    z-index: 0;
    width: 100%;
    aspect-ratio: 1.2;
    max-height: 46svh;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 60%, transparent 100%);

    @media screen and (min-width: 750px) {
      aspect-ratio: 1.75;
      max-height: 58svh;
    }

    & picture,
    & .hero__photo-image {
      display: block;
      width: 100%;
      height: 100%;
    }

    & .hero__photo-image {
      object-fit: cover;
      /* !important: image_tag may write an inline focal point. */
      object-position: var(--photo-crop-x, 50%) 32% !important;
    }
  }

  .hero__photo-inner {
    position: relative;
    z-index: 2;
    margin-block-start: clamp(-6rem, -12vw, -2.5rem);
    padding-block-end: clamp(2.5rem, 7vw, 4rem);
  }

  .hero--photo .hero__content {
    max-width: 34rem;
  }

  .hero--photo .hero__title {
    font-size: calc(clamp(2.6rem, 1.2rem + 3.2vw, 4.5rem) * var(--font-heading-scale, 1));
  }

  /* Small phones: keep the main button on the first screen. */
  @media screen and (max-width: 749px) and (max-height: 700px) {
    .hero--photo .hero__photo {
      max-height: 34svh;
    }

    .hero--photo .hero__content {
      gap: var(--space-sm);
    }
  }

  .hero--photo .hero__text {
    max-width: 30rem;
  }

  .hero--photo .hero__trust {
    gap: var(--space-2xs) var(--space-md);
    border-block-start-color: var(--warm-hairline);

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  /* No photo yet: a clean rose banner that still fills the first screen. */
  .hero--photo.hero--no-image {
    min-height: var(--hero-h);
  }

  .hero--photo.hero--no-image .hero__photo-inner {
    display: grid;
    align-content: center;
    margin-block-start: 0;
    padding-block: clamp(3rem, 10vh, 6rem);
  }

  @media screen and (min-width: 990px) {
    .hero--photo {
      min-height: var(--hero-h);

      /* Rose wash behind the text: keeps it legible where the photo fades in. */
      &::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(
          to right,
          rgb(var(--color-background-rgb) / 0.94) 0%,
          rgb(var(--color-background-rgb) / 0.8) 24%,
          rgb(var(--color-background-rgb) / 0) 42%
        );
      }
    }

    .hero__photo {
      position: absolute;
      inset-block-start: 0;
      inset-inline-end: 0;
      /* Never wider than the free space next to the text column. */
      width: min(var(--photo-width, 70%), calc(var(--hero-h) * var(--photo-ratio)), calc(100% - 22rem));
      max-height: none;
      aspect-ratio: var(--photo-ratio);
      -webkit-mask-image:
        linear-gradient(to right, transparent 0, #000 20%),
        linear-gradient(to bottom, #000 0, #000 76%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 0, #000 20%),
        linear-gradient(to bottom, #000 0, #000 76%, transparent 100%);
      mask-composite: intersect;

      & .hero__photo-image {
        object-position: 50% 50% !important;
      }
    }

    .hero__photo-inner {
      display: grid;
      align-content: center;
      margin-block-start: 0;
      padding-block: clamp(2.5rem, 6vh, 5rem);
    }

    .hero--photo .hero__content {
      max-width: min(34rem, 36vw);
    }
  }

  /* ------------------------------------------------------------------ */
  /* Pink layout: soft rose page, text on the left, arched visual        */
  /* ------------------------------------------------------------------ */

  .hero--pink {
    position: relative;
    display: grid;
    min-height: max(34rem, calc(100svh - var(--header-offset, 7rem)));

    /* Soft light behind the visual: depth without changing the pink. */
    &::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(55% 60% at 74% 42%, rgb(255 255 255 / 0.55), transparent 70%);
    }
  }

  .hero__pink-grid {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: center;
    gap: var(--space-xl);
    padding-block: clamp(2.5rem, 7vh, 5.5rem) clamp(3rem, 9vh, 6.5rem);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 6vw, 8rem);
    }
  }

  .hero--pink .hero__content {
    max-width: 40rem;
  }

  .hero--pink .hero__title {
    font-size: calc(clamp(2.75rem, 1.5rem + 4.2vw, 5.25rem) * var(--font-heading-scale, 1));
  }

  .hero--pink .hero__text {
    max-width: 34rem;
  }

  .hero--pink .hero__trust {
    gap: var(--space-2xs) var(--space-md);
    border-block-start-color: var(--warm-hairline);

    /* On phones the announcement bar already carries these reassurances. */
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .hero--pink.hero--media-left .hero__visual {
    @media screen and (min-width: 990px) {
      order: -1;
    }
  }

  .hero__visual {
    --arch-radius: 50% 50% var(--radius-lg) var(--radius-lg) / 40% 40% var(--radius-lg) var(--radius-lg);

    position: relative;
    isolation: isolate;
    justify-self: center;
    width: min(76%, 22rem);
    margin-inline-start: 0.9rem;

    @media screen and (min-width: 750px) {
      width: min(60%, 26rem);
    }

    @media screen and (min-width: 990px) {
      width: min(100%, 31rem);
    }

    /* Fine warm-brown arch, offset behind the visual */
    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      translate: -0.9rem 0.9rem;
      border: 1px solid rgb(var(--warm-rgb) / 0.75);
      border-radius: var(--arch-radius);
      pointer-events: none;
    }
  }

  .hero__arch {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--arch-radius);
    background: linear-gradient(180deg, var(--palette-warm-white) 0%, #f8e6e9 100%);
    box-shadow: 0 40px 80px -48px rgb(73 53 47 / 0.5);
  }

  .hero__arch-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Without a photo: one glossy drop above two warm ripples */
  .hero__arch-art {
    position: absolute;
    inset: 0;
  }

  .hero__arch-drop {
    position: absolute;
    top: 38%;
    left: 50%;
    width: 30%;
    aspect-ratio: 1;
    translate: -50% -50%;
    rotate: -45deg;
    border-radius: 50% 0 50% 50%;
    background:
      radial-gradient(circle at 44% 30%, rgb(255 255 255 / 0.95) 0 5%, transparent 16%),
      radial-gradient(circle at 70% 70%, rgb(255 255 255 / 0.25) 0 10%, transparent 30%),
      linear-gradient(225deg, #f9e3e7 0%, #ecbcc5 55%, #dc97a4 100%);
    box-shadow:
      inset -2px 2px 0 rgb(255 255 255 / 0.6),
      inset 0 0 0 1px rgb(var(--warm-rgb) / 0.5),
      0 26px 40px -22px rgb(160 90 105 / 0.55);
  }

  .hero__arch-ripple {
    position: absolute;
    top: 74%;
    left: 50%;
    width: 44%;
    aspect-ratio: 4 / 1;
    translate: -50% -50%;
    border: 1px solid rgb(var(--warm-rgb) / 0.6);
    border-radius: 50%;
  }

  .hero__arch-ripple--outer {
    width: 70%;
    border-color: rgb(var(--warm-rgb) / 0.3);
  }

  /* ------------------------------------------------------------------ */
  /* Split layout: text and image side by side                          */
  /* ------------------------------------------------------------------ */

  .hero--split {
    padding-block: var(--space-lg) var(--section-space);

    @media screen and (min-width: 990px) {
      padding-block: var(--space-xl) var(--section-space);
    }
  }

  .hero__grid {
    display: grid;
    gap: var(--space-md);
    align-items: center;

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 5vw, 6rem);
    }
  }

  .hero--media-left .hero__media {
    @media screen and (min-width: 990px) {
      order: -1;
    }
  }

  .hero__media {
    --media-ratio: 4 / 3;
    border-radius: var(--radius-lg);

    @media screen and (min-width: 990px) {
      --media-ratio: 5 / 6;
      max-height: calc(100dvh - var(--header-height) - 4rem);
      min-height: 32rem;
    }
  }

  /* Mobile split: title first, then the visual, then the text and buttons. */
  @media screen and (max-width: 989px) {
    .hero--split .hero__content {
      display: contents;
    }

    .hero--split .hero__content > * {
      order: 2;
    }

    .hero--split .hero__content > .eyebrow,
    .hero--split .hero__content > .hero__title {
      order: 0;
    }

    .hero--split .hero__media {
      order: 1;
    }

    .hero--split .hero__content > .eyebrow {
      margin-block-end: calc(var(--space-sm) * -1);
    }
  }
{% endstylesheet %}

{% schema %}
