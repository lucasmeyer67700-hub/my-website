{%- comment -%}
  The customer's journey in three steps (difficult days → discovering the
  belt → a moment of comfort): one image, a short title and one or two
  sentences per step. Without an image, a step shows as a soft card with its
  icon, so the section never shows empty frames.
{%- endcomment -%}
{%- assign anchor = section.settings.anchor | handleize -%}

<section
  class="journey section color-{{ section.settings.color_scheme }}{% if section.settings.show_drops %} has-drops{% endif %}"
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
  {% if section.settings.heading != blank %}
    aria-labelledby="JourneyTitle-{{ section.id }}"
  {% endif %}
>
  {%- if section.settings.show_drops -%}
    {% render 'drops', animated: true %}
  {%- endif -%}
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header section-header--center reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" id="JourneyTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="lead">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      comment
        Without any photo, the steps become a light timeline (icon, line, text)
        instead of empty picture frames.
      endcomment
      assign has_images = false
      for block in section.blocks
        if block.settings.image != blank
          assign has_images = true
        endif
      endfor
    -%}
    <ol class="journey__steps{% unless has_images %} journey__steps--timeline{% endunless %}" role="list">
      {%- for block in section.blocks -%}
        {%- assign step_image = block.settings.image -%}
        <li class="journey__step reveal" {{ block.shopify_attributes }}>
          {%- if has_images -%}
            <div class="journey__media{% if step_image == blank %} journey__media--empty{% endif %}">
              {%- if step_image != blank -%}
                {% render 'responsive-image',
                  image: step_image,
                  sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw',
                  widths: '360, 540, 720, 900, 1080',
                  class: 'journey__image'
                %}
              {%- else -%}
                <span class="journey__art" aria-hidden="true">{% render 'icon', icon: block.settings.icon %}</span>
                {%- if request.design_mode -%}
                  <p class="journey__hint">{{ 'sections.journey_image_hint' | t }}</p>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="journey__marker" aria-hidden="true">
              <span class="journey__art">{% render 'icon', icon: block.settings.icon %}</span>
              {%- unless forloop.last -%}<span class="journey__line"></span>{%- endunless -%}
            </div>
          {%- endif -%}
          <div class="journey__body">
            <p class="journey__label">{{ 'sections.journey_step' | t: number: forloop.index }}</p>
            <h3 class="journey__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="journey__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .journey__steps {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.25rem, 2.5vw, 2.5rem);
    }
  }

  .journey__step {
    display: grid;
    align-content: start;
    gap: var(--space-sm);

    @media screen and (max-width: 749px) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
      gap: var(--space-sm);
    }
  }

  .journey__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);

    & .journey__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @media screen and (max-width: 749px) {
      aspect-ratio: 1;
    }
  }

  /* No image yet: a soft card with the step's icon */
  .journey__media--empty {
    display: grid;
    place-items: center;
    aspect-ratio: auto;
    min-height: 9.5rem;
    border: 1px solid var(--warm-hairline);
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(255 255 255 / 0.85), transparent 70%),
      var(--palette-rose-light);

    @media screen and (min-width: 750px) {
      min-height: 13rem;
    }

    @media screen and (max-width: 749px) {
      aspect-ratio: 1;
      min-height: 0;
    }
  }

  .journey__art {
    display: grid;
    place-items: center;
    width: clamp(3.75rem, 3rem + 2vw, 5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--warm-text);
    background-color: rgb(255 255 255 / 0.9);
    box-shadow: 0 0 0 1px var(--warm-hairline), 0 14px 30px -18px rgb(73 53 47 / 0.35);

    & .icon {
      --icon-size: clamp(1.5rem, 1.2rem + 0.8vw, 2rem);
    }
  }

  .journey__hint {
    position: absolute;
    inset-inline: var(--space-xs);
    inset-block-end: var(--space-xs);
    font-size: var(--text-xs);
    text-align: center;
    color: var(--color-text-muted);
  }

  .journey__body {
    display: grid;
    gap: var(--space-2xs);
  }

  /* Timeline (no photos yet): icon, a dotted line to the next step, then the text */
  .journey__steps--timeline {
    & .journey__step {
      @media screen and (max-width: 749px) {
        grid-template-columns: auto minmax(0, 1fr);
        align-items: start;
        gap: var(--space-md);
      }
    }

    & .journey__body {
      @media screen and (min-width: 750px) {
        padding-inline-end: var(--space-md);
      }
    }
  }

  .journey__marker {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-sm);

    @media screen and (max-width: 749px) {
      flex-direction: column;
      align-self: stretch;
    }
  }

  .journey__line {
    flex: 1 1 auto;
    min-width: 2rem;
    border-block-start: 1px dashed rgb(var(--warm-rgb) / 0.55);

    @media screen and (max-width: 749px) {
      min-width: 0;
      min-height: 1.5rem;
      border-block-start: 0;
      border-inline-start: 1px dashed rgb(var(--warm-rgb) / 0.55);
    }
  }

  .journey__label {
    font-size: var(--text-xs);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .journey__title {
    font-family: var(--font-heading-family);
    font-size: var(--heading-4);
    font-weight: var(--font-heading-weight);
    line-height: var(--line-height-heading);
    text-wrap: balance;
  }

  .journey__text {
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Parcours en 3 étapes",
  "tag": "div",
  "class": "section-journey",
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Trois photos cohérentes (même lumière, mêmes tons). Sans photo, l'étape s'affiche avec son icône. Pas de promesse de résultat médical."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Votre parcours"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Des jours plus doux, <em>étape par étape.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "checkbox",
      "id": "show_drops",
      "label": "Gouttes roses en arrière-plan",
      "info": "Elles tombent lentement, avec un bouton pause. Immobiles si la visiteuse réduit les animations.",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre (lien interne)",
      "default": "parcours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-6"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Format portrait conseillé (4:5). Pensez au texte alternatif de l'image."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône (sans photo)",
          "options": [
            { "value": "cloud", "label": "Nuage" },
            { "value": "heat", "label": "Chaleur" },
            { "value": "feather", "label": "Plume" },
            { "value": "home", "label": "Maison" },
            { "value": "clock", "label": "Horloge" }
          ],
          "default": "heat"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Titre de l'étape"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte (une ou deux phrases)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Parcours en 3 étapes",
      "blocks": [
        { "type": "step", "settings": { "icon": "cloud", "title": "Quand les règles compliquent la journée." } },
        { "type": "step", "settings": { "icon": "heat", "title": "Une nouvelle façon de prendre du temps pour soi." } },
        { "type": "step", "settings": { "icon": "feather", "title": "Retrouvez votre moment de douceur." } }
      ]
    }
  ]
}
{% endschema %}
