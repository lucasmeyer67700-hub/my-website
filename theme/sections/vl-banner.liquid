{%- comment -%}
  Bannière plein écran : photo de fond paysage, texte à gauche, bouton blanc arrondi.
  Tant qu'aucune photo n'est choisie, un fond rose poudré « studio » sert de repère.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  assign focal_style = 'object-position: ' | append: section.settings.focal
  assign link = section.settings.button_link
  if link == blank and section.settings.product != blank
    assign link = section.settings.product.url
  endif
-%}
<section class="vl-banner{% if img == blank %} vl-banner--placeholder{% endif %}" style="--vl-banner-overlay: {{ section.settings.overlay | divided_by: 100.0 }}">
  <div class="vl-banner__bg">
    {%- if img != blank -%}
      {{ img | image_url: width: 2800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2800', alt: img.alt | default: '', style: focal_style }}
    {%- elsif request.design_mode -%}
      <span class="vl-banner__hint">Ajoute ta photo paysage (2800 × 1400) dans « Photo de fond »</span>
    {%- endif -%}
  </div>
  <div class="page-width vl-banner__inner">
    <div class="vl-banner__copy">
      {%- if section.settings.pill != blank %}<p class="vl-banner__pill">{{ section.settings.pill | escape }}</p>{% endif -%}
      <h1 class="vl-banner__title">{{ section.settings.title }}</h1>
      {%- if section.settings.subtitle != blank %}<p class="vl-banner__subtitle">{{ section.settings.subtitle | escape }}</p>{% endif -%}
      <div class="vl-banner__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="vl-banner__button" href="{{ link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.note != blank %}<p class="vl-banner__note">{{ section.settings.note | escape }}</p>{% endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VELEA · Grande bannière",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo de fond", "info": "Paysage, 2800 × 1400 minimum. Garde la partie gauche épurée pour le texte." },
    { "type": "text", "id": "focal", "label": "Cadrage de la photo", "default": "center center", "info": "Ex. : right center" },
    { "type": "range", "id": "overlay", "label": "Voile sombre sur la photo", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 20 },
    { "type": "product", "id": "product", "label": "Produit lié au bouton" },
    { "type": "text", "id": "pill", "label": "Pastille", "default": "Nouvelle saison" },
    { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "LA SAISON COCON" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "TA CHALEUR DOUCE PENDANT TES RÈGLES" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "JE DÉCOUVRE" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "note", "label": "Petite mention", "default": "Satisfaite ou remboursée 30 jours" }
  ],
  "presets": [{ "name": "VELEA · Grande bannière" }]
}
{% endschema %}
