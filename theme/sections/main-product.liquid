{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign submit_id = 'ProductSubmit-' | append: section.id
  assign tagline = product.metafields.custom.accroche.value
  assign installments_id = 'ProductInstallments-' | append: section.id

  comment
    Real availability of the selected variant: "En stock" only when Shopify
    tracks the inventory and has some; "Disponible" when the variant can be
    ordered but the stock is not tracked (or sold beyond zero).
  endcomment
  assign availability = 'available'
  if current_variant.available == false
    assign availability = 'unavailable'
  elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0
    assign availability = 'in_stock'
  endif
  assign sticky_media = current_variant.featured_media | default: product.featured_media
-%}

<section class="product section section--compact color-{{ section.settings.color_scheme }}" data-product-section>
  {%- liquid
    comment
      Each block is built once, then placed: buying blocks in the right-hand
      column, reading blocks (benefits, accordions, notice) under the photos on
      large screens. Phones keep a single column: photos, buying, details.
    endcomment
    assign info_html = ''
    assign details_html = ''
  -%}
  {%- for block in section.blocks -%}
    {%- capture block_html -%}
      {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'reviews_highlight' -%}
            {% render 'review-highlight',
              product: product,
              heading: block.settings.heading,
              limit: block.settings.limit,
              interval: block.settings.interval,
              attributes: block.shopify_attributes
            %}

          {%- when 'guarantee' -%}
            {%- liquid
              assign guarantee_title = block.settings.title | default: settings.returns_info
              assign guarantee_link = block.settings.link
              if guarantee_link == blank and settings.returns_page != blank
                assign guarantee_link = settings.returns_page.url
              endif
            -%}
            {%- if guarantee_title != blank -%}
              <div class="product__guarantee" {{ block.shopify_attributes }}>
                <span class="product__guarantee-icon" aria-hidden="true">{% render 'icon', icon: block.settings.icon %}</span>
                <span class="product__guarantee-body">
                  {%- if guarantee_link != blank -%}
                    <a class="product__guarantee-title" href="{{ guarantee_link }}">{{ guarantee_title | escape }}</a>
                  {%- else -%}
                    <span class="product__guarantee-title">{{ guarantee_title | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="product__guarantee-text">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </span>
              </div>
            {%- endif -%}

          {%- when 'delivery' -%}
            {%- liquid
              assign delivery_text = block.settings.right_text | default: settings.shipping_info
              assign delivery_delay = block.settings.left_text | default: settings.shipping_delay
            -%}
            {%- if delivery_text != blank -%}
              <p class="product__delivery" {{ block.shopify_attributes }}>
                {% render 'icon', icon: 'truck' %}
                <span>
                  {%- if settings.shipping_page != blank -%}
                    <a href="{{ settings.shipping_page.url }}">{{ delivery_text | escape }}</a>
                  {%- else -%}
                    {{ delivery_text | escape }}
                  {%- endif -%}
                  {%- if delivery_delay != blank -%}
                    <span class="product__delivery-delay"> · {{ delivery_delay | escape }}</span>
                  {%- endif -%}
                </span>
                {%- if block.settings.show_flag -%}
                  <svg class="product__flag" viewBox="0 0 3 2" aria-hidden="true" focusable="false"><path fill="#0055a4" d="M0 0h1v2H0z"/><path fill="#fff" d="M1 0h1v2H1z"/><path fill="#ef4135" d="M2 0h1v2H2z"/></svg>
                {%- endif -%}
              </p>
            {%- endif -%}

          {%- when 'inventory' -%}
            <p
              class="product-availability"
              data-availability
              data-state="{{ availability }}"
              data-label-in-stock="{{ 'products.availability_in_stock' | t }}"
              data-label-available="{{ 'products.availability_available' | t }}"
              data-label-unavailable="{{ 'products.availability_unavailable' | t }}"
              {{ block.shopify_attributes }}
            >
              <span class="product-availability__dot" aria-hidden="true"></span>
              <span data-availability-label aria-live="polite">
                {%- case availability -%}
                  {%- when 'in_stock' -%}
                    {{ 'products.availability_in_stock' | t }}
                  {%- when 'unavailable' -%}
                    {{ 'products.availability_unavailable' | t }}
                  {%- else -%}
                    {{ 'products.availability_available' | t }}
                {%- endcase -%}
              </span>
            </p>

          {%- when 'benefits' -%}
            {%- capture benefit_items -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  assign title_key = 'title_' | append: i
                  assign text_key = 'text_' | append: i
                  assign icon_key = 'icon_' | append: i
                  assign benefit_title = block.settings[title_key]
                  assign benefit_text = block.settings[text_key]
                  assign benefit_icon = block.settings[icon_key]
                -%}
                {%- if benefit_title != blank -%}
                  <li class="product-benefits__item">
                    <span class="product-benefits__icon" aria-hidden="true">{% render 'icon', icon: benefit_icon %}</span>
                    <span class="product-benefits__body">
                      <span class="product-benefits__title">{{ benefit_title | escape }}</span>
                      {%- if benefit_text != blank -%}
                        <span class="product-benefits__text">{{ benefit_text | escape }}</span>
                      {%- endif -%}
                    </span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if benefit_items != blank -%}
              <div class="product-benefits" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="product-benefits__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <ul class="product-benefits__list" role="list">{{ benefit_items }}</ul>
              </div>
            {%- endif -%}

          {%- when 'points' -%}
            {%- assign points = product.metafields.custom.points_forts.value -%}
            {%- if points != blank and points.size > 0 -%}
              <ul class="check-list product__points" role="list" {{ block.shopify_attributes }}>
                {%- for point in points -%}
                  <li>{% render 'icon', icon: 'check' %}<span>{{ point | escape }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="rte product__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'variant-picker',
                product: product,
                section_id: section.id,
                offer_heading: block.settings.offer_heading,
                offer_note_single: block.settings.offer_note_single,
                offer_note_multi: block.settings.offer_note_multi,
                multi_hint: block.settings.multi_hint,
                unit_label: block.settings.unit_label,
                best_label: block.settings.best_label,
                perks_single: block.settings.perks_single,
                perks_multi: block.settings.perks_multi
              %}
            </div>

          {%- when 'buy_buttons' -%}
            <product-form class="product-form" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form__form', novalidate: 'novalidate' -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                  data-variant-id-input
                >
                <noscript>
                  {%- unless product.has_only_default_variant -%}
                    <label class="field__label" for="NoscriptVariant-{{ section.id }}">{{ 'products.choose_option' | t }}</label>
                    <select class="field__input" id="NoscriptVariant-{{ section.id }}" name="id">
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          {% if variant == current_variant %}
                            selected
                          {% endif %}
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                          {{ variant.title | escape }} – {{ variant.price | money | strip_html }}
                        </option>
                      {%- endfor -%}
                    </select>
                  {%- endunless -%}
                </noscript>

                <div class="product-form__row">
                  {%- if block.settings.show_quantity -%}
                    <div class="product-form__quantity">
                      <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                      <quantity-input class="quantity">
                        <button type="button" class="icon-button" data-step="-1">
                          {% render 'icon', icon: 'minus' %}
                          <span class="visually-hidden">{{ 'products.decrease_quantity' | t }}</span>
                        </button>
                        <input
                          class="quantity__input"
                          type="number"
                          id="Quantity-{{ section.id }}"
                          name="quantity"
                          value="1"
                          min="1"
                          inputmode="numeric"
                        >
                        <button type="button" class="icon-button" data-step="1">
                          {% render 'icon', icon: 'plus' %}
                          <span class="visually-hidden">{{ 'products.increase_quantity' | t }}</span>
                        </button>
                      </quantity-input>
                    </div>
                  {%- endif -%}

                  <button
                    id="{{ submit_id }}"
                    type="submit"
                    name="add"
                    class="button product-form__submit"
                    data-add-to-cart
                    {% unless current_variant.available %}
                      disabled
                    {% endunless %}
                  >
                    <span data-add-to-cart-label>
                      {%- if current_variant.available -%}
                        {{ 'products.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="button__spinner" aria-hidden="true"></span>
                  </button>
                </div>

                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="product-form__express">
                    {%- if settings.buy_now_button == 'shopify' -%}
                      {{ form | payment_button }}
                    {%- else -%}
                      {% render 'buy-now-button', product: product %}
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <div class="form-message form-message--error" role="alert" data-product-error hidden>
                  {% render 'icon', icon: 'alert' %}
                  <span data-error-message></span>
                </div>
              {%- endform -%}
            </product-form>

          {%- when 'trust' -%}
            <div class="product__trust{% unless block.settings.show_lines %} product__trust--compact{% endunless %}" {{ block.shopify_attributes }}>
              {%- if block.settings.show_lines -%}
              <ul class="trust-list" role="list">
                {%- if settings.shipping_info != blank -%}
                  <li>
                    {% render 'icon', icon: 'truck' %}
                    <span>
                      {%- if settings.shipping_page != blank -%}
                        <a href="{{ settings.shipping_page.url }}">{{ settings.shipping_info | escape }}</a>
                      {%- else -%}
                        {{ settings.shipping_info | escape }}
                      {%- endif -%}
                      {%- if settings.shipping_delay != blank %} · {{ settings.shipping_delay | escape }}{% endif -%}
                    </span>
                  </li>
                {%- endif -%}
                {%- if settings.returns_info != blank -%}
                  <li>
                    {% render 'icon', icon: 'return' %}
                    <span>
                      {%- if settings.returns_page != blank -%}
                        <a href="{{ settings.returns_page.url }}">{{ settings.returns_info | escape }}</a>
                      {%- else -%}
                        {{ settings.returns_info | escape }}
                      {%- endif -%}
                    </span>
                  </li>
                {%- endif -%}
                {%- if settings.warranty_info != blank -%}
                  <li>{% render 'icon', icon: 'shield' %}<span>{{ settings.warranty_info | escape }}</span></li>
                {%- endif -%}
                {%- unless block.settings.show_payment_icons -%}
                  <li>{% render 'icon', icon: 'lock' %}<span>{{ 'products.secure_payment' | t }}</span></li>
                {%- endunless -%}
              </ul>
              {%- else -%}
                {%- unless block.settings.show_payment_icons -%}
                  <p class="product__secure">{% render 'icon', icon: 'lock' %}<span>{{ 'products.secure_payment' | t }}</span></p>
                {%- endunless -%}
              {%- endif -%}
              {%- comment -%} Right under the buy buttons: a light line and the logos of the enabled methods. {%- endcomment -%}
              {%- if block.settings.show_payment_icons -%}
                {% render 'secure-payment', style: 'compact' %}
              {%- endif -%}
              {% render 'reassurance-row', hide_payment: true, class: 'product__reassurance' %}
            </div>

          {%- when 'accordion' -%}
            {%- liquid
              capture accordion_content
                case block.settings.source
                  when 'description'
                    comment
                      Only the introduction: the other accordions already cover
                      use, precautions, box contents and delivery.
                    endcomment
                    if product.description != blank
                      assign description_intro = product.description | split: '<h3>' | first
                      echo '<div class="rte">'
                      echo description_intro
                      echo '</div>'
                    endif
                  when 'specs'
                    if product.metafields.custom.caracteristiques.value != blank
                      render 'product-specs', product: product
                    endif
                  when 'usage'
                    render 'metafield-lines', value: product.metafields.custom.mode_emploi.value, ordered: true
                  when 'usage_precautions'
                    assign usage_value = product.metafields.custom.mode_emploi.value
                    assign precautions_value = product.metafields.custom.precautions.value
                    if usage_value != blank
                      echo '<h3 class="product__accordion-subtitle">'
                      echo 'products.usage_heading' | t
                      echo '</h3>'
                      render 'metafield-lines', value: usage_value, ordered: true
                    endif
                    if precautions_value != blank
                      echo '<h3 class="product__accordion-subtitle">'
                      echo 'products.precautions_heading' | t
                      echo '</h3>'
                      render 'metafield-lines', value: precautions_value, ordered: false
                    endif
                  when 'care'
                    render 'metafield-lines', value: product.metafields.custom.entretien.value, ordered: false
                  when 'size_guide'
                    render 'metafield-lines', value: product.metafields.custom.guide_tailles.value, ordered: false, plain: true
                  when 'precautions'
                    render 'metafield-lines', value: product.metafields.custom.precautions.value, ordered: false
                  when 'box'
                    render 'box-contents', product: product
                  when 'safety_info'
                    render 'metafield-lines', value: product.metafields.custom.informations_securite.value, ordered: false, plain: true
                  when 'shipping'
                    render 'shipping-summary', returns_offer: block.settings.show_returns_offer
                  else
                    if block.settings.content != blank
                      echo '<div class="rte">'
                      echo block.settings.content
                      echo '</div>'
                    endif
                endcase
              endcapture
            -%}
            {%- if accordion_content != blank -%}
              <details
                class="accordion product__accordion"
                {% if block.settings.source == 'size_guide' %}
                  id="guide-tailles"
                {% endif %}
                {% if block.settings.open %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="accordion__summary">
                  <span class="accordion__title">
                    {%- if block.settings.icon != 'none' -%}
                      {% render 'icon', icon: block.settings.icon %}
                    {%- endif -%}
                    {{ block.settings.title | escape }}
                  </span>
                  {% render 'icon', icon: 'plus', class: 'icon--toggle' %}
                </summary>
                <div class="accordion__content">{{ accordion_content }}</div>
              </details>
            {%- endif -%}

          {%- when 'notice' -%}
            {%- if settings.health_notice != blank -%}
              <p class="product__notice" {{ block.shopify_attributes }}>
                {% render 'icon', icon: 'info' %}
                <span>{{ settings.health_notice | escape }}</span>
              </p>
            {%- endif -%}
      {%- endcase -%}
    {%- endcapture -%}
    {%- liquid
      case block.type
        when 'benefits', 'accordion', 'notice', 'points'
          assign details_html = details_html | append: block_html
        else
          assign info_html = info_html | append: block_html
      endcase
    -%}
  {%- endfor -%}

  <div class="page-width product__grid{% if details_html != blank %} product__grid--details{% endif %}">
    <div class="product__media">
      {% render 'product-gallery',
        product: product,
        fit: section.settings.gallery_fit,
        ratio: section.settings.gallery_ratio,
        overlays: section.blocks,
        slots: section.settings.show_media_slots
      %}
    </div>

    <div class="product__info" id="ProductInfo">
      <div class="product__header">
        {%- if section.settings.banner != blank -%}
          <p class="product__banner">{{ section.settings.banner | escape }}</p>
        {%- endif -%}
        {% render 'product-rating', product: product, anchor: 'avis' %}
        <h1 class="product__title">{{ product.title | escape }}</h1>
        <div class="product__price-row">
          {% render 'price', product: product, class: 'product__price' %}
          {%- if section.settings.price_badge != blank -%}
            <span class="product__badge">{{ section.settings.price_badge | escape }}</span>
          {%- endif -%}
        </div>
        {%- comment -%} Pay in installments: shown only when Shopify offers it for the store. {%- endcomment -%}
        {%- form 'product', product, id: installments_id, class: 'product__installments' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>
          {{ form | payment_terms }}
        {%- endform -%}
        {%- if tagline != blank -%}
          <p class="product__tagline">{{ tagline | escape }}</p>
        {%- endif -%}
      </div>

      {{ info_html }}
    </div>

    {%- if details_html != blank -%}
      <div class="product__details">{{ details_html }}</div>
    {%- endif -%}
  </div>

  {%- if section.settings.sticky_bar -%}
    <sticky-buy-bar class="sticky-buy-bar" data-watch="{{ submit_id }}">
      <div class="sticky-buy-bar__inner page-width">
        {%- if sticky_media -%}
          <img
            class="sticky-buy-bar__image"
            src="{{ sticky_media.preview_image | image_url: width: 120, height: 120, crop: 'center' }}"
            alt=""
            width="56"
            height="56"
            loading="lazy"
            data-variant-image
          >
        {%- endif -%}
        <div class="sticky-buy-bar__info">
          <p class="sticky-buy-bar__title">{{ product.title | escape }}</p>
          <p class="sticky-buy-bar__meta">
            {%- unless product.has_only_default_variant -%}
              <span data-variant-title>{{ current_variant.title | escape }}</span>
              <span aria-hidden="true"> · </span>
            {%- endunless -%}
            <span class="sticky-buy-bar__price" data-price-current>{{ current_variant.price | money }}</span>
          </p>
          <p class="sticky-buy-bar__error" role="alert" data-product-error-for="{{ form_id }}" hidden></p>
        </div>
        <button
          type="submit"
          form="{{ form_id }}"
          class="button sticky-buy-bar__button"
          data-add-to-cart
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          <span data-add-to-cart-label>
            {%- if current_variant.available -%}
              {{ 'products.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </span>
          <span class="button__spinner" aria-hidden="true"></span>
        </button>
      </div>
    </sticky-buy-bar>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

{% stylesheet %}
  .product__grid {
    display: grid;
    gap: var(--space-lg);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-xl) clamp(3rem, 5vw, 5.5rem);
      align-items: start;
    }
  }

  /* Large screens: details fill the space under the photos, buying stays on the right */
  .product__grid--details {
    @media screen and (min-width: 990px) {
      grid-template-areas:
        'media info'
        'details info';
      grid-template-rows: auto 1fr;

      & .product__media {
        position: static;
        grid-area: media;
      }

      & .product__info {
        grid-area: info;
      }

      & .product__details {
        grid-area: details;
      }
    }
  }

  .product__media {
    min-width: 0;

    @media screen and (min-width: 990px) {
      position: sticky;
      inset-block-start: calc(var(--header-height) + 1.5rem);
    }
  }

  .product__details {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .product__info {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .product__header {
    display: grid;
    gap: var(--space-xs);
  }

  .product__banner {
    padding: 0.55rem var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text);
    background-color: #f2eeed;
  }

  .product__title {
    font-size: calc(clamp(2rem, 1.6rem + 1.4vw, 2.75rem) * var(--font-heading-scale, 1));
    line-height: var(--line-height-tight);
  }

  .product__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .product__tagline {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text);
    text-wrap: pretty;
  }

  /* Guarantee: no box, fine lines above and below, the icon in a soft rose ring
     (same look as the promises under the home offer) */
  .product__guarantee {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-block: 1px solid rgb(var(--warm-rgb) / 0.22);
  }

  .product__guarantee-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.625rem;
    height: 2.625rem;
    border-radius: 50%;
    color: var(--rose-text);
    background: radial-gradient(circle at 30% 25%, rgb(255 255 255 / 0.55), rgb(var(--rose-strong-rgb) / 0.1) 70%);
    box-shadow: inset 0 0 0 1px rgb(var(--rose-strong-rgb) / 0.35);

    & .icon {
      --icon-size: 1.15rem;
    }
  }

  .product__guarantee-body {
    display: grid;
    gap: 0.1rem;
  }

  .product__guarantee-title {
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-bold);
    color: var(--color-text);
    text-decoration: none;
  }

  a.product__guarantee-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product__guarantee-text {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Delivery line under the button */
  .product__delivery {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-sm);

    & > .icon {
      --icon-size: 1.1rem;
      color: var(--color-accent);
    }

    & a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--warm-hairline);
      text-underline-offset: 0.2em;
    }
  }

  .product__delivery-delay {
    color: var(--color-text-muted);
  }

  .product__flag {
    flex: none;
    width: 1.1rem;
    height: auto;
    margin-inline-start: auto;
    border-radius: 1px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08);
  }

  /* Practical benefits (2 or 3), under the buy area */
  .product-benefits {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
  }

  .product-benefits__heading {
    font-family: var(--font-body-family);
    font-size: var(--text-xs);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .product-benefits__list {
    display: grid;
    gap: var(--space-sm);
  }

  .product-benefits__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .product-benefits__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--warm-text);
    background-color: var(--palette-rose-light);

    & .icon {
      --icon-size: 1.1rem;
    }
  }

  .product-benefits__body {
    display: grid;
    gap: 0.1rem;
  }

  .product-benefits__title {
    font-weight: var(--font-body-weight-medium);
  }

  .product-benefits__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product__accordion-subtitle {
    margin-block: var(--space-sm) var(--space-2xs);
    font-family: var(--font-body-family);
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-bold);

    &:first-child {
      margin-block-start: 0;
    }
  }

  .product__points {
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
  }

  .product__trust {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .product__trust--compact {
    justify-items: center;
    gap: var(--space-2xs);
    padding: 0;
    background: none;
  }

  .product__secure {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--color-text-muted);

    & .icon {
      --icon-size: 0.9rem;
    }
  }

  .product__accordion .accordion__title .icon {
    --icon-size: 1.2rem;
    color: var(--color-accent);
  }

  .product__specs-note {
    margin-block-start: var(--space-sm);
  }

  .product__notice {
    display: flex;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);

    & .icon {
      --icon-size: 1.1rem;
      margin-block-start: 0.15em;
    }
  }

  /* Floating add-to-cart bar: appears once the main button is out of view */
  .sticky-buy-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--z-sticky-bar);
    display: block;
    padding-block: var(--space-xs) calc(var(--space-xs) + env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--color-border);
    background-color: rgb(var(--color-background-rgb) / 0.97);
    box-shadow: 0 -10px 30px -18px rgb(73 53 47 / 0.3);
    visibility: hidden;
    transform: translateY(110%);
    transition:
      transform var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base);

    &.is-visible {
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
  }

  .sticky-buy-bar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .sticky-buy-bar__image {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
    object-fit: cover;
    background-color: var(--gallery-bg);

    @media screen and (max-width: 359px) {
      display: none;
    }
  }

  .sticky-buy-bar__info {
    flex: 1 1 auto;
    min-width: 0;
  }

  .sticky-buy-bar__title {
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .sticky-buy-bar__meta {
    overflow: hidden;
    font-size: var(--text-sm);
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--color-text-muted);
  }

  .sticky-buy-bar__price {
    font-weight: var(--font-body-weight-medium);
    color: var(--color-text);
  }

  .sticky-buy-bar__error {
    font-size: var(--text-xs);
    color: var(--color-error);
  }

  .sticky-buy-bar__button {
    flex: none;
    min-height: 2.875rem;
    padding-inline: var(--space-md);
    font-size: var(--text-sm);

    @media screen and (min-width: 750px) {
      min-width: 15rem;
    }
  }

  /* Shopify Inbox chat bubble sits bottom-right: keep the bar's button clear of it. */
  body:has(#shopify-chat, inbox-online-store-chat) .sticky-buy-bar__inner {
    padding-inline-end: 4.5rem;
  }

  body.has-sticky-bar .site-footer {
    padding-block-end: 6rem;
  }
{% endstylesheet %}

