{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign submit_id = 'ProductSubmit-' | append: section.id
  assign tagline = product.metafields.custom.accroche.value
  assign installments_id = 'ProductInstallments-' | append: section.id
-%}

<section class="product section section--compact color-{{ section.settings.color_scheme }}" data-product-section>
  <div class="page-width product__grid">
    <div class="product__media">
      {% render 'product-gallery',
        product: product,
        fit: section.settings.gallery_fit,
        ratio: section.settings.gallery_ratio,
        overlays: section.blocks
      %}
    </div>

    <div class="product__info" id="ProductInfo">
      <div class="product__header">
        {%- if section.settings.banner != blank -%}
          <p class="product__banner">{{ section.settings.banner | escape }}</p>
        {%- endif -%}
        {% render 'product-rating', product: product, anchor: 'avis' %}
        <h1 class="product__title">{{ product.title | escape }}</h1>
        <div class="product__price-row">
          {% render 'price', product: product, class: 'product__price' %}
          {%- if section.settings.price_badge != blank -%}
            <span class="product__badge">{{ section.settings.price_badge | escape }}</span>
          {%- endif -%}
        </div>
        {%- comment -%} Pay in installments: shown only when Shopify offers it for the store. {%- endcomment -%}
        {%- form 'product', product, id: installments_id, class: 'product__installments' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>
          {{ form | payment_terms }}
        {%- endform -%}
        {%- if tagline != blank -%}
          <p class="product__tagline">{{ tagline | escape }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'guarantee' -%}
            {%- liquid
              assign guarantee_title = block.settings.title | default: settings.returns_info
              assign guarantee_link = block.settings.link
              if guarantee_link == blank and settings.returns_page != blank
                assign guarantee_link = settings.returns_page.url
              endif
            -%}
            {%- if guarantee_title != blank -%}
              <div class="product__guarantee" {{ block.shopify_attributes }}>
                <span class="product__guarantee-icon" aria-hidden="true">{% render 'icon', icon: block.settings.icon %}</span>
                <span class="product__guarantee-body">
                  {%- if guarantee_link != blank -%}
                    <a class="product__guarantee-title" href="{{ guarantee_link }}">{{ guarantee_title | escape }}</a>
                  {%- else -%}
                    <span class="product__guarantee-title">{{ guarantee_title | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="product__guarantee-text">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </span>
              </div>
            {%- endif -%}

          {%- when 'delivery' -%}
            {%- liquid
              assign delivery_left = block.settings.left_text
              if delivery_left == blank and settings.shipping_delay != blank
                assign delivery_left = 'products.delivery_time' | t: delay: settings.shipping_delay
              endif
              assign delivery_right = block.settings.right_text | default: settings.shipping_info
            -%}
            <div class="product__delivery" {{ block.shopify_attributes }}>
              {%- if delivery_left != blank -%}
                <p class="product__delivery-time"><span class="product__delivery-dot" aria-hidden="true"></span>{{ delivery_left | escape }}</p>
              {%- endif -%}
              {%- if delivery_right != blank -%}
                <p class="product__delivery-shipping">
                  {%- if block.settings.show_flag -%}
                    <svg class="product__flag" viewBox="0 0 3 2" aria-hidden="true" focusable="false"><path fill="#0055a4" d="M0 0h1v2H0z"/><path fill="#fff" d="M1 0h1v2H1z"/><path fill="#ef4135" d="M2 0h1v2H2z"/></svg>
                    <span class="product__delivery-sep" aria-hidden="true">|</span>
                  {%- endif -%}
                  {%- if settings.shipping_page != blank -%}
                    <a href="{{ settings.shipping_page.url }}">{{ delivery_right | escape }}</a>
                  {%- else -%}
                    <span>{{ delivery_right | escape }}</span>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>

          {%- when 'points' -%}
            {%- assign points = product.metafields.custom.points_forts.value -%}
            {%- if points != blank and points.size > 0 -%}
              <ul class="check-list product__points" role="list" {{ block.shopify_attributes }}>
                {%- for point in points -%}
                  <li>{% render 'icon', icon: 'check' %}<span>{{ point | escape }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="rte product__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'variant-picker',
                product: product,
                section_id: section.id,
                offer_heading: block.settings.offer_heading,
                offer_note_single: block.settings.offer_note_single,
                offer_note_multi: block.settings.offer_note_multi,
                multi_hint: block.settings.multi_hint,
                unit_label: block.settings.unit_label,
                best_label: block.settings.best_label,
                perks_single: block.settings.perks_single,
                perks_multi: block.settings.perks_multi
              %}
            </div>

          {%- when 'buy_buttons' -%}
            <product-form class="product-form" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form__form', novalidate: 'novalidate' -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                  data-variant-id-input
                >
                <noscript>
                  {%- unless product.has_only_default_variant -%}
                    <label class="field__label" for="NoscriptVariant-{{ section.id }}">{{ 'products.choose_option' | t }}</label>
                    <select class="field__input" id="NoscriptVariant-{{ section.id }}" name="id">
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          {% if variant == current_variant %}
                            selected
                          {% endif %}
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                          {{ variant.title | escape }} – {{ variant.price | money | strip_html }}
                        </option>
                      {%- endfor -%}
                    </select>
                  {%- endunless -%}
                </noscript>

                <div class="product-form__row">
                  {%- if block.settings.show_quantity -%}
                    <div class="product-form__quantity">
                      <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                      <quantity-input class="quantity">
                        <button type="button" class="icon-button" data-step="-1">
                          {% render 'icon', icon: 'minus' %}
                          <span class="visually-hidden">{{ 'products.decrease_quantity' | t }}</span>
                        </button>
                        <input
                          class="quantity__input"
                          type="number"
                          id="Quantity-{{ section.id }}"
                          name="quantity"
                          value="1"
                          min="1"
                          inputmode="numeric"
                        >
                        <button type="button" class="icon-button" data-step="1">
                          {% render 'icon', icon: 'plus' %}
                          <span class="visually-hidden">{{ 'products.increase_quantity' | t }}</span>
                        </button>
                      </quantity-input>
                    </div>
                  {%- endif -%}

                  <button
                    id="{{ submit_id }}"
                    type="submit"
                    name="add"
                    class="button product-form__submit"
                    data-add-to-cart
                    {% unless current_variant.available %}
                      disabled
                    {% endunless %}
                  >
                    <span data-add-to-cart-label>
                      {%- if current_variant.available -%}
                        {{ 'products.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="button__spinner" aria-hidden="true"></span>
                  </button>
                </div>

                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="product-form__express">{{ form | payment_button }}</div>
                {%- endif -%}

                <div class="form-message form-message--error" role="alert" data-product-error hidden>
                  {% render 'icon', icon: 'alert' %}
                  <span data-error-message></span>
                </div>
              {%- endform -%}
            </product-form>

          {%- when 'trust' -%}
            <div class="product__trust{% unless block.settings.show_lines %} product__trust--compact{% endunless %}" {{ block.shopify_attributes }}>
              {%- if block.settings.show_lines -%}
              <ul class="trust-list" role="list">
                {%- if settings.shipping_info != blank -%}
                  <li>
                    {% render 'icon', icon: 'truck' %}
                    <span>
                      {%- if settings.shipping_page != blank -%}
                        <a href="{{ settings.shipping_page.url }}">{{ settings.shipping_info | escape }}</a>
                      {%- else -%}
                        {{ settings.shipping_info | escape }}
                      {%- endif -%}
                      {%- if settings.shipping_delay != blank %} · {{ settings.shipping_delay | escape }}{% endif -%}
                    </span>
                  </li>
                {%- endif -%}
                {%- if settings.returns_info != blank -%}
                  <li>
                    {% render 'icon', icon: 'return' %}
                    <span>
                      {%- if settings.returns_page != blank -%}
                        <a href="{{ settings.returns_page.url }}">{{ settings.returns_info | escape }}</a>
                      {%- else -%}
                        {{ settings.returns_info | escape }}
                      {%- endif -%}
                    </span>
                  </li>
                {%- endif -%}
                {%- if settings.warranty_info != blank -%}
                  <li>{% render 'icon', icon: 'shield' %}<span>{{ settings.warranty_info | escape }}</span></li>
                {%- endif -%}
                <li>{% render 'icon', icon: 'lock' %}<span>{{ 'products.secure_payment' | t }}</span></li>
              </ul>
              {%- else -%}
                <p class="product__secure">{% render 'icon', icon: 'lock' %}<span>{{ 'products.secure_payment' | t }}</span></p>
              {%- endif -%}
              {%- if block.settings.show_payment_icons -%}
                {% render 'payment-icons', class: 'product__payments' %}
              {%- endif -%}
            </div>

          {%- when 'accordion' -%}
            {%- liquid
              capture accordion_content
                case block.settings.source
                  when 'description'
                    comment
                      Only the introduction: the other accordions already cover
                      use, precautions, box contents and delivery.
                    endcomment
                    if product.description != blank
                      assign description_intro = product.description | split: '<h3>' | first
                      echo '<div class="rte">'
                      echo description_intro
                      echo '</div>'
                    endif
                  when 'specs'
                    if product.metafields.custom.caracteristiques.value != blank
                      render 'product-specs', product: product
                      echo '<p class="text-small product__specs-note">'
                      echo 'products.specs_note' | t
                      echo '</p>'
                    endif
                  when 'usage'
                    render 'metafield-lines', value: product.metafields.custom.mode_emploi.value, ordered: true
                  when 'precautions'
                    render 'metafield-lines', value: product.metafields.custom.precautions.value, ordered: false
                  when 'box'
                    render 'box-contents', product: product
                  when 'safety_info'
                    render 'metafield-lines', value: product.metafields.custom.informations_securite.value, ordered: false, plain: true
                  when 'shipping'
                    render 'shipping-summary'
                  else
                    if block.settings.content != blank
                      echo '<div class="rte">'
                      echo block.settings.content
                      echo '</div>'
                    endif
                endcase
              endcapture
            -%}
            {%- if accordion_content != blank -%}
              <details class="accordion product__accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  <span class="accordion__title">
                    {% render 'icon', icon: block.settings.icon %}
                    {{ block.settings.title | escape }}
                  </span>
                  {% render 'icon', icon: 'plus', class: 'icon--toggle' %}
                </summary>
                <div class="accordion__content">{{ accordion_content }}</div>
              </details>
            {%- endif -%}

          {%- when 'notice' -%}
            {%- if settings.health_notice != blank -%}
              <p class="product__notice" {{ block.shopify_attributes }}>
                {% render 'icon', icon: 'info' %}
                <span>{{ settings.health_notice | escape }}</span>
              </p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <sticky-buy-bar class="sticky-buy-bar" data-watch="{{ submit_id }}">
      <div class="sticky-buy-bar__inner">
        <div class="sticky-buy-bar__info">
          <p class="sticky-buy-bar__title">{{ product.title | escape }}</p>
          <p class="sticky-buy-bar__meta">
            {%- unless product.has_only_default_variant -%}
              <span data-variant-title>{{ current_variant.title | escape }}</span>
              <span aria-hidden="true"> · </span>
            {%- endunless -%}
            <span data-price-current>{{ current_variant.price | money }}</span>
          </p>
        </div>
        <button
          type="submit"
          form="{{ form_id }}"
          class="button button--small"
          data-add-to-cart
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          <span data-add-to-cart-label>
            {%- if current_variant.available -%}
              {{ 'products.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </span>
          <span class="button__spinner" aria-hidden="true"></span>
        </button>
      </div>
    </sticky-buy-bar>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

{% stylesheet %}
  .product__grid {
    display: grid;
    gap: var(--space-lg);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 5vw, 5.5rem);
      align-items: start;
    }
  }

  .product__media {
    min-width: 0;

    @media screen and (min-width: 990px) {
      position: sticky;
      inset-block-start: calc(var(--header-height) + 1.5rem);
    }
  }

  .product__info {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .product__header {
    display: grid;
    gap: var(--space-xs);
  }

  .product__banner {
    padding: 0.55rem var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text);
    background-color: #f2eeed;
  }

  .product__title {
    font-size: calc(clamp(2rem, 1.6rem + 1.4vw, 2.75rem) * var(--font-heading-scale, 1));
    line-height: var(--line-height-tight);
  }

  .product__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .product__price {
    font-size: var(--text-xl);

    & .price__current {
      font-weight: var(--font-body-weight-bold);
    }

    & .price__compare {
      order: -1;
      font-weight: var(--font-body-weight);
      color: var(--rose-strong);
    }
  }

  .product__badge {
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-xs);
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background-color: var(--rose-strong);
  }

  /* Shopify fills the payment terms itself (empty when not offered): no box of our own. */
  .product__installments {
    display: contents;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product__tagline {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text);
    text-wrap: pretty;
  }

  /* Guarantee box, dashed (under the offers) */
  .product__guarantee {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 2px dashed rgb(var(--rose-strong-rgb) / 0.55);
    border-radius: var(--radius-sm);
    background-color: #fff;
  }

  .product__guarantee-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-xs);
    color: var(--rose-strong);
    background-color: var(--rose-soft);

    & .icon {
      --icon-size: 1.15rem;
    }
  }

  .product__guarantee-body {
    display: grid;
    gap: 0.1rem;
  }

  .product__guarantee-title {
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-bold);
    color: var(--color-text);
    text-decoration: none;
  }

  a.product__guarantee-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product__guarantee-text {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Delivery line under the button */
  .product__delivery {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
    font-size: var(--text-sm);
  }

  .product__delivery-time {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-success);
  }

  .product__delivery-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: currentColor;
    box-shadow: 0 0 0 3px rgb(47 107 74 / 0.15);
  }

  .product__delivery-shipping {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);

    & a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .product__flag {
    width: 1.1rem;
    height: auto;
    border-radius: 1px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08);
  }

  .product__delivery-sep {
    color: var(--color-text-muted);
  }

  .product__points {
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
  }

  .product-form__form {
    display: grid;
    gap: var(--space-sm);
  }

  .product-form__row {
    display: flex;
    gap: var(--space-xs);
  }

  .product-form__quantity .quantity {
    height: 100%;
    min-height: 3.25rem;
  }

  .product-form__submit {
    flex: 1 1 auto;
    min-height: 3.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .product-form__express:empty {
    display: none;
  }

  .product-form__express .shopify-payment-button__button {
    min-height: 3.25rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .product__trust {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .product__trust--compact {
    justify-items: center;
    gap: var(--space-2xs);
    padding: 0;
    background: none;
  }

  .product__secure {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--color-text-muted);

    & .icon {
      --icon-size: 0.9rem;
    }
  }

  .product__accordion .accordion__title .icon {
    --icon-size: 1.2rem;
    color: var(--color-accent);
  }

  .product__specs-note {
    margin-block-start: var(--space-sm);
  }

  .product__notice {
    display: flex;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);

    & .icon {
      --icon-size: 1.1rem;
      margin-block-start: 0.15em;
    }
  }

  .sticky-buy-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--z-sticky-bar);
    display: block;
    padding: var(--space-xs) var(--gutter) calc(var(--space-xs) + env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--color-border);
    background-color: rgb(var(--color-background-rgb) / 0.96);
    box-shadow: 0 -8px 24px -16px rgb(48 39 36 / 0.25);
    visibility: hidden;
    transform: translateY(110%);
    transition:
      transform var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base);

    &.is-visible {
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    @media screen and (min-width: 990px) {
      display: none;
    }
  }

  .sticky-buy-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .sticky-buy-bar__info {
    min-width: 0;
  }

  .sticky-buy-bar__title {
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .sticky-buy-bar__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Shopify Inbox chat bubble sits bottom-right: keep the bar's button clear of it. */
  body:has(#shopify-chat, inbox-online-store-chat) .sticky-buy-bar {
    @media screen and (max-width: 989px) {
      padding-inline-end: calc(var(--gutter) + 4.25rem);
    }
  }

  body.has-sticky-bar .site-footer {
    @media screen and (max-width: 989px) {
      padding-block-end: 6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fiche produit",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    {
      "type": "text",
      "id": "banner",
      "label": "Bandeau au-dessus du titre",
      "default": "La ceinture chauffante sans fil, pour vos jours de règles"
    },
    {
      "type": "text",
      "id": "price_badge",
      "label": "Pastille à côté du prix",
      "info": "Une information vraie (ex. : Nouveauté). Laissez vide pour la masquer.",
      "default": "Nouveauté"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Format des photos",
      "options": [
        { "value": "1", "label": "Carré" },
        { "value": "4 / 5", "label": "Portrait" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Cadrage des photos",
      "options": [
        { "value": "contain", "label": "Photo entière" },
        { "value": "cover", "label": "Remplir le cadre" }
      ],
      "default": "contain"
    },
    {
      "type": "checkbox",
      "id": "sticky_bar",
      "label": "Barre d'achat fixe sur mobile",
      "info": "Apparaît une fois le bouton principal dépassé.",
      "default": true
    },
    {
