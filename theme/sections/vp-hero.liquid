{%- liquid
  assign p = section.settings.product
  assign link = section.settings.button_link | default: p.url
-%}
<section class="vp vp-hero"><div class="vp-wrap"><div class="vp-hero__grid">
  <div>
    {%- render 'vp-rating', product: p, sim_rating: section.settings.sim_rating, sim_count: section.settings.sim_count, class: 'vp-hero__rating' -%}
    <h1 class="vp-hero__title">{{ section.settings.title | escape }}</h1>
    {%- if section.settings.text != blank %}<p class="vp-hero__text">{{ section.settings.text | escape }}</p>{% endif -%}
    <a class="vp-btn" href="{{ link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}{% if p != blank and section.settings.show_price %} <span class="vp-btn__price">{{ p.price | money }}</span>{% endif %}</a>
    {%- if section.settings.ticks != blank -%}
      <ul class="vp-ticks">{%- assign ls = section.settings.ticks | split: '|' -%}{%- for t in ls -%}<li>{{ t | strip | escape }}</li>{%- endfor -%}</ul>
    {%- endif -%}
  </div>
  <div class="vp-heat">
    {%- assign img = section.settings.image | default: p.featured_image -%}
    {%- if img != blank -%}{{ img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: p.title | default: 'Ceinture chauffante VELEA' }}{%- endif -%}
  </div>
</div></div></section>
{% schema %}
{
  "name": "VELEA+ · Haut de page",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo du produit détouré (fond transparent)" },
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Tes règles, sans rester au lit." },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la ceinture" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "checkbox", "id": "show_price", "label": "Prix dans le bouton", "default": true },
    { "type": "text", "id": "ticks", "label": "Réassurance (séparée par |)", "default": "Livraison offerte | 30 jours pour l'essayer, remboursée si elle ne te convient pas" },
    { "type": "text", "id": "sim_rating", "label": "Note simulée (aperçu uniquement)", "default": "4,7" },
    { "type": "text", "id": "sim_count", "label": "Nombre d'avis simulé", "default": "298" }
  ],
  "presets": [{ "name": "VELEA+ · Haut de page" }]
}
{% endschema %}
