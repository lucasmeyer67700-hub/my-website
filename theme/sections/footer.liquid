<footer class="site-footer color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="site-footer__brand" {{ block.shopify_attributes }}>
              <a class="site-footer__logo" href="{{ routes.root_url }}">
                {%- if settings.logo -%}
                  {{
                    settings.logo
                    | image_url: width: 400
                    | image_tag: widths: '200, 400', width: settings.logo_width, alt: shop.name, loading: 'lazy'
                  }}
                {%- else -%}
                  {{ shop.name }}
                {%- endif -%}
              </a>
              {%- if settings.brand_tagline != blank -%}
                <p class="site-footer__tagline">{{ settings.brand_tagline | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="site-footer__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {% render 'social-links' %}
            </div>

          {%- when 'menu' -%}
            {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
              <nav class="site-footer__menu" aria-labelledby="FooterMenu-{{ block.id }}" {{ block.shopify_attributes }}>
                <h2 class="site-footer__heading" id="FooterMenu-{{ block.id }}">
                  {{- block.settings.heading | default: block.settings.menu.title | escape -}}
                </h2>
                <ul class="site-footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a class="site-footer__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- endif -%}

          {%- when 'newsletter' -%}
            <div class="site-footer__newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="site-footer__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- assign form_id = 'NewsletterForm-' | append: block.id -%}
              {%- form 'customer', id: form_id, class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-message form-message--success" role="status" data-newsletter-success>
                    {% render 'icon', icon: 'check' %}
                    {{ 'newsletter.success' | t }}
                  </p>
                {%- else -%}
                  <div class="newsletter-form__field">
                    <label class="visually-hidden" for="NewsletterEmail-{{ block.id }}">{{ 'newsletter.label' | t }}</label>
                    <input
                      class="field__input"
                      id="NewsletterEmail-{{ block.id }}"
                      type="email"
                      name="contact[email]"
                      autocomplete="email"
                      placeholder="{{ 'newsletter.placeholder' | t }}"
                      required
                      {% if form.errors %}
                        aria-invalid="true" aria-describedby="NewsletterError-{{ block.id }}"
                      {% endif %}
                    >
                    <button type="submit" class="button">{{ 'newsletter.submit' | t }}</button>
                  </div>
                  {%- if form.errors -%}
                    <p class="form-message form-message--error" id="NewsletterError-{{ block.id }}" role="alert">
                      {% render 'icon', icon: 'alert' %}
                      {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                    </p>
                  {%- endif -%}
                  <p class="newsletter-form__consent">{{ 'newsletter.consent' | t }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      {%- if settings.health_notice != blank -%}
        <p class="site-footer__notice">
          {% render 'icon', icon: 'info' %}
          <span>{{ settings.health_notice | escape }}</span>
        </p>
      {%- endif -%}
      <div class="site-footer__legal">
        {%- assign current_year = 'now' | date: '%Y' -%}
        <p>{{ 'general.copyright' | t: year: current_year, shop: shop.name }}</p>
        <button type="button" class="site-footer__cookies" data-cookie-preferences aria-haspopup="dialog" hidden>
          {{- 'cookies.manage' | t -}}
        </button>
        {% render 'payment-icons' %}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    padding-block: var(--space-2xl) var(--space-lg);
    font-size: var(--text-sm);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-xl) var(--space-lg);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 0.8fr)) minmax(0, 1.4fr);
    }
  }

  .site-footer__brand {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
  }

  .site-footer__logo {
    font-family: var(--font-heading-family);
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
  }

  .site-footer__tagline {
    font-family: var(--font-heading-family);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.3;
  }

  .site-footer__heading {
    margin-block-end: var(--space-sm);
    font-family: var(--font-body-family);
    font-size: var(--text-xs);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .site-footer__links {
    display: grid;
    gap: 0.15rem;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    text-decoration: none;
    color: var(--color-text-muted);

    &:hover {
      color: var(--color-text);
      text-decoration: underline;
    }
  }

  .site-footer__text {
    color: var(--color-text-muted);
  }

  .newsletter-form {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
  }

  .newsletter-form__field {
    display: grid;
    gap: var(--space-2xs);

    @media screen and (min-width: 480px) {
      grid-template-columns: 1fr auto;
    }
  }

  .newsletter-form__consent {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .site-footer__bottom {
    display: grid;
    gap: var(--space-md);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .site-footer__notice {
    display: flex;
    gap: var(--space-2xs);
    max-width: 52rem;
    font-size: var(--text-xs);
    line-height: 1.55;

    & .icon {
      --icon-size: 1rem;
      margin-block-start: 0.1em;
    }
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    font-size: var(--text-xs);
  }

  .site-footer__cookies {
    min-height: var(--tap-target);
    margin-inline-end: auto;
    padding: 0;
    border: 0;
    font: inherit;
    color: inherit;
    background: none;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;

    &:hover {
      color: var(--color-text);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pied de page",
  "tag": "div",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Affiche le logo, la signature de marque (Paramètres du thème > Logo et identité) et les réseaux sociaux renseignés."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte complémentaire"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Inscription e-mail",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Les inscrites sont enregistrées dans Clients avec le tag « newsletter » et leur consentement marketing. Envoyez vos e-mails avec Shopify Email."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Restons en contact"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Conseils confort et nouveautés, de temps en temps."
        }
      ]
    }
  ]
}
{% endschema %}
