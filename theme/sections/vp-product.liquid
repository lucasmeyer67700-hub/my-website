{%- assign p = section.settings.product -%}
{%- if p != blank -%}
{%- assign v = p.selected_or_first_available_variant -%}
<section class="vp vp-sec vp-bg-white" id="vp-product"><div class="vp-wrap">
  {%- if section.settings.heading != blank %}<h2 class="vp-h2 vp-card-title">{{ section.settings.heading }}</h2>{% endif -%}
  <div class="vp-product vp-product--card">
  <div class="vp-product__media">
    {%- assign img = section.settings.image | default: p.featured_image -%}
    {%- if img != blank -%}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 990px) 45vw, 90vw', alt: p.title }}{%- endif -%}
    {%- if section.settings.badge != blank %}<span class="vp-product__badge">{{ section.settings.badge | escape }}</span>{% endif -%}
  </div>
  <div>
    {%- render 'vp-rating', product: p, sim_rating: section.settings.sim_rating, sim_count: section.settings.sim_count, class: 'vp-product__rating' -%}
    <h2 class="vp-product__title">{{ section.settings.title | default: p.title | escape }}</h2>
    <p class="vp-product__price">{{ v.price | money }}{% if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif %} <small>{{ section.settings.price_note | escape }}</small></p>
    {%- assign mf = p.metafields.velea.benefices.value -%}
    <ul class="vp-checks">
      {%- if section.settings.points != blank -%}
        {%- assign ls = section.settings.points | newline_to_br | split: '<br />' -%}{%- for l in ls -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}
      {%- else -%}{%- for l in mf -%}<li>{{ l | escape }}</li>{%- endfor -%}{%- endif -%}
    </ul>
    {%- form 'product', p, class: 'vp-product__form' -%}
      <input type="hidden" name="id" value="{{ v.id }}">
      <button type="submit" class="vp-btn vp-btn--dark"{% unless v.available %} disabled{% endunless %}>{% if v.available %}{{ section.settings.button_label | escape }}, {{ v.price | money }}{% else %}Bientôt de retour{% endif %}</button>
    {%- endform -%}
    {%- if section.settings.note != blank %}<p class="vp-note">{% if section.settings.note_tag != blank %}<span>{{ section.settings.note_tag | escape }}</span>{% endif %}{{ section.settings.note | escape }}</p>{% endif -%}
    {%- if section.settings.under != blank %}<ul class="vp-ticks" style="justify-content:flex-start">{%- assign ls = section.settings.under | split: '|' -%}{%- for t in ls -%}<li>{{ t | strip | escape }}</li>{%- endfor -%}</ul>{%- endif -%}
  </div>
</div></div></section>
{%- if section.settings.sticky -%}
<div class="vp vp-sticky" id="vp-sticky" aria-hidden="true">
  <div class="vp-sticky__info"><strong>{{ section.settings.title | default: p.title | escape }}</strong><span>{{ v.price | money }} · livraison offerte</span></div>
  <a class="vp-btn" href="#vp-product" tabindex="-1">{{ section.settings.sticky_label | escape }}</a>
</div>
<script>
  (function () {
    var bar = document.getElementById('vp-sticky'), target = document.getElementById('vp-product');
    if (!bar || !('IntersectionObserver' in window)) return;
    var seenHero = false, prodVisible = false;
    function update() { var show = window.scrollY > 500 && !prodVisible; bar.classList.toggle('is-visible', show); bar.setAttribute('aria-hidden', show ? 'false' : 'true'); }
    new IntersectionObserver(function (e) { prodVisible = e[0].isIntersecting; update(); }).observe(target);
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>
{%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "VELEA+ · Produit",
  "tag": "div",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Titre au-dessus", "default": "Reprends le contrôle de tes règles" },
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "image_picker", "id": "image", "label": "Photo (sinon photo du produit)" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Notre best-seller" },
    { "type": "text", "id": "title", "label": "Titre (sinon nom du produit)" },
    { "type": "text", "id": "price_note", "label": "Mention prix", "default": "TTC · livraison offerte" },
    { "type": "textarea", "id": "points", "label": "Bénéfices (un par ligne, sinon champ du produit)" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Ajouter au panier" },
    { "type": "text", "id": "note_tag", "label": "Étiquette de la mention", "default": "PACK" },
    { "type": "text", "id": "note", "label": "Mention sous le bouton", "default": "Ceinture + 10 patchs + pochette dans le Pack Cocon" },
    { "type": "text", "id": "under", "label": "Sous le bouton (séparé par |)", "default": "Paiement sécurisé | Retours 30 jours" },
    { "type": "checkbox", "id": "sticky", "label": "Barre d'achat collante sur mobile", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Bouton de la barre", "default": "Je la veux" },
    { "type": "text", "id": "sim_rating", "label": "Note simulée (aperçu uniquement)", "default": "4,7" },
    { "type": "text", "id": "sim_count", "label": "Nombre d'avis simulé", "default": "298" }
  ],
  "presets": [{ "name": "VELEA+ · Produit" }]
}
{% endschema %}
