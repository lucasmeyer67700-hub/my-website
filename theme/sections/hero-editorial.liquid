{%- comment -%}
  Opening of the home page, magazine layout: the title set on three lines
  (the last one stepped in), a short text, an outlined button and a quiet
  link on the left; the film framed at the bottom right with its caption,
  the price at the top right. Phones: the film first (square), the text
  below. Everything arrives once, in order; nothing moves for visitors who
  asked for less motion.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign hero_video = section.settings.video
  assign primary_link = section.settings.button_link
  if primary_link == blank and product != blank
    assign primary_link = product.url
  endif
  if primary_link == blank
    assign primary_link = routes.all_products_collection_url
  endif

  capture heading_text
    echo section.settings.line_1
    if section.settings.line_2 != blank
      echo ' ' | append: section.settings.line_2
    endif
    if section.settings.line_3 != blank
      echo ' ' | append: section.settings.line_3
    endif
  endcapture
  assign heading_text = heading_text | strip

  assign price_text = ''
  if section.settings.show_price and product != blank
    assign price_text = product.price | money
  endif
-%}

<section
  class="hero-ed"
  id="HeroEditorial-{{ section.id }}"
  aria-labelledby="HeroEditorialTitle-{{ section.id }}"
>
  <div class="hero-ed__copy">
    {%- if section.settings.kicker != blank or price_text != blank -%}
      <p class="hero-ed__kicker">
        <span class="hero-ed__rule" aria-hidden="true"></span>
        <span>{{ section.settings.kicker | escape }}</span>
        {%- if price_text != blank -%}
          <span class="hero-ed__kicker-price">&nbsp;— {{ price_text }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    <h1 class="hero-ed__title" id="HeroEditorialTitle-{{ section.id }}" aria-label="{{ heading_text | escape }}">
      {%- if section.settings.line_1 != blank -%}
        <span class="hero-ed__line" aria-hidden="true"><span class="hero-ed__line-inner">{{ section.settings.line_1 | escape }}</span></span>
      {%- endif -%}
      {%- if section.settings.line_2 != blank -%}
        <span class="hero-ed__line" aria-hidden="true"><span class="hero-ed__line-inner">{{ section.settings.line_2 | escape }}</span></span>
      {%- endif -%}
      {%- if section.settings.line_3 != blank -%}
        <span class="hero-ed__line hero-ed__line--offset" aria-hidden="true"><span class="hero-ed__line-inner">{{ section.settings.line_3 | escape }}</span></span>
      {%- endif -%}
    </h1>

    {%- if section.settings.text != blank -%}
      <p class="hero-ed__lede">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    <div class="hero-ed__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="hero-ed__btn" href="{{ primary_link }}"><span>{{ section.settings.button_label | escape }}</span></a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <a class="hero-ed__quiet" href="{{ section.settings.secondary_link }}"><span>{{ section.settings.secondary_label | escape }}</span></a>
      {%- endif -%}
    </div>
  </div>

  {%- if price_text != blank -%}
    <p class="hero-ed__price"><span class="visually-hidden">{{ 'products.price' | t }} : </span>{{ price_text }}</p>
  {%- endif -%}

  <figure class="hero-ed__film">
    <div class="hero-ed__frame">
      {%- if hero_video != blank -%}
        {%- liquid
          assign src_1080 = ''
          assign src_720 = ''
          for source in hero_video.sources
            if source.format == 'mp4'
              if source.height == 1080
                assign src_1080 = source.url
              elsif source.height == 720
                assign src_720 = source.url
              endif
            endif
          endfor
          if src_1080 == blank
            for source in hero_video.sources
              if source.format == 'mp4'
                assign src_1080 = source.url
              endif
            endfor
          endif
          if src_720 == blank
            assign src_720 = src_1080
          endif
          assign src_phone = src_720
          assign phone_video = section.settings.video_mobile
          assign poster = hero_video.preview_image
          if phone_video != blank
            assign phone_best = 0
            for source in phone_video.sources
              if source.format == 'mp4' and source.height > phone_best
                assign phone_best = source.height
                assign src_phone = source.url
              endif
            endfor
          endif
        -%}
        <video-player class="hero-ed__player" data-autoplay-always>
          <video
            class="hero-ed__video"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            disablepictureinpicture
            aria-hidden="true"
            tabindex="-1"
            poster="{{ poster | image_url: width: 1600 }}"
          >
            <source src="{{ src_phone }}" type="video/mp4" media="(max-width: 600px)">
            <source src="{{ src_1080 }}" type="video/mp4">
          </video>
        </video-player>
      {%- elsif section.settings.image != blank -%}
        {% render 'responsive-image',
          image: section.settings.image,
          sizes: '(min-width: 821px) 60vw, 100vw',
          widths: '600, 900, 1200, 1600, 2000',
          eager: true,
          alt: section.settings.image.alt,
          class: 'hero-ed__video'
        %}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hero-ed__video' }}
      {%- endif -%}
    </div>

    {%- if section.settings.caption != blank -%}
      <figcaption class="hero-ed__caption">{{ section.settings.caption | escape | replace: ' · ', ' <span class="hero-ed__dot" aria-hidden="true">·</span> ' }}</figcaption>
    {%- endif -%}

    <div class="hero-ed__cue hero-ed__cue--film" aria-hidden="true">
      <span>{{ 'sections.hero_scroll' | t }}</span>
      <span class="hero-ed__track"><i></i></span>
    </div>
  </figure>

  <div class="hero-ed__cue hero-ed__cue--side" aria-hidden="true">
    <span class="hero-ed__cue-label">{{ 'sections.hero_scroll' | t }}</span>
    <span class="hero-ed__track"><i></i></span>
  </div>
</section>

{% stylesheet %}
  .hero-ed {
    --hero-ed-pad: 20px;
    --hero-ed-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --hero-ed-soft: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    display: flex;
    flex-direction: column;
    max-width: 1440px;
    margin: 0 auto;
    color: #2b2422;
    background: #fff;
  }

  /* The film */
  .hero-ed__film {
    position: relative;
    order: -1;
    width: 100%;
    aspect-ratio: 1 / 1;
    margin: 0;
    background: #f6e6e8;
  }

  .hero-ed__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #f6e6e8;
  }

  .hero-ed__player,
  .hero-ed__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-ed__video::-webkit-media-controls,
  .hero-ed__video::-webkit-media-controls-start-playback-button {
    display: none !important; /* iPhone: never a play button over the background film */
    -webkit-appearance: none;
  }

  .hero-ed__caption {
    display: none;
  }

  .hero-ed__dot {
    padding: 0 0.2em;
    color: #c9727e;
  }

  .hero-ed__cue--film {
    position: absolute;
    bottom: 16px;
    left: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: rgb(255 255 255 / 0.92);
    transform: translateX(-50%);

    & span:first-child {
      font-size: 8px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-shadow: 0 1px 4px rgb(43 36 34 / 0.55);
    }

    & .hero-ed__track {
      height: 22px;
      background: rgb(255 255 255 / 0.35);
    }

    & .hero-ed__track i {
      height: 8px;
      background: rgb(255 255 255 / 0.95);
    }
  }

  .hero-ed__track {
    position: relative;
    display: block;
    width: 1px;
    overflow: hidden;

    & i {
      position: absolute;
      top: 0;
      left: 0;
      display: block;
      width: 1px;
    }
  }

  .hero-ed__cue--side {
    display: none;
  }

  /* The words */
  .hero-ed__copy {
    width: 100%;
    padding: 16px var(--hero-ed-pad) max(20px, env(safe-area-inset-bottom));
  }

  .hero-ed__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 9px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6f6461;
  }

  .hero-ed__rule {
    flex: none;
    width: 18px;
    height: 1px;
    background: #c9727e;
  }

  .hero-ed__kicker-price {
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #2b2422;
  }

  .hero-ed__title {
    margin: 8px 0 0;
    font-family: var(--font-heading-family);
    font-size: clamp(34px, 9.2vw, 40px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #2b2422;
    text-wrap: initial;
  }

  .hero-ed__line {
    display: block;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    /* Hides the line below its baseline while it rises, never its sides */
    clip-path: inset(-0.3em -100vw 0 -100vw);
  }

  .hero-ed__line-inner {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-ed__line--offset {
    margin-left: 36px;
  }

  .hero-ed__lede {
    max-width: 100%;
    margin: 10px 0 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: #6f6461;
  }

  .hero-ed__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    margin-top: 12px;
  }

  .hero-ed__btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 50px;
    padding: 0 30px;
    overflow: hidden;
    border: 1px solid #a14a5c;
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: #a14a5c;
    background: transparent;
    transition: color 0.22s ease-out 0.04s;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      background: #a14a5c;
      transform: scaleY(0);
      transform-origin: bottom;
      transition: transform 0.46s var(--hero-ed-soft);
    }

    & > span {
      position: relative;
      z-index: 1;
    }

    &:is(:hover, :focus-visible, :active) {
      color: #fff;
    }

    &:is(:hover, :focus-visible, :active)::before {
      transform: scaleY(1);
    }

    &:focus-visible {
      outline: 2px solid #a14a5c;
      outline-offset: 3px;
    }
  }

  .hero-ed__quiet {
    display: inline-flex;
    align-self: center;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    color: #2b2422;

    & span {
      padding-bottom: 3px;
      border-bottom: 1px solid #c9727e;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    &:hover {
      color: #a14a5c;
    }

    &:hover span {
      border-color: #a14a5c;
    }
  }

  .hero-ed__price {
    display: none;
  }

  /* Tablets */
  @media screen and (min-width: 601px) {
    .hero-ed {
      --hero-ed-pad: 48px;
    }

    .hero-ed__film {
      aspect-ratio: 16 / 9;
    }

    .hero-ed__copy {
      padding: 36px var(--hero-ed-pad) 48px;
    }

    .hero-ed__kicker {
      font-size: 9.5px;
      letter-spacing: 0.16em;
    }

    .hero-ed__rule {
      width: 24px;
    }

    .hero-ed__title {
      margin-top: 14px;
      font-size: clamp(38px, 6vw, 52px);
    }

    .hero-ed__line--offset {
      margin-left: 48px;
    }

    .hero-ed__lede {
      max-width: 440px;
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.7;
    }

    .hero-ed__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 26px;
      margin-top: 24px;
    }

    .hero-ed__btn {
      width: auto;
      height: 54px;
      font-size: 11px;
    }

    .hero-ed__quiet {
      align-self: auto;
      font-size: 12px;
    }
  }

  /* Computers: text on the left, film framed at the bottom right */
  @media screen and (min-width: 821px) {
    .hero-ed {
      --hero-ed-pad: 56px;
      display: block;
      min-height: max(calc(100svh - var(--header-offset, 97px)), 680px);
      padding: 44px var(--hero-ed-pad) 56px;
    }

    .hero-ed__copy {
      position: relative;
      z-index: 1;
      width: calc(50% - 40px);
      padding: 0;
    }

    .hero-ed__film {
      position: absolute;
      right: 0;
      bottom: 0;
      order: 0;
      width: 58.333%;
      aspect-ratio: 16 / 9;
      background: transparent;
    }

    .hero-ed__cue--film {
      display: none;
    }

    .hero-ed__caption {
      position: absolute;
      top: -26px;
      right: var(--hero-ed-pad);
      display: block;
      margin: 0;
      font-size: 8.5px;
      font-weight: 500;
      line-height: 1.4;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      white-space: nowrap;
      color: #6f6461;
    }

    .hero-ed__title {
      font-size: clamp(40px, 4.6vw, 54px);
    }

    .hero-ed__line--offset {
      margin-left: 44px;
    }

    .hero-ed__kicker-price {
      display: none;
    }

    .hero-ed__price {
      position: absolute;
      top: 44px;
      right: var(--hero-ed-pad);
      display: block;
      margin: 0;
      font-family: var(--font-heading-family);
      font-size: 22px;
      line-height: 1;
      letter-spacing: -0.01em;
      text-align: right;
      color: #2b2422;

      &::before {
        content: '';
        display: block;
        width: 32px;
        height: 1px;
        margin: 0 0 11px auto;
        background: #c9727e;
      }
    }
  }

  @media screen and (min-width: 1025px) {
    .hero-ed {
      --hero-ed-pad: 64px;
      padding: 52px var(--hero-ed-pad) 72px;
    }

    .hero-ed__kicker {
      font-size: 10px;
      letter-spacing: 0.18em;
    }

    .hero-ed__title {
      margin-top: 18px;
      font-size: clamp(48px, 4.6vw, 64px);
    }

    .hero-ed__line--offset {
      margin-left: 64px;
    }

    .hero-ed__lede {
      max-width: 390px;
      margin-top: 22px;
    }

    .hero-ed__actions {
      gap: 16px 28px;
      margin-top: 30px;
    }

    .hero-ed__price {
      top: 52px;
    }

    .hero-ed__cue--side {
      position: absolute;
      bottom: 34px;
      left: var(--hero-ed-pad);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      color: #6f6461;

      & .hero-ed__track {
        height: 44px;
        margin-left: 2px;
        background: #f6e6e8;
      }

      & .hero-ed__track i {
        height: 14px;
        background: #a14a5c;
      }
    }

    .hero-ed__cue-label {
      font-size: 9px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }
  }

  @media screen and (min-width: 1200px) {
    .hero-ed__title {
      font-size: clamp(60px, 4.7vw, 72px);
    }
  }

  @media screen and (max-height: 760px) and (min-width: 1025px) {
    .hero-ed__cue--side {
      display: none;
    }
  }

  /* Arrival, in order: film, label, title line by line, text, buttons, details */
  @media (prefers-reduced-motion: no-preference) {
    .hero-ed__frame {
      animation: hero-ed-fade 1.1s ease-out 0.05s both;
    }

    .hero-ed__video {
      animation: hero-ed-zoom 1.8s var(--hero-ed-ease) 0.05s both;
    }

    .hero-ed__kicker {
      animation: hero-ed-up 0.7s var(--hero-ed-ease) 0.28s both;
    }

    .hero-ed__line-inner {
      animation: hero-ed-rise 0.95s var(--hero-ed-soft) both;
    }

    .hero-ed__line:nth-child(1) .hero-ed__line-inner {
      animation-delay: 0.42s;
    }

    .hero-ed__line:nth-child(2) .hero-ed__line-inner {
      animation-delay: 0.52s;
    }

    .hero-ed__line:nth-child(3) .hero-ed__line-inner {
      animation-delay: 0.62s;
    }

    .hero-ed__lede {
      animation: hero-ed-up 0.75s var(--hero-ed-ease) 0.95s both;
    }

    .hero-ed__actions {
      animation: hero-ed-up 0.75s var(--hero-ed-ease) 1.1s both;
    }

    .hero-ed__price {
      animation: hero-ed-up 0.7s var(--hero-ed-ease) 0.78s both;
    }

    .hero-ed__caption {
      animation: hero-ed-up 0.6s var(--hero-ed-ease) 1.15s both;
    }

    .hero-ed__cue {
      animation: hero-ed-fade 0.7s var(--hero-ed-ease) 1.45s both;
    }

    .hero-ed__track i {
      animation: hero-ed-cue 2.8s var(--hero-ed-soft) 2.2s infinite;
    }
  }

  @keyframes hero-ed-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-ed-zoom {
    from {
      transform: scale(1.055);
    }
  }

  @keyframes hero-ed-rise {
    from {
      transform: translateY(112%);
    }
  }

  @keyframes hero-ed-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes hero-ed-cue {
    0% {
      transform: translateY(-16px);
    }

    60%,
    100% {
      transform: translateY(50px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Accueil éditorial",
  "tag": "div",
  "class": "section-hero-editorial",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Petite ligne au-dessus du titre",
      "default": "Ceinture chauffante sans fil"
    },
    {
      "type": "text",
      "id": "line_1",
      "label": "Titre, ligne 1",
      "default": "La chaleur d'une"
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Titre, ligne 2",
      "default": "bouillotte."
    },
    {
      "type": "text",
      "id": "line_3",
      "label": "Titre, ligne 3 (décalée)",
      "default": "Sans le fil."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Afficher le prix",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Voir la ceinture"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton",
      "info": "Sans lien : la fiche du produit choisi."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Texte du lien discret",
      "default": "Toute la collection"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Lien discret"
    },
    {
      "type": "header",
      "content": "Film"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo (ordinateur, format 16:9)"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Vidéo (téléphone, format carré)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (si pas de vidéo)"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Légende au-dessus du film",
      "info": "Séparez deux idées par « · ».",
      "default": "Trois niveaux de chaleur · Quatre modes de vibration"
    }
  ],
  "presets": [{ "name": "Accueil éditorial" }]
}
{% endschema %}
