{%- comment -%}
  Who we are: a title (or, without one, the small label set as the title),
  a paragraph, optional short lines on ruled rows, a button; the photo
  beside it, framed to its own shape so nobody is cut off.
{%- endcomment -%}
{%- liquid
  assign title = section.settings.heading
  assign label = section.settings.eyebrow
  if title == blank and label != blank
    assign title = label | escape
    assign label = ''
  endif

  # A "line" longer than a short sentence was typed as a paragraph: it is
  # shown as text, the short ones as the ruled list.
  assign short_count = 0
  for block in section.blocks
    if block.settings.text != blank and block.settings.text.size <= 90
      assign short_count = short_count | plus: 1
    endif
  endfor

  assign image = section.settings.image
  assign ratio = '4 / 5'
  if image != blank
    assign ratio = image.aspect_ratio
  endif
-%}
<section
  class="brand-statement section"
  {% if title != blank %}
    aria-labelledby="StatementTitle-{{ section.id }}"
  {% endif %}
>
  <div class="brand-statement__grid page-width page-width--wide">
    <div class="brand-statement__copy reveal">
      {%- if label != blank -%}
        <p class="brand-statement__eyebrow">{{ label | escape }}</p>
      {%- endif -%}
      {%- if title != blank -%}
        <h2 class="brand-statement__title" id="StatementTitle-{{ section.id }}">{{ title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="brand-statement__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text.size > 90 -%}
          <p class="brand-statement__text" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- endif -%}
      {%- endfor -%}

      {%- if short_count > 0 -%}
        <ul class="brand-statement__points" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank and block.settings.text.size <= 90 -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="shop-row__all brand-statement__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="brand-statement__media media reveal" style="--media-ratio: {{ ratio }};">
      {%- if image != blank -%}
        {% render 'responsive-image',
          image: image,
          sizes: '(min-width: 990px) 55vw, 100vw',
          widths: '600, 900, 1200, 1600, 2000',
          alt: image.alt
        %}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* Phones and tablets: words, then the photo. From 990px: the words on the
     left, centred against the photo on the right. */
  .brand-statement__grid {
    display: grid;
    gap: 2.25rem;

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 5vw, 6rem);
      align-items: center;
    }
  }

  .brand-statement__copy {
    min-width: 0;
    max-width: 38rem;
  }

  .brand-statement__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .brand-statement__title {
    max-width: 21ch;
    margin: 0;
    text-wrap: balance;
  }

  .brand-statement__text {
    margin: 1.25rem 0 0;
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-text);
    text-wrap: pretty;

    & p {
      margin: 0;
    }

    & p + p {
      margin-block-start: 1em;
    }
  }

  /* Short lines, each on its own ruled row with a small rose dot */
  ul.brand-statement__points[role='list'] {
    display: grid;
    max-width: 32rem;
    margin: 1.75rem 0 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border, rgb(31 26 25 / 0.14));
    list-style: none;
  }

  .brand-statement__points li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-block: 0.95rem;
    border-block-end: 1px solid var(--color-border, rgb(31 26 25 / 0.14));
    font-size: var(--text-md);
    line-height: 1.45;

    &::before {
      content: '';
      flex: none;
      width: 0.4rem;
      height: 0.4rem;
      margin-block-start: calc((1.45em - 0.4rem) / 2);
      border-radius: 50%;
      background-color: var(--rose-cta);
    }
  }

  .brand-statement__button {
    margin-block-start: 2rem;
  }

  .brand-statement__media {
    border-radius: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Qui nous sommes",
  "tag": "div",
  "class": "section-brand-statement",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petite ligne",
      "default": "Nous sommes VELEA"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "info": "Sans titre, la petite ligne devient le titre."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Affichée en entier, dans son propre format."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Notre histoire"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "info": "Une phrase courte, affichée sur une ligne à puce. Pour un paragraphe, utilisez le champ « Texte » de la section.",
          "default": "Une phrase courte"
        }
      ]
    }
  ],
  "presets": [{ "name": "Qui nous sommes" }]
}
{% endschema %}
