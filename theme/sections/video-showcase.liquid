{%- comment -%}
  Up to eight upright videos in a carousel (arrows, counter, progress line;
  swipe on phones). Videos come from Content > Files. A slot
  without a video only shows in the theme editor, never to visitors; without
  any video the section stays hidden.
{%- endcomment -%}
{%- liquid
  assign ratio = section.settings.ratio
  assign filled = 0
  for block in section.blocks
    if block.settings.video != blank
      assign filled = filled | plus: 1
    endif
  endfor
  assign visible = filled
  if request.design_mode
    assign visible = section.blocks.size
  endif
  assign anchor = section.settings.anchor | handleize
-%}

{%- if visible > 0 -%}
  <section
    class="video-showcase section color-{{ section.settings.color_scheme }}"
    {% if anchor != blank %}
      id="{{ anchor }}"
    {% endif %}
    {% if section.settings.heading != blank %}
      aria-labelledby="VideoShowcaseTitle-{{ section.id }}"
    {% endif %}
  >
    <video-carousel class="video-showcase__carousel" style="--video-ratio: {{ ratio }};">
      <div class="page-width video-showcase__head reveal">
        <div class="video-showcase__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2" id="VideoShowcaseTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="video-showcase__lead">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
        <div class="video-showcase__nav" data-carousel-nav hidden>
          <p class="video-showcase__counter" aria-hidden="true">
            <span data-carousel-current>01</span>
            <span class="video-showcase__counter-line"></span>
            <span>{{ visible | prepend: '0' | slice: -2, 2 }}</span>
          </p>
          <button type="button" class="video-showcase__arrow" data-carousel-prev aria-label="{{ 'general.previous' | t }}">
            {% render 'icon', icon: 'chevron-left' %}
          </button>
          <button type="button" class="video-showcase__arrow" data-carousel-next aria-label="{{ 'general.next' | t }}">
            {% render 'icon', icon: 'chevron-right' %}
          </button>
        </div>
      </div>

      <ul
        class="video-showcase__track"
        role="list"
        aria-label="{{ 'sections.video_carousel' | t }}"
        data-carousel-track
        tabindex="0"
      >
        {%- assign slide_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign video = block.settings.video -%}
          {%- if video == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          {%- assign slide_number = slide_number | plus: 1 -%}
          {%- assign shop_product = block.settings.product -%}
          <li
            class="video-showcase__slide"
            data-carousel-slide
            aria-label="{{ 'sections.video_slide' | t: number: slide_number, total: visible }}"
            {{ block.shopify_attributes }}
          >
            <figure class="video-showcase__card">
              <div class="video-showcase__frame">
                {%- if video != blank -%}
                  {%- if section.settings.autoplay -%}
                    <video-player class="video-showcase__player">
                      {{
                        video
                        | video_tag:
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'none',
                          image_size: '900x',
                          class: 'video-showcase__video'
                      }}
                      <div class="video-showcase__controls">
                        <button
                          type="button"
                          class="icon-button video-showcase__control"
                          data-video-toggle
                          aria-pressed="false"
                          aria-label="{{ 'sections.video_pause' | t }}"
                        >
                          <span class="video-showcase__icon video-showcase__icon--pause">{% render 'icon', icon: 'pause' %}</span>
                          <span class="video-showcase__icon video-showcase__icon--play">{% render 'icon', icon: 'play' %}</span>
                        </button>
                        <button
                          type="button"
                          class="icon-button video-showcase__control"
                          data-video-sound
                          aria-pressed="false"
                          aria-label="{{ 'sections.video_sound' | t }}"
                        >
                          <span class="video-showcase__icon video-showcase__icon--muted">{% render 'icon', icon: 'volume-off' %}</span>
                          <span class="video-showcase__icon video-showcase__icon--sound">{% render 'icon', icon: 'volume' %}</span>
                        </button>
                      </div>
                    </video-player>
                  {%- else -%}
                    {{
                      video
                      | video_tag:
                        controls: true,
                        playsinline: true,
                        preload: 'none',
                        image_size: '900x',
                        class: 'video-showcase__video'
                    }}
                  {%- endif -%}
                {%- else -%}
                  <div class="video-showcase__empty">
                    <span class="video-showcase__empty-icon" aria-hidden="true">{% render 'icon', icon: 'play' %}</span>
                    <p>{{ 'sections.video_slot_hint' | t: number: forloop.index }}</p>
                  </div>
                {%- endif -%}

                {%- if block.settings.tag != blank -%}
                  <span class="video-showcase__tag">{{ block.settings.tag | escape }}</span>
                {%- endif -%}

                {%- if block.settings.title != blank or block.settings.text != blank -%}
                  <figcaption class="video-showcase__caption">
                    {%- if block.settings.title != blank -%}
                      <span class="video-showcase__title">{{ block.settings.title | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <span class="video-showcase__text">{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                  </figcaption>
                {%- endif -%}
              </div>

              {%- if shop_product != blank -%}
                <a class="video-showcase__product" href="{{ shop_product.url }}">
                  {%- if shop_product.featured_image != blank -%}
                    {{
                      shop_product.featured_image
                      | image_url: width: 120, height: 120, crop: 'center'
                      | image_tag: loading: 'lazy', alt: '', class: 'video-showcase__product-image', width: 60, height: 60
                    }}
                  {%- endif -%}
                  <span class="video-showcase__product-info">
                    <span class="video-showcase__product-title">{{ shop_product.title | escape }}</span>
                    <span class="video-showcase__product-price">{{ shop_product.price | money }}</span>
                  </span>
                  <span class="video-showcase__product-go" aria-hidden="true">{% render 'icon', icon: 'arrow-right' %}</span>
                  <span class="visually-hidden">{{ 'sections.video_shop' | t }}</span>
                </a>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>

      <div class="page-width">
        <div class="video-showcase__progress" data-carousel-progress hidden aria-hidden="true">
          <span class="video-showcase__progress-bar" data-carousel-bar></span>
        </div>

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="video-showcase__actions reveal">
            <a class="button" href="{{ section.settings.button_link }}">
              {{- section.settings.button_label | escape -}}
              {% render 'icon', icon: 'arrow-right' %}
            </a>
          </div>
        {%- endif -%}
      </div>
    </video-carousel>
  </section>
{%- endif -%}

{% stylesheet %}
  /*
    Video carousel: upright cards in a row that scrolls sideways. The card in
    the middle is in focus; its neighbours are a little smaller and lighter.
    Caption over a soft gradient, an optional label on top and an optional
    product card underneath.
  */
  .video-showcase {
    overflow: hidden;
  }

  .video-showcase__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: clamp(1.75rem, 1.2rem + 2vw, 3rem);

    @media screen and (max-width: 749px) {
      justify-content: center;
      text-align: center;
    }
  }

  .video-showcase__intro {
    display: grid;
    gap: var(--space-xs);
    max-width: 34rem;

    & .h2 {
      margin: 0;
    }
  }

  .video-showcase__lead {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Arrows and counter (only when the cards do not all fit) */
  .video-showcase__nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);

    &[hidden] {
      display: none;
    }

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .video-showcase__counter {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 var(--space-xs) 0 0;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);

    & [data-carousel-current] {
      color: var(--color-text);
    }
  }

  .video-showcase__counter-line {
    width: 2rem;
    height: 1px;
    background-color: currentColor;
    opacity: 0.5;
  }

  .video-showcase__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(var(--color-text-rgb) / 0.18);
    border-radius: 50%;
    color: var(--color-text);
    background-color: var(--color-background);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;

    & .icon {
      --icon-size: 1rem;
    }

    &:hover:not([disabled]) {
      border-color: var(--color-text);
      color: var(--color-background);
      background-color: var(--color-text);
    }

    &[disabled] {
      opacity: 0.35;
      cursor: default;
    }

    &:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 3px;
    }
  }

  /*
    The row of cards: each card can come to the centre of the screen.
    Two classes: the base list reset (ul[role='list']) must not undo the padding.
  */
  .video-showcase .video-showcase__track {
    position: relative;
    --slide-width: clamp(15rem, 70vw, 20rem);
    --track-gutter: calc((100% - var(--slide-width)) / 2);

    display: flex;
    gap: clamp(0.85rem, 0.6rem + 1vw, 1.5rem);
    margin: 0;
    padding: 0.5rem var(--track-gutter) 1.25rem;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;

    &::-webkit-scrollbar {
      display: none;
    }

    &:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: -2px;
    }
  }

  /* Few cards that all fit: centred, nothing to scroll */
  video-carousel:not([data-overflow]) .video-showcase__track.video-showcase__track {
    justify-content: center;
  }

  .video-showcase__slide {
    flex: 0 0 var(--slide-width);
    min-width: 0;
    scroll-snap-align: center;
    transition:
      opacity 0.6s var(--ease-reveal),
      scale 0.6s var(--ease-reveal);
  }

  /* Neighbours step back a little while the carousel can scroll */
  video-carousel[data-overflow] .video-showcase__slide:not(.is-active) {
    opacity: 0.55;
    scale: 0.94;
  }

  .video-showcase__card {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
  }

  .video-showcase__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--video-ratio, 9 / 16);
    border-radius: 1.25rem;
    background-color: var(--color-surface);
    box-shadow:
      0 0 0 1px rgb(var(--color-text-rgb) / 0.06),
      0 30px 50px -36px rgb(43 36 34 / 0.55);
    isolation: isolate;

    /* Soft gradient so the caption stays readable on any video */
    &::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      z-index: 1;
      height: 45%;
      background: linear-gradient(to top, rgb(20 14 12 / 0.62), transparent);
      pointer-events: none;
    }
  }

  .video-showcase__player {
    display: block;
    height: 100%;
  }

  .video-showcase__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: var(--color-surface);
    transition: scale 1.2s var(--ease-reveal);
  }

  @media (hover: hover) {
    .video-showcase__slide:hover .video-showcase__video {
      scale: 1.03;
    }
  }

  .video-showcase__tag {
    position: absolute;
    inset-block-start: 0.9rem;
    inset-inline-start: 0.9rem;
    z-index: 2;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--palette-ink);
    background-color: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(6px);
  }

  .video-showcase__caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 4.75rem 1.1rem 1.1rem;
    color: #fff;
  }

  .video-showcase__title {
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    line-height: 1.15;
  }

  .video-showcase__text {
    font-size: var(--text-sm);
    line-height: 1.4;
    opacity: 0.9;
    text-wrap: pretty;
  }

  .video-showcase__controls {
    position: absolute;
    inset-inline-end: 0.75rem;
    inset-block-end: 0.75rem;
    z-index: 3;
    display: flex;
    gap: 0.4rem;
  }

  .video-showcase__control {
    width: 2.25rem;
    min-width: 2.25rem;
    height: 2.25rem;
    min-height: 2.25rem;
    color: var(--palette-ink);
    background-color: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(6px);

    & .icon {
      --icon-size: 0.9rem;
    }
  }

  .video-showcase__icon {
    display: inline-flex;
  }

  .video-showcase__icon--play,
  .video-showcase__icon--sound,
  [data-video-toggle][aria-pressed='true'] .video-showcase__icon--pause,
  [data-video-sound][aria-pressed='true'] .video-showcase__icon--muted {
    display: none;
  }

  [data-video-toggle][aria-pressed='true'] .video-showcase__icon--play,
  [data-video-sound][aria-pressed='true'] .video-showcase__icon--sound {
    display: inline-flex;
  }

  /* Product shown in the video, one tap away */
  .video-showcase__product {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem 0.5rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    background-color: var(--color-background);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;

    &:hover {
      border-color: rgb(var(--color-text-rgb) / 0.4);
      box-shadow: 0 10px 24px -18px rgb(43 36 34 / 0.6);
    }

    &:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 3px;
    }
  }

  .video-showcase__product-image {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    background-color: var(--gallery-bg);
  }

  .video-showcase__product-info {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }

  .video-showcase__product-title {
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: var(--font-body-weight-medium);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .video-showcase__product-price {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .video-showcase__product-go {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: #fff;
    background-color: var(--rose-cta);

    & .icon {
      --icon-size: 0.85rem;
    }
  }

  /* Thin progress line under the row */
  .video-showcase__progress {
    position: relative;
    height: 2px;
    margin-block-start: var(--space-sm);
    overflow: hidden;
    border-radius: 2px;
    background-color: rgb(var(--color-text-rgb) / 0.1);

    &[hidden] {
      display: none;
    }
  }

  .video-showcase__progress-bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--progress-size, 30%);
    background-color: var(--rose-cta);
    translate: var(--progress-offset, 0%) 0;
    transition: translate 0.4s var(--ease-out);
  }

  /* Empty slot (theme editor only) */
  .video-showcase__empty {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-sm);
    height: 100%;
    padding: var(--space-md);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text-muted);
    background: radial-gradient(120% 80% at 50% 0%, #fff, transparent 70%), var(--palette-rose-light);
  }

  .video-showcase__empty-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--rose-text);
    background-color: #fff;
  }

  .video-showcase__actions {
    display: flex;
    justify-content: center;
    margin-block-start: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .video-showcase__slide,
    .video-showcase__video {
      transition: none;
    }

    video-carousel[data-overflow] .video-showcase__slide:not(.is-active) {
      scale: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vidéos du produit",
  "tag": "div",
  "class": "section-video-showcase",
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Ajoutez vos vidéos (Contenu > Fichiers) dans chaque bloc « Vidéo ». Un emplacement sans vidéo n'apparaît que dans l'éditeur ; sans aucune vidéo, la section reste masquée."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "En vidéo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "La ceinture, <em>en images.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format des vidéos",
      "options": [
        { "value": "9 / 16", "label": "Vertical (9:16)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1", "label": "Carré" },
        { "value": "16 / 9", "label": "Horizontal (16:9)" }
      ],
      "default": "9 / 16"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Lecture automatique, sans le son",
      "info": "Avec boutons pause et son. Décochez pour une lecture au clic, avec les commandes du navigateur.",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre (lien interne)",
      "default": "videos"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Vidéo",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vidéo"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Étiquette (facultative)",
          "info": "Petit mot en haut de la vidéo, par exemple « Au bureau »."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre (facultatif)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Légende (facultative)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produit montré (facultatif)",
          "info": "Une petite carte cliquable sous la vidéo : photo, nom et prix."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vidéos du produit",
      "blocks": [{ "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
