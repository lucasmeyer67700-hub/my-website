{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "eyebrow": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<p class=\"product__text uppercase pp-pdp-eyebrow\">{{ product.type }} · Livraison offerte</p>"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "save": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign v = product.selected_or_first_available_variant -%}\n{%- if v.compare_at_price > v.price -%}\n  <p class=\"pp-save\">Vous économisez {{ v.compare_at_price | minus: v.price | money }}</p>\n{%- endif -%}"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "delivery": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pp-delivery', min: 7, max: 14 %}"
          }
        },
        "icons": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Livraison offerte",
            "icon_2": "return",
            "heading_2": "Essai 30 nuits",
            "icon_3": "lock",
            "heading_3": "Paiement sécurisé"
          }
        },
        "description": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pp-description', title: 'Description' %}"
          }
        },
        "tab_ship": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Livraison et essai 30 nuits",
            "icon": "truck",
            "content": "<p>Livraison offerte en France métropolitaine, avec numéro de suivi, en 7 à 14 jours ouvrés.</p><p>Vous avez 30 nuits pour l'essayer. S'il ne vous convient pas, écrivez-nous : nous organisons le retour puis le remboursement.</p>"
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Entretien",
            "icon": "washing",
            "content": "<p>Taies lavables en machine à 30 °C (cycle délicat). La mousse ne se lave pas : aérez-la de temps en temps. Pour les housses, suivez les consignes de leur étiquette.</p>"
          }
        }
      },
      "block_order": [
        "eyebrow",
        "title",
        "price",
        "save",
        "variant_picker",
        "quantity",
        "buy",
        "delivery",
        "icons",
        "description",
        "tab_ship",
        "tab_care"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-3",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 40,
        "padding_bottom": 80
      }
    },
    "trust": {
      "type": "pp-trust-bar",
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 28,
        "padding_bottom": 28
      },
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "icon": "layers",
            "title": "Mousse à mémoire",
            "text": "Épouse puis reprend sa forme"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "icon": "wind",
            "title": "Housse respirante",
            "text": "Côtés en maille qui laissent passer l'air"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "icon": "moon",
            "title": "Essai 30 nuits",
            "text": "Satisfait ou remboursé"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "icon": "chat",
            "title": "Service client",
            "text": "Réponse sous 24 h ouvrées"
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3",
        "item_4"
      ]
    },
    "faq": {
      "type": "collapsible-content",
      "settings": {
        "caption": "",
        "heading": "Questions fréquentes",
        "heading_size": "h1",
        "heading_alignment": "center",
        "layout": "none",
        "container_color_scheme": "scheme-6",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": false,
        "image_ratio": "adapt",
        "desktop_layout": "image_first",
        "padding_top": 72,
        "padding_bottom": 72
      },
      "blocks": {
        "collapsible_row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Quelle position de sommeil convient à l'Oreiller Papillon ?",
            "icon": "silhouette",
            "row_content": "<p>Il est pensé pour les personnes qui dorment sur le dos, sur le côté, ou qui alternent les deux. Si vous dormez principalement sur le ventre, il risque d'être trop haut.</p>"
          }
        },
        "collapsible_row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Combien de temps faut-il pour s'habituer ?",
            "icon": "stopwatch",
            "row_content": "<p>Comptez en général une à deux semaines. Les premières nuits peuvent sembler inhabituelles : votre nuque découvre un soutien différent. C'est pour cela que nous offrons 30 nuits d'essai.</p>"
          }
        },
        "collapsible_row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Comment l'entretenir ?",
            "icon": "washing",
            "row_content": "<p>La mousse ne se lave pas : aérez-la de temps en temps, à l'abri du soleil direct. Pour la housse, suivez les consignes de son étiquette.</p>"
          }
        },
        "collapsible_row_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Il a une odeur à la réception, est-ce normal ?",
            "icon": "leaf",
            "row_content": "<p>Oui, c'est l'odeur de neuf de la mousse, qui a voyagé compressée. Laissez-le 24 à 48 h dans une pièce aérée : elle disparaît.</p>"
          }
        },
        "collapsible_row_5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Quels sont les délais de livraison ?",
            "icon": "truck",
            "row_content": "<p>La livraison est offerte en France métropolitaine. Chaque commande est expédiée avec un numéro de suivi et livrée en 7 à 14 jours ouvrés.</p>"
          }
        },
        "collapsible_row_6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Comment fonctionne l'essai 30 nuits ?",
            "icon": "return",
            "row_content": "<p>Si l'oreiller ne vous convient pas dans les 30 nuits suivant la réception, contactez-nous. Nous vous indiquons la marche à suivre pour le retour et vous remboursons dès réception.</p>"
          }
        }
      },
      "block_order": [
        "collapsible_row_1",
        "collapsible_row_2",
        "collapsible_row_3",
        "collapsible_row_4",
        "collapsible_row_5",
        "collapsible_row_6"
      ]
    },
    "related": {
      "type": "related-products",
      "settings": {
        "heading": "Complétez votre nuit",
        "heading_size": "h1",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "sticky": {
      "type": "pp-sticky-atc",
      "settings": {
        "button_label": "Ajouter au panier",
        "color_scheme": "scheme-6"
      }
    },
    "bundle": {
      "type": "pp-bundle-promo",
      "settings": {
        "product": "pack-sur-mesure",
        "eyebrow": "Pack sur mesure",
        "title": "Composez votre pack",
        "text": "<p>Partez de l'Oreiller Papillon et ajoutez la taie de rechange, le coussin genoux, ou les deux. Plus le pack est complet, plus vous économisez : jusqu'à 22,99 €.</p>",
        "compare_note": "prix des mêmes produits achetés à l'unité",
        "button_label": "Composer mon pack",
        "color_scheme": "scheme-2",
        "padding_top": 72,
        "padding_bottom": 72
      },
      "blocks": {
        "p1": {
          "type": "point",
          "settings": {
            "text": "L'Oreiller Papillon, toujours inclus"
          }
        },
        "p2": {
          "type": "point",
          "settings": {
            "text": "+ la taie, le coussin genoux, ou les deux"
          }
        },
        "p3": {
          "type": "point",
          "settings": {
            "text": "Livraison offerte et essai 30 nuits"
          }
        }
      },
      "block_order": [
        "p1",
        "p2",
        "p3"
      ]
    }
  },
  "order": [
    "main",
    "bundle",
    "trust",
    "faq",
    "related",
    "sticky"
  ]
}
