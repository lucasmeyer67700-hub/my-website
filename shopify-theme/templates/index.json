    "steps": {
      "type": "pp-steps",
      "settings": {
        "eyebrow": "Mode d'emploi",
        "title": "Bien démarrer avec votre oreiller",
        "text": "",
        "color_scheme": "scheme-2",
        "padding_top": 80,
        "padding_bottom": 80
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Laissez-le respirer",
            "text": "<p>À la réception, sortez l'oreiller de son emballage et laissez-le 24 à 48 h dans une pièce aérée pour qu'il reprenne tout son volume.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Choisissez votre hauteur",
            "text": "<p>Tournez l'oreiller : le bord le plus bas pour les nuques fines ou le dos, le plus haut pour les épaules larges ou le côté.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Laissez-vous quelques nuits",
            "text": "<p>Le corps a ses habitudes. Comptez une à deux semaines pour vous y faire : c'est pour ça que l'essai dure 30 nuits.</p>"
          }
        }
      },
