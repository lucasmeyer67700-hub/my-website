{%- comment -%}
  Illustrations vectorielles (aucune image requise).
  - name: 'pillow'     -> oreiller papillon vu de dessus (markers: true pour numéroter les zones)
  - name: 'align-good' -> profil allongé, nuque alignée
  - name: 'align-bad'  -> profil allongé, nuque cassée (oreiller trop haut)
  - name: 'knee'       -> coussin genoux
{%- endcomment -%}
{%- case name -%}
  {%- when 'pillow' -%}
    <svg class="pp-illu pp-illu--pillow" viewBox="0 0 400 280" role="img" aria-label="Oreiller cervical papillon vu de dessus">
      <defs>
        <radialGradient id="ppHollow{{ uid }}" cx="50%" cy="45%" r="60%">
          <stop offset="0" stop-color="#CDD1D7"/>
          <stop offset="1" stop-color="#EEF0F2"/>
        </radialGradient>
        <linearGradient id="ppBody{{ uid }}" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#F7F8F9"/>
          <stop offset="1" stop-color="#DDE0E4"/>
        </linearGradient>
      </defs>
      <ellipse cx="200" cy="258" rx="170" ry="12" fill="#2A2C31" opacity=".08"/>
      <path d="M200 58C230 58 250 28 300 26C355 24 392 58 388 106C386 128 372 136 372 136C372 136 386 146 386 168C388 216 350 248 300 246C250 244 232 214 200 214C168 214 150 244 100 246C50 248 12 216 14 168C14 146 28 136 28 136C28 136 14 128 12 106C8 58 45 24 100 26C150 28 170 58 200 58Z" fill="url(#ppBody{{ uid }})" stroke="#BFC4CA" stroke-width="2"/>
      <path d="M200 70C226 70 246 42 298 40C346 38 376 68 374 106C373 124 360 136 360 136C360 136 373 148 372 168C371 206 340 234 298 232C250 230 228 202 200 202C172 202 150 230 102 232C60 234 29 206 28 168C27 148 40 136 40 136C40 136 27 124 26 106C24 68 54 38 102 40C154 42 174 70 200 70Z" fill="none" stroke="#C9CDD3" stroke-width="1.5" stroke-dasharray="4 5"/>
      <ellipse cx="200" cy="136" rx="72" ry="46" fill="url(#ppHollow{{ uid }})"/>
      <path d="M140 196C170 186 230 186 260 196" fill="none" stroke="#AEB3BA" stroke-width="3" stroke-linecap="round"/>
      <path d="M92 92C76 110 76 162 92 180M308 92C324 110 324 162 308 180" fill="none" stroke="#CDD1D7" stroke-width="2" stroke-linecap="round"/>
      {%- if markers -%}
        <g class="pp-illu__markers" font-family="inherit" font-size="15" font-weight="600" text-anchor="middle">
          <g><circle cx="200" cy="136" r="15" fill="#2A2C31"/><text x="200" y="141" fill="#fff">1</text></g>
          <g><circle cx="200" cy="198" r="15" fill="#2A2C31"/><text x="200" y="203" fill="#fff">2</text></g>
          <g><circle cx="100" cy="92" r="15" fill="#2A2C31"/><text x="100" y="97" fill="#fff">3</text></g>
          <g><circle cx="300" cy="92" r="15" fill="#2A2C31"/><text x="300" y="97" fill="#fff">3</text></g>
          <g><circle cx="368" cy="136" r="15" fill="#2A2C31"/><text x="368" y="141" fill="#fff">4</text></g><g><circle cx="32" cy="136" r="15" fill="#2A2C31"/><text x="32" y="141" fill="#fff">4</text></g>
        </g>
      {%- endif -%}
    </svg>
  {%- when 'align-good' or 'align-bad' -%}
    {%- liquid
      if name == 'align-good'
        assign head_y = 104
        assign pillow_path = 'M40 150 L40 132 Q60 120 92 122 Q120 112 150 126 Q164 134 164 150 Z'
        assign axis = 'M70 104 L380 112'
      else
        assign head_y = 70
        assign pillow_path = 'M40 150 L40 96 Q70 80 110 88 Q150 92 166 116 Q174 132 170 150 Z'
        assign axis = 'M70 70 L170 108 L380 112'
      endif
    -%}
    <svg class="pp-illu pp-illu--align" viewBox="0 0 420 180" role="img" aria-label="{% if name == 'align-good' %}Nuque alignée avec la colonne{% else %}Nuque cassée par un oreiller trop haut{% endif %}">
      <rect x="20" y="150" width="380" height="14" rx="7" fill="#DDE0E4"/>
      <path d="{{ pillow_path }}" fill="#EEF0F2" stroke="#BFC4CA" stroke-width="2" stroke-linejoin="round"/>
      <rect x="150" y="98" width="240" height="40" rx="20" fill="#9A9EA6"/>
      <path d="M100 {{ head_y | plus: 14 }} Q140 {{ head_y | plus: 22 }} 160 112" fill="none" stroke="#9A9EA6" stroke-width="22" stroke-linecap="round"/>
      <circle cx="80" cy="{{ head_y }}" r="28" fill="#4A4E57"/>
      <path d="{{ axis }}" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" opacity=".85"/>
    </svg>
  {%- when 'knee' -%}
    <svg class="pp-illu pp-illu--knee" viewBox="0 0 400 260" role="img" aria-label="Coussin genoux ergonomique">
      <ellipse cx="200" cy="236" rx="150" ry="12" fill="#2A2C31" opacity=".08"/>
      <path d="M70 120C70 70 120 60 150 82C175 100 225 100 250 82C280 60 330 70 330 120V200C330 220 316 228 300 228H100C84 228 70 220 70 200Z" fill="#F7F8F9" stroke="#BFC4CA" stroke-width="2"/>
      <path d="M70 120C70 70 120 60 150 82C175 100 225 100 250 82C280 60 330 70 330 120C300 108 272 112 250 126C225 142 175 142 150 126C128 112 100 108 70 120Z" fill="#9A9EA6"/>
      <path d="M86 168H314" stroke="#DDE0E4" stroke-width="2" stroke-dasharray="4 5"/>
    </svg>
{%- endcase -%}
