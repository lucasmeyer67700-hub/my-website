{%- comment -%}
  Icônes au trait, cohérentes avec la charte gris / blanc.
  Usage : {% render 'pp-icon', icon: 'truck' %}
{%- endcomment -%}
<svg class="pp-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9H3z"/><path d="M14 9.5h3.6l3.4 3.4v2.6h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
    {%- when 'moon' -%}
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
    {%- when 'shield' -%}
      <path d="M12 3l7.5 3v5.5c0 4.5-3.2 8.2-7.5 9.5-4.3-1.3-7.5-5-7.5-9.5V6z"/><path d="M8.8 12.2l2.2 2.2 4.4-4.6"/>
    {%- when 'mail' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/>
    {%- when 'return' -%}
      <path d="M4 10h11a5 5 0 0 1 0 10H9"/><path d="M8 6l-4 4 4 4"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19l7-7"/>
    {%- when 'wind' -%}
      <path d="M3 9h11a3 3 0 1 0-3-3"/><path d="M3 13h15a3 3 0 1 1-3 3"/><path d="M3 17h7"/>
    {%- when 'layers' -%}
      <path d="M12 4l9 4.5-9 4.5-9-4.5z"/><path d="M3 12.5l9 4.5 9-4.5"/><path d="M3 16.5l9 4.5 9-4.5"/>
    {%- when 'neck' -%}
      <circle cx="12" cy="6" r="3"/><path d="M10.5 9v3.5c0 1 .5 1.5 1.5 1.5s1.5-.5 1.5-1.5V9"/><path d="M5 21c.5-4 3-6.5 7-6.5s6.5 2.5 7 6.5"/>
    {%- when 'wash' -%}
      <path d="M3.5 7l1.7 12h13.6L20.5 7"/><path d="M3.5 7c2 1.5 3.5 1.5 5.5 0s3.5-1.5 5.5 0 3.5 1.5 5.5 0"/><path d="M9.5 14h5"/>
    {%- when 'ruler' -%}
      <path d="M3 15.5L15.5 3 21 8.5 8.5 21z"/><path d="M7 11.5l2 2M10 8.5l2 2M13 5.5l2 2"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="9" width="17" height="4" rx="1"/><path d="M5 13v7.5h14V13M12 9v11.5"/><path d="M12 9c-1.5-3-5-4-5-1.5S10 9 12 9zm0 0c1.5-3 5-4 5-1.5S14 9 12 9z"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'cross' -%}
      <path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>
    {%- when 'thermo' -%}
      <path d="M12 3v11"/><circle cx="12" cy="17" r="3.5"/><path d="M16 6h3M16 9.5h3M16 13h3"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/><path d="M8.5 12.2l2.3 2.3 4.7-4.8"/>
  {%- endcase -%}
</svg>
