{%- comment -%} Description du produit dans un volet repliable, au style des onglets Dawn. {%- endcomment -%}
<div class="product__accordion accordion quick-add-hidden">
  <details{% if open %} open{% endif %}>
    <summary>
      <div class="summary__title">
        {% render 'pp-icon', icon: 'layers' %}
        <h2 class="h4 accordion__title inline-richtext">{{ title | default: 'Description' }}</h2>
      </div>
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </summary>
    <div class="accordion__content rte">{{ product.description }}</div>
  </details>
</div>
