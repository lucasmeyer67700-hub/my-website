{%- comment -%}
  Ligne « ★★★★★ 4,8 · 164 avis » qui renvoie vers la section avis de la page.
  Usage : {% render 'pp-rating-line', rating: '4.8', count: '164', anchor: 'avis' %}
  Sans note (rating vide) : une étoile et le nombre d'avis.
{%- endcomment -%}
{%- liquid
  assign pct = rating | plus: 0 | divided_by: 5.0 | times: 100
-%}
{%- capture stars -%}
  <svg viewBox="0 0 120 24" aria-hidden="true" focusable="false"><g fill="currentColor">
    {%- for i in (0..4) -%}<path transform="translate({{ i | times: 24 }} 0)" d="M12 1.8l3 6.2 6.8.9-5 4.7 1.3 6.7L12 17l-6.1 3.3 1.3-6.7-5-4.7 6.8-.9z"/>{%- endfor -%}
  </g></svg>
{%- endcapture -%}
<a class="pp-rating-line" href="#{{ anchor | default: 'avis' }}" data-pp-scroll>
  {%- if rating != blank -%}
    <span class="pp-stars" style="--pct: {{ pct }}%" aria-hidden="true">
      <span class="pp-stars__base">{{ stars }}</span>
      <span class="pp-stars__fill">{{ stars }}</span>
    </span>
    <span><strong>{{ rating | replace: '.', ',' }}</strong>/5 · {{ count }} avis</span>
  {%- else -%}
    <span class="pp-rating-line__star" aria-hidden="true">★</span>
    <span>{{ count }} avis clients</span>
  {%- endif -%}
</a>
