{%- comment -%}
  Transition douce entre deux zones de couleurs différentes (ex. gris nuit → blanc).
  Le dégradé suit une courbe adoucie (plusieurs paliers) pour éviter l'effet
  « bande grise » d'un dégradé linéaire simple.
{%- endcomment -%}
{%- liquid
  assign hide = false
  if section.settings.hide_on_home and request.page_type == 'index'
    assign hide = true
  endif
-%}
{%- unless hide -%}
  {%- liquid
    assign a = section.settings.color_from
    assign b = section.settings.color_to
  -%}
  <div
    class="pp-fade"
    style="--pp-fade-h: {{ section.settings.height }}px; background: linear-gradient(180deg,
      {{ a }} 0%,
      {{ a | color_mix: b, 92 }} 12%,
      {{ a | color_mix: b, 78 }} 26%,
      {{ a | color_mix: b, 58 }} 40%,
      {{ a | color_mix: b, 38 }} 55%,
      {{ a | color_mix: b, 20 }} 70%,
      {{ a | color_mix: b, 8 }} 85%,
      {{ b }} 100%);"
    aria-hidden="true"
  ></div>
{%- endunless -%}

{% schema %}
{
  "name": "Dégradé de transition",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "color_from", "label": "Couleur du haut", "default": "#16171A" },
    { "type": "color", "id": "color_to", "label": "Couleur du bas", "default": "#FFFFFF" },
    { "type": "range", "id": "height", "min": 24, "max": 320, "step": 8, "unit": "px", "label": "Hauteur", "default": 160 },
    { "type": "checkbox", "id": "hide_on_home", "label": "Masquer sur la page d'accueil", "default": false }
  ],
  "presets": [ { "name": "Dégradé de transition" } ]
}
{% endschema %}
