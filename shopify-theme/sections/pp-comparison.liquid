{% render 'pp-padding', section: section %}

<div class="pp-compare color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="pp-heading pp-heading--center pp-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<div class="pp-heading__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="pp-compare__wrap pp-reveal">
      <table class="pp-compare__table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Critère</span></th>
            <th scope="col" class="pp-compare__ours">{{ section.settings.col_1 }}</th>
            <th scope="col">{{ section.settings.col_2 }}</th>
            {%- if section.settings.col_3 != blank -%}<th scope="col">{{ section.settings.col_3 }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              {%- for i in (1..3) -%}
                {%- if i == 3 and section.settings.col_3 == blank -%}{%- continue -%}{%- endif -%}
                {%- assign key = 'value_' | append: i -%}
                {%- assign value = block.settings[key] | strip -%}
                {%- assign v = value | downcase -%}
                <td class="{% if i == 1 %}pp-compare__ours{% endif %}">
                  {%- case v -%}
                    {%- when 'oui' -%}<span class="pp-compare__yes">{% render 'pp-icon', icon: 'check' %}<span class="visually-hidden">Oui</span></span>
                    {%- when 'non' -%}<span class="pp-compare__no">{% render 'pp-icon', icon: 'cross' %}<span class="visually-hidden">Non</span></span>
                    {%- when 'partiel' -%}<span class="pp-compare__partial">~<span class="visually-hidden">Partiellement</span></span>
                    {%- else -%}{{ value }}
                  {%- endcase -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tableau comparatif",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Comparatif" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Pourquoi pas un oreiller classique ?" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "col_1", "label": "Colonne 1 (la vôtre)", "default": "Notre oreiller" },
    { "type": "text", "id": "col_2", "label": "Colonne 2", "default": "Oreiller classique" },
    { "type": "text", "id": "col_3", "label": "Colonne 3 (optionnelle)", "default": "Mémoire de forme premier prix" },
    { "type": "paragraph", "content": "Dans les lignes, écrivez « oui », « non » ou « partiel » pour afficher une icône, ou n'importe quel texte court." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 72 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "label", "label": "Critère", "default": "Critère" },
        { "type": "text", "id": "value_1", "label": "Colonne 1", "default": "oui" },
        { "type": "text", "id": "value_2", "label": "Colonne 2", "default": "non" },
        { "type": "text", "id": "value_3", "label": "Colonne 3", "default": "partiel" }
      ]
    }
  ],
  "presets": [ { "name": "Tableau comparatif" } ]
}
{% endschema %}
