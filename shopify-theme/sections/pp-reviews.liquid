{%- comment -%}
  Avis clients : note globale à gauche, avis qui défilent en continu à droite
  (deux rangées en sens opposés, pause au survol). Les avis sont saisis comme blocs.
  La provenance des avis est affichée sous la note (obligation de transparence :
  article L111-7-2 du Code de la consommation).
  Aucune donnée structurée n'est générée : Google n'accepte pas, dans ses
  extraits enrichis, des avis qui n'ont pas été recueillis sur le site lui-même.
{%- endcomment -%}
{% render 'pp-padding', section: section %}

{%- liquid
  assign rating = section.settings.rating | plus: 0
  assign pct = rating | divided_by: 5.0 | times: 100
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}

{%- capture stars -%}
  <svg viewBox="0 0 120 24" aria-hidden="true" focusable="false"><g fill="currentColor">
    {%- for i in (0..4) -%}<path transform="translate({{ i | times: 24 }} 0)" d="M12 1.8l3 6.2 6.8.9-5 4.7 1.3 6.7L12 17l-6.1 3.3 1.3-6.7-5-4.7 6.8-.9z"/>{%- endfor -%}
  </g></svg>
{%- endcapture -%}

<div
  id="{{ section.settings.anchor | default: 'avis' | handleize }}"
  class="pp-reviews pp-anchor color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pp-reviews__grid">
      <div class="pp-reviews__summary pp-reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h1 pp-reviews__title">{{ section.settings.title }}</h2>

        <div class="pp-reviews__score">
          <span class="pp-reviews__note">{{ section.settings.rating | replace: '.', ',' }}</span>
          <div>
            <span class="pp-stars pp-stars--lg" style="--pct: {{ pct }}%" role="img" aria-label="Note moyenne : {{ section.settings.rating | replace: '.', ',' }} sur 5">
              <span class="pp-stars__base">{{ stars }}</span>
              <span class="pp-stars__fill">{{ stars }}</span>
            </span>
            <p class="pp-reviews__count">{{ section.settings.count }} avis</p>
          </div>
        </div>

        {%- assign tags = section.settings.tags | newline_to_br | split: '<br />' -%}
        {%- if section.settings.tags != blank -%}
          <ul class="pp-reviews__tags" role="list">
            {%- for t in tags -%}
              {%- assign t = t | strip -%}
              {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.source_note != blank -%}
          <p class="pp-reviews__source">{% render 'pp-icon', icon: 'shield' %}<span>{{ section.settings.source_note }}</span></p>
        {%- endif -%}
      </div>

      <div class="pp-reviews__wall pp-reveal" style="--d: 1">
        {%- for row in (1..2) -%}
          {%- capture cards -%}
            {%- for block in section.blocks -%}
              {%- liquid
                if row == 1 and forloop.index > half
                  continue
                endif
                if row == 2 and forloop.index <= half
                  continue
                endif
                assign r = block.settings.rating
                assign rp = r | times: 20
              -%}
              <article class="pp-review" {{ block.shopify_attributes }}>
                <header class="pp-review__head">
                  <span class="pp-review__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 | upcase }}</span>
                  <span class="pp-review__who">
                    <strong>{{ block.settings.author }}</strong>
                    <span>{{ block.settings.date }}</span>
                  </span>
                  <span class="pp-stars" style="--pct: {{ rp }}%" role="img" aria-label="{{ r }} sur 5">
                    <span class="pp-stars__base">{{ stars }}</span>
                    <span class="pp-stars__fill">{{ stars }}</span>
                  </span>
                </header>
                <p class="pp-review__text">{{ block.settings.text | newline_to_br }}</p>
                {%- if section.settings.verified_label != blank -%}
                  <p class="pp-review__badge">{% render 'pp-icon', icon: 'check' %}{{ section.settings.verified_label }}</p>
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- endcapture -%}
          <div class="pp-reviews__row{% if row == 2 %} pp-reviews__row--reverse{% endif %}">
            <div class="pp-reviews__track">
              <div class="pp-reviews__set">{{ cards }}</div>
              <div class="pp-reviews__set" aria-hidden="true">{{ cards }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Avis clients",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (lien #...)", "default": "avis" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Avis clients" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ils dorment déjà dessus" },
    { "type": "text", "id": "rating", "label": "Note moyenne (sur 5)", "default": "4.8" },
    { "type": "text", "id": "count", "label": "Nombre d'avis", "default": "164" },
    { "type": "textarea", "id": "tags", "label": "Mots-clés (un par ligne)" },
    { "type": "textarea", "id": "source_note", "label": "Provenance des avis", "info": "Obligatoire : indiquez d'où viennent les avis et s'ils sont vérifiés." },
    { "type": "text", "id": "verified_label", "label": "Mention sous chaque avis", "default": "Achat vérifié" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 88 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "text", "id": "author", "label": "Auteur", "default": "Client" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Note", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [ { "name": "Avis clients" } ]
}
{% endschema %}
