{% render 'pp-padding', section: section %}

<div class="pp-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pp-hero__grid">
      <div class="pp-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="pp-hero__title">{{ section.settings.title }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="pp-hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="pp-checklist" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="pp-checklist__mark">{% render 'pp-icon', icon: 'check' %}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="pp-hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="button button--primary pp-button-lg" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="button button--secondary pp-button-lg" href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>

        {%- if section.settings.reassurance != blank -%}
          <p class="pp-hero__reassurance">{{ section.settings.reassurance }}</p>
        {%- endif -%}
      </div>

      <div class="pp-hero__media">
        <div class="pp-hero__frame">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1600', class: 'pp-hero__img'
            }}
          {%- else -%}
            {% render 'pp-illustration', name: 'pillow', uid: section.id %}
          {%- endif -%}
          {%- if section.settings.badge != blank -%}
            <div class="pp-hero__badge">
              {% render 'pp-icon', icon: 'moon' %}
              <span>{{ section.settings.badge }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Héros (accueil)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Oreiller cervical ergonomique" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Réveillez-vous sans nuque raide." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un oreiller en mousse à mémoire de forme pensé pour garder la tête, la nuque et le dos dans le même axe, que vous dormiez sur le dos ou sur le côté.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Découvrir l'oreiller" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button_label_2", "label": "Bouton secondaire", "default": "Voir les packs" },
    { "type": "url", "id": "button_link_2", "label": "Lien du bouton secondaire" },
    { "type": "text", "id": "reassurance", "label": "Ligne de réassurance", "default": "Livraison offerte · Essai 30 nuits · Paiement sécurisé" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Sans image, une illustration de l'oreiller est affichée." },
    { "type": "text", "id": "badge", "label": "Badge sur l'image", "default": "30 nuits pour l'essayer" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 56 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point fort",
      "limit": 5,
      "settings": [ { "type": "text", "id": "text", "label": "Texte", "default": "Point fort" } ]
    }
  ],
  "presets": [ { "name": "Héros (accueil)" } ]
}
{% endschema %}
