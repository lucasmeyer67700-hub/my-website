{%- comment -%}
  Produit en vedette sur fond sombre : la photo studio avec des points numérotés
  posés sur chaque zone, et la liste des atouts correspondants.
  Survoler (ou toucher) un atout met son point en avant, et inversement.
  Les points apparaissent un à un quand la section entre à l'écran.
{%- endcomment -%}
{% render 'pp-padding', section: section %}

{%- assign img = section.settings.image | default: product.featured_image -%}

<div
  id="{{ section.settings.anchor | default: 'zones' | handleize }}"
  class="pp-spot pp-anchor color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pp-heading pp-heading--center pp-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<div class="pp-heading__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <pp-spotlight class="pp-spot__grid">
      <div class="pp-spot__media pp-reveal">
        {%- if img != blank -%}
          {{ img | image_url: width: 2048 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 58vw, 100vw', widths: '600, 900, 1200, 1600, 2048', class: 'pp-spot__img', alt: img.alt }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pp-spot__img placeholder-svg' }}
        {%- endif -%}
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="pp-spot__pin"
            style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --d: {{ forloop.index0 }};"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ forloop.index }}. {{ block.settings.title | escape }}"
          >
            <span>{{ forloop.index }}</span>
          </button>
        {%- endfor -%}
      </div>

      <ol class="pp-spot__list" role="list">
        {%- for block in section.blocks -%}
          <li class="pp-spot__item pp-reveal" style="--d: {{ forloop.index }}" data-index="{{ forloop.index0 }}" tabindex="0" {{ block.shopify_attributes }}>
            <span class="pp-spot__num">{{ forloop.index }}</span>
            <div>
              <h3 class="pp-spot__title">{{ block.settings.title }}</h3>
              <p class="pp-spot__text">{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </pp-spotlight>
  </div>
</div>

<script>
  if (!customElements.get('pp-spotlight')) {
    customElements.define('pp-spotlight', class extends HTMLElement {
      connectedCallback() {
        const pins = this.querySelectorAll('.pp-spot__pin');
        const items = this.querySelectorAll('.pp-spot__item');
        const set = (i) => {
          pins.forEach((p) => p.classList.toggle('is-active', p.dataset.index === i));
          items.forEach((it) => it.classList.toggle('is-active', it.dataset.index === i));
        };
        [...pins, ...items].forEach((el) => {
          el.addEventListener('mouseenter', () => set(el.dataset.index));
          el.addEventListener('focus', () => set(el.dataset.index));
          el.addEventListener('click', () => set(el.dataset.index));
        });
        this.addEventListener('mouseleave', () => set(null));
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(([e]) => {
            if (!e.isIntersecting) return;
            this.classList.add('is-in');
            io.disconnect();
          }, { threshold: 0.3 });
          io.observe(this);
        } else {
          this.classList.add('is-in');
        }
      }
    });
  }
</script>

{% schema %}
{
  "name": "Zones du produit",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (lien #...)", "default": "zones" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le fonctionnement" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Chaque courbe a une raison d'être." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Sans photo, la première photo du produit est utilisée." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 88 }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Zone",
      "limit": 6,
      "settings": [
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Position horizontale", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Position verticale", "default": 50 },
        { "type": "text", "id": "title", "label": "Titre", "default": "Zone" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [ { "name": "Zones du produit" } ]
}
{% endschema %}
