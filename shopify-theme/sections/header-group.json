{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "announce": {
      "type": "pp-announce",
      "settings": {
        "interval": 4
      },
      "blocks": {
        "m1": {
          "type": "message",
          "settings": {
            "text": "Livraison offerte en France métropolitaine",
            "icon": "truck"
          }
        },
        "m2": {
          "type": "message",
          "settings": {
            "text": "Essai 30 nuits · Satisfait ou remboursé",
            "icon": "moon",
            "link": "shopify://pages/livraison-et-retours"
          }
        },
        "m3": {
          "type": "message",
          "settings": {
            "text": "−10 % sur votre première commande avec notre newsletter",
            "icon": "gift"
          }
        },
        "m4": {
          "type": "message",
          "settings": {
            "text": "Pack Nuit complète : l'oreiller + le coussin genoux, −10 €",
            "icon": "check",
            "link": "shopify://products/pack-dormeur-sur-le-cote"
          }
        }
      },
      "block_order": [
        "m1",
        "m2",
        "m3",
        "m4"
      ]
    },
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme-3",
        "menu_color_scheme": "scheme-3",
        "logo_position": "middle-left",
        "menu": "main-menu",
        "menu_type_desktop": "dropdown",
        "sticky_header_type": "on-scroll-up",
        "show_line_separator": false,
        "enable_country_selector": false,
        "enable_language_selector": false,
        "mobile_logo_position": "center",
        "margin_bottom": 0,
        "padding_top": 16,
        "padding_bottom": 16
      }
    }
  },
  "order": [
    "announce",
    "header"
  ]
}
