{% render 'pp-padding', section: section %}

<div class="pp-positions color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pp-heading pp-heading--center pp-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<div class="pp-heading__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="pp-positions__grid">
      {%- for block in section.blocks -%}
        <a class="pp-position pp-reveal" style="--d: {{ forloop.index0 }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="pp-position__picto" aria-hidden="true">
            <svg viewBox="0 0 160 80" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 64h144" opacity=".35"/>
              <path d="M14 64v-12q8-6 22-4l10 4v12" fill="currentColor" opacity=".12" stroke="none"/>
              {%- case block.settings.position -%}
                {%- when 'side' -%}
                  <circle cx="32" cy="36" r="11"/>
                  <path d="M44 44c14 -4 30 -8 52 -6 18 2 30 8 44 6"/>
                  <path d="M96 38c8 8 12 16 30 20"/>
                  <path d="M60 42c4 6 10 10 20 10"/>
                {%- when 'stomach' -%}
                  <circle cx="30" cy="44" r="10"/>
                  <path d="M42 50h92"/>
                  <path d="M44 46c20 -6 60 -6 88 -2"/>
                  <path d="M60 48l-10 -14"/>
                {%- else -%}
                  <circle cx="30" cy="38" r="11"/>
                  <path d="M42 46h96"/>
                  <path d="M44 38c24 -6 62 -6 94 0"/>
              {%- endcase -%}
            </svg>
          </span>
          <span class="pp-position__body">
            <span class="pp-position__title h3">{{ block.settings.title }}</span>
            <span class="pp-position__text">{{ block.settings.text }}</span>
            {%- if block.settings.advice != blank -%}
              <span class="pp-position__advice">{{ block.settings.advice }}</span>
            {%- endif -%}
            <span class="pp-position__link">{{ block.settings.link_label }} <span aria-hidden="true">→</span></span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Positions de sommeil",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Trouvez votre combinaison" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Comment dormez-vous ?" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 72 }
  ],
  "blocks": [
    {
      "type": "position",
      "name": "Position",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "position", "label": "Pictogramme", "default": "back", "options": [
          { "value": "back", "label": "Sur le dos" },
          { "value": "side", "label": "Sur le côté" },
          { "value": "stomach", "label": "Sur le ventre" }
        ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Sur le dos" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "advice", "label": "Notre conseil" },
        { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "Voir la sélection" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [ { "name": "Positions de sommeil" } ]
}
{% endschema %}
