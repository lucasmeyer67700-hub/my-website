{%- comment -%}
  Ouverture plein écran sur fond gris sombre : la photo se fond dans l'anthracite,
  titre en serif, deux boutons empilés qui font défiler vers les sections de la page
  (fonctionnement, puis produits). Repères cliquables sur chaque produit.

  Animation d'entrée : fondu + zoom lent de la photo, texte en cascade, repères qui
  apparaissent, indicateur de défilement. Coupée si le visiteur demande moins d'animations.

  Les repères sont placés en % de la photo. Sur mobile, la photo est recadrée en 4:3
  (point focal réglable) et les repères sont recalculés en CSS pour rester sur les produits.
{%- endcomment -%}
{% render 'pp-padding', section: section %}

{%- liquid
  assign image = section.settings.image
  assign ratio = 1.7768
  if image != blank
    assign ratio = image.aspect_ratio
  endif
  assign mobile_ratio = 1.3333
  assign visible = mobile_ratio | divided_by: ratio
  if visible > 1
    assign visible = 1
  endif
  assign hidden = 1 | minus: visible
  assign focus = section.settings.mobile_focus | divided_by: 100.0
  assign offset = hidden | times: focus | times: 100
-%}

<div
  class="pp-hi color-{{ section.settings.color_scheme }} gradient{% if section.settings.animate %} pp-hi--animate{% endif %}"
  style="--pp-hi-ratio: {{ ratio }}; --pp-hi-visible: {{ visible }}; --pp-hi-offset: {{ offset }}%; --pp-hi-focus: {{ section.settings.mobile_focus }}%;"
>
  <div class="pp-hi__media">
    <div class="pp-hi__frame">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 3840
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1920, 2560, 3200, 3840',
            class: 'pp-hi__img',
            alt: image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'pp-hi__img placeholder-svg' }}
      {%- endif -%}
      <span class="pp-hi__veil" aria-hidden="true"></span>

      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <a
          class="pp-hotspot pp-hotspot--{{ block.settings.label_side }}"
          href="{% if p != blank %}{{ p.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --yn: {{ block.settings.y | divided_by: 100.0 }}; --delay: {{ forloop.index0 | times: 220 | plus: 1500 }}ms;"
          {{ block.shopify_attributes }}
        >
          <span class="pp-hotspot__dot" aria-hidden="true"></span>
          <span class="pp-hotspot__label">
            <span class="pp-hotspot__name">{{ block.settings.label | default: p.title }}</span>
            {%- if p != blank -%}
              <span class="pp-hotspot__price">{{ p.price | money }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>

  <div class="page-width pp-hi__shell section-{{ section.id }}-padding">
    <div class="pp-hi__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pp-eyebrow pp-hi__in" style="--i: 0">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="pp-hi__title pp-hi__in" style="--i: 1">
        {{ section.settings.title }}
        {%- if section.settings.title_accent != blank %} <em>{{ section.settings.title_accent }}</em>{% endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="pp-hi__text rte pp-hi__in" style="--i: 2">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="pp-hi__side">
      <div class="pp-hi__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="pp-hi__btn pp-hi__btn--primary pp-hi__in" style="--i: 3" href="{{ section.settings.button_link | default: '#fonctionnement' }}" data-pp-scroll>
            <span>{{ section.settings.button_label }}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="pp-hi__btn pp-hi__btn--ghost pp-hi__in" style="--i: 4" href="{{ section.settings.button_link_2 | default: '#produits' }}" data-pp-scroll>
            <span>{{ section.settings.button_label_2 }}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.reassurance != blank -%}
        <p class="pp-hi__reassurance pp-hi__in" style="--i: 5">
          {% render 'pp-icon', icon: 'moon' %}<span>{{ section.settings.reassurance }}</span>
        </p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_cue -%}
    <a class="pp-hi__cue" href="{{ section.settings.button_link | default: '#fonctionnement' }}" data-pp-scroll aria-label="Faire défiler">
      <span></span>
    </a>
  {%- endif -%}
</div>

<script>
  (function () {
    // Défilement doux vers une ancre de la page, en tenant compte de l'en-tête collant.
    if (window.ppScrollReady) return;
    window.ppScrollReady = true;
    document.addEventListener('click', function (event) {
      var link = event.target.closest('a[data-pp-scroll]');
      if (!link) return;
      var hash = link.getAttribute('href');
      if (!hash || hash.charAt(0) !== '#') return;
      var target = document.getElementById(hash.slice(1));
      if (!target) return;
      event.preventDefault();
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var top = target.getBoundingClientRect().top + window.scrollY - 16;
      window.scrollTo({ top: top, behavior: reduce ? 'auto' : 'smooth' });
      history.replaceState(null, '', hash);
    });
  })();
</script>

{% schema %}
{
  "name": "Bannière photo",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Format paysage, 3840 px de large idéalement." },
    { "type": "range", "id": "mobile_focus", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Point focal sur mobile (gauche → droite)", "default": 40 },
    { "type": "checkbox", "id": "animate", "label": "Animation à l'ouverture", "default": true },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Indicateur de défilement", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le duo des dormeurs sur le côté" },
    { "type": "text", "id": "title", "label": "Titre", "default": "De la nuque aux genoux," },
    { "type": "text", "id": "title_accent", "label": "Fin du titre (en italique)", "default": "enfin aligné." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Découvrir le fonctionnement" },
    { "type": "text", "id": "button_link", "label": "Lien du bouton principal", "default": "#fonctionnement", "info": "Une ancre de la page (#fonctionnement) ou une adresse (/products/...)." },
    { "type": "text", "id": "button_label_2", "label": "Bouton secondaire", "default": "Voir les produits" },
    { "type": "text", "id": "button_link_2", "label": "Lien du bouton secondaire", "default": "#produits" },
    { "type": "text", "id": "reassurance", "label": "Ligne de réassurance", "default": "Livraison offerte · Essai 30 nuits" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute (sous le titre)", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 72 }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Repère produit",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "text", "id": "label", "label": "Nom affiché", "info": "Laissez vide pour reprendre le nom du produit." },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Position horizontale", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Position verticale", "default": 50 },
        { "type": "select", "id": "label_side", "label": "Étiquette", "default": "bottom-right", "options": [
          { "value": "bottom-right", "label": "En dessous, vers la droite" },
          { "value": "bottom-left", "label": "En dessous, vers la gauche" },
          { "value": "right", "label": "À droite" },
          { "value": "left", "label": "À gauche" }
        ] }
      ]
    }
  ],
  "presets": [ { "name": "Bannière photo" } ]
}
{% endschema %}
