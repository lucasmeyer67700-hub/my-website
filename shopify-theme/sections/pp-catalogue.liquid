{%- comment -%}
  Page catalogue : les produits de la collection en cartes premium, puis
  « Composez votre pack » où le client coche les produits qu'il veut.
  La remise du pack est une remise automatique Shopify (créée dans l'admin) :
  cette section ne fait qu'afficher les paliers et ajoute les produits choisis au panier.
{%- endcomment -%}
{% render 'pp-padding', section: section %}

{%- capture stars -%}
  <svg viewBox="0 0 120 24" aria-hidden="true" focusable="false"><g fill="currentColor">
    {%- for i in (0..4) -%}<path transform="translate({{ i | times: 24 }} 0)" d="M12 1.8l3 6.2 6.8.9-5 4.7 1.3 6.7L12 17l-6.1 3.3 1.3-6.7-5-4.7 6.8-.9z"/>{%- endfor -%}
  </g></svg>
{%- endcapture -%}

<div class="pp-cat color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pp-heading pp-heading--center pp-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h1">{{ section.settings.title | default: collection.title }}</h1>
      {%- if section.settings.text != blank -%}<div class="pp-heading__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- comment -%} Les cartes produits {%- endcomment -%}
    <div class="pp-cat__grid">
      {%- for p in collection.products limit: 6 -%}
        {%- liquid
          assign badge = ''
          assign rating = ''
          assign rating_count = ''
          if forloop.first
            assign badge = section.settings.first_badge
            assign rating = section.settings.rating
            assign rating_count = section.settings.rating_count
          endif
          assign lines = section.settings.ratings_more | newline_to_br | replace: '<br />', '§' | replace: '<br>', '§' | split: '§'
          for line in lines
            assign parts = line | split: '|'
            assign h = parts[0] | strip
            if h == p.handle
              assign rating = parts[1] | strip
              assign rating_count = parts[2] | strip
            endif
          endfor
        -%}
        {% render 'pp-cat-card', p: p, index: forloop.index0, badge: badge, rating: rating, rating_count: rating_count, swatches: true, stars: stars %}
      {%- endfor -%}
    </div>
    {%- comment -%} Sur téléphone, les cartes défilent au doigt ; les points indiquent la carte affichée {%- endcomment -%}
    {%- assign shown = collection.products.size | at_most: 6 -%}
    {%- if shown > 1 -%}
      <div class="pp-cat__dots" aria-hidden="true" data-pp-cat-dots>
        {%- for i in (1..shown) -%}<span{% if forloop.first %} class="is-on"{% endif %}></span>{%- endfor -%}
      </div>
      <script>
        (function () {
          var dots = document.currentScript.previousElementSibling;
          var grid = dots.previousElementSibling;
          if (!grid || !grid.classList.contains('pp-cat__grid')) return;
          var t;
          grid.addEventListener('scroll', function () {
            clearTimeout(t);
            t = setTimeout(function () {
              var cards = grid.children, best = 0, dist = Infinity;
              for (var i = 0; i < cards.length; i++) {
                var d = Math.abs(cards[i].offsetLeft - grid.offsetLeft - grid.scrollLeft - parseFloat(getComputedStyle(grid).paddingLeft));
                if (d < dist) { dist = d; best = i; }
              }
              [].forEach.call(dots.children, function (s, i) { s.classList.toggle('is-on', i === best); });
            }, 60);
          }, { passive: true });
        })();
      </script>
    {%- endif -%}

    {%- comment -%} Packs déjà composés {%- endcomment -%}
    {%- if section.settings.packs.size > 0 -%}
      <div class="pp-cat__packs">
        <p class="pp-show__extra-title pp-reveal">{{ section.settings.packs_title }}</p>
        <div class="pp-cat__grid pp-cat__grid--packs">
          {%- for p in section.settings.packs -%}
            {% render 'pp-cat-card', p: p, index: forloop.index0, badge: '', rating: '', rating_count: '', swatches: false, stars: stars %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Composez votre pack {%- endcomment -%}
    {%- if section.settings.show_builder and collection.products.size > 1 -%}
      <pp-pack-builder
        class="pp-pack color-scheme-3 pp-reveal"
        data-tier2="{{ section.settings.tier2_amount | times: 100 }}"
        data-tier3="{{ section.settings.tier3_amount | times: 100 }}"
        data-currency="{{ cart.currency.iso_code }}"
        id="composer-pack"
      >
        <div class="pp-pack__head">
          <p class="pp-eyebrow">{{ section.settings.builder_eyebrow }}</p>
          <h2 class="pp-pack__title">{{ section.settings.builder_title }}</h2>
          <ul class="pp-pack__tiers" role="list">
            <li data-tier="2"><strong>2 produits</strong><span>−{{ section.settings.tier2_amount }} €</span></li>
            <li data-tier="3"><strong>3 produits</strong><span>−{{ section.settings.tier3_amount }} €</span></li>
          </ul>
        </div>

        <div class="pp-pack__items">
          {%- for p in collection.products limit: 6 -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            <label class="pp-pack__item{% unless p.available %} is-disabled{% endunless %}">
              <input type="checkbox" class="pp-pack__check" value="{{ p.id }}" {% unless p.available %}disabled{% endunless %} {% if forloop.first %}checked{% endif %}>
              <span class="pp-pack__tick" aria-hidden="true"></span>
              <span class="pp-pack__thumb">
                {%- if p.featured_image -%}
                  {{ v.featured_image | default: p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {% render 'pp-illustration', name: 'pillow', uid: p.id %}
                {%- endif -%}
              </span>
              <span class="pp-pack__info">
                <span class="pp-pack__name">{{ p.title }}</span>
                {%- if p.has_only_default_variant -%}
                  <input type="hidden" class="pp-pack__variant" value="{{ v.id }}" data-price="{{ v.price }}">
                {%- else -%}
                  <select class="pp-pack__variant" aria-label="{{ p.options.first }} : {{ p.title | escape }}">
                    {%- for variant in p.variants -%}
                      <option value="{{ variant.id }}" data-price="{{ variant.price }}"{% if variant.featured_image %} data-img="{{ variant.featured_image | image_url: width: 240 }}"{% endif %} {% if variant.id == v.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>
                    {%- endfor -%}
                  </select>
                {%- endif -%}
              </span>
              <span class="pp-pack__price" data-pp-item-price>{{ v.price | money }}</span>
            </label>
          {%- endfor -%}
        </div>

        <div class="pp-pack__summary">
          <div class="pp-pack__lines">
            <p><span>Sous-total</span><span data-pp-subtotal>—</span></p>
            <p class="pp-pack__saving"><span>Remise pack</span><span data-pp-saving>—</span></p>
            <p class="pp-pack__total"><span>Total</span><span data-pp-total>—</span></p>
            <p class="pp-pack__hint" data-pp-hint></p>
          </div>
          <button type="button" class="pp-show__add pp-pack__add" data-pp-add>Ajouter le pack au panier</button>
          <p class="pp-pack__note">{{ section.settings.builder_note }}</p>
        </div>
      </pp-pack-builder>
    {%- endif -%}
  </div>
</div>

<script>
  // Pastilles de coloris : changent la photo et le lien de la carte.
  document.querySelectorAll('.pp-cat__card').forEach(function (card) {
    card.querySelectorAll('.pp-cat__swatch').forEach(function (sw) {
      sw.addEventListener('click', function () {
        card.querySelectorAll('.pp-cat__swatch').forEach(function (s) { s.classList.toggle('is-active', s === sw); });
        var name = card.querySelector('.pp-cat__swatch-name');
        if (name) name.textContent = sw.getAttribute('aria-label');
        var img = card.querySelector('.pp-cat__img');
        if (img && sw.dataset.img) { img.removeAttribute('srcset'); img.src = sw.dataset.img; }
        if (sw.dataset.url) card.querySelectorAll('[data-pp-card-link]').forEach(function (a) { a.href = sw.dataset.url; });
      });
    });
  });

  if (!customElements.get('pp-pack-builder')) {
    customElements.define('pp-pack-builder', class extends HTMLElement {
      connectedCallback() {
        this.tier2 = +this.dataset.tier2 || 0;
        this.tier3 = +this.dataset.tier3 || 0;
        this.fmt = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: this.dataset.currency || 'EUR' });
        this.addEventListener('change', () => this.update());
        this.querySelector('[data-pp-add]').addEventListener('click', () => this.add());
        this.update();
      }
      selected() {
        return [...this.querySelectorAll('.pp-pack__item')].filter((row) => row.querySelector('.pp-pack__check').checked).map((row) => {
          const field = row.querySelector('.pp-pack__variant');
          const opt = field.tagName === 'SELECT' ? field.selectedOptions[0] : field;
          return { id: +field.value, price: +opt.dataset.price, row };
        });
      }
      update() {
        this.querySelectorAll('.pp-pack__item').forEach((row) => {
          const field = row.querySelector('.pp-pack__variant');
          const opt = field.tagName === 'SELECT' ? field.selectedOptions[0] : field;
          row.querySelector('[data-pp-item-price]').textContent = this.fmt.format(opt.dataset.price / 100);
          const thumb = row.querySelector('.pp-pack__thumb img');
          if (thumb && opt.dataset.img && thumb.dataset.src !== opt.dataset.img) {
            thumb.dataset.src = opt.dataset.img;
            thumb.removeAttribute('srcset');
            thumb.src = opt.dataset.img;
          }
          row.classList.toggle('is-checked', row.querySelector('.pp-pack__check').checked);
        });
        const items = this.selected();
        const n = items.length;
        const subtotal = items.reduce((s, i) => s + i.price, 0);
        const saving = n >= 3 ? this.tier3 : n >= 2 ? this.tier2 : 0;
        this.querySelector('[data-pp-subtotal]').textContent = this.fmt.format(subtotal / 100);
        this.querySelector('[data-pp-saving]').textContent = saving ? '−' + this.fmt.format(saving / 100) : '—';
        this.querySelector('[data-pp-total]').textContent = this.fmt.format((subtotal - saving) / 100);
        const hint = this.querySelector('[data-pp-hint]');
        if (n < 2) hint.textContent = 'Ajoutez un produit de plus pour économiser ' + this.fmt.format(this.tier2 / 100) + '.';
        else if (n < 3 && this.tier3) hint.textContent = 'Encore un produit et la remise passe à ' + this.fmt.format(this.tier3 / 100) + '.';
        else hint.textContent = 'Remise maximale appliquée.';
        this.querySelectorAll('.pp-pack__tiers li').forEach((li) => li.classList.toggle('is-active', +li.dataset.tier <= n));
        this.querySelector('[data-pp-add]').disabled = n === 0;
      }
      async add() {
        const btn = this.querySelector('[data-pp-add]');
        const items = this.selected().map((i) => ({ id: i.id, quantity: 1 }));
        if (!items.length) return;
        btn.disabled = true;
        btn.textContent = 'Ajout en cours…';
        const label = btn.textContent;
        try {
          if (window.ppAddToCart && document.querySelector('cart-drawer')) {
            // Panier coulissant : le pack s'ajoute et le panier s'ouvre sans quitter la page
            await window.ppAddToCart(items);
            btn.disabled = false;
            btn.textContent = label;
            return;
          }
          const res = await fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items }),
          });
          if (!res.ok) throw new Error();
          window.location.href = '{{ routes.cart_url }}';
        } catch (e) {
          btn.disabled = false;
          btn.textContent = 'Réessayer';
        }
      }
    });
  }
</script>

{% schema %}
{
  "name": "Catalogue",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le catalogue" },
    { "type": "text", "id": "title", "label": "Titre", "info": "Vide : titre de la collection." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "first_badge", "label": "Badge du premier produit", "default": "Best-seller" },
    { "type": "text", "id": "rating", "label": "Note du premier produit (sur 5)" },
    { "type": "text", "id": "rating_count", "label": "Nombre d'avis du premier produit" },
    { "type": "textarea", "id": "ratings_more", "label": "Avis des autres produits", "info": "Une ligne par produit : identifiant du produit | note | nombre d'avis. Laissez la note vide si vous ne la connaissez pas (ex. : le-coussin-genoux | | 41)." },
    { "type": "header", "content": "Packs déjà composés" },
    { "type": "product_list", "id": "packs", "label": "Packs", "limit": 4 },
    { "type": "text", "id": "packs_title", "label": "Titre", "default": "Nos packs" },
    { "type": "header", "content": "Composez votre pack" },
    { "type": "checkbox", "id": "show_builder", "label": "Afficher", "default": true },
    { "type": "text", "id": "builder_eyebrow", "label": "Sur-titre", "default": "Sur mesure" },
    { "type": "text", "id": "builder_title", "label": "Titre", "default": "Composez votre pack" },
    { "type": "number", "id": "tier2_amount", "label": "Remise pour 2 produits (€)", "default": 10, "info": "Doit correspondre à la remise automatique créée dans Shopify." },
    { "type": "number", "id": "tier3_amount", "label": "Remise pour 3 produits (€)", "default": 20 },
    { "type": "text", "id": "builder_note", "label": "Mention sous le bouton", "default": "La remise s'applique automatiquement dans le panier." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 96 }
  ]
}
{% endschema %}
