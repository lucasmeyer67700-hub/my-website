{%- comment -%}
  Photo et texte côte à côte sur fond sombre : une grande photo d'un côté,
  un titre, un texte et une liste d'atouts (icône + titre + phrase) de l'autre.
  Sur téléphone, la photo passe au-dessus du texte.
{%- endcomment -%}
{% render 'pp-padding', section: section %}

{%- assign img = section.settings.image -%}
<div class="pp-mt color-{{ section.settings.color_scheme }} gradient{% if section.settings.image_right %} pp-mt--right{% endif %}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pp-mt__grid">
      <div class="pp-mt__media pp-reveal">
        {%- if img != blank -%}
          {{ img | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1600, 2400', class: 'pp-mt__img', alt: img.alt }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pp-mt__img placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.badge != blank -%}<span class="pp-mt__badge">{{ section.settings.badge }}</span>{%- endif -%}
      </div>

      <div class="pp-mt__body">
        {%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow pp-reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="pp-mt__title h1 pp-reveal" style="--d: 1">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<div class="pp-mt__text rte pp-reveal" style="--d: 2">{{ section.settings.text }}</div>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="pp-mt__points" role="list">
            {%- for block in section.blocks -%}
              <li class="pp-mt__point pp-reveal" style="--d: {{ forloop.index | plus: 2 }}" {{ block.shopify_attributes }}>
                <span class="pp-mt__icon" aria-hidden="true">{% render 'pp-icon', icon: block.settings.icon %}</span>
                <span>
                  <strong>{{ block.settings.title }}</strong>
                  {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="pp-mt__btn pp-reveal" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
        {%- if section.settings.note != blank -%}<p class="pp-mt__note pp-reveal">{{ section.settings.note }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Photo et texte",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "checkbox", "id": "image_right", "label": "Photo à droite", "default": false },
    { "type": "text", "id": "badge", "label": "Étiquette sur la photo" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La mousse à mémoire de forme" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Elle épouse, puis elle reprend sa forme." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "note", "label": "Petite mention sous le bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 88 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Atout",
      "limit": 6,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "layers",
          "options": [
            { "value": "layers", "label": "Couches" },
            { "value": "neck", "label": "Nuque" },
            { "value": "wind", "label": "Air" },
            { "value": "ruler", "label": "Mesure" },
            { "value": "moon", "label": "Nuit" },
            { "value": "wash", "label": "Lavage" },
            { "value": "thermo", "label": "Température" },
            { "value": "shield", "label": "Garantie" },
            { "value": "check", "label": "Coche" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Atout" },
        { "type": "text", "id": "text", "label": "Phrase" }
      ]
    }
  ],
  "presets": [ { "name": "Photo et texte" } ]
}
{% endschema %}
