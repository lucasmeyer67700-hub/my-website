{%- comment -%}
  Page contact : à gauche, les moyens de nous joindre (e-mail, assistant instantané,
  suivi de commande) et les réponses rapides ; à droite, le formulaire de contact Shopify
  (les messages arrivent dans la boîte e-mail de la boutique).
{%- endcomment -%}
{% render 'pp-padding', section: section %}

{%- assign email = section.settings.email | default: shop.email -%}
<div class="pp-contact color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pp-contact__grid">
      <div class="pp-contact__intro">
        {%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow pp-reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="h1 pp-contact__title pp-reveal" style="--d: 1">{{ section.settings.title }}</h1>
        {%- if section.settings.text != blank -%}<div class="pp-contact__text rte pp-reveal" style="--d: 2">{{ section.settings.text }}</div>{%- endif -%}

        <ul class="pp-contact__ways" role="list">
          <li class="pp-reveal" style="--d: 2">
            <a class="pp-contact__way" href="mailto:{{ email }}">
              <span class="pp-contact__icon" aria-hidden="true">{% render 'pp-icon', icon: 'mail' %}</span>
              <span><strong>Par e-mail</strong><span>{{ email }}</span></span>
            </a>
          </li>
          <li class="pp-reveal" style="--d: 3">
            <button type="button" class="pp-contact__way" data-pp-open-assistant>
              <span class="pp-contact__icon" aria-hidden="true">{% render 'pp-icon', icon: 'chat' %}</span>
              <span><strong>Réponse immédiate</strong><span>Notre assistant répond aux questions courantes, jour et nuit</span></span>
            </button>
          </li>
          <li class="pp-reveal" style="--d: 4">
            <a class="pp-contact__way" href="/pages/suivi-de-commande">
              <span class="pp-contact__icon" aria-hidden="true">{% render 'pp-icon', icon: 'truck' %}</span>
              <span><strong>Suivre ma commande</strong><span>Avec le lien reçu par e-mail à l'expédition</span></span>
            </a>
          </li>
        </ul>

        {%- if section.settings.promise != blank -%}
          <p class="pp-contact__promise pp-reveal">{% render 'pp-icon', icon: 'check' %}<span>{{ section.settings.promise }}</span></p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="pp-contact__quick pp-reveal">
            <p class="pp-contact__quick-title">{{ section.settings.quick_title }}</p>
            <ul role="list">
              {%- for block in section.blocks -%}
                <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}">{{ block.settings.label }} <span aria-hidden="true">→</span></a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      <div class="pp-contact__card pp-reveal" style="--d: 2">
        {%- form 'contact', id: 'PpContactForm', class: 'pp-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="pp-contact__ok" tabindex="-1" autofocus>
              <span class="pp-contact__ok-icon" aria-hidden="true">{% render 'pp-icon', icon: 'check' %}</span>
              <p class="pp-contact__ok-title">Message bien reçu, merci.</p>
              <p>{{ section.settings.success_text }}</p>
            </div>
          {%- else -%}
            <p class="pp-contact__form-title">{{ section.settings.form_title }}</p>
            {%- if form.errors -%}
              <p class="pp-contact__error" role="alert">Merci de vérifier les champs : {{ form.errors | default_errors }}</p>
            {%- endif -%}
            <div class="pp-contact__row">
              <label class="pp-contact__field">
                <span>Nom</span>
                <input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
              </label>
              <label class="pp-contact__field">
                <span>E-mail</span>
                <input type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
              </label>
            </div>
            <div class="pp-contact__row">
              <label class="pp-contact__field">
                <span>Sujet</span>
                <select name="contact[sujet]">
                  <option>Un produit</option>
                  <option>Ma commande</option>
                  <option>Un retour, l'essai 30 nuits</option>
                  <option>Autre</option>
                </select>
              </label>
              <label class="pp-contact__field">
                <span>N° de commande <em>(facultatif)</em></span>
                <input type="text" name="contact[commande]" placeholder="#1001">
              </label>
            </div>
            <label class="pp-contact__field">
              <span>Votre message</span>
              <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
            </label>
            <button type="submit" class="pp-contact__submit">Envoyer le message</button>
            <p class="pp-contact__fine">Vos informations servent uniquement à vous répondre. <a href="/pages/confidentialite-et-cookies">Confidentialité</a></p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-pp-open-assistant]');
    if (!b) return;
    var t = document.querySelector('[data-pp-dock-toggle]');
    if (t && t.getAttribute('aria-expanded') !== 'true') t.click();
  });
</script>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Contact" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une question ? On vous répond." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un produit, une commande, un retour : écrivez-nous. Une vraie personne vous répond, en français.</p>" },
    { "type": "text", "id": "email", "label": "E-mail affiché", "info": "Vide : l'e-mail de la boutique." },
    { "type": "text", "id": "promise", "label": "Engagement de réponse", "default": "Réponse sous 24 h ouvrées" },
    { "type": "text", "id": "quick_title", "label": "Titre des réponses rapides", "default": "Les réponses aux questions les plus fréquentes" },
    { "type": "text", "id": "form_title", "label": "Titre du formulaire", "default": "Écrivez-nous" },
    { "type": "text", "id": "success_text", "label": "Message après envoi", "default": "Nous vous répondons par e-mail sous 24 h ouvrées. Pensez à regarder dans vos courriers indésirables." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Réponse rapide",
      "settings": [
        { "type": "text", "id": "label", "label": "Question", "default": "Où en est ma commande ?" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [ { "name": "Contact" } ]
}
{% endschema %}
