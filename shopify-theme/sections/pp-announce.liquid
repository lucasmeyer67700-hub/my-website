{%- comment -%}
  Barre d'annonce premium : les messages se succèdent automatiquement (glissement
  vertical en fondu), sans flèches. Pause au survol ; sans animation si le visiteur
  a demandé à réduire les animations (les messages défilent alors simplement).
{%- endcomment -%}
<div class="pp-announce" role="region" aria-label="Annonces">
  <pp-announce class="pp-announce__inner page-width" data-interval="{{ section.settings.interval | times: 1000 }}">
    {%- for block in section.blocks -%}
      {%- capture inner -%}
        {%- if block.settings.icon != 'none' -%}<span class="pp-announce__icon">{% render 'pp-icon', icon: block.settings.icon %}</span>{%- endif -%}
        <span class="pp-announce__text">{{ block.settings.text }}</span>
        {%- if block.settings.link != blank -%}<span class="pp-announce__arrow" aria-hidden="true">→</span>{%- endif -%}
      {%- endcapture -%}
      {%- if block.settings.link != blank -%}
        <a class="pp-announce__item{% if forloop.first %} is-active{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ inner }}</a>
      {%- else -%}
        <p class="pp-announce__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>{{ inner }}</p>
      {%- endif -%}
    {%- endfor -%}
  </pp-announce>
</div>

<script>
  if (!customElements.get('pp-announce')) {
    customElements.define('pp-announce', class extends HTMLElement {
      connectedCallback() {
        this.items = [...this.querySelectorAll('.pp-announce__item')];
        if (this.items.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.i = 0;
        this.items.forEach((el, n) => { if (n) el.setAttribute('aria-hidden', 'true'); });
        const start = () => { clearInterval(this.t); this.t = setInterval(() => this.next(), +this.dataset.interval || 4000); };
        this.addEventListener('mouseenter', () => clearInterval(this.t));
        this.addEventListener('mouseleave', start);
        this.addEventListener('focusin', () => clearInterval(this.t));
        this.addEventListener('focusout', start);
        start();
      }
      next() {
        const cur = this.items[this.i];
        this.i = (this.i + 1) % this.items.length;
        const nxt = this.items[this.i];
        cur.classList.remove('is-active');
        cur.classList.add('is-leaving');
        cur.setAttribute('aria-hidden', 'true');
        nxt.classList.add('is-active');
        nxt.removeAttribute('aria-hidden');
        setTimeout(() => cur.classList.remove('is-leaving'), 700);
      }
    });
  }
</script>

{% schema %}
{
  "name": "Barre d'annonce animée",
  "tag": "div",
  "class": "pp-announce-section",
  "settings": [
    { "type": "range", "id": "interval", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Durée de chaque message", "default": 4 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "select", "id": "icon", "label": "Icône", "default": "none", "options": [
          { "value": "none", "label": "Aucune" },
          { "value": "truck", "label": "Livraison" },
          { "value": "moon", "label": "Nuit" },
          { "value": "gift", "label": "Cadeau" },
          { "value": "star", "label": "Étoile" },
          { "value": "lock", "label": "Paiement" },
          { "value": "check", "label": "Coche" }
        ] }
      ]
    }
  ],
  "presets": [ { "name": "Barre d'annonce animée" } ]
}
{% endschema %}
