{%- comment -%}
  Vitrine produits en mosaïque : un produit vedette en grand (photo en situation),
  les autres en cartes. Animations : apparition en cascade au défilement, survol
  avec élévation, zoom doux du visuel, reflet lumineux et flèche qui glisse.
  Sans photo produit, une illustration vectorielle adaptée au type est affichée.
{%- endcomment -%}
{% render 'pp-padding', section: section %}

{%- assign featured = section.settings.featured_product -%}
{%- assign source = section.settings.collection -%}

<div
  id="{{ section.settings.anchor | default: 'produits' | handleize }}"
  class="pp-products pp-anchor color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pp-heading pp-heading--center pp-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<div class="pp-heading__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="pp-products__grid{% if featured != blank %} pp-products__grid--featured{% endif %}">
      {%- if featured != blank -%}
        {%- assign v = featured.selected_or_first_available_variant -%}
        <a class="pp-pcard pp-pcard--hero pp-reveal" href="{{ featured.url }}" style="--d: 0">
          <span class="pp-pcard__media">
            {%- assign hero_img = section.settings.featured_image | default: featured.featured_image -%}
            {%- if hero_img != blank -%}
              {{ hero_img | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1600, 2000', class: 'pp-pcard__img', alt: featured.title }}
            {%- else -%}
              <span class="pp-pcard__illu">{% render 'pp-illustration', name: 'pillow', uid: 'feat' %}</span>
            {%- endif -%}
          </span>
          <span class="pp-pcard__overlay">
            {%- if v.compare_at_price > v.price -%}
              <span class="pp-pcard__badge">Économisez {{ v.compare_at_price | minus: v.price | money }}</span>
            {%- elsif section.settings.featured_badge != blank -%}
              <span class="pp-pcard__badge">{{ section.settings.featured_badge }}</span>
            {%- endif -%}
            <span class="pp-pcard__title">{{ featured.title }}</span>
            {%- if section.settings.featured_text != blank -%}
              <span class="pp-pcard__desc">{{ section.settings.featured_text }}</span>
            {%- endif -%}
            <span class="pp-pcard__foot">
              <span class="pp-pcard__price">
                {{ v.price | money }}
                {%- if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif -%}
              </span>
              <span class="pp-pcard__cta">Découvrir <span class="pp-pcard__arrow" aria-hidden="true">→</span></span>
            </span>
          </span>
        </a>
      {%- endif -%}

      {%- assign shown = 0 -%}
      {%- for p in source.products -%}
        {%- if featured != blank and p.id == featured.id -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        <a class="pp-pcard pp-reveal" href="{{ p.url }}" style="--d: {{ shown }}">
          <span class="pp-pcard__media">
            {%- if p.featured_image != blank -%}
              {{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 900', class: 'pp-pcard__img', alt: p.featured_image.alt | default: p.title }}
            {%- else -%}
              <span class="pp-pcard__illu">
                {%- if p.type == 'Coussin' -%}
                  {% render 'pp-illustration', name: 'knee', uid: p.id %}
                {%- else -%}
                  {% render 'pp-illustration', name: 'pillow', uid: p.id %}
                {%- endif -%}
              </span>
            {%- endif -%}
            {%- if v.compare_at_price > v.price -%}
              <span class="pp-pcard__badge pp-pcard__badge--float">−{{ v.compare_at_price | minus: v.price | money }}</span>
            {%- elsif p.tags contains 'le-plus-choisi' -%}
              <span class="pp-pcard__badge pp-pcard__badge--float">Le plus choisi</span>
            {%- endif -%}
          </span>
          <span class="pp-pcard__body">
            <span class="pp-pcard__type">{{ p.type }}</span>
            <span class="pp-pcard__title">{{ p.title }}</span>
            {%- assign color_option = p.options_with_values | where: 'name', 'Coloris' | first -%}
            {%- unless color_option -%}{%- assign color_option = p.options_with_values | first -%}{%- endunless -%}
            {%- if color_option and color_option.values.size > 1 -%}
              <span class="pp-pcard__swatches" aria-label="{{ color_option.values.size }} coloris">
                {%- for value in color_option.values -%}
                  {%- liquid
                    case value
                      when 'Gris perle'
                        assign sw = '#D9DCE1'
                      when 'Gris anthracite'
                        assign sw = '#3A3D44'
                      when 'Bleu ardoise'
                        assign sw = '#4A5D78'
                      when 'Vert sauge'
                        assign sw = '#9AAE98'
                      else
                        assign sw = '#C9CDD3'
                    endcase
                  -%}
                  <span class="pp-pcard__swatch" style="--sw: {{ sw }}" title="{{ value }}"></span>
                {%- endfor -%}
              </span>
            {%- endif -%}
            <span class="pp-pcard__foot">
              <span class="pp-pcard__price">
                {{ v.price | money }}
                {%- if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif -%}
              </span>
              <span class="pp-pcard__cta">Voir <span class="pp-pcard__arrow" aria-hidden="true">→</span></span>
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_all and source != blank -%}
      <div class="pp-products__all pp-reveal">
        <a class="button button--secondary" href="{{ source.url }}">Voir toute la collection</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vitrine produits",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (lien #...)", "default": "produits" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La collection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos essentiels du sommeil" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Nombre de cartes", "default": 4 },
    { "type": "header", "content": "Produit vedette (grande carte)" },
    { "type": "product", "id": "featured_product", "label": "Produit" },
    { "type": "image_picker", "id": "featured_image", "label": "Photo en situation" },
    { "type": "text", "id": "featured_badge", "label": "Badge (si pas de réduction)" },
    { "type": "text", "id": "featured_text", "label": "Accroche" },
    { "type": "checkbox", "id": "show_all", "label": "Bouton « Voir toute la collection »", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 88 }
  ],
  "presets": [ { "name": "Vitrine produits" } ]
}
{% endschema %}
