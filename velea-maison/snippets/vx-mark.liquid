{%- doc -%}
  Emblème VELEA : un disque chaud traversé d'une bande, comme la ceinture posée sur le ventre.

  @param {string} [uid] - Identifiant unique du dégradé quand l'emblème apparaît plusieurs fois.
  @param {string} [class] - Classe CSS supplémentaire.
{%- enddoc -%}
<svg class="vx-mark {{ class }}" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="vxMarkHeat{{ uid }}" cx="38%" cy="30%" r="75%">
      <stop offset="0" stop-color="#F7D3C4"/>
      <stop offset=".55" stop-color="#E89A93"/>
      <stop offset="1" stop-color="#C8566F"/>
    </radialGradient>
  </defs>
  <circle cx="20" cy="20" r="18" fill="url(#vxMarkHeat{{ uid }})"/>
  <path d="M2.6 22.4c5.4-2.6 11.2-3.9 17.4-3.9s12 1.3 17.4 3.9v4.4c-5.4-2.6-11.2-3.9-17.4-3.9s-12 1.3-17.4 3.9z" fill="#3E1A26"/>
</svg>
