{%- if section.settings.text != blank -%}
  <div class="vx-announce color-{{ section.settings.color_scheme }}">
    <p class="vx-announce__text page-width">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        {{ section.settings.text | escape }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Bandeau",
  "class": "vx-announce-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Livraison offerte en France métropolitaine" },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-5" }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "VELEA · Bandeau" }]
}
{% endschema %}
