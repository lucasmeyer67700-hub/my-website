{%- render 'vx-space' -%}
<section class="vx-faq color-{{ section.settings.color_scheme }} gradient" id="questions">
  <div class="page-width vx-space-{{ section.id }}">
    <div class="vx-faq__grid">
      <div class="vx-faq__head">
        <h2 class="vx-h2">{{ section.settings.title | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="vx-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.settings.contact_label != blank -%}
          <a class="vx-link" href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ section.settings.contact_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="vx-faq__list">
        {%- for block in section.blocks -%}
          <details class="vx-tab" {{ block.shopify_attributes }}>
            <summary class="vx-tab__summary"><span>{{ block.settings.question | escape }}</span>{%- render 'vx-icon', icon: 'plus' -%}</summary>
            <div class="vx-tab__body rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Questions",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Vos questions" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "contact_label", "label": "Lien de contact", "default": "Poser une autre question" },
    { "type": "url", "id": "contact_link", "label": "Adresse du lien" },
    { "type": "checkbox", "id": "schema_markup", "label": "Données structurées FAQ (une seule section par page)", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Combien de temps la porter ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>30 minutes par séance.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "VELEA · Questions", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
