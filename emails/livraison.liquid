"></i><i class="vc" style="width:10px;height:10px;background:#e896a8;border-radius:50%;--x:147px;--y:-140px;--x2:165px;--y2:128px;--r:49deg;--r2:-97deg;animation-duration:2.75s;animation-delay:0.2s;"></i><i class="vc" style="width:9px;height:5px;background:#a14a5c;border-radius:2px;--x:224px;--y:-54px;--x2:251px;--y2:235px;--r:-16deg;--r2:-287deg;animation-duration:2.48s;animation-delay:0.36s;"></i><i class="vc" style="width:7px;height:7px;background:#a14a5c;border-radius:50%;--x:1px;--y:31px;--x2:2px;--y2:240px;--r:-291deg;--r2:-11deg;animation-duration:2.93s;animation-delay:0.27s;"></i><i class="vc" style="width:9px;height:9px;background:#c9727e;border-radius:50%;--x:-100px;--y:64px;--x2:-112px;--y2:382px;--r:-157deg;--r2:-216deg;animation-duration:3.01s;animation-delay:0.35s;"></i><i class="vc" style="width:12px;height:7px;background:#a14a5c;border-radius:2px;--x:-96px;--y:-127px;--x2:-108px;--y2:177px;--r:-468deg;--r2:-124deg;animation-duration:2.57s;animation-delay:0.13s;"></i><i class="vc" style="width:9px;height:7px;background:#a14a5c;border-radius:2px;--x:-235px;--y:16px;--x2:-263px;--y2:198px;--r:-19deg;--r2:-191deg;animation-duration:2.33s;animation-delay:0.14s;"></i><i class="vc" style="width:11px;height:6px;background:#a14a5c;border-radius:2px;--x:86px;--y:-285px;--x2:96px;--y2:29px;--r:-382deg;--r2:-396deg;animation-duration:2.9s;animation-delay:0.15s;"></i><i class="vc" style="width:7px;height:7px;background:#d6a85c;border-radius:50%;--x:-337px;--y:-151px;--x2:-377px;--y2:159px;--r:-199deg;--r2:-307deg;animation-duration:2.73s;animation-delay:0.42s;"></i><i class="vc" style="width:8px;height:8px;background:#f0c4cd;border-radius:50%;--x:-302px;--y:-15px;--x2:-338px;--y2:188px;--r:468deg;--r2:664deg;animation-duration:2.94s;animation-delay:0.38s;"></i><i class="vc" style="width:10px;height:6px;background:#d6a85c;border-radius:2px;--x:201px;--y:1px;--x2:225px;--y2:241px;--r:-19deg;--r2:171deg;animation-duration:2.51s;animation-delay:0.32s;"></i><i class="