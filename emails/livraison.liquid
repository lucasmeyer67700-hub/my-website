{%- comment -%}
  VELEA — e-mail « Colis livré »
  À coller dans Shopify : Paramètres > Notifications > Notifications client >
  Livraison effectuée (« Livrée ») > Modifier le code (remplacer tout le contenu).
  Objet conseillé : Votre colis VELEA est arrivé ✿ commande {{ order_name }}

  Code merci : laisser vide pour ne rien afficher. S'il est rempli, le code
  doit exister dans Shopify > Réductions. Il est offert que la cliente laisse
  un avis ou non (une réduction en échange d'un avis est interdite).
{%- endcomment -%}
{%- assign merci_code = '' -%}
{%- assign merci_text = '−20 % sur votre prochaine commande' -%}
{%- assign merci_until = '' -%}
{%- assign confetti_url = 'https://cdn.shopify.com/s/files/1/1068/3334/6905/files/confettis-velea.gif?v=1795191999' -%}
{%- assign review_email = 'maisonvelea@gmail.com' -%}
{%- assign rose = '#a14a5c' -%}
{%- assign ink = '#2b2422' -%}
{%- assign muted = '#6f6461' -%}
{%- assign blush = '#fbf4f4' -%}
{%- assign line_color = '#f0e2e2' -%}
{%- assign has_belt = false -%}
{%- for line in fulfillment.fulfillment_line_items -%}
  {%- assign t = line.line_item.title | downcase -%}
  {%- if t contains 'ceinture' -%}{%- assign has_belt = true -%}{%- endif -%}
{%- endfor -%}
{%- capture review_subject -%}Mon avis VELEA – commande {{ order_name }}{%- endcapture -%}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <title>Votre colis VELEA est arrivé</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@0;1&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body { margin: 0; padding: 0; background: {{ blush }}; }
    a { color: {{ rose }}; }
    @media (max-width: 600px) {
      .wrap { width: 100% !important; }
      .pad { padding-left: 22px !important; padding-right: 22px !important; }
      .title { font-size: 30px !important; }
      .btn a { display: block !important; }
      .step { font-size: 11px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:{{ blush }};">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Votre colis {{ order_name }} est bien arrivé chez vous. Merci, et à très vite !</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ blush }};">
    <tr>
      <td align="center" style="padding:28px 12px;">
        <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#ffffff;border-radius:18px;overflow:hidden;">

          {%- comment -%} Des confettis qui tombent (image animée, fixe sur les messageries qui ne l'animent pas) {%- endcomment -%}
          <tr>
            <td style="padding:0;line-height:0;font-size:0;">
              <img src="{{ confetti_url }}" alt="" width="600" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
            </td>
          </tr>

          <tr>
            <td align="center" class="pad" style="padding:0 40px 10px;">
              <a href="{{ shop.url }}" style="text-decoration:none;color:{{ ink }};">
                {%- if shop.email_logo_url -%}
                  <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 120 }}" style="display:block;border:0;max-width:180px;height:auto;">
                {%- else -%}
                  <span style="font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:20px;letter-spacing:0.5em;color:{{ ink }};">VELEA</span>
                {%- endif -%}
              </a>
            </td>
          </tr>

          <tr>
            <td align="center" class="pad" style="padding:22px 40px 0;">
              <div style="width:12px;height:12px;margin:0 auto 18px;background:{{ rose }};border-radius:50%;line-height:12px;font-size:1px;">&nbsp;</div>
              <p style="margin:0 0 10px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:{{ rose }};">Commande {{ order_name }}</p>
              <h1 class="title" style="margin:0;font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:36px;line-height:1.1;color:{{ ink }};">
                Votre colis<br><em style="color:{{ rose }};">est arrivé.</em>
              </h1>
              <p style="margin:18px auto 0;max-width:440px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:{{ muted }};">
                {% if customer.first_name %}{{ customer.first_name }}, votre{% else %}Votre{% endif %} colis est bien arrivé chez vous. Merci de votre confiance&nbsp;: on espère que VELEA vous accompagnera en douceur, dès vos prochaines règles.
              </p>
            </td>
          </tr>

          {%- comment -%} Les étapes : tout est fait, « Chez vous » en avant {%- endcomment -%}
          <tr>
            <td class="pad" style="padding:28px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:'DM Sans',Helvetica,Arial,sans-serif;">
                <tr>
                  <td width="33%" align="center" valign="top">
                    <div style="width:14px;height:14px;margin:0 auto;border-radius:50%;background:{{ rose }};font-size:1px;line-height:14px;">&nbsp;</div>
                    <p class="step" style="margin:8px 0 0;font-size:12px;color:{{ ink }};">Commandée</p>
                  </td>
                  <td width="34%" align="center" valign="top">
                    <div style="width:14px;height:14px;margin:0 auto;border-radius:50%;background:{{ rose }};font-size:1px;line-height:14px;">&nbsp;</div>
                    <p class="step" style="margin:8px 0 0;font-size:12px;color:{{ ink }};">Expédiée</p>
                  </td>
                  <td width="33%" align="center" valign="top">
                    <div style="width:20px;height:20px;margin:-3px auto 0;border-radius:50%;background:{{ rose }};color:#ffffff;font-size:12px;line-height:20px;font-weight:500;">&#10003;</div>
                    <p class="step" style="margin:5px 0 0;font-size:12px;font-weight:500;color:{{ rose }};">Chez vous</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {%- comment -%} Conseils de première utilisation (notice du fabricant), seulement avec une ceinture {%- endcomment -%}
          {%- if has_belt -%}
            <tr>
              <td class="pad" style="padding:28px 40px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ blush }};border-radius:14px;">
                  <tr>
                    <td style="padding:20px 22px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.7;color:{{ ink }};">
                      <p style="margin:0 0 8px;font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:{{ rose }};">Pour bien commencer</p>
                      <p style="margin:0;color:{{ muted }};">
                        ✿ Chargez-la complètement avec le câble fourni : voyant rouge pendant la charge, vert quand elle est prête.<br>
                        ✿ Portez-la sur le bas du ventre, par-dessus un vêtement fin, en commençant par la chaleur la plus douce.<br>
                        ✿ Elle s'arrête seule au bout de 30 minutes, par sécurité : faites une pause avant de la relancer.<br>
                        ✿ Ne l'utilisez pas en dormant, et prenez le temps de lire la notice.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          {%- endif -%}

          {%- comment -%} L'avis et les photos {%- endcomment -%}
          <tr>
            <td align="center" class="pad" style="padding:34px 40px 0;">
              <p style="margin:0 0 6px;font-size:22px;line-height:1;letter-spacing:0.12em;color:{{ rose }};">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
              <p style="margin:0;font-family:'Playfair Display',Georgia,serif;font-size:24px;line-height:1.25;color:{{ ink }};">Votre avis compte <em style="color:{{ rose }};">beaucoup.</em></p>
              <p style="margin:14px auto 0;max-width:440px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:{{ muted }};">
                Dans quelques jours, quand vous l'aurez essayée, dites-nous ce que vous en pensez&nbsp;: ce qui vous plaît, ce qui pourrait être mieux. Votre retour aide d'autres femmes à choisir, et nous aide à progresser.
              </p>
            </td>
          </tr>
          <tr>
            <td class="pad" style="padding:20px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid {{ line_color }};border-radius:14px;">
                <tr>
                  <td style="padding:18px 22px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.7;color:{{ ink }};">
                    <p style="margin:0 0 4px;font-family:'Playfair Display',Georgia,serif;font-size:18px;">Une photo ou une petite vidéo&nbsp;?</p>
                    <p style="margin:0;color:{{ muted }};">Si vous le souhaitez, envoyez-nous une photo ou une courte vidéo de votre ceinture portée (par-dessus un vêtement, c'est parfait). Avec votre accord, nous pourrons la partager sur notre site.</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" class="pad btn" style="padding:24px 40px 0;">
              <a href="mailto:{{ review_email }}?subject={{ review_subject | url_encode | replace: '+', '%20' }}" style="display:inline-block;padding:15px 30px;border-radius:999px;background:{{ rose }};color:#ffffff;text-decoration:none;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:12px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;">Donner mon avis</a>
              <p style="margin:12px auto 0;max-width:420px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:{{ muted }};">Ou répondez simplement à cet e-mail, avec vos photos en pièce jointe.</p>
            </td>
          </tr>

          {%- comment -%} Le merci : seulement si un code est rempli en haut du modèle {%- endcomment -%}
          {%- if merci_code != blank -%}
            <tr>
              <td class="pad" style="padding:28px 40px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ blush }};border-radius:14px;">
                  <tr>
                    <td align="center" style="padding:22px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:{{ ink }};">
                      <p style="margin:0 0 6px;font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:{{ rose }};">Un merci de notre part</p>
                      <p style="margin:0;font-family:'Playfair Display',Georgia,serif;font-size:20px;">{{ merci_text }}</p>
                      <p style="display:inline-block;margin:14px 0 0;padding:10px 22px;border:1.5px dashed {{ rose }};border-radius:10px;font-size:18px;font-weight:500;letter-spacing:0.18em;color:{{ rose }};background:#ffffff;">{{ merci_code }}</p>
                      <p style="margin:12px 0 0;font-size:12px;color:{{ muted }};">À saisir au moment du paiement{% if merci_until != blank %}, valable jusqu'au {{ merci_until }}{% endif %}. Offert que vous laissiez un avis ou non.</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          {%- endif -%}

          <tr>
            <td align="center" class="pad" style="padding:32px 40px 34px;">
              <p style="margin:0;font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:20px;color:{{ ink }};">Vos règles, en douceur.</p>
              <p style="margin:12px auto 0;max-width:420px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.7;color:{{ muted }};">
                En nous envoyant un avis, une photo ou une vidéo, vous acceptez que nous les publiions sur maisonvelea.fr et nos réseaux, avec votre prénom uniquement. Vous pouvez changer d'avis à tout moment en nous écrivant.<br><br>
                Une question ou un souci&nbsp;? Répondez à cet e-mail ou écrivez-nous via la <a href="{{ shop.url }}/pages/contact" style="color:{{ rose }};">page contact</a>. Si la ceinture ne vous convient pas, vous avez 30 jours après réception pour nous la retourner (<a href="{{ shop.url }}/policies/refund-policy" style="color:{{ rose }};">conditions</a>).
              </p>
            </td>
          </tr>
        </table>

        <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;">
          <tr>
            <td align="center" style="padding:22px 20px 8px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.7;color:{{ muted }};">
              <a href="{{ shop.url }}" style="color:{{ muted }};text-decoration:none;letter-spacing:0.3em;">VELEA</a>
              &nbsp;·&nbsp; <a href="https://www.instagram.com/_maisonvelea/" style="color:{{ muted }};">Instagram</a>
              &nbsp;·&nbsp; <a href="{{ shop.url }}/pages/suivi-de-commande" style="color:{{ muted }};">Suivi de commande</a>
              &nbsp;·&nbsp; <a href="{{ shop.url }}/pages/livraison-et-retours" style="color:{{ muted }};">Livraison et retours</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
