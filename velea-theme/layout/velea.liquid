<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#2A1B12">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if template.name == 'index' -%}
    <title>VELEA | Ceinture chauffante menstruelle avec massage vibrant</title>
  {%- else -%}
    <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {%- endif %}
  {%- liquid
    assign seo_desc = page_description
    if template.name == 'index' and seo_desc == blank
      assign seo_desc = 'Ceinture chauffante menstruelle rechargeable avec massage vibrant. Découvrez une nouvelle routine de confort pendant les règles avec VELEA.'
    endif
  -%}
  {% if seo_desc %}<meta name="description" content="{{ seo_desc | escape }}">{% endif %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if seo_desc %}<meta property="og:description" content="{{ seo_desc | escape }}">{% endif %}
  {%- if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500&family=Jost:wght@200;300;400;500;600&display=swap" rel="stylesheet">
  <script>document.documentElement.className += ' js';</script>
  {{ 'velea.css' | asset_url | stylesheet_tag }}
  {{ 'velea-premium.css' | asset_url | stylesheet_tag }}
  {{ 'velea-ui.css' | asset_url | stylesheet_tag }}
  {{ 'velea-chalet.css' | asset_url | stylesheet_tag }}
  {{ 'velea-automne.css' | asset_url | stylesheet_tag }}
  {{ 'velea-v3.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="v-body">
  <div class="v-glow" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
  <div class="v-bubbles" aria-hidden="true">{%- for i in (1..14) -%}<i></i>{%- endfor -%}</div>
  <div class="v-frame" aria-hidden="true"></div>
  <a class="v-skip" href="#contenu">Aller au contenu</a>

  {% sections 'velea-announce-group' %}

  <header class="v-header">
    <div class="v-wrap v-header__inner">
      <div class="v-header__left">
        <button type="button" class="v-icon-btn v-burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="v-drawer" data-drawer-open>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <nav class="v-nav" aria-label="Navigation principale">
          {%- for link in linklists['main-menu'].links -%}
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      </div>
      <a href="{{ routes.root_url }}" class="v-logo" aria-label="{{ shop.name }}, accueil">VELEA</a>
      <div class="v-header__right">
        <button type="button" class="v-icon-btn" aria-label="Rechercher" aria-expanded="false" aria-controls="v-search" data-search-open>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
        </button>
        <a href="{{ routes.cart_url }}" class="v-icon-btn v-cart" aria-label="Panier, {{ cart.item_count }} article(s)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
          {% if cart.item_count > 0 %}<span class="v-cart__count">{{ cart.item_count }}</span>{% endif %}
        </a>
      </div>
    </div>
    <div class="v-search" id="v-search" hidden>
      <form action="{{ routes.search_url }}" method="get" role="search" class="v-wrap v-search__form">
        <input type="hidden" name="type" value="product">
        <label for="v-search-input" class="v-skip-sr">Rechercher</label>
        <input id="v-search-input" type="search" name="q" placeholder="Rechercher sur VELEA" autocomplete="off">
        <button type="submit" class="v-btn v-btn--main">Chercher</button>
        <button type="button" class="v-icon-btn" aria-label="Fermer la recherche" data-search-close>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </form>
    </div>
  </header>

  <div class="v-drawer" id="v-drawer" hidden>
    <div class="v-drawer__backdrop" data-drawer-close></div>
    <nav class="v-drawer__panel" aria-label="Menu">
      <div class="v-drawer__top">
        <span class="v-logo">VELEA</span>
        <button type="button" class="v-icon-btn" aria-label="Fermer le menu" data-drawer-close>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <ul class="v-drawer__links">
        {%- for link in linklists['main-menu'].links -%}
          <li><a href="{{ link.url }}" data-drawer-close>{{ link.title }}</a></li>
        {%- endfor -%}
        <li><a href="{{ routes.cart_url }}">Mon panier</a></li>
      </ul>
      {%- assign main_product = all_products['ceinture-chauffante-regles'] -%}
      <a href="{{ main_product.url | default: routes.all_products_collection_url }}" class="v-btn v-btn--main v-btn--full">Découvrir la ceinture</a>
    </nav>
  </div>

  <main id="contenu" class="v-main">
    {{ content_for_layout }}
  </main>

  <footer class="v-footer">
    <div class="v-wrap v-footer__grid">
      <div>
        <p class="v-logo v-logo--footer">VELEA</p>
        <p class="v-footer__tag">Accessoires de confort pour les jours de règles.</p>
      </div>
      {%- assign footer_menus = 'pied-de-page-aide,pied-de-page-legal' | split: ',' -%}
      {%- for handle in footer_menus -%}
        {%- assign menu = linklists[handle] -%}
        {%- if menu.links.size > 0 -%}
          <div>
            <p class="v-footer__title">{{ menu.title | remove: 'Pied de page – ' }}</p>
            <ul>
              {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
      <div>
        <p class="v-footer__title">Paiement sécurisé</p>
        <ul class="v-pay" aria-label="Moyens de paiement acceptés">
          {% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}
        </ul>
      </div>
    </div>
    {%- if localization.available_languages.size > 1 -%}
      <div class="v-wrap v-lang">
        {%- form 'localization', id: 'v-lang-form', class: 'v-lang__form' -%}
          <span class="v-lang__label" id="v-lang-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/></svg>
            Langue
          </span>
          <ul class="v-lang__list" role="list" aria-labelledby="v-lang-label">
            {%- for language in localization.available_languages -%}
              <li><button type="submit" name="language_code" value="{{ language.iso_code }}" class="v-lang__btn{% if language.iso_code == localization.language.iso_code %} is-current{% endif %}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} aria-current="true"{% endif %}>{{ language.endonym_name | capitalize }}</button></li>
            {%- endfor -%}
          </ul>
        {%- endform -%}
      </div>
    {%- endif -%}
    <p class="v-wrap v-footer__legal">© {{ 'now' | date: '%Y' }} VELEA. Tous droits réservés.</p>
  </footer>

  <script src="{{ 'velea.js' | asset_url }}" defer></script>
</body>
</html>
