<section class="v-section v-section--coquille v-final">
  <div class="v-heat" aria-hidden="true"></div>
  <div class="v-wrap v-final__inner v-reveal">
    <h2 class="v-h2">{{ section.settings.title }}</h2>
    <p class="v-lead">{{ section.settings.text }}</p>
    <a href="#ceinture" class="v-btn v-btn--main">{{ section.settings.cta }}</a>
  </div>
</section>

{% schema %}
{
  "name": "VELEA · Dernier appel",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Le mois prochain, ce sera différent." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Commande aujourd'hui, et garde-la près de toi pour tes prochaines règles." },
    { "type": "text", "id": "cta", "label": "Bouton", "default": "Commander ma ceinture" }
  ],
  "presets": [{ "name": "VELEA · Dernier appel" }]
}
{% endschema %}
