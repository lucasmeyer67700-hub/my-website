<section class="v-section v-section--coquille v-final">
  <div class="v-heat" aria-hidden="true"></div>
  <div class="v-wrap v-final__inner v-reveal">
    <h2 class="v-h2">{{ section.settings.title }}</h2>
    <p class="v-lead">{{ section.settings.text }}</p>
    {%- assign fp = section.settings.product | default: all_products['ceinture-chauffante-regles'] -%}
    <a href="{{ section.settings.link | default: fp.url }}" class="v-btn v-btn--main">{{ section.settings.cta }}</a>
  </div>
</section>

{% schema %}
{
  "name": "VELEA · Dernier appel",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Prête pour votre prochaine routine de confort ?" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Découvrez la ceinture chauffante avec massage vibrant." },
    { "type": "text", "id": "cta", "label": "Bouton", "default": "Découvrir la ceinture" },
    { "type": "product", "id": "product", "label": "Produit lié au bouton" },
    { "type": "url", "id": "link", "label": "Lien du bouton (remplace le produit)" }
  ],
  "presets": [{ "name": "VELEA · Dernier appel" }]
}
{% endschema %}
