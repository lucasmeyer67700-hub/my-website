{%- comment -%}
  Avis clients. N'ajoutez que de vrais avis (Code de la consommation, art. L121-4) :
  la section reste invisible pour les visiteurs tant qu'elle ne contient aucun avis.
{%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
  {%- render 'vl-padding' -%}
  <section class="vl-reviews color-{{ section.settings.color_scheme }} gradient" id="{{ section.settings.anchor | default: 'avis' | handle }}">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="vl-heading vl-heading--center">
        {%- if section.settings.eyebrow != blank %}<p class="vl-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
        <h2 class="h1">{{ section.settings.title | escape }}</h2>
      </div>
      {%- if section.blocks.size == 0 -%}
        <p class="vl-reviews__empty">Ajoutez ici les avis de vos clientes (blocs « Avis »). Cette section est masquée en boutique tant qu'elle est vide.</p>
      {%- else -%}
        <ul class="vl-reviews__grid" role="list">
          {%- for block in section.blocks -%}
            <li class="vl-review" {{ block.shopify_attributes }}>
              <p class="vl-review__stars" aria-label="{{ block.settings.rating }} sur 5">
                {%- for i in (1..5) -%}<span class="{% if i <= block.settings.rating %}is-on{% endif %}">★</span>{%- endfor -%}
              </p>
              <blockquote class="vl-review__text">« {{ block.settings.text | escape }} »</blockquote>
              <p class="vl-review__author">
                <strong>{{ block.settings.author | escape }}</strong>
                {%- if block.settings.detail != blank %} · {{ block.settings.detail | escape }}{% endif -%}
              </p>
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.source_note != blank %}<p class="vl-reviews__note">{{ section.settings.source_note | escape }}</p>{% endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Avis clients",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Uniquement des avis réels de clientes. La section est masquée tant qu'il n'y a aucun avis." },
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "avis" },
    { "type": "text", "id": "eyebrow", "label": "Petit titre", "default": "Elles l'ont adoptée" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce qu'elles en disent" },
    { "type": "textarea", "id": "source_note", "label": "Origine des avis", "info": "Indiquez d'où viennent les avis et s'ils sont vérifiés." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "text", "id": "author", "label": "Prénom (ou initiale)" },
        { "type": "text", "id": "detail", "label": "Détail (ville, date…)" },
        { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Avis" }
      ]
    }
  ],
  "presets": [{ "name": "VELEA · Avis clients" }]
}
{% endschema %}
