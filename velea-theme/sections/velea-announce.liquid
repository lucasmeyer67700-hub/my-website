{%- liquid
  assign msgs = section.blocks | map: 'settings' | map: 'text' | compact
-%}
{%- if section.blocks.size > 0 -%}
<div class="v-announce" role="region" aria-label="Annonce">
  <p class="v-skip-sr">{{ msgs | join: ' · ' }}</p>
  <div class="v-announce__track" aria-hidden="true">
    {%- for i in (1..6) -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a class="v-announce__item" href="{{ block.settings.link }}" tabindex="-1" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
        {%- else -%}
          <span class="v-announce__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Barre d'annonce",
  "max_blocks": 4,
  "blocks": [{
    "type": "message", "name": "Message",
    "settings": [
      { "type": "text", "id": "text", "label": "Texte", "default": "Découvrez une nouvelle routine de confort pendant les règles" },
      { "type": "url", "id": "link", "label": "Lien (facultatif)" }
    ]
  }],
  "default": { "blocks": [{ "type": "message" }] }
}
{% endschema %}
