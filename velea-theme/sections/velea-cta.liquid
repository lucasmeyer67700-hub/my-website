{%- assign p = section.settings.product | default: all_products['ceinture-chauffante-regles'] -%}
<section class="v-ctaband">
  <a class="v-ctaband__link" href="{{ section.settings.link | default: p.url }}">
    <span class="v-ctaband__note">{{ section.settings.note }}</span>
    <svg class="v-ctaband__arrow" width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M14 34 34 14M18 14h16v16"/></svg>
    <span class="v-ctaband__word">{{ section.settings.word }}</span>
  </a>
</section>

{% schema %}
{
  "name": "VELEA · Grand bouton",
  "settings": [
    { "type": "text", "id": "word", "label": "Mot", "default": "Commander" },
    { "type": "text", "id": "note", "label": "Phrase", "default": "Livraison suivie en 5 à 10 jours ouvrés, retours sous 14 jours." },
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "VELEA · Grand bouton" }]
}
{% endschema %}
