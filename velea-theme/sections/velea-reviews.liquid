{%- if section.blocks.size > 0 or request.design_mode or section.settings.examples -%}
<section id="avis" class="v-section v-reviews">
  <div class="v-wrap">
    <div class="v-section__head v-section__head--center v-reveal">
      {%- if section.settings.kicker != blank -%}<p class="v-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="v-h2">{{ section.settings.title }}</h2>
    </div>
    {%- if section.settings.show_summary and section.settings.count > 0 -%}
      {%- assign pct = section.settings.rating | times: 20 -%}
      <div class="v-rsum v-reveal" data-rsum>
        <div class="v-rsum__score">
          <p class="v-rsum__big"><span data-count-to="{{ section.settings.rating }}" data-decimals="1">{{ section.settings.rating }}</span><small>/5</small></p>
          <div class="v-rsum__stars" role="img" aria-label="{{ section.settings.rating }} sur 5"><span class="v-rsum__fill" style="--w: {{ pct }}%">★★★★★</span>★★★★★</div>
          <p class="v-rsum__count"><span data-count-to="{{ section.settings.count }}">{{ section.settings.count }}</span> avis</p>
          <p class="v-rsum__src"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg>{{ section.settings.source }}</p>
        </div>
        <ul class="v-rsum__bars">
          {%- for n in (1..3) -%}
            {%- capture lk -%}crit_{{ n }}_label{%- endcapture -%}
            {%- capture vk -%}crit_{{ n }}_value{%- endcapture -%}
            {%- if section.settings[lk] != blank -%}
              <li><span class="v-rsum__lbl">{{ section.settings[lk] }}</span><span class="v-rsum__bar"><i style="--w: {{ section.settings[vk] }}%"></i></span><b>{{ section.settings[vk] }} %</b></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    <div class="v-reviews__track">
      {%- if section.blocks.size == 0 and section.settings.examples -%}
        {%- for i in (1..3) -%}
          <figure class="v-review v-review--example v-reveal">
            <span class="v-review__tag">Exemple</span>
            <div class="v-review__stars" aria-hidden="true"><span class="is-on">★</span><span class="is-on">★</span><span class="is-on">★</span><span class="is-on">★</span><span class="is-on">★</span></div>
            <div class="v-slot v-review__slot"><div class="v-slot__label"><span>Photo de la cliente</span></div></div>
            <blockquote>Emplacement pour l'avis d'une cliente : son ressenti, en deux ou trois phrases.</blockquote>
            <figcaption><strong>Prénom N.</strong><span class="v-review__badge">Acheteuse vérifiée</span></figcaption>
          </figure>
        {%- endfor -%}
      {%- endif -%}
      {%- for block in section.blocks -%}
        <figure class="v-review v-reveal" {{ block.shopify_attributes }}>
          <div class="v-review__stars" role="img" aria-label="{{ block.settings.rating }} sur 5">
            {%- for i in (1..5) -%}<span class="{% if i <= block.settings.rating %}is-on{% endif %}">★</span>{%- endfor -%}
          </div>
          {%- if block.settings.photo != blank -%}{{ block.settings.photo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'v-review__photo', alt: '' }}{%- endif -%}
          <blockquote>{{ block.settings.text }}</blockquote>
          <figcaption>
            <strong>{{ block.settings.name }}</strong>
            {%- if block.settings.verified -%}<span class="v-review__badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>Acheteuse vérifiée</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Avis clientes",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petite phrase", "default": "Elles l'ont adoptée" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Avis clientes" },
    { "type": "header", "content": "Résumé des notes" },
    { "type": "checkbox", "id": "show_summary", "label": "Afficher le résumé", "default": true },
    { "type": "text", "id": "rating", "label": "Note moyenne (ex. 4.7)", "default": "4.7" },
    { "type": "number", "id": "count", "label": "Nombre d'avis", "default": 394 },
    { "type": "text", "id": "source", "label": "Origine des avis (obligatoire, affichée)", "default": "Avis d'acheteurs vérifiés recueillis sur AliExpress pour ce modèle" },
    { "type": "text", "id": "crit_1_label", "label": "Critère 1", "default": "Facilité d'utilisation" },
    { "type": "range", "id": "crit_1_value", "label": "Critère 1 (%)", "min": 0, "max": 100, "step": 1, "default": 72 },
    { "type": "text", "id": "crit_2_label", "label": "Critère 2", "default": "Confort" },
    { "type": "range", "id": "crit_2_value", "label": "Critère 2 (%)", "min": 0, "max": 100, "step": 1, "default": 73 },
    { "type": "text", "id": "crit_3_label", "label": "Critère 3", "default": "Chaleur efficace" },
    { "type": "range", "id": "crit_3_value", "label": "Critère 3 (%)", "min": 0, "max": 100, "step": 1, "default": 56 },
    { "type": "checkbox", "id": "examples", "label": "Afficher des cartes d'exemple (à décocher avant la mise en ligne)", "default": false }
  ],
  "blocks": [{
    "type": "review", "name": "Avis",
    "settings": [
      { "type": "paragraph", "content": "Uniquement de vrais avis de clientes ayant acheté le produit." },
      { "type": "text", "id": "name", "label": "Prénom et initiale", "default": "Prénom N." },
      { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Avis" },
      { "type": "checkbox", "id": "verified", "label": "Achat vérifié (commande retrouvée)", "default": false },
      { "type": "image_picker", "id": "photo", "label": "Photo de la cliente (facultatif)" }
    ]
  }],
  "presets": [{ "name": "VELEA · Avis clientes" }]
}
{% endschema %}
