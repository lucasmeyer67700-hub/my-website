<section class="v-section v-section--blanc">
  <div class="v-wrap">
    <div class="v-section__head v-section__head--center v-reveal">
      <h2 class="v-h2">{{ section.settings.title }}</h2>
      <p class="v-lead v-muted">{{ section.settings.text }}</p>
    </div>
    <div class="v-benefits v-reveal">
      {%- for block in section.blocks -%}
        <div class="v-benefit" {{ block.shopify_attributes }}>
          <div class="v-benefit__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'heat' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 4c-1.5 2 1.5 3.5 0 6M12 4c-1.5 2 1.5 3.5 0 6M16 4c-1.5 2 1.5 3.5 0 6"/><path d="M4 14h16v2a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/></svg>
              {%- when 'wave' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 12c2-3 4-3 6 0s4 3 6 0 4-3 6 0"/><path d="M3 17c2-3 4-3 6 0s4 3 6 0 4-3 6 0" opacity=".5"/></svg>
              {%- when 'battery' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="7" width="16" height="10" rx="2"/><path d="M21 11v2M7 10v4M11 10v4"/></svg>
              {%- when 'feather' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 4C11 4 6 9 6 18l-2 2"/><path d="M6 18c7 0 12-5 14-14"/></svg>
              {%- when 'leaf' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 19C5 10 10 5 20 5c0 10-5 15-14 15"/><path d="M5 19 13 11"/></svg>
              {%- else -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="v-h3">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VELEA · Bénéfices",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Pensée pour ton corps, pas pour un tiroir." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Tout ce qu'une bouillotte ne fait pas : elle te suit partout et garde la bonne température." }
  ],
  "blocks": [{
    "type": "benefit", "name": "Bénéfice",
    "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "options": [
        { "value": "heat", "label": "Chaleur" }, { "value": "wave", "label": "Massage" }, { "value": "battery", "label": "Batterie" },
        { "value": "feather", "label": "Légèreté" }, { "value": "leaf", "label": "Naturel" }, { "value": "clock", "label": "Temps" } ], "default": "heat" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Chaleur douce" },
      { "type": "textarea", "id": "text", "label": "Texte", "default": "Plusieurs niveaux pour trouver la température qui te fait du bien." }
    ]
  }],
  "presets": [{ "name": "VELEA · Bénéfices" }]
}
{% endschema %}
