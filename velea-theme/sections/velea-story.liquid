<section class="v-section v-section--coquille v-story">
  <div class="v-wrap v-story__grid">
    <div class="v-reveal">
      <h2 class="v-h2" style="margin-bottom:22px">{{ section.settings.title }}</h2>
      <p class="v-story__quote">{{ section.settings.quote }}</p>
      <p class="v-lead">{{ section.settings.text }}</p>
      <ul class="v-story__list">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
      </ul>
    </div>
    {% render 'velea-slot', image: section.settings.image, label: 'Photo : une femme adulte dans un intérieur confortable', sizes: '(min-width: 900px) 45vw, 100vw' %}
  </div>
</section>

{% schema %}
{
  "name": "VELEA · La douleur",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Ces jours-là, on a besoin de douceur." },
    { "type": "textarea", "id": "quote", "label": "Phrase forte", "default": "Chaque mois, le corps demande un peu plus d'attention." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Une ceinture chauffante rechargeable pour s'accorder un moment de confort, à la maison ou ailleurs." },
    { "type": "image_picker", "id": "image", "label": "Photo (carrée)" }
  ],
  "blocks": [{ "type": "line", "name": "Situation", "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Situation" }] }],
  "presets": [{ "name": "VELEA · La douleur" }]
}
{% endschema %}
