{%- liquid
  assign on_product_page = false
  if product != blank
    assign on_product_page = true
  endif
  assign p = product | default: section.settings.product
  if p == blank
    assign p = collections.all.products.first
  endif
  assign v = p.selected_or_first_available_variant
  assign media_limit = section.settings.media_limit
  assign images = p.media | where: 'media_type', 'image'
-%}
<section id="{{ section.settings.anchor | default: 'ceinture' }}" class="v-section v-section--coquille v-buy" aria-labelledby="buy-title-{{ section.id }}">
  <div class="v-wrap v-buy__grid">
    <div class="v-gallery" data-gallery>
      {%- if images.size > 0 -%}
        <div class="v-gallery__track" data-gallery-track tabindex="0" aria-label="Photos du produit">
          {%- for media in images limit: media_limit -%}
            {%- assign media_alt = media.alt | default: p.title -%}
            {%- if forloop.first and on_product_page -%}{%- assign media_ld = 'eager' -%}{%- else -%}{%- assign media_ld = 'lazy' -%}{%- endif -%}
            <figure class="v-gallery__slide v-slot">
              {{ media.preview_image | image_url: width: 1400 | image_tag: loading: media_ld, sizes: '(min-width: 900px) 480px, 86vw', widths: '400, 600, 800, 1000, 1400', alt: media_alt }}
            </figure>
          {%- endfor -%}
        </div>
        {%- if images.size > 1 and media_limit > 1 -%}
          <div class="v-gallery__thumbs" role="group" aria-label="Choisir une photo">
            {%- for media in images limit: media_limit -%}
              <button type="button" class="v-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="Afficher la photo {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        {% render 'velea-slot', class: 'v-gallery__main', label: 'Photo produit : la ceinture rose seule sur fond clair', sizes: '480px' %}
      {%- endif -%}
    </div>

    <div class="v-buy__panel">
      {%- if on_product_page -%}
        <h1 id="buy-title-{{ section.id }}" class="v-h2">{{ p.title }}</h1>
      {%- else -%}
        <h2 id="buy-title-{{ section.id }}" class="v-h2">{{ section.settings.title | default: p.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="v-muted" style="margin:0">{{ section.settings.subtitle }}</p>{%- endif -%}

      {%- if v -%}
        <div class="v-buy__price">
          <span class="now">{{ v.price | money }}</span>
          {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
        </div>
        <p class="v-buy__tax">{% if shop.taxes_included %}Prix TTC.{% else %}Taxes calculées à l'étape du paiement.{% endif %} Frais de livraison calculés à l'étape du paiement.</p>
      {%- endif -%}

      <ul class="v-buy__points">
        {%- for block in section.blocks -%}
          {%- if block.type == 'point' -%}
            <li {{ block.shopify_attributes }}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>{{ block.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if p != blank -%}
        {%- form 'product', p, id: 'velea-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ v.id }}">
          {%- unless p.has_only_default_variant -%}
            <label class="v-field-label" for="velea-variant-{{ section.id }}">{{ p.options.first }}</label>
            <select id="velea-variant-{{ section.id }}" class="v-select" data-variant-select>
              {%- for variant in p.variants -%}<option value="{{ variant.id }}" {% if variant == v %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} (épuisé){% endunless %}</option>{%- endfor -%}
            </select>
          {%- endunless -%}
          <div class="v-qty-row">
            <div class="v-qty" data-qty>
              <button type="button" data-step="-1" aria-label="Diminuer la quantité">−</button>
              <input type="number" name="quantity" value="1" min="1" max="10" aria-label="Quantité" inputmode="numeric">
              <button type="button" data-step="1" aria-label="Augmenter la quantité">+</button>
            </div>
            <button type="submit" name="add" class="v-btn v-btn--main" data-add-btn {% unless v.available %}disabled{% endunless %}>
              <span>{%- if v.available -%}Ajouter au panier{%- else -%}Temporairement indisponible{%- endif -%}</span>
            </button>
          </div>
          {%- if v.available -%}{{ form | payment_button }}{%- endif -%}
          {%- unless v.available -%}<p class="v-buy__soldout" role="status">Ce produit est temporairement indisponible. Contactez-nous pour connaître la date de retour.</p>{%- endunless -%}
        {%- endform -%}
      {%- endif -%}

      <ul class="v-buy__pay" aria-label="Moyens de paiement acceptés">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
      </ul>

      <ul class="v-infos">
        {%- for block in section.blocks -%}
          {%- if block.type == 'info' -%}
            <li class="v-info" {{ block.shopify_attributes }}>
              <span class="v-info__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                  {%- when 'return' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9h11a5 5 0 0 1 0 10H9"/><path d="m8 5-4 4 4 4"/></svg>
                  {%- when 'lock' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                  {%- when 'shield' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/></svg>
                  {%- else -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h16v10H8l-4 4z"/></svg>
                {%- endcase -%}
              </span>
              <span>
                <strong>{{ block.settings.title }}</strong>
                {%- if block.settings.text != blank -%} {{ block.settings.text }}{%- endif -%}
                {%- if block.settings.link != blank -%} <a href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'En savoir plus' }}</a>{%- endif -%}
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- unless on_product_page -%}
        <a href="{{ p.url }}" class="v-link v-buy__more">Voir la fiche produit complète</a>
      {%- endunless -%}
    </div>
  </div>
</section>

{%- if p != blank and v -%}
<div class="v-sticky" data-sticky>
  <div class="v-sticky__info">
    <strong>{{ p.title }}</strong>
    <span>{{ v.price | money }}</span>
  </div>
  <a href="#{{ section.settings.anchor | default: 'ceinture' }}" class="v-btn v-btn--main">Commander</a>
</div>
{%- endif -%}

{%- if on_product_page -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ p.title | json }},
  "url": {{ request.origin | append: p.url | json }},
  {%- if p.featured_image %}"image": [{{ p.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
  "description": {{ p.description | strip_html | strip_newlines | truncate: 500 | json }},
  {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
  "brand": { "@type": "Brand", "name": {{ p.vendor | default: shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "url": {{ request.origin | append: p.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ v.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "VELEA · Achat",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit (page d'accueil)" },
    { "type": "text", "id": "anchor", "label": "Ancre (lien interne)", "default": "ceinture" },
    { "type": "text", "id": "title", "label": "Titre sur l'accueil (vide = nom du produit)" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Chaleur réglable, massage vibrant et batterie rechargeable" },
    { "type": "range", "id": "media_limit", "label": "Nombre de photos produit affichées", "min": 1, "max": 10, "step": 1, "default": 6 }
  ],
  "blocks": [
    { "type": "point", "name": "Point fort", "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Batterie rechargeable intégrée" }] },
    { "type": "info", "name": "Information de confiance", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "options": [
        { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retour" }, { "value": "lock", "label": "Paiement" },
        { "value": "shield", "label": "Garantie" }, { "value": "chat", "label": "Service client" } ], "default": "truck" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Livraison" },
      { "type": "text", "id": "text", "label": "Texte (uniquement des informations confirmées)" },
      { "type": "url", "id": "link", "label": "Lien" },
      { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "En savoir plus" }
    ] }
  ],
  "presets": [{ "name": "VELEA · Achat" }]
}
{% endschema %}
