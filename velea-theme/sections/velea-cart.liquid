<section class="v-section v-page v-cartpage">
  <div class="v-wrap v-page__wrap">
    <h1 class="v-h2 v-page__title">Votre panier</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="v-cart-form" data-cart-page>
        <ul class="v-cart-list">
          {%- for item in cart.items -%}
            <li class="v-cart-item">
              <a href="{{ item.url }}" class="v-cart-item__img">
                {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}
              </a>
              <div class="v-cart-item__info">
                <a href="{{ item.url }}" class="v-cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="v-muted">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="v-cart-item__price">{{ item.final_line_price | money }}</p>
                <div class="v-cart-item__actions">
                  <div class="v-cd__qty">
                    <button type="button" aria-label="Diminuer" data-cd-line="{{ forloop.index }}" data-cd-qty="{{ item.quantity | minus: 1 }}">−</button>
                    <span>{{ item.quantity }}</span>
                    <button type="button" aria-label="Augmenter" data-cd-line="{{ forloop.index }}" data-cd-qty="{{ item.quantity | plus: 1 }}">+</button>
                  </div>
                  <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                  <button type="button" class="v-cd__remove" data-cd-line="{{ forloop.index }}" data-cd-qty="0">Retirer</button>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="v-cart-summary">
          <p class="v-cart-summary__total"><span>Sous-total</span><strong>{{ cart.total_price | money }}</strong></p>
          <p class="v-muted v-cart-summary__note">{% if shop.taxes_included %}Prix TTC. {% endif %}Frais de livraison calculés à l'étape du paiement.</p>
          <button type="submit" name="checkout" class="v-btn v-btn--main v-btn--full">Passer au paiement</button>
          {%- if additional_checkout_buttons -%}<div class="v-cart-summary__dyn">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        </div>
      </form>
    {%- else -%}
      <div class="v-empty">
        <p>Votre panier est vide.</p>
        {%- assign main_product = all_products['ceinture-chauffante-regles'] -%}
        <a href="{{ main_product.url | default: routes.all_products_collection_url }}" class="v-btn v-btn--main">Découvrir la ceinture</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "VELEA · Panier", "settings": [] }
{% endschema %}
