<section id="{{ section.settings.anchor | default: 'details' }}" class="v-section v-flow">
  <div class="v-wrap">
    <div class="v-section__head v-section__head--center v-reveal">
      {%- if section.settings.kicker != blank -%}<p class="v-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="v-h2">{{ section.settings.title }}</h2>
    </div>
    <ol class="v-flow__list">
      <li class="v-flow__line" aria-hidden="true"><span class="v-flow__arrow"></span></li>
      {%- for block in section.blocks -%}
        <li class="v-flow__node v-reveal" {{ block.shopify_attributes }}>
          <div class="v-flow__media">
            {% render 'velea-slot', image: block.settings.image, label: block.settings.placeholder, sizes: '(min-width: 900px) 360px, 80vw' %}
          </div>
          <div class="v-flow__dot" aria-hidden="true"></div>
          <div class="v-flow__txt">
            <p class="v-flow__key">{{ block.settings.keyword }}</p>
            <h3 class="v-flow__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="v-flow__desc">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "VELEA · Schéma flèche",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "details" },
    { "type": "text", "id": "kicker", "label": "Petite phrase", "default": "En un coup d'œil" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Tout ce qu'elle fait pour vous" }
  ],
  "blocks": [{
    "type": "node", "name": "Étape du schéma",
    "settings": [
      { "type": "text", "id": "keyword", "label": "Mot-clé", "default": "Chaleur" },
      { "type": "text", "id": "title", "label": "Titre court", "default": "3 niveaux" },
      { "type": "text", "id": "text", "label": "Une ligne (facultatif)" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "placeholder", "label": "Texte de l'emplacement vide", "default": "Image à ajouter" }
    ]
  }],
  "presets": [{ "name": "VELEA · Schéma flèche" }]
}
{% endschema %}
