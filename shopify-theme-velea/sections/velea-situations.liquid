{%- comment -%} VELEA : les situations dans lesquelles le client se reconnaît {%- endcomment -%}
<section class="vl-band--beige">
  <div class="vl-wrap">
    <div class="vl-head vl-center">
      <h2 class="vl-h2">{{ section.settings.title }}</h2>
    </div>
    <div class="vl-grid3">
      {%- for block in section.blocks -%}
        <div class="vl-situation" {{ block.shopify_attributes }}>
          {% render 'velea-photo', image: block.settings.image, label: block.settings.photo_label, ratio: '1 / 1', sizes: '(min-width: 990px) 33vw, 100vw' %}
          <p class="vl-situation__q">{{ block.settings.title }}</p>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VELEA situations",
  "max_blocks": 3,
  "settings": [ { "type": "text", "id": "title", "label": "Titre", "default": "Vous vous reconnaissez ?" } ],
  "blocks": [
    { "type": "situation", "name": "Situation", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo (carrée)" },
      { "type": "text", "id": "photo_label", "label": "Description de la photo attendue" },
      { "type": "text", "id": "title", "label": "Phrase" },
      { "type": "textarea", "id": "text", "label": "Texte" }
    ] }
  ],
  "presets": [ { "name": "VELEA situations" } ]
}
{% endschema %}
