{{ 'rituel.css' | asset_url | stylesheet_tag }}
{%- assign m = all_products['masque-led-visage-cou-silicone-souple-sans-fil'] -%}
{%- assign pk = all_products['pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard'] -%}
{%- assign gs = all_products['rouleau-de-jade-amp-gua-sha'] -%}
{%- if m.url != blank -%}{%- assign m_url = m.url -%}{%- else -%}{%- assign m_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if pk.url != blank -%}{%- assign pk_url = pk.url -%}{%- else -%}{%- assign pk_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if gs.url != blank -%}{%- assign gs_url = gs.url -%}{%- else -%}{%- assign gs_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if m.price -%}{%- assign m_price = m.price | money -%}{%- else -%}{%- assign m_price = '107,90 €' -%}{%- endif -%}
{%- if pk.price -%}{%- assign pk_price = pk.price | money -%}{%- else -%}{%- assign pk_price = '144,90 €' -%}{%- endif -%}
{%- if gs.price -%}{%- assign gs_price = gs.price | money -%}{%- else -%}{%- assign gs_price = '34,00 €' -%}{%- endif -%}

<div class="section section--page-width" style="padding-top:20px;padding-bottom:20px">
<div class="rt"><section class="rt-wrap" style="padding-left:0;padding-right:0">
<div class="rt-center"><p class="rt-eyebrow">La boutique</p><h2>Composez <em>votre rituel</em></h2></div>
<div class="rt-grid rt-shop">
<a class="rt-pc" href="{{ m_url }}"><div class="rt-pc__img">{%- if m.featured_image -%}<img src="{{ m.featured_image | image_url: width: 700 }}" alt="{{ m.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 240" fill="none"><path d="M100 8c48 0 82 36 82 92 0 62-36 124-82 124S18 162 18 100C18 44 52 8 100 8z" fill="#fff" stroke="#E7B7BD" stroke-width="4"/><g fill="#E0707E"><circle cx="70" cy="60" r="5"/><circle cx="100" cy="52" r="5"/><circle cx="130" cy="60" r="5"/><circle cx="60" cy="140" r="5"/><circle cx="140" cy="140" r="5"/><circle cx="100" cy="190" r="5"/></g></svg>{%- endif -%}<span class="rt-pc__badge">Best-seller</span></div><div class="rt-pc__body"><h3>Masque LED visage &amp; cou</h3><p>Silicone souple · 7 lumières · sans prise</p><span class="rt-pc__price">{{ m_price }}</span></div></a>
<a class="rt-pc" href="{{ pk_url }}"><div class="rt-pc__img">{%- if pk.featured_image -%}<img src="{{ pk.featured_image | image_url: width: 700 }}" alt="{{ pk.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 200" fill="none"><rect x="30" y="80" width="140" height="100" rx="10" fill="#fff"/><rect x="22" y="60" width="156" height="30" rx="8" fill="#FBEFEC"/><rect x="92" y="60" width="16" height="120" fill="#C47A86"/><path d="M100 60c-10-22-38-26-40-10-2 12 22 12 40 10zM100 60c10-22 38-26 40-10 2 12-22 12-40 10z" fill="#C47A86"/></svg>{%- endif -%}<span class="rt-pc__badge">Coffret</span></div><div class="rt-pc__body"><h3>Coffret masque + lunettes LED</h3><p>La routine complète visage et regard</p><span class="rt-pc__price">{{ pk_price }}</span></div></a>
<a class="rt-pc" href="{{ gs_url }}"><div class="rt-pc__img">{%- if gs.featured_image -%}<img src="{{ gs.featured_image | image_url: width: 700 }}" alt="{{ gs.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 200" fill="none"><path d="M60 150c-20-30 10-90 60-100 30-6 40 20 20 40-14 14-40 20-50 50-4 12-22 22-30 10z" fill="#fff" stroke="#E7B7BD" stroke-width="4"/></svg>{%- endif -%}</div><div class="rt-pc__body"><h3>Gua sha &amp; rouleau</h3><p>Le geste massage du matin</p><span class="rt-pc__price">{{ gs_price }}</span></div></a>
</div>
</section></div>
</div>
