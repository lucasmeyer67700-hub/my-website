{{ 'rituel.css' | asset_url | stylesheet_tag }}
{%- assign m = all_products['masque-led-visage-cou-silicone-souple-sans-fil'] -%}
{%- assign m_ok = false -%}{%- if m.handle == 'masque-led-visage-cou-silicone-souple-sans-fil' -%}{%- assign m_ok = true -%}{%- endif -%}
{%- if m_ok -%}{%- assign m_url = m.url -%}{%- else -%}{%- assign m_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if m_ok -%}{%- assign m_price = m.price | money -%}{%- else -%}{%- assign m_price = '107,90 €' -%}{%- endif -%}
{%- assign pk = all_products['pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard'] -%}
{%- assign pk_ok = false -%}{%- if pk.handle == 'pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard' -%}{%- assign pk_ok = true -%}{%- endif -%}
{%- if pk_ok -%}{%- assign pk_url = pk.url -%}{%- else -%}{%- assign pk_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if pk_ok -%}{%- assign pk_price = pk.price | money -%}{%- else -%}{%- assign pk_price = '144,90 €' -%}{%- endif -%}
{%- assign gs = all_products['rouleau-de-jade-amp-gua-sha'] -%}
{%- assign gs_ok = false -%}{%- if gs.handle == 'rouleau-de-jade-amp-gua-sha' -%}{%- assign gs_ok = true -%}{%- endif -%}
{%- if gs_ok -%}{%- assign gs_url = gs.url -%}{%- else -%}{%- assign gs_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if gs_ok -%}{%- assign gs_price = gs.price | money -%}{%- else -%}{%- assign gs_price = '34,00 €' -%}{%- endif -%}
{%- assign ey = all_products['lunettes-led-regard-lumiere-rouge-contour-des-yeux'] -%}
{%- assign ey_ok = false -%}{%- if ey.handle == 'lunettes-led-regard-lumiere-rouge-contour-des-yeux' -%}{%- assign ey_ok = true -%}{%- endif -%}
{%- if ey_ok -%}{%- assign ey_url = ey.url -%}{%- else -%}{%- assign ey_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if ey_ok -%}{%- assign ey_price = ey.price | money -%}{%- else -%}{%- assign ey_price = '53,90 €' -%}{%- endif -%}
{%- assign sep = 0 -%}{%- if m_ok and ey_ok and pk_ok -%}{%- assign sep = m.price | plus: ey.price | minus: pk.price -%}{%- endif -%}
<div class="section section--page-width" style="padding-top:20px;padding-bottom:20px">
<div class="rt rt-anim" id="rt-rituel"><section class="rt-wrap" style="padding-left:0;padding-right:0">
<div class="rt-center"><p class="rt-eyebrow">Complétez votre rituel</p><h2>Ils accompagnent <em>votre masque</em></h2><p class="rt-lead">Choisissez ce qui vous fait envie : un soin du regard, un geste massage, ou la routine complète.</p></div>
<div class="rt-cmp">
<a class="rt-pc" href="{{ ey_url }}"><div class="rt-pc__img">{%- if ey_ok and ey.featured_image -%}<img src="{{ ey.featured_image | image_url: width: 700 }}" alt="{{ ey.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 120" fill="none" aria-hidden="true"><path d="M10 50c0-20 30-30 90-30s90 10 90 30-30 40-50 40c-18 0-24-16-40-16S78 90 60 90C40 90 10 70 10 50z" fill="#fff" stroke="#E7B7BD" stroke-width="4"/><g fill="#E0707E"><circle cx="45" cy="60" r="4"/><circle cx="60" cy="68" r="4"/><circle cx="75" cy="64" r="4"/><circle cx="125" cy="64" r="4"/><circle cx="140" cy="68" r="4"/><circle cx="155" cy="60" r="4"/></g></svg>{%- endif -%}</div><div class="rt-pc__body"><h3>Lunettes LED regard</h3><p>Lumière rouge douce pour le contour des yeux</p><span class="rt-pc__price">{{ ey_price }}</span><span class="rt-pc__cta">Voir le produit</span></div></a>
<a class="rt-pc rt-pc--hl" href="{{ pk_url }}"><div class="rt-pc__img">{%- if pk_ok and pk.featured_image -%}<img src="{{ pk.featured_image | image_url: width: 700 }}" alt="{{ pk.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 200" fill="none" aria-hidden="true"><rect x="30" y="80" width="140" height="100" rx="10" fill="#fff"/><rect x="22" y="60" width="156" height="30" rx="8" fill="#FBEFEC"/><rect x="92" y="60" width="16" height="120" fill="#C47A86"/><path d="M100 60c-10-22-38-26-40-10-2 12 22 12 40 10zM100 60c10-22 38-26 40-10 2 12-22 12-40 10z" fill="#C47A86"/></svg>{%- endif -%}<span class="rt-pc__badge">Offre premium</span></div><div class="rt-pc__body"><h3>Coffret masque + lunettes</h3><p>La routine complète : visage, cou et regard</p><span class="rt-pc__price">{{ pk_price }}{%- if sep > 0 -%}<span class="rt-pc__old">{{ m.price | plus: ey.price | money }}</span>{%- endif -%}</span><span class="rt-pc__cta">Voir le produit</span></div></a>
<a class="rt-pc" href="{{ gs_url }}"><div class="rt-pc__img">{%- if gs_ok and gs.featured_image -%}<img src="{{ gs.featured_image | image_url: width: 700 }}" alt="{{ gs.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 200" fill="none" aria-hidden="true"><path d="M60 150c-20-30 10-90 60-100 30-6 40 20 20 40-14 14-40 20-50 50-4 12-22 22-30 10z" fill="#fff" stroke="#E7B7BD" stroke-width="4"/></svg>{%- endif -%}</div><div class="rt-pc__body"><h3>Gua sha &amp; rouleau</h3><p>Le geste massage du matin</p><span class="rt-pc__price">{{ gs_price }}</span><span class="rt-pc__cta">Voir le produit</span></div></a>
</div>
{%- if sep > 0 -%}<p class="rt-small" style="text-align:center;margin-top:10px">Prix barré du coffret = prix du masque + prix des lunettes achetés séparément.</p>{%- endif -%}
</section></div>
</div>
{% schema %}
{"name": "RT · Compléments", "settings": [], "presets": [{"name": "RT · Compléments"}]}
{% endschema %}
