{{ 'rituel.css' | asset_url | stylesheet_tag }}
{%- assign m = all_products['masque-led-visage-cou-silicone-souple-sans-fil'] -%}
{%- assign m_ok = false -%}{%- if m.handle == 'masque-led-visage-cou-silicone-souple-sans-fil' -%}{%- assign m_ok = true -%}{%- endif -%}
{%- assign pk = all_products['pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard'] -%}
{%- assign pk_ok = false -%}{%- if pk.handle == 'pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard' -%}{%- assign pk_ok = true -%}{%- endif -%}
{%- if pk_ok -%}{%- assign pk_url = pk.url -%}{%- else -%}{%- assign pk_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if pk_ok -%}{%- assign pk_price = pk.price_min | money -%}{%- else -%}{%- assign pk_price = '139,90 €' -%}{%- endif -%}
{%- assign hf = all_products['stylo-visage-haute-frequence'] -%}
{%- assign hf_ok = false -%}{%- if hf.handle == 'stylo-visage-haute-frequence' -%}{%- assign hf_ok = true -%}{%- endif -%}
{%- if hf_ok -%}{%- assign hf_url = hf.url -%}{%- else -%}{%- assign hf_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if hf_ok -%}{%- assign hf_price = hf.price | money -%}{%- else -%}{%- assign hf_price = '49,90 €' -%}{%- endif -%}
{%- assign ey = all_products['lunettes-led-regard-lumiere-rouge-contour-des-yeux'] -%}
{%- assign ey_ok = false -%}{%- if ey.handle == 'lunettes-led-regard-lumiere-rouge-contour-des-yeux' -%}{%- assign ey_ok = true -%}{%- endif -%}
{%- if ey_ok -%}{%- assign ey_url = ey.url -%}{%- else -%}{%- assign ey_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if ey_ok -%}{%- assign ey_price = ey.price | money -%}{%- else -%}{%- assign ey_price = '53,90 €' -%}{%- endif -%}
{%- comment -%} Coffret au choix : économie réelle = masque + complément achetés séparément − prix de la variante du coffret (la plus grande des deux). {%- endcomment -%}
{%- assign sep = 0 -%}{%- assign ref = 0 -%}{%- assign vmin = 999999999 -%}
{%- if pk_ok and m_ok -%}{%- for v in pk.variants -%}
{%- assign sv = 0 -%}
{%- assign st = 0 -%}
{%- if ey_ok and v.title contains 'Lunettes' -%}{%- assign st = m.price | plus: ey.price -%}{%- endif -%}
{%- if hf_ok and v.title contains 'Stylo' -%}{%- assign st = m.price | plus: hf.price -%}{%- endif -%}
{%- if st > 0 -%}{%- assign sv = st | minus: v.price -%}{%- if v.price < vmin -%}{%- assign vmin = v.price -%}{%- assign ref = st -%}{%- endif -%}{%- endif -%}
{%- if sv > sep -%}{%- assign sep = sv -%}{%- endif -%}
{%- endfor -%}{%- endif -%}
<div class="section section--page-width" style="padding-top:10px;padding-bottom:10px">
<div class="rt rt-anim" id="rt-rituel"><section class="rt-wrap" style="padding-left:0;padding-right:0">
<div class="rt-center"><p class="rt-eyebrow">Complétez votre rituel</p><h2>Ils accompagnent <em>votre masque</em></h2><p class="rt-lead">Choisissez ce qui vous fait envie : un soin du regard, un geste massage, ou la routine complète.</p></div>
<div class="rt-cmp">
<a class="rt-pc" href="{{ ey_url }}"><div class="rt-pc__img">{%- if ey_ok and ey.featured_image -%}<img src="{{ ey.featured_image | image_url: width: 700 }}" srcset="{{ ey.featured_image | image_url: width: 500 }} 500w, {{ ey.featured_image | image_url: width: 900 }} 900w" sizes="(max-width: 989px) 76vw, 33vw" alt="{{ ey.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 120" fill="none" aria-hidden="true"><path d="M10 50c0-20 30-30 90-30s90 10 90 30-30 40-50 40c-18 0-24-16-40-16S78 90 60 90C40 90 10 70 10 50z" fill="#fff" stroke="#E7B7BD" stroke-width="4"/><g fill="#E0707E"><circle cx="45" cy="60" r="4"/><circle cx="60" cy="68" r="4"/><circle cx="75" cy="64" r="4"/><circle cx="125" cy="64" r="4"/><circle cx="140" cy="68" r="4"/><circle cx="155" cy="60" r="4"/></g></svg>{%- endif -%}</div><div class="rt-pc__body"><h3>Lunettes LED regard</h3><p>Micro-massage doux et lumière rouge pour le regard</p><span class="rt-pc__price">{{ ey_price }}</span><span class="rt-pc__cta">Voir le produit</span></div></a>
<a class="rt-pc rt-pc--hl" href="{{ pk_url }}"><div class="rt-pc__img">{%- if pk_ok and pk.featured_image -%}<img src="{{ pk.featured_image | image_url: width: 700 }}" srcset="{{ pk.featured_image | image_url: width: 500 }} 500w, {{ pk.featured_image | image_url: width: 900 }} 900w" sizes="(max-width: 989px) 76vw, 33vw" alt="{{ pk.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 200" fill="none" aria-hidden="true"><rect x="30" y="80" width="140" height="100" rx="10" fill="#fff"/><rect x="22" y="60" width="156" height="30" rx="8" fill="#FBEFEC"/><rect x="92" y="60" width="16" height="120" fill="#C47A86"/><path d="M100 60c-10-22-38-26-40-10-2 12 22 12 40 10zM100 60c10-22 38-26 40-10 2 12-22 12-40 10z" fill="#C47A86"/></svg>{%- endif -%}<span class="rt-pc__badge">Offre premium</span></div><div class="rt-pc__body"><h3>Coffret masque + au choix</h3><p>Le masque LED + les lunettes regard ou le stylo visage</p><span class="rt-pc__price">dès {{ pk_price }}{%- if ref > vmin -%} <s class="rt-pc__ref">{{ ref | money }}</s>{%- endif -%}</span>{%- if sep > 0 -%}<span class="rt-pc__save">Jusqu'à {{ sep | money }} d'économie</span>{%- endif -%}<span class="rt-pc__cta">Je compose mon coffret</span></div></a>
<a class="rt-pc" href="{{ hf_url }}"><div class="rt-pc__img">{%- if hf_ok and hf.featured_image -%}<img src="{{ hf.featured_image | image_url: width: 700 }}" srcset="{{ hf.featured_image | image_url: width: 500 }} 500w, {{ hf.featured_image | image_url: width: 900 }} 900w" sizes="(max-width: 989px) 76vw, 33vw" alt="{{ hf.title | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg viewBox="0 0 200 200" fill="none" aria-hidden="true"><rect x="88" y="30" width="24" height="110" rx="12" fill="#fff" stroke="#E7B7BD" stroke-width="4"/><path d="M92 140h16l-4 30h-8z" fill="#F6C9A0" stroke="#E7A870" stroke-width="3"/><circle cx="100" cy="176" r="6" fill="#F6B27A"/></svg>{%- endif -%}</div><div class="rt-pc__body"><h3>Stylo visage haute fréquence</h3><p>Le geste institut, à la maison</p><span class="rt-pc__price">{{ hf_price }}</span><span class="rt-pc__cta">Voir le produit</span></div></a>
</div>
{%- if sep > 0 -%}<p class="rt-small" style="text-align:center;margin-top:10px">Prix barré et économie : calculés par rapport au masque et au complément achetés séparément sur notre boutique.</p>{%- endif -%}
<style>.rt-pc__ref{font-weight:500;font-size:14px;color:#7A5E63;margin-left:4px}.rt-pc__save{display:inline-block;margin-top:6px;font-size:13px;font-weight:600;color:#94702F}</style>
</section></div>
</div>
{% schema %}
{"name": "RT · Compléments", "settings": [], "presets": [{"name": "RT · Compléments"}]}
{% endschema %}
