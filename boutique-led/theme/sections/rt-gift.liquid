{{ 'rituel.css' | asset_url | stylesheet_tag }}
{%- assign m = all_products['masque-led-visage-cou-silicone-souple-sans-fil'] -%}
{%- assign m_ok = false -%}{%- if m.handle == 'masque-led-visage-cou-silicone-souple-sans-fil' -%}{%- assign m_ok = true -%}{%- endif -%}
{%- assign pk = all_products['pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard'] -%}
{%- assign pk_ok = false -%}{%- if pk.handle == 'pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard' -%}{%- assign pk_ok = true -%}{%- endif -%}
{%- if pk_ok -%}{%- assign pk_url = pk.url -%}{%- else -%}{%- assign pk_url = '/collections/all' -%}{%- endif -%}
{%- if pk_ok -%}{%- assign pk_price = pk.price_min | money -%}{%- else -%}{%- assign pk_price = '104,90 €' -%}{%- endif -%}
{%- assign ey = all_products['lunettes-led-regard-lumiere-rouge-contour-des-yeux'] -%}
{%- assign ey_ok = false -%}{%- if ey.handle == 'lunettes-led-regard-lumiere-rouge-contour-des-yeux' -%}{%- assign ey_ok = true -%}{%- endif -%}
{%- assign hf = all_products['stylo-visage-haute-frequence'] -%}
{%- assign hf_ok = false -%}{%- if hf.handle == 'stylo-visage-haute-frequence' -%}{%- assign hf_ok = true -%}{%- endif -%}
{%- comment -%} Économie réelle maximale (masque + complément achetés séparément − variante du coffret). {%- endcomment -%}
{%- assign sep = 0 -%}{%- assign ref = 0 -%}{%- assign vmin = 999999999 -%}
{%- if pk_ok and m_ok -%}{%- for v in pk.variants -%}
{%- assign sv = 0 -%}
{%- assign st = 0 -%}
{%- if ey_ok and v.title contains 'Lunettes' -%}{%- assign st = m.price | plus: ey.price -%}{%- endif -%}
{%- if hf_ok and v.title contains 'Stylo' -%}{%- assign st = m.price | plus: hf.price -%}{%- endif -%}
{%- if st > 0 -%}{%- assign sv = st | minus: v.price -%}{%- if v.price < vmin -%}{%- assign vmin = v.price -%}{%- assign ref = st -%}{%- endif -%}{%- endif -%}
{%- if sv > sep -%}{%- assign sep = sv -%}{%- endif -%}
{%- endfor -%}{%- endif -%}
<div class="section section--page-width" style="padding-top:10px;padding-bottom:10px">
<div class="rt rt-anim"><section class="rt-wrap rt-gift">
<div>
<p class="rt-eyebrow">Le coffret</p>
<h2>Le coffret <em>Rituel Éclat</em> : composez votre duo</h2>
<p class="rt-lead">Le masque LED visage &amp; cou, plus le complément de votre choix. Moins cher qu'achetés séparément. À s'offrir… ou à offrir.</p>
<ul><li>Masque LED visage &amp; cou, dans tous les coffrets</li><li>Au choix : les lunettes regard, micro-massage doux + lumière rouge</li><li>Ou le stylo visage haute fréquence, 4 embouts en verre</li></ul>
<div class="rt-price"><b>dès {{ pk_price }}{%- if ref > vmin -%} <s style="font-size:.6em;font-weight:500;color:#E8D9D5;opacity:.8">{{ ref | money }}</s>{%- endif -%}</b><span>{%- if sep > 0 -%}Prix barré = masque + complément achetés séparément · jusqu'à {{ sep | money }} d'économie{%- else -%}Deux choix de coffret{%- endif -%}</span></div>
<div class="rt-btns"><a class="rt-btn rt-btn--p" href="{{ pk_url }}">Je compose mon coffret</a></div>
<p class="rt-small">Le coffret peut arriver en 2 colis, chacun avec son numéro de suivi.</p>
</div>
<div class="rt-gift__vis">{%- if pk_ok and pk.featured_image -%}<img src="{{ pk.featured_image | image_url: width: 900 }}" srcset="{{ pk.featured_image | image_url: width: 600 }} 600w, {{ pk.featured_image | image_url: width: 1100 }} 1100w" sizes="(max-width: 989px) 92vw, 45vw" alt="{{ pk.title | escape }}" loading="lazy" width="900" height="900">{%- else -%}<svg viewBox="0 0 200 200" width="58%" fill="none" aria-hidden="true"><rect x="30" y="80" width="140" height="100" rx="10" fill="#fff"/><rect x="22" y="60" width="156" height="30" rx="8" fill="#FBEFEC"/><rect x="92" y="60" width="16" height="120" fill="#C47A86"/><path d="M100 60c-10-22-38-26-40-10-2 12 22 12 40 10zM100 60c10-22 38-26 40-10 2 12-22 12-40 10z" fill="#C47A86"/></svg>{%- endif -%}<span class="rt-gift__badge">Au choix</span></div>
</section></div>
</div>
{% schema %}
{"name": "RT · Coffret", "settings": [], "presets": [{"name": "RT · Coffret"}]}
{% endschema %}
