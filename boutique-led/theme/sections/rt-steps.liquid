{{ 'rituel.css' | asset_url | stylesheet_tag }}
<div class="section section--page-width" style="padding-top:10px;padding-bottom:10px">
<div class="rt"><section class="rt-wrap rt-steps vh-steps">
<div class="rt-center"><h2>Comment ça marche</h2></div>
{%- if section.settings.video != blank -%}<div class="vh-steps__video">{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false }}</div>{%- endif -%}
<ol class="vh-steps__list">
<li><span>01</span><div><h3>Peau propre</h3><p>Visage et cou nettoyés et secs, sans maquillage.</p></div></li>
<li><span>02</span><div><h3>Allumez</h3><p>Posez le masque, appuyez 3 secondes pour allumer, puis choisissez votre couleur d'une touche.</p></div></li>
<li><span>03</span><div><h3>10 à 15 minutes</h3><p>Retirez-le, puis appliquez votre soin habituel.</p></div></li>
</ol>
<p class="rt-small" style="text-align:center;margin-top:18px">3 à 5 fois par semaine, de préférence le soir. Lisez la notice avant la première utilisation.</p>
</section></div>
</div>
{% schema %}
{"name": "RT · Comment ça marche", "settings": [
{"type": "video", "id": "video", "label": "Vidéo courte (facultatif)", "info": "8 à 12 secondes, verticale, sans son : on allume le masque, 2 ou 3 couleurs, puis le masque porté."}
], "presets": [{"name": "RT · Comment ça marche"}]}
{% endschema %}
