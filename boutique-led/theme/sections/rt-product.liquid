{{ 'rituel.css' | asset_url | stylesheet_tag }}
{%- assign m = all_products['masque-led-visage-cou-silicone-souple-sans-fil'] -%}
{%- assign m_ok = false -%}{%- if m.handle == 'masque-led-visage-cou-silicone-souple-sans-fil' -%}{%- assign m_ok = true -%}{%- endif -%}
{%- if m_ok -%}{%- assign m_url = m.url -%}{%- else -%}{%- assign m_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if m_ok -%}{%- assign m_price = m.price | money -%}{%- else -%}{%- assign m_price = '79,90 €' -%}{%- endif -%}
<div class="section section--page-width" style="padding-top:10px;padding-bottom:10px">
<div class="rt rt-anim" id="rt-masque"><section class="rt-wrap" style="padding-left:0;padding-right:0"><div class="rt-prod">
<div class="rt-prod__img vl-frame" aria-hidden="true"></div>
<div>
<h2>Le masque en détail</h2>
{%- if m_ok -%}{% render 'velea-etoiles', product: m, link: '#avis' %}{%- endif -%}
<p class="rt-lead" style="margin-top:12px">Un masque pour le visage et une pièce pour le cou, reliés par une boucle détachable. Batterie intégrée, sans fil ni boîtier.</p>
<div class="rt-feat">
<div><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3c4 4 6 7 6 10a6 6 0 0 1-12 0c0-3 2-6 6-10z"/></svg></span><p><b>Protège-yeux</b><span>Fenêtres transparentes</span></p></div>
<div><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="7" r="4"/><path d="M9 11v3c0 1 1.3 2 3 2s3-1 3-2v-3M5 21c1-3 3.8-5 7-5s6 2 7 5"/></svg></span><p><b>Visage + cou</b><span>2 pièces incluses</span></p></div>
<div><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span><p><b>7 couleurs</b><span>120 × 3 LED</span></p></div>
<div><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M10 2h4M11 9l-2 4h4l-2 4"/></svg></span><p><b>Sans fil</b><span>600 mAh, recharge USB-C</span></p></div>
<div><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><p><b>1 à 2,5 h</b><span>d'autonomie par charge</span></p></div>
<div><span class="rt-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3"/><path d="M2 13a2 2 0 0 1 4 0v2h12v-2a2 2 0 0 1 4 0v5H2z"/><path d="M5 18v2M19 18v2"/></svg></span><p><b>Bouton tactile</b><span>Une touche pour tout</span></p></div>
</div>
<div class="rt-box"><b>Dans la boîte :</b> 1 masque visage, 1 pièce pour le cou, 1 sangle, 1 câble USB-C, 1 notice, 1 boîte.</div>
<div class="rt-price"><b>{{ m_price }}</b><span>30 jours pour changer d'avis</span></div>
<div class="rt-btns"><a class="rt-btn rt-btn--p" href="{{ m_url }}">Je commande mon masque</a></div>
{% render 'velea-paiement' %}
<p class="rt-small" style="margin-top:12px">Appareil de bien-être, non médical. Lisez les précautions avant utilisation.</p>
</div>
</div></section></div>
</div>
