{{ 'rituel.css' | asset_url | stylesheet_tag }}
{%- assign m = all_products['masque-led-visage-cou-silicone-souple-sans-fil'] -%}
{%- assign m_ok = false -%}{%- if m.handle == 'masque-led-visage-cou-silicone-souple-sans-fil' -%}{%- assign m_ok = true -%}{%- endif -%}
{%- if m_ok -%}{%- assign m_url = m.url -%}{%- else -%}{%- assign m_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if m_ok -%}{%- assign m_price = m.price | money -%}{%- else -%}{%- assign m_price = '107,90 €' -%}{%- endif -%}
{%- assign pk = all_products['pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard'] -%}
{%- assign ey = all_products['lunettes-led-regard-lumiere-rouge-contour-des-yeux'] -%}
{%- assign hf = all_products['stylo-visage-haute-frequence'] -%}
<div class="section section--page-width" style="padding-top:8px;padding-bottom:4px">
<div class="rt"><section class="rt-wrap rt-hero"><div class="rt-hero__in">
<div>
<h1>Le masque LED visage &amp; cou</h1>
{%- if m_ok -%}{% render 'velea-etoiles', product: m, link: '#avis' %}{%- endif -%}
<p class="rt-lead">Silicone souple, sans fil, minuteur de 10 minutes. On le pose le soir, on ferme les yeux, il s'éteint tout seul.</p>
<div class="rt-price"><b>{{ m_price }}</b><span>Livraison suivie en 5 à 10 jours ouvrés</span></div>
<div class="rt-btns"><a class="rt-btn rt-btn--p" href="{{ m_url }}">Voir le masque</a><a class="rt-btn rt-btn--s" href="#rt-rituel">Les coffrets</a></div>
{% render 'velea-paiement' %}
<nav class="vl-chips" aria-label="Accès rapide">
<a href="{{ m_url }}">Masque</a>
{%- if pk.handle != blank -%}<a href="{{ pk.url }}">Coffret</a>{%- endif -%}
{%- if ey.handle != blank -%}<a href="{{ ey.url }}">Lunettes</a>{%- endif -%}
{%- if hf.handle != blank -%}<a href="{{ hf.url }}">Stylo</a>{%- endif -%}
<a href="#faq">Questions</a>
</nav>
</div>
<div class="rt-viscol"><div class="rt-vis vl-frame" aria-hidden="true"></div></div>
</div></section>
<div class="rt-sticky"><p><b>{{ m_price }}</b>Masque LED visage &amp; cou</p><a class="rt-btn rt-btn--p" href="{{ m_url }}">Voir le masque</a></div>
</div>
</div>
{% schema %}
{"name": "RT · Bannière masque LED", "settings": [], "presets": [{"name": "RT · Bannière masque LED"}]}
{% endschema %}
