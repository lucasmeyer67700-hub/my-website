{{ 'rituel.css' | asset_url | stylesheet_tag }}
{%- assign m = all_products['masque-led-visage-cou-silicone-souple-sans-fil'] -%}
{%- assign m_ok = false -%}{%- if m.handle == 'masque-led-visage-cou-silicone-souple-sans-fil' -%}{%- assign m_ok = true -%}{%- endif -%}
{%- if m_ok -%}{%- assign m_url = m.url -%}{%- else -%}{%- assign m_url = '/collections/all' -%}{%- endif -%}
{%- if m_ok -%}{%- assign m_price = m.price | money -%}{%- else -%}{%- assign m_price = '79,90 €' -%}{%- endif -%}
{%- comment -%} Photo : celle choisie dans l'éditeur, sinon la photo principale du masque. Sans photo : pas de cadre vide. {%- endcomment -%}
{%- assign img = section.settings.photo -%}
{%- if img == blank and m_ok -%}{%- assign img = m.featured_image -%}{%- endif -%}
<div class="section section--page-width" style="padding-top:8px;padding-bottom:4px">
<div class="rt"><section class="rt-wrap rt-hero vh-hero{% if img == blank %} vh-hero--noimg{% endif %}"><div class="rt-hero__in">
<div class="vh-hero__txt">
<h1>{{ section.settings.titre }}</h1>
{%- if m_ok -%}{% render 'velea-etoiles', product: m, link: '#avis' %}{%- endif -%}
<p class="rt-lead">{{ section.settings.texte }}</p>
<p class="vh-price">{{ m_price }}</p>
<div class="vh-goldwrap"><a class="vh-gold" id="vh-hero-cta" href="#rt-masque"><span class="vh-gold__t">{{ section.settings.cta }}</span><span class="vh-gold__a" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg></span></a></div>
</div>
{%- if img != blank -%}
<div class="rt-viscol"><div class="vh-vis">{{ img | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 989px) 100vw, 600px', widths: '600, 900, 1200', alt: section.settings.alt }}</div></div>
{%- endif -%}
</div></section>
<div class="rt-sticky" id="vh-sticky"><p><b>{{ m_price }}</b>Masque LED visage &amp; cou</p><a class="rt-btn vh-gold-btn" href="{{ m_url }}">Découvrir</a></div>
<style>
html{scroll-behavior:smooth}
#rt-masque{scroll-margin-top:84px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.vh-gold__a{animation:none}}
</style>
<script>
(function(){var s=document.getElementById('vh-sticky'),c=document.getElementById('vh-hero-cta');if(!s||!c||!('IntersectionObserver' in window))return;
var past=false,end=false;function u(){s.classList.toggle('is-on',past&&!end)}
new IntersectionObserver(function(e){past=!e[0].isIntersecting&&e[0].boundingClientRect.top<0;u()}).observe(c);
var f=document.querySelector('.vh-final')||document.querySelector('footer');if(f)new IntersectionObserver(function(e){end=e[0].isIntersecting||e[0].boundingClientRect.top<0;u()}).observe(f);})();
/* v22 : effet au toucher (iOS) + apparition douce au défilement */
document.addEventListener('touchstart',function(){},{passive:true});
(function(){if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
var els=document.querySelectorAll('.rt .rt-center,.vh-trust>div,.rt-feat>div,.vh-why__list>div,.vh-steps__list li,.vh-rev__card,.vh-cof__card,.vh-comp__card,.vh-mini__card,.vh-det__colors,.vh-det__specs,.vh-det__care,.rt-faq details,.vh-final>*,.vh-prod__img');
var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});
els.forEach(function(el){if(el.closest('.vh-hero'))return;var i=Array.prototype.indexOf.call(el.parentNode.children,el);el.style.transitionDelay=Math.min(i,5)*70+'ms';el.classList.add('vh-r');el.addEventListener('transitionend',function d(ev){if(ev.propertyName!=='opacity')return;el.classList.remove('vh-r','is-in');el.style.transitionDelay='';el.removeEventListener('transitionend',d)});io.observe(el)});})();
</script>
</div>
</div>
{% schema %}
{"name": "RT · Bannière masque LED", "settings": [
{"type": "image_picker", "id": "photo", "label": "Photo (masque porté et allumé)", "info": "Carrée, 1200 × 1200 px, fond rose poudré ou crème, sans texte. Sans photo choisie : photo principale du masque."},
{"type": "text", "id": "alt", "label": "Description de la photo", "default": "Femme portant le masque LED VELEA allumé sur le visage et le cou"},
{"type": "text", "id": "titre", "label": "Titre", "default": "La lumière LED, visage et cou."},
{"type": "textarea", "id": "texte", "label": "Phrase", "default": "Un masque sans fil à porter 10 à 15 minutes, le soir, chez vous. 7 couleurs de lumière, un bouton, rien d'autre."},
{"type": "text", "id": "cta", "label": "Bouton", "default": "Voir le masque", "info": "Le bouton fait descendre la page jusqu'au masque."}
], "presets": [{"name": "RT · Bannière masque LED"}]}
{% endschema %}
