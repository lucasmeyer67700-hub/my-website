{{ 'rituel.css' | asset_url | stylesheet_tag }}
<div class="section section--page-width" style="padding-top:10px;padding-bottom:10px">
<div class="rt"><section class="rt-wrap vh-why">
<div class="rt-center"><h2>Pourquoi VELEA</h2><p class="rt-lead">Nous avons choisi un seul masque, et nous l'avons choisi avec soin.</p></div>
<div class="vh-why__list">
<div><h3>Un seul appareil, visage et cou</h3><p>Le cou est souvent oublié. Ici, il a sa propre pièce, incluse.</p></div>
<div><h3>Vraiment sans fil</h3><p>Pas de boîtier à tenir ni de câble pendant la séance. Vous bougez librement.</p></div>
<div><h3>Des informations claires</h3><p>Caractéristiques, contenu de la boîte, précautions : tout est écrit. Pas de promesse miracle.</p></div>
<div><h3>30 jours pour essayer</h3><p>S'il ne vous convient pas, vous le renvoyez et nous vous remboursons.</p></div>
</div>
{%- if section.settings.citation != blank -%}<blockquote class="vh-why__sig"><p>« {{ section.settings.citation }} »</p>{%- if section.settings.signature != blank -%}<cite>{{ section.settings.signature }}</cite>{%- endif -%}</blockquote>{%- endif -%}
{%- if section.settings.lien != blank -%}<p class="rt-center" style="margin-top:18px"><a class="vh-link" href="{{ section.settings.lien }}">Notre histoire</a></p>{%- endif -%}
</section></div>
</div>
{% schema %}
{"name": "RT · Pourquoi VELEA", "settings": [
{"type": "textarea", "id": "citation", "label": "Votre phrase (facultatif, seulement si c'est vrai)", "info": "Ex. : J'ai lancé VELEA pour proposer des appareils beauté simples, bien expliqués et faciles à utiliser chez soi."},
{"type": "text", "id": "signature", "label": "Signature (ex. Prénom, fondateur)"},
{"type": "url", "id": "lien", "label": "Lien « Notre histoire »"}
], "presets": [{"name": "RT · Pourquoi VELEA"}]}
{% endschema %}
