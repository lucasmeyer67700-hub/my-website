{{ 'rituel.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Avis clientes RÉELS uniquement. Invisible pour les clientes tant que moins de 3 avis sont ajoutés.
  Dans l'éditeur, 3 cartes d'exemple (clairement marquées) montrent le rendu.
{%- endcomment -%}
{%- assign real = section.blocks.size -%}
{%- if real >= 3 or request.design_mode -%}
<div class="section section--page-width" style="padding-top:10px;padding-bottom:10px">
<div class="rt" id="avis"><section class="rt-wrap vh-rev" style="padding-left:0;padding-right:0">
<div class="rt-center"><h2>Ce qu'en disent nos clientes</h2>
{%- if real >= 3 and section.settings.note != blank and section.settings.nombre != blank -%}<p class="vh-rev__sum"><span class="vh-rev__stars" aria-hidden="true">★★★★★</span> <b>{{ section.settings.note }}</b> sur 5 · {{ section.settings.nombre }} avis</p>{%- endif -%}
{%- if real < 3 -%}<p class="vh-rev__demo">Aperçu visible uniquement dans l'éditeur : la section apparaîtra pour vos clientes à partir de 3 vrais avis.</p>{%- endif -%}
</div>
<div class="vh-rev__grid">
{%- if real >= 3 -%}
{%- for b in section.blocks limit: 6 -%}
<figure class="vh-rev__card" {{ b.shopify_attributes }}>
<span class="vh-rev__stars" aria-label="{{ b.settings.note }} sur 5">{%- for i in (1..5) -%}{%- if i <= b.settings.note -%}★{%- else -%}<i>★</i>{%- endif -%}{%- endfor -%}</span>
{%- if b.settings.photo != blank -%}<div class="vh-rev__ph">{{ b.settings.photo | image_url: width: 144 | image_tag: loading: 'lazy', width: 72, height: 72, alt: b.settings.nom }}</div>{%- endif -%}
<blockquote>{{ b.settings.texte }}</blockquote>
<figcaption><b>{{ b.settings.nom }}</b>{%- if b.settings.date != blank -%} · {{ b.settings.date }}{%- endif -%}{%- if b.settings.verifie -%} · Achat vérifié{%- endif -%}{%- if b.settings.offert -%} · Produit offert{%- endif -%}</figcaption>
</figure>
{%- endfor -%}
{%- else -%}
{%- for i in (1..3) -%}<figure class="vh-rev__card"><span class="vh-rev__stars">★★★★★</span><blockquote>Exemple : le texte de l'avis de votre cliente s'affichera ici.</blockquote><figcaption><b>Prénom N.</b> · date</figcaption></figure>{%- endfor -%}
{%- endif -%}
</div>
{%- if section.settings.lien != blank -%}<div class="rt-btns" style="justify-content:center;margin-top:20px"><a class="rt-btn rt-btn--s" href="{{ section.settings.lien }}">Lire tous les avis</a></div>{%- endif -%}
</section></div>
</div>
{%- endif -%}
{% schema %}
{"name": "RT · Avis clientes", "settings": [
{"type": "paragraph", "content": "Ajoutez uniquement de VRAIS avis. La section reste invisible pour les clientes tant qu'il y a moins de 3 avis."},
{"type": "text", "id": "note", "label": "Note moyenne réelle (ex. 4,7)"},
{"type": "text", "id": "nombre", "label": "Nombre réel d'avis"},
{"type": "url", "id": "lien", "label": "Lien « Lire tous les avis » (facultatif)"}
], "blocks": [{"type": "avis", "name": "Avis", "settings": [
{"type": "text", "id": "nom", "label": "Prénom + initiale (ex. Sophie M.)", "default": "Prénom N."},
{"type": "text", "id": "date", "label": "Date (ex. octobre 2026)"},
{"type": "range", "id": "note", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5},
{"type": "textarea", "id": "texte", "label": "Texte de l'avis"},
{"type": "image_picker", "id": "photo", "label": "Photo de la cliente (avec son accord)"},
{"type": "checkbox", "id": "verifie", "label": "Achat vérifié (commande retrouvée)", "default": false},
{"type": "checkbox", "id": "offert", "label": "Produit offert (obligatoire de l'indiquer)", "default": false}
]}], "presets": [{"name": "RT · Avis clientes"}]}
{% endschema %}
