{%- comment -%}
  Vue 360° du masque (page produit masque) – modèle 3D (assets/velea-3d.js, source : boutique-led/viewer3d).
  On tourne le masque à 360° ; les pastilles allument les LED. Image fixe affichée pendant le chargement ou si la 3D n'est pas disponible.
{%- endcomment -%}
<div class="vh-360" id="vue-360" data-js="{{ 'velea-3d.js' | asset_url }}">
  <div class="vh-360__stage" role="img" aria-label="Masque LED VELEA en 3D : faites glisser pour le tourner à 360°">
    <img class="vh-360__poster" src="{{ 'velea-360-p0.webp' | asset_url }}" alt="Masque LED VELEA de face" width="509" height="722" fetchpriority="high" draggable="false">
    <div class="vh-360__gl"></div>
    <span class="vh-360__hint" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/></svg><span>Glissez pour tourner</span></span>
    <span class="vh-360__badge">360°</span>
    <button type="button" class="vh-360__arr vh-360__arr--l" data-turn="-60" aria-label="Tourner vers la gauche"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
    <button type="button" class="vh-360__arr vh-360__arr--r" data-turn="60" aria-label="Tourner vers la droite"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
  </div>
  <div class="vh-360__bar" role="group" aria-label="Couleurs des LED">
    <button type="button" class="vh-360__b vh-360__b--spin is-on" data-mode="spin"><span>Éteint</span></button>
    <button type="button" class="vh-360__b" data-hex="#ff2e2e"><i style="background:#E0474C"></i><span>Rouge</span></button>
    <button type="button" class="vh-360__b" data-hex="#27e36a"><i style="background:#4CAF7A"></i><span>Vert</span></button>
    <button type="button" class="vh-360__b" data-hex="#2f6bff"><i style="background:#3F7FE0"></i><span>Bleu</span></button>
    <button type="button" class="vh-360__b" data-hex="#9b4dff"><i style="background:#8E5BD6"></i><span>Violet</span></button>
    <button type="button" class="vh-360__b" data-hex="#ffc21f"><i style="background:#F2C94C"></i><span>Jaune</span></button>
    <button type="button" class="vh-360__b" data-hex="#1fe0ff"><i style="background:#3FC6D1"></i><span>Cyan</span></button>
    <button type="button" class="vh-360__b" data-hex="#ffffff"><i style="background:#FFFFFF"></i><span>Blanc</span></button>
  </div>
  <p class="vh-360__cap"><span data-cap="spin">Tournez le masque à 360°, ou touchez une couleur pour allumer les LED.</span><span data-cap="led" hidden>LED allumées : <b></b></span></p>
  <p class="vh-360__note">Modèle 3D d'illustration. Couleurs et lumière des LED simulées.</p>
</div>
<style>
.vh-360{width:100%;font-family:var(--font-body--family),sans-serif}
.vh-360__stage{position:relative;aspect-ratio:1/1;border-radius:22px;overflow:hidden;background:radial-gradient(circle at 50% 41%,#B8737F 0%,#93505D 50%,#5E2A35 100%);user-select:none;-webkit-user-select:none}
.vh-360__gl{position:absolute;inset:0;opacity:0;transition:opacity .6s ease;cursor:grab}
.vh-360__gl:active{cursor:grabbing}
.vh-360__gl canvas{display:block;width:100%!important;height:100%!important;outline:none}
.vh-360.is-3d .vh-360__gl{opacity:1}
.vh-360__poster{position:absolute;left:50%;top:6%;height:88%;width:auto;max-width:none;transform:translateX(-50%);filter:drop-shadow(0 24px 30px rgba(40,10,18,.45));transition:opacity .6s ease;pointer-events:none}
.vh-360.is-3d .vh-360__poster{opacity:0}
.vh-360__hint{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.16);color:#fff;font-size:13px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);transition:opacity .4s ease;pointer-events:none;white-space:nowrap}
.vh-360.is-touched .vh-360__hint,.vh-360.no-gl .vh-360__hint{opacity:0}
.vh-360__badge{position:absolute;top:14px;left:14px;padding:5px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.45);color:#fff;font-size:12px;font-weight:600;letter-spacing:.04em;pointer-events:none}
.vh-360__bar{display:flex;gap:6px;margin-top:12px;overflow-x:auto;scrollbar-width:none;padding:2px 2px 4px}
.vh-360__bar::-webkit-scrollbar{display:none}
.vh-360__b{flex:none;display:inline-flex;align-items:center;gap:7px;min-height:40px;padding:8px 12px;border-radius:999px;border:1px solid #E8D5CC;background:#fff;color:#3D2B2F;font-size:13px;font-weight:500;cursor:pointer;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease;-webkit-tap-highlight-color:transparent}
.vh-360__b i{display:block;width:16px;height:16px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(61,43,47,.15)}
.vh-360__b:hover{transform:translateY(-1px);border-color:#C9A894}
.vh-360__b:active{transform:scale(.95)}
.vh-360__b.is-on{border-color:#93505D;box-shadow:0 0 0 1px #93505D;background:#FCF6F4}
.vh-360__b--spin{font-weight:600}
.vh-360.no-gl .vh-360__bar,.vh-360.no-gl .vh-360__cap{display:none}
.vh-360__cap{margin:8px 2px 0;font-size:14px;color:#3D2B2F}
.vh-360__note{margin:2px 2px 0;font-size:12px;color:#7D625A}
@media (min-width:990px){.vh-360__bar{flex-wrap:wrap;overflow:visible}}
@media (max-width:749px){
  .vh-360__bar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;overflow:visible;padding:0}
  .vh-360__b{justify-content:center;gap:5px;min-height:42px;padding:6px 4px;font-size:12px}
  .vh-360__b i{width:13px;height:13px}
}
.vh-360__arr{position:absolute;top:50%;z-index:2;display:grid;place-items:center;width:44px;height:44px;margin-top:-22px;border:0;border-radius:50%;background:rgba(255,255,255,.2);color:#fff;cursor:pointer;opacity:0;pointer-events:none;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);transition:opacity .4s ease,background .2s ease,transform .15s ease;-webkit-tap-highlight-color:transparent}
.vh-360__arr--l{left:10px}.vh-360__arr--r{right:10px}
.vh-360.is-3d .vh-360__arr{opacity:1;pointer-events:auto}
.vh-360__arr:hover{background:rgba(255,255,255,.32)}
.vh-360__arr:active{transform:scale(.92)}
@media (max-width:749px){
  .vh-360__stage{width:min(88%,46vh);width:min(88%,46svh);margin:0 auto;border-radius:18px}
  .vh-360--stylo .vh-360__stage{width:min(76%,40vh);width:min(76%,40svh)}
  .vh-360__hint{font-size:12px;bottom:10px;padding:6px 11px}
  .vh-360__badge{top:10px;left:10px}
  .vh-360__cap,.vh-360__note{text-align:center}
}

</style>
<script>
(function(){
  var root=document.getElementById('vue-360'); if(!root||root.dataset.ok)return; root.dataset.ok=1;
  var btns=[].slice.call(root.querySelectorAll('.vh-360__b')), api=null, pending=null;
  var capS=root.querySelector('[data-cap="spin"]'), capL=root.querySelector('[data-cap="led"]'), capB=capL.querySelector('b');
  function select(b){
    btns.forEach(function(x){x.classList.toggle('is-on',x===b)});
    var hex=b.dataset.hex||null;
    capS.hidden=!!hex; capL.hidden=!hex; if(hex)capB.textContent=b.textContent.trim();
    if(!api){pending=b;return}
    api.setLed(hex); if(hex)api.turnTo(150); else api.turnTo(0);
  }
  btns.forEach(function(b){b.addEventListener('click',function(){select(b)})});
  [].forEach.call(root.querySelectorAll('[data-turn]'),function(b){b.addEventListener('click',function(){if(api&&api.turnBy)api.turnBy(+b.dataset.turn)})});
  function start(){
    if(root.dataset.loading)return; root.dataset.loading=1;
    var ok=false; try{var c=document.createElement('canvas');ok=!!(window.WebGLRenderingContext&&(c.getContext('webgl2')||c.getContext('webgl')))}catch(e){}
    if(!ok){root.classList.add('no-gl');return}
    var s=document.createElement('script'); s.src=root.dataset.js; s.async=true;
    s.onload=function(){ if(window.VeleaMask3D){api=window.VeleaMask3D(root,{dist:8.4})||null; if(api&&pending)select(pending);} else root.classList.add('no-gl'); };
    s.onerror=function(){root.classList.add('no-gl')};
    document.head.appendChild(s);
  }
  if('IntersectionObserver' in window){var io=new IntersectionObserver(function(en){if(en[0].isIntersecting){io.disconnect();start()}},{rootMargin:'200px'});io.observe(root)}else start();
})();
</script>
