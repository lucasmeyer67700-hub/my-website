{%- comment -%}
  Carte produit VELEA. Paramètre : p (produit).
  Photo : photo principale du produit, sinon rendu 3D (masque, stylo, lunettes), sinon visuel rose avec icône (coffret).
{%- endcomment -%}
{%- liquid
  assign h = p.handle
  assign nom = p.title
  assign kicker = 'Complément'
  assign asset = ''
  assign ico = 'star'
  assign desc = ''
  assign from_price = false
  if h == 'masque-led-visage-cou-silicone-souple-sans-fil'
    assign nom = 'Masque LED visage & cou'
    assign kicker = 'Le produit phare'
    assign asset = 'velea-masque-3d'
  elsif h == 'pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard'
    assign nom = 'Coffret masque + complément'
    assign kicker = 'Coffret'
    assign ico = 'gift'
    assign desc = 'Masque + 1 appareil au choix'
    assign from_price = true
  elsif h == 'lunettes-led-regard-lumiere-rouge-contour-des-yeux'
    assign nom = 'Lunettes LED regard'
    assign asset = 'velea-lunettes-3d'
    assign ico = 'eye'
    assign desc = 'Pour le contour des yeux'
  elsif h == 'stylo-visage-haute-frequence'
    assign nom = 'Stylo visage haute fréquence'
    assign asset = 'velea-stylo-3d'
  endif
-%}
<a class="vc" href="{{ p.url }}">
  <span class="vc__media">
    {%- if p.featured_image -%}
      {{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 70vw, 320px', widths: '400, 600, 900', alt: nom, class: 'vc__img' }}
    {%- elsif asset != '' -%}
      {%- capture a8 -%}{{ asset | append: '-800.webp' | asset_url }}{%- endcapture -%}
      {%- capture a12 -%}{{ asset | append: '-1200.webp' | asset_url }}{%- endcapture -%}
      <img class="vc__img" src="{{ a8 }}" srcset="{{ a8 }} 800w, {{ a12 }} 1200w" sizes="(max-width: 749px) 70vw, 320px" width="800" height="1000" loading="lazy" decoding="async" alt="{{ nom | escape }}">
    {%- else -%}
      <span class="vc__ph" aria-hidden="true">
        <span class="vc__ico">
          {%- case ico -%}
            {%- when 'gift' -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="18" width="32" height="24" rx="2"/><path d="M6 12h36v6H6zM24 12v30M24 12c-3-6-12-7-12-1 0 3 6 1 12 1zM24 12c3-6 12-7 12-1 0 3-6 1-12 1z"/></svg>
            {%- when 'eye' -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 24c3-5 9-9 14-9h12c5 0 11 4 14 9"/><rect x="7" y="20" width="15" height="10" rx="5"/><rect x="26" y="20" width="15" height="10" rx="5"/><path d="M22 25h4"/></svg>
            {%- else -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="24" cy="24" r="10"/></svg>
          {%- endcase -%}
        </span>
        <span class="vc__phname">{{ desc | default: nom }}</span>
      </span>
    {%- endif -%}
    <span class="vc__badge">{{ kicker }}</span>
  </span>
  <span class="vc__body">
    <span class="vc__name">{{ nom }}</span>
    <span class="vc__price">{% if from_price and p.price_varies %}Dès {% endif %}{{ p.price_min | money }}</span>
    <span class="vc__cta">Découvrir<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
  </span>
</a>
