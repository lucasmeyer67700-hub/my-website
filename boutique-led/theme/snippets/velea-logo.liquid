{% comment %} Logo VELEA : fleur dorée à traits fins (5 pétales, cœur rosé) + nom. {% endcomment %}
<span class="vl-logo" aria-label="VELEA">
  <svg class="vl-flower" viewBox="0 0 48 48" aria-hidden="true">
    <defs><linearGradient id="vlGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#E6CF9E"/><stop offset=".5" stop-color="#C9A461"/><stop offset="1" stop-color="#A87F3E"/></linearGradient></defs>
    <g transform="translate(24 25.5)">
      <g fill="#FBEFEC" stroke="url(#vlGold)" stroke-width="1.15" stroke-linejoin="round"><path d="M0 -2.5C4.6 -7 5.2 -14.5 0 -20.5C-5.2 -14.5 -4.6 -7 0 -2.5Z" transform="rotate(0)"/><path d="M0 -2.5C4.6 -7 5.2 -14.5 0 -20.5C-5.2 -14.5 -4.6 -7 0 -2.5Z" transform="rotate(72)"/><path d="M0 -2.5C4.6 -7 5.2 -14.5 0 -20.5C-5.2 -14.5 -4.6 -7 0 -2.5Z" transform="rotate(144)"/><path d="M0 -2.5C4.6 -7 5.2 -14.5 0 -20.5C-5.2 -14.5 -4.6 -7 0 -2.5Z" transform="rotate(216)"/><path d="M0 -2.5C4.6 -7 5.2 -14.5 0 -20.5C-5.2 -14.5 -4.6 -7 0 -2.5Z" transform="rotate(288)"/></g>
      <g fill="#E9B7BE" opacity=".55"><path d="M0 -5C2 -8 2.3 -12 0 -15C-2.3 -12 -2 -8 0 -5Z" transform="rotate(0)"/><path d="M0 -5C2 -8 2.3 -12 0 -15C-2.3 -12 -2 -8 0 -5Z" transform="rotate(72)"/><path d="M0 -5C2 -8 2.3 -12 0 -15C-2.3 -12 -2 -8 0 -5Z" transform="rotate(144)"/><path d="M0 -5C2 -8 2.3 -12 0 -15C-2.3 -12 -2 -8 0 -5Z" transform="rotate(216)"/><path d="M0 -5C2 -8 2.3 -12 0 -15C-2.3 -12 -2 -8 0 -5Z" transform="rotate(288)"/></g>
      <circle r="2.3" fill="url(#vlGold)"/>
    </g>
  </svg>
  <span class="vl-word">VELEA</span>
</span>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&display=swap');
  .vl-logo{display:inline-flex;align-items:center;gap:12px;line-height:1;color:#3D2B2F}
  .vl-flower{width:38px;height:38px;flex:none;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .header-logo:hover .vl-flower{transform:rotate(72deg)}
  .vl-word{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:26px;letter-spacing:.34em;margin-right:-.34em}
  @media screen and (max-width:749px){.vl-flower{width:30px;height:30px}.vl-word{font-size:21px;letter-spacing:.26em;margin-right:-.26em}.vl-logo{gap:8px}}
  @media (prefers-reduced-motion:reduce){.vl-flower{transition:none}}
</style>
