  <span class="vl-word">VELEA</span>
</span>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&display=swap');
  .vl-logo{display:inline-flex;align-items:center;gap:12px;line-height:1;color:#3D2B2F}
  .vl-face{width:40px;height:40px;flex:none;transition:transform .5s cubic-bezier(.2,.7,.2,1)}
  .header-logo:hover .vl-face{transform:scale(1.08)}
  .vl-word{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:26px;letter-spacing:.3em;margin-right:-.3em}
  @media screen and (max-width:749px){.vl-face{width:32px;height:32px}.vl-word{font-size:21px;letter-spacing:.24em;margin-right:-.24em}.vl-logo{gap:8px}}
  @media (prefers-reduced-motion:reduce){.vl-face{transition:none}}
</style>
