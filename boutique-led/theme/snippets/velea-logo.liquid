{% comment %} Logo VELEA : « fleur en V » (deux pétales fins dorés formant le V de VELEA + bouton rose) + nom en lettres modernes espacées. {% endcomment %}
<span class="vl-logo" aria-label="VELEA">
  <svg class="vl-flower" viewBox="0 0 40 40" aria-hidden="true">
    <defs><linearGradient id="vlGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#D9B77A"/><stop offset="1" stop-color="#A87F3E"/></linearGradient></defs>
    <g fill="none" stroke="url(#vlGold)" stroke-width="1.6" stroke-linejoin="round">
      <path class="vl-p1" d="M20 35C13 29 7 20 8 9c7 2 11 10 12 26z"/>
      <path class="vl-p2" d="M20 35c7-6 13-15 12-26-7 2-11 10-12 26z"/>
    </g>
    <circle class="vl-bud" cx="20" cy="9" r="3.2" fill="#C47A86"/>
  </svg>
  <span class="vl-word">VELEA</span>
</span>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400&display=swap');
  .vl-logo{display:inline-flex;align-items:center;gap:12px;line-height:1;color:#3D2B2F}
  .vl-flower{width:34px;height:34px;flex:none;overflow:visible}
  .vl-flower .vl-p1,.vl-flower .vl-p2{transform-origin:20px 35px;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .vl-flower .vl-bud{transition:transform .6s cubic-bezier(.2,.7,.2,1);transform-origin:20px 9px}
  .header-logo:hover .vl-p1{transform:rotate(-6deg)}
  .header-logo:hover .vl-p2{transform:rotate(6deg)}
  .header-logo:hover .vl-bud{transform:translateY(-2px) scale(1.12)}
  .vl-word{font-family:'Montserrat',var(--font-body--family),sans-serif;font-weight:400;font-size:21px;letter-spacing:.42em;margin-right:-.42em}
  @media screen and (max-width:749px){.vl-flower{width:28px;height:28px}.vl-word{font-size:17px;letter-spacing:.34em;margin-right:-.34em}.vl-logo{gap:9px}}
  @media (prefers-reduced-motion:reduce){.vl-flower *{transition:none}}
</style>
