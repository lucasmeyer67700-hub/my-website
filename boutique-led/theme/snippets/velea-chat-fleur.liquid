{%- comment -%} Petite fleur VELEA posée sur la bulle du chat (Inbox), en bas à droite. Cachée quand le chat est ouvert.
  Position réglable : --vl-fleur-right / --vl-fleur-bottom. {%- endcomment -%}
<span class="vl-chat-fleur" aria-hidden="true"><svg viewBox="0 0 40 40"><g fill="#FFFBFA" stroke="#C9A461" stroke-width="2" stroke-linejoin="round"><path d="M20 35C13 29 7 20 8 9c7 2 11 10 12 26z"/><path d="M20 35c7-6 13-15 12-26-7 2-11 10-12 26z"/></g><circle cx="20" cy="9" r="3.4" fill="#C47A86"/></svg></span>
<style>
  .vl-chat-fleur{position:fixed;right:var(--vl-fleur-right,58px);bottom:var(--vl-fleur-bottom,60px);width:26px;height:26px;z-index:2147483647;pointer-events:none;filter:drop-shadow(0 1px 2px rgba(61,43,47,.25));animation:vlFleur 6s ease-in-out infinite}
  .vl-chat-fleur svg{width:100%;height:100%;display:block}
  body:has(shopify-chat[open]) .vl-chat-fleur,body:has(.theme-drawer__dialog.chat-drawer[open]) .vl-chat-fleur{display:none}
  @keyframes vlFleur{0%,100%{transform:rotate(0)}50%{transform:rotate(18deg)}}
  @media (prefers-reduced-motion:reduce){.vl-chat-fleur{animation:none}}
</style>
