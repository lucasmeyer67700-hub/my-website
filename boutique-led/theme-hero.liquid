{%- assign re_p = all_products['masque-led-visage-cou-silicone-souple-sans-fil'] -%}
{%- assign re_pack = all_products['pack-rituel-eclat-masque-led-visage-cou-lunettes-led-regard'] -%}
{%- if re_p.url != blank -%}{%- assign re_url = re_p.url -%}{%- else -%}{%- assign re_url = '/collections/rituel-eclat' -%}{%- endif -%}
{%- if re_pack.url != blank -%}{%- assign re_pack_url = re_pack.url -%}{%- else -%}{%- assign re_pack_url = '/collections/rituel-eclat' -%}{%- endif -%}
<style>
.re-hero{--g:#1f3a2e;--g2:#4a6b5a;--g3:#e8f2eb;--g4:#f3f8f4;--line:#d6e6da;background:linear-gradient(135deg,#ffffff 0%,var(--g4) 55%,var(--g3) 100%);border-radius:24px;overflow:hidden;position:relative}
.re-hero__in{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:48px;padding:72px 64px}
.re-hero__eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--g2);background:#fff;border:1px solid var(--line);padding:8px 14px;border-radius:999px;margin:0 0 22px}
.re-hero__eyebrow i{width:8px;height:8px;border-radius:50%;background:#7fb893;box-shadow:0 0 0 4px rgba(127,184,147,.2)}
.re-hero h1{font-family:var(--font-heading--family);color:var(--g);font-size:clamp(34px,4.6vw,58px);line-height:1.05;letter-spacing:-.02em;margin:0 0 18px;font-weight:600}
.re-hero h1 em{font-style:italic;font-weight:400;color:var(--g2)}
.re-hero__sub{color:var(--g2);font-size:17px;line-height:1.6;max-width:30em;margin:0 0 30px}
.re-hero__cta{display:flex;flex-wrap:wrap;gap:12px;margin:0 0 34px}
.re-btn{display:inline-flex;align-items:center;justify-content:center;padding:16px 28px;border-radius:14px;font-size:15px;font-weight:600;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease}
.re-btn--p{background:var(--g);color:#fff;box-shadow:0 10px 24px -10px rgba(31,58,46,.55)}
.re-btn--p:hover{transform:translateY(-1px);box-shadow:0 14px 28px -10px rgba(31,58,46,.6)}
.re-btn--s{background:#fff;color:var(--g);border:1px solid var(--g)}
.re-hero__pts{display:flex;flex-wrap:wrap;gap:10px 22px;list-style:none;padding:0;margin:0;color:var(--g);font-size:14px}
.re-hero__pts li{display:flex;align-items:center;gap:8px}
.re-hero__pts svg{flex:none}
.re-hero__vis{position:relative;aspect-ratio:1/1;max-width:480px;width:100%;justify-self:center}
.re-hero__vis img{width:100%;height:100%;object-fit:cover;border-radius:50%;box-shadow:0 30px 60px -30px rgba(31,58,46,.45)}
.re-glow{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 50% 45%,#ffffff 0 30%,#dcefe2 46%,#bfe0c9 60%,rgba(191,224,201,0) 72%)}
.re-ring{position:absolute;border-radius:50%;border:1px solid rgba(74,107,90,.22);inset:var(--i)}
.re-ring:nth-child(2){--i:4%;animation:re-pulse 5s ease-in-out infinite}
.re-ring:nth-child(3){--i:14%;animation:re-pulse 5s ease-in-out 1.2s infinite}
.re-ring:nth-child(4){--i:24%;animation:re-pulse 5s ease-in-out 2.4s infinite}
@keyframes re-pulse{0%,100%{opacity:.35;transform:scale(1)}50%{opacity:1;transform:scale(1.03)}}
.re-mask{position:absolute;inset:26% 30%;}
.re-tag{position:absolute;background:#fff;border:1px solid var(--line);border-radius:14px;padding:10px 14px;font-size:13px;color:var(--g);box-shadow:0 12px 30px -18px rgba(31,58,46,.5);line-height:1.3}
.re-tag b{display:block;font-size:18px}
.re-tag--a{top:8%;right:-2%}.re-tag--b{bottom:10%;left:-4%}
@media (prefers-reduced-motion:reduce){.re-ring{animation:none!important}}
@media (max-width:900px){.re-hero__in{grid-template-columns:1fr;padding:40px 22px 48px;gap:28px;text-align:left}.re-hero__vis{max-width:320px;order:-1}.re-tag--a{right:0}.re-tag--b{left:0}.re-hero__sub{font-size:16px}.re-btn{flex:1 1 100%}}
</style>
<div class="re-hero">
  <div class="re-hero__in">
    <div>
      <p class="re-hero__eyebrow"><i></i>Routine spa à la maison</p>
      <h1>Votre rituel éclat, <em>comme au spa</em>, sans quitter la maison</h1>
      <p class="re-hero__sub">Le masque LED visage &amp; cou en silicone souple : 10 minutes de lumière douce le soir, pour un teint plus lumineux même en plein hiver.</p>
      <div class="re-hero__cta">
        <a class="re-btn re-btn--p" href="{{ re_url }}">Découvrir le masque LED</a>
        <a class="re-btn re-btn--s" href="{{ re_pack_url }}">Voir le pack masque + lunettes</a>
      </div>
      <ul class="re-hero__pts">
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a6b5a" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>10 min par séance</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a6b5a" stroke-width="2" stroke-linecap="round"><path d="M12 3c4 4 6 7 6 10a6 6 0 0 1-12 0c0-3 2-6 6-10z"/></svg>Silicone souple</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a6b5a" stroke-width="2" stroke-linecap="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M10 2h4M10 12l2-3v6l2-3"/></svg>Sans prise murale</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a6b5a" stroke-width="2" stroke-linecap="round"><path d="M3 12h13l-4-4M16 12l-4 4"/><path d="M20 5v14"/></svg>Retours 14 jours</li>
      </ul>
    </div>
    <div class="re-hero__vis">
      {%- if re_p.featured_image -%}
        <img src="{{ re_p.featured_image | image_url: width: 1000 }}" alt="{{ re_p.featured_image.alt | default: re_p.title | escape }}" width="1000" height="1000" loading="eager">
      {%- else -%}
        <div class="re-glow"></div><div class="re-ring"></div><div class="re-ring"></div><div class="re-ring"></div>
        <svg class="re-mask" viewBox="0 0 200 240" fill="none" aria-hidden="true">
          <path d="M100 8c48 0 82 36 82 92 0 62-36 124-82 124S18 162 18 100C18 44 52 8 100 8z" fill="#ffffff" stroke="#bcd8c4" stroke-width="3"/>
          <ellipse cx="68" cy="96" rx="20" ry="11" fill="#f3f8f4" stroke="#bcd8c4" stroke-width="2"/>
          <ellipse cx="132" cy="96" rx="20" ry="11" fill="#f3f8f4" stroke="#bcd8c4" stroke-width="2"/>
          <path d="M84 176c10 7 22 7 32 0" stroke="#bcd8c4" stroke-width="3" stroke-linecap="round"/>
          <g fill="#e46b6b" opacity=".75">
            <circle cx="60" cy="50" r="3"/><circle cx="80" cy="42" r="3"/><circle cx="100" cy="40" r="3"/><circle cx="120" cy="42" r="3"/><circle cx="140" cy="50" r="3"/>
            <circle cx="48" cy="128" r="3"/><circle cx="62" cy="142" r="3"/><circle cx="138" cy="142" r="3"/><circle cx="152" cy="128" r="3"/>
            <circle cx="70" cy="196" r="3"/><circle cx="100" cy="206" r="3"/><circle cx="130" cy="196" r="3"/><circle cx="100" cy="130" r="3"/><circle cx="100" cy="150" r="3"/>
          </g>
        </svg>
      {%- endif -%}
      <div class="re-tag re-tag--a"><b>7</b>couleurs de lumière</div>
      <div class="re-tag re-tag--b"><b>Visage + cou</b>2 pièces incluses</div>
    </div>
  </div>
</div>
