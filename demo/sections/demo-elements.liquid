{%- comment -%}
  DÉMO PRIVÉE, jamais publiée (voir demo/README.md) : « Vu sur », témoignages
  avec âge et « Acheteur vérifié », promesses de résultat. Tout le contenu est
  un gabarit à trous, à ne remplir qu'avec des informations vraies.
{%- endcomment -%}
<section class="demo-el section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- case section.settings.part -%}
      {%- when 'press' -%}
        <p class="demo-el__small">Vu sur</p>
        <div class="demo-el__logos">
          {%- for i in (1..4) -%}
            <div class="demo-el__logo">LOGO MÉDIA<br><span class="demo-hole">[article réel]</span></div>
          {%- endfor -%}
        </div>

      {%- when 'testimonials' -%}
        {%- comment -%} The shop's own reviews of the belt (custom.avis_selection), never invented ones. {%- endcomment -%}
        {%- assign belt = all_products['ceinture-chauffante-regles'] -%}
        <h2 class="h2 demo-el__title">Elles l'ont adoptée <em>(et ne peuvent plus s'en passer).</em></h2>
        <p class="demo-el__sub">Rejoignez les <span class="demo-hole">+[nombre réel]</span> clientes satisfaites</p>
        <div class="demo-el__cards">
          {%- assign shown = 0 -%}
          {%- for review in belt.metafields.custom.avis_selection.value -%}
            {%- if review.texte.value == blank -%}{%- continue -%}{%- endif -%}
            {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- capture author -%}{% render 'review-name', name: review.auteur.value %}{%- endcapture -%}
            <article class="demo-el__card">
              {% render 'stars', rating: review.note.value.rating %}
              <p class="demo-el__name">{{ author | escape }}</p>
              <p class="demo-el__quote">{{ review.texte.value | strip_newlines | truncate: 220, '…' | escape }}</p>
              {%- if review.achat_verifie.value and review.source.value == blank -%}
                <p class="demo-el__verified">✔ Acheteur vérifié</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

      {%- when 'timeline' -%}
        <h2 class="h2 demo-el__title">Des résultats, <em>jour après jour.</em></h2>
        <div class="demo-el__steps">
          {%- for i in (1..3) -%}
            <div class="demo-el__step">
              <span class="demo-el__tag">Dès <span class="demo-hole">[délai]</span></span>
              <p class="demo-el__promise"><span class="demo-hole">[Promesse de résultat]</span></p>
            </div>
          {%- endfor -%}
        </div>
        <div class="demo-el__cta">
          <a class="button section-cta__button" href="{% if template.name == 'product' %}#ProductInfo{% else %}{{ routes.all_products_collection_url }}{% endif %}">Je veux ces résultats (−[xx] %)</a>
          <p class="section-cta__note">Sans risque : satisfaite ou remboursée 30 jours</p>
        </div>
    {%- endcase -%}
  </div>
</section>

<style>
  .demo-el {
    text-align: center;
  }

  .demo-el__small {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .demo-el__logos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    max-width: 40rem;
    margin-inline: auto;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .demo-el__logo {
    padding: 0.9rem 0.5rem;
    border: 2px dashed rgb(var(--color-text-rgb) / 0.25);
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .demo-el__title {
    margin: 0 0 0.4rem;
  }

  .demo-el__sub {
    margin: 0 0 1.5rem;
    font-weight: 600;
  }

  .demo-el__cards {
    display: grid;
    gap: 0.9rem;
    text-align: start;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .demo-el__card {
    padding: 1.1rem;
    border-radius: 1rem;
    background: var(--color-background);
    box-shadow: 0 14px 30px -20px rgb(0 0 0 / 0.35);

    & p {
      margin: 0 0 0.5rem;
    }
  }

  .demo-el__stars {
    letter-spacing: 0.12em;
    color: #c9727e;
  }

  .demo-el__name {
    font-weight: 600;
  }

  .demo-el__quote {
    font-style: italic;
    line-height: 1.5;
  }

  .demo-el__verified {
    font-size: 0.8rem;
    font-weight: 600;
    color: #2e7d4f;
  }

  .demo-el__steps {
    display: grid;
    gap: 0.8rem;
    margin-block-start: 1.25rem;
    text-align: start;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .demo-el__step {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .demo-el__tag {
    display: inline-block;
    padding: 0.15rem 0.7rem;
    border: 1px solid var(--color-text);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .demo-el__promise {
    margin: 0.6rem 0 0;
    font-weight: 600;
  }

  .demo-el__cta {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin-block-start: 1.5rem;

    & p {
      margin: 0;
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }
  }
</style>

{% schema %}
{
  "name": "DÉMO : élément fictif",
  "settings": [
    {
      "type": "select",
      "id": "part",
      "label": "Élément",
      "options": [
        { "value": "press", "label": "Vu sur" },
        { "value": "testimonials", "label": "Témoignages" },
        { "value": "timeline", "label": "Promesses de résultat" }
      ],
      "default": "press"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Couleurs",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "DÉMO : élément fictif" }]
}
{% endschema %}
